  "concrete_source_gap": [
    "xdist WorkerInteractor.pytest_sessionfinish sends workerfinished before pytest Config._ensure_unconfigure",
    "Config._ensure_unconfigure invokes pytest_unconfigure then cleanup_stack.close; hook completion alone is not whole cleanup",
    "execnet executetask catches BaseException and closes channel with remote error for ordinary teardown exceptions",
    "WorkerController workerfinished sets _down True; subsequent Marker.END calls _getremoteerror but only notifies errordown if not _down",
    "Channel._getremoteerror destructively pops stored error; a new later waitclose cannot reconstruct consumed remote error"
  ],
