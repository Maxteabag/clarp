  "source_ready": false,
  "source_rules": [
    {
      "id": "cleanup_does_not_allocate",
      "fact": "db.close_local and telemetry.close_local first read existing thread-local conn; absence returns/no opening call. A handler finish call is not a newly born SQLite connection.",
      "not_claimed": "Handler never opened a DB; finish succeeded; descendants drained; all DB identities observed."
    },
    {
      "id": "RPC_thread_scope",
      "fact": "Native RPC handles one decoded request line, dispatches and writes response; handler finish closes this thread state/telemetry handles if present. ThreadingMixIn daemon-thread and socket/request counts are not SQLite connection counts.",
      "not_claimed": "One request one database; retries/concurrent workers share TLS; request finish is all-child drain."
    },
    {
      "id": "status_default_provider",
      "fact": "Default RuntimeRPCServer status provider calls native runtime_status; it composes slot/live/compaction/provider/failover views. Some selected methods are in-memory views.",
      "not_claimed": "Complete all-callee SQL-free theorem; actual private startup has no recovery/client/error branches."
    },
    {
      "id": "status_callee_conditions",
      "fact": "AccountFailover.status may invoke attempt.owned for qualifying attempts; provider_turns catches errors and logs them. Empty attempt/client state and absence of import/log/error side effects need source+actual fixture evidence before reducing a producer bound.",
      "not_claimed": "Callbacks/logging harmless or ignored; module import is no-cost/no-database; every status call follows empty-state route."
    },
    {
      "id": "separate_namespaces",
      "fact": "State db and telemetry expose separate conn/TLS/close functions. Current finite state _TrackedConnection witness is not automatically a telemetry lifetime/actor/cgroup proof.",
      "not_claimed": "All telemetry excluded or free; same file/namespace/connection/commit semantics."
    },
    {
      "id": "steady_external_fanout",
      "fact": "Prior frozen120direct+120HTTP steady offered reads can cause240runtime status calls in that subgraph; none of those call totals is a connection bound. Readiness and other native traffic remain additional.",
      "not_claimed": "240requests is entire campaign;1connection per socket/retry;0connections globally."
    }
  ],
  "remaining": "Exact root/client/API/callee/worker/native retry/fallback and startup/recovery/import/logger state bindings; positive owned process/DB identity and ALL-producer total/live lifetimes; numeric clean/detection/inflight/drain/time/CPU/heap/common A/B policy before integration."
}
