{
  "state": "PREREGISTERED_SOURCE_CLASSIFICATION_PROPOSAL_UNEXECUTED",
  "default": "Unresolved condition => sticky PARTIAL/STOP; native call/result/primary preserved, no outcome-based reclassification",
  "rules": [
    {
      "id": "normal_write_needed_probe",
      "decision": "SOURCE_CONTROL_FLOW_ONLY_IF_PROVED",
      "modules": {
        "server/lib/message_writes.py": [
          "_WriteNeeded",
          "_ImportWriter.execute",
          "store_transcript_turns",
          "store_transcript_tail"
        ]
      },
      "conditions": [
        "Exact native _WriteNeeded object/source raised by the unlocked _ImportWriter before forwarding a write.",
        "Read-probe transaction ending and subsequent locked pass belong to the same native import attempt, no unknown acknowledgement.",
        "Retain observed BEGIN/read/ROLLBACK and all later native writes; no discarded committed batches."
      ],
      "not_allowed": "No generic exception-message match or all probe exceptions ignored."
    },
    {
      "id": "native_admission_poll",
      "decision": "SOURCE_BOUNDED_RETRY_ONLY_IF_PROVED",
      "modules": {
        "server/lib/db.py": [
          "_TrackedConnection._only_acquires_lock",
          "_TrackedConnection._execute_polled",
          "_TrackedConnection.execute",
          "_is_lock_contention"
        ]
      },
      "conditions": [
        "Actual source _only_acquires_lock admits this call; exact plain SQLITE_BUSY predicate, not any OperationalError or extended BUSY code.",
        "Original statement/result/cursor/fetch/call count unchanged; no observer retry or prefetch.",
        "Include actual native polling/timeout cost and the successful outer statement, or classify final native failure before qualifying cell."
      ],
      "not_allowed": "No treating statement return as an autocommit RETURNING finalization certificate."
    },
    {
      "id": "native_whole_operation_lock_retry",
      "decision": "SOURCE_GROUPED_ATTEMPTS_ONLY_IF_PROVED",
      "modules": {
        "server/lib/db.py": [
          "retry_locked",
          "is_locked_error"
        ],
        "server/lib/transcript_import_cache.py": [
          "_import_admitted"
        ]
      },
      "conditions": [
        "Actual source-qualified retry_locked invocation and retries argument; default is three attempts, not permission for uninspected overrides.",
        "Each actual attempt/exception/native transaction outcome retained, including earlier commits; bind all attempts to the same logical owner/source operation.",
        "Last successful result does not excuse unknown acknowledgement, incomplete capture, wrong field/source or an unrelated caught failure."
      ],
      "not_allowed": "No global locked-string acceptance outside the actual retry helper/caller."
    },
    {
      "id": "native_tail_invalidated_fallback",
      "decision": "CANDIDATE_NATIVE_FALLBACK_PROFILE_UNQUALIFIED",
      "modules": {
        "server/lib/message_writes.py": [
          "_TailInvalidated",
          "store_transcript_tail"
        ],
        "server/lib/transcript_incremental.py": [
          "_try_tail",
          "_refuse_tail",
          "import_transcript"
        ]
      },
      "conditions": [
        "Bind exact native class/raise/catch/fallback source and actual transaction state.",
        "Retain invalidated attempt and native subsequent full import, source identity/counter/fields and actual final work coverage.",
        "Do not force a tail hit, repair checkpoints or bypass native full import to fit a cell."
      ],
      "not_allowed": "No claim that every refused checkpoint/tail or logged exception is a qualified successful path."
    },
    {
      "id": "approved_native_usage_enoent",
      "decision": "SOURCE_GUARD_ELIGIBILITY_ONLY_IF_PROVED",
      "modules": {},
      "conditions": [
        "Exact per-pin fetch_codex_usage_app_server source/hash and native Popen argv/kwargs/cwd/inherited private namespace match Guard.",
        "Actual immutable executable namespace contains no allowed provider; genuine native FileNotFoundError errnoENOENT filenamecodex, no returned process.",
        "Qualified attempt and native ENOENT counts, unchanged original exception, zero out-of-band guard failures and no unexpected child."
      ],
      "not_allowed": "No manufactured ENOENT, generic missing CLI fallback, provider execution, process allowlist or old certificate transfer."
    }
  ],
