{
  "catalog": "clarp.form",
  "catalog_version": 1,
  "schema_keywords": [
    "type",
    "properties",
    "required",
    "additionalProperties",
    "items",
    "enum",
    "const",
    "minLength",
    "maxLength",
    "minItems",
    "maxItems",
    "minimum",
    "maximum"
  ],
  "identifiers": {
    "first": "abcdefghijklmnopqrstuvwxyz",
    "rest": "abcdefghijklmnopqrstuvwxyz0123456789_",
    "maxLength": 40,
    "minLength": 1
  },
  "expression_shapes": {
    "$state": {
      "type": "object",
      "properties": {
        "$state": {
          "type": "string",
          "minLength": 2,
          "maxLength": 41
        }
      },
      "required": [
        "$state"
      ],
      "additionalProperties": false
    },
    "$bindState": {
      "type": "object",
      "properties": {
        "$bindState": {
          "type": "string",
          "minLength": 2,
          "maxLength": 41
        }
      },
      "required": [
        "$bindState"
      ],
      "additionalProperties": false
    }
  },
  "components": {
    "stack": {
      "props": {
        "type": "object",
        "properties": {
          "axis": {
            "enum": [
              "vertical",
              "horizontal"
            ]
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "children": true,
      "defaults": {
        "axis": "vertical"
      }
    },
    "card": {
      "props": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "children": true,
      "forbid_descendants": [
        "card"
      ]
    },
    "heading": {
      "props": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 200
          },
          "level": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ]
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "children": false,
      "defaults": {
        "level": 2
      }
    },
    "text": {
      "props": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "children": false,
      "reads": {
        "text": "$state"
      }
    },
    "text_field": {
      "props": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1
          },
          "placeholder": {
            "type": "string",
            "maxLength": 120
          },
          "multiline": {
            "type": "boolean"
          },
          "value": {
            "type": "object",
            "properties": {
              "$bindState": {
                "type": "string",
                "minLength": 2,
                "maxLength": 41
              }
            },
            "required": [
              "$bindState"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false
      },
      "children": false,
      "bindings": {
        "value": "string"
      },
      "defaults": {
        "multiline": false
      }
    },
    "toggle": {
      "props": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1
          },
          "value": {
            "type": "object",
            "properties": {
              "$bindState": {
                "type": "string",
                "minLength": 2,
                "maxLength": 41
              }
            },
            "required": [
              "$bindState"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false
      },
      "children": false,
      "bindings": {
        "value": "boolean"
      }
    },
    "choice": {
      "props": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 12,
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "maxLength": 120,
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "maxLength": 120,
                  "minLength": 1
                }
              },
              "required": [
                "value",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "value": {
            "type": "object",
            "properties": {
              "$bindState": {
                "type": "string",
                "minLength": 2,
                "maxLength": 41
              }
            },
            "required": [
              "$bindState"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "label",
          "options",
          "value"
        ],
        "additionalProperties": false
      },
      "children": false,
      "bindings": {
        "value": "string_enum_in_option_order"
      }
    },
    "divider": {
      "props": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "children": false
    }
  },
  "initial_ui": {
    "text_field": "empty",
    "toggle": false,
    "choice": "unselected"
  },
  "submission": {
    "control": "app_footer",
    "label_source": "submit.label",
    "omit_empty_text_field": true,
    "omit_unselected_choice": true,
    "always_include_toggle": true,
    "require_values_before_submit": true
  }
}
