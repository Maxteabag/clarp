{
  "about": "The chat list's line of a message. The Host sends it as `last_message_preview` (an agent row, a chat preview event, a /log answer) and `preview_parts` (a user-notification): a kind and its values, which each app words in the user's language. `en` is the English line the Host also sends as `last_message` / `preview` for apps that do not know a kind (before \"You: \" for the user's own message, `own: true`). `max`, where given, is the cut of the words. Held by server-rs/crates/clarp-speech/src/list_line.rs.",
  "kinds": {
    "text": [
      "text"
    ],
    "image": [
      "caption (\"\" when none)"
    ],
    "images": [
      "count"
    ],
    "file": [
      "name"
    ],
    "files": [
      "count"
    ],
    "attachments": [
      "count"
    ],
    "code": [],
    "decision": [
      "question",
      "outcome: approved|declined|answered|discarded|expired|resolved",
      "answer (for answered)"
    ],
    "tool": [
      "category: exec|read|list|search|edit|write|fetch|mcp|agent|todo|other",
      "name",
      "label"
    ]
  },
