  "steps": [
    {"open": true},
    {"log": {"mode": "tail", "response": {"conversation_id": "c1", "turns": [{"id": "m1", "role": "assistant", "text": "old", "revision": 1}], "latest_revision": 1, "has_more": false, "missing": false}}},
    {"log": {"mode": "delta", "response": {"conversation_id": "c2", "turns": [{"id": "n1", "role": "assistant", "text": "new", "revision": 2}], "latest_revision": 2, "has_more": false, "missing": false}}},
    {"log": {"mode": "tail", "response": {"conversation_id": "c2", "turns": [{"id": "n1", "role": "assistant", "text": "new", "revision": 2}], "latest_revision": 2, "has_more": false, "missing": false}}}
  ],
