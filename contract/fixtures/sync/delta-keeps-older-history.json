{
  "title": "a delta's has_more is about newer changes; older history stays loadable after it",
  "area": "sync",
  "steps": [
    {"open": true},
    {"log": {"mode": "tail", "response": {"conversation_id": "c1", "turns": [{"id": "m5", "role": "assistant", "text": "five", "revision": 5}], "latest_revision": 5, "has_more": true, "missing": false}}},
    {"sse": {"type": "transcript-updated", "session": "rachel"}},
    {"log": {"mode": "delta", "response": {"conversation_id": "c1", "turns": [{"id": "m6", "role": "assistant", "text": "six", "revision": 6}], "latest_revision": 6, "has_more": false, "missing": false}}}
  ],
  "expect": {
    "effects": ["fetch_tail", "fetch_delta"],
    "cursor": 6,
    "turn_ids": ["m5", "m6"],
    "hasMore": true
  }
}
