{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clarp.local/contract/schemas/agents-snapshot.json",
  "title": "GET /agents/snapshot",
  "description": "Bootstrap read model. head_revision + conversation_id tell a client whether its cached chat is current.",
  "type": "object",
  "additionalProperties": true,
  "required": ["agents"],
  "properties": {
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["agent_id", "session", "persona", "backend", "cwd"],
        "properties": {
          "agent_id": {"type": "string"},
          "session": {"type": "string"},
          "persona": {"type": "string"},
          "backend": {"type": "string"},
          "cwd": {"type": "string"},
          "created_at": {"type": "integer", "description": "Agent creation time in epoch milliseconds (agent_api_status)."},
          "model": {"type": "string"},
          "effort": {"type": "string"},
          "voice_id": {"type": "string"},
          "voice_profile": {"$ref": "#/$defs/voice_profile"},
          "avatar_symbol": {"type": "string"},
          "avatar_url": {"type": "string"},
          "model_avatar_url": {"type": "string"},
          "backend_session_id": {"type": "string"},
          "conversation_id": {"type": "string"},
          "head_revision": {"type": "integer"},
          "last_message_id": {"type": "string"},
          "last_message": {"type": "string"},
          "alive": {"type": "boolean"},
          "busy": {"type": "boolean"},
          "focused": {"type": "boolean"},
          "latest_state": {"type": ["string", "null"]},
          "latest_state_ts": {"type": ["integer", "null"]},
          "turn_started_at": {"type": "integer"},
          "last_activity": {"type": "integer"},
          "last_turn_end": {"type": "integer"},
          "status_text": {"type": ["string", "null"]},
          "compacting": {"type": "boolean"},
          "context_tokens": {"type": ["integer", "null"]},
          "context_window": {"type": ["integer", "null"]},
          "account_quota": {"type": ["object", "null"], "description": "context_meter (issue 869): the windows of the account the agent's tool is on ({provider_id, observed_at, freshness, windows: [{kind, used_percentage, resets_at}]}); null where none is known or the agent is bound to a provider of its own."},
          "queued_turn_count": {"type": "integer"},
          "queued_turn_revision": {"type": "integer"},
          "queue_paused": {"type": "boolean"},
          "moved": {"type": ["object", "null"], "description": "agent_moved: the agent moved to another Host ({to: {host, id}, at}); no turn of it starts here. null otherwise.", "properties": {"to": {"type": "object", "properties": {"host": {"type": "string"}, "id": {"type": "string"}}}, "at": {"type": "integer"}}},
          "muted": {"type": "boolean"},
          "snoozed_until": {"type": ["integer", "null"], "description": "snooze (issue 871): until when, in milliseconds since the epoch, the owner put the chat out of sight on every app; null when it is in sight."},
          "coordination_visibility": {"enum": ["show", "hide"], "description": "Host contract (piece 3 of issue 478): the chat's effective visibility of coordination between agents."},
          "coordination_override": {"type": ["string", "null"], "description": "The chat's own choice, or null when it follows the Host."},
          "chat_view": {"enum": ["conversation", "session"], "description": "feature chat_view (issue 702): how the user reads this chat; default session."},
          "working_audience": {"enum": ["user", "agents", null], "description": "coordination_working_state: who the running turn is for, as /log's audience of its rows ('user' for a turn of an agent that cannot leave a note); null when idle."},
          "working_with": {"type": ["object", "null"], "description": "coordination_working_state: the agent whose message started the running turn ({agent_id, name}), or null."},
          "archived_at": {"type": ["integer", "string", "null"]},
          "heartbeat_enabled": {"type": "boolean"},
          "dreaming_enabled": {"type": "boolean"},
          "schedules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["schedule_id", "agent_id", "session", "name", "cron_expression", "prompt", "enabled", "created_at", "updated_at"],
              "properties": {
                "schedule_id": {"type": "string"},
                "agent_id": {"type": "string"},
                "session": {"type": "string"},
                "name": {"type": "string"},
                "cron_expression": {"type": "string"},
                "prompt": {"type": "string"},
                "enabled": {"type": "boolean"},
                "last_run_at": {"type": ["integer", "null"]},
                "next_run_at": {"type": ["integer", "null"]},
                "created_at": {"type": "integer"},
                "updated_at": {"type": "integer"}
              }
            }
          },
          "team_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "focus": {"type": ["string", "null"]},
    "roster": {"type": "array", "items": {"type": "string"}},
    "personas": {"type": "array"},
    "available_mcp_servers": {"type": "array", "items": {"type": "string"}},
    "voice_defaults": {"$ref": "#/$defs/voice_profile"},
    "voice_profile_version": {"type": "string"}
  },
  "$defs": {
    "voice_profile": {
      "description": "Feature voice_profile (Host contract 109): the agent's voice and hearing as the Host resolves them. origin, engine_origin, language_origin and silent_reason are open sets.",
      "type": "object",
      "additionalProperties": true,
      "required": ["speech", "hearing"],
      "properties": {
        "speech": {
          "type": "object",
          "additionalProperties": true,
          "required": ["provider", "voice_id", "origin", "silent_reason"],
          "properties": {
            "provider": {"type": "string"},
            "provider_label": {"type": "string"},
            "voice_id": {"type": ["string", "null"]},
            "voice_label": {"type": ["string", "null"]},
            "origin": {"type": ["string", "null"]},
            "streaming": {"type": "boolean"},
            "silent_reason": {"type": ["string", "null"]},
            "shared_with": {"type": "integer", "minimum": 0},
            "assignment": {"type": "string"}
          }
        },
        "hearing": {
          "type": "object",
          "additionalProperties": true,
          "required": ["engines", "engine_origin", "languages", "language_origin"],
          "properties": {
            "engines": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": ["id"],
                "properties": {
                  "id": {"type": "string"},
                  "provider": {"type": "string"},
                  "model": {"type": "string"},
                  "label": {"type": "string"}
                }
              }
            },
            "engine_origin": {"type": "string"},
            "device_may_override": {"type": "boolean"},
            "device_cloud_languages": {"type": ["array", "null"], "items": {"type": "string"}},
            "languages": {"type": "array", "items": {"type": "string"}},
            "language_origin": {"type": "string"},
            "configured_languages": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  }
}
