{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clarp.local/contract/schemas/server-info.json",
  "title": "GET /server-info",
  "description": "Host identity, version window, and feature gates. capabilities.features is the only feature gate clients may use.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "server_id",
    "name",
    "deployment_mode",
    "version",
    "default_cwd",
    "clarp_version",
    "min_app_version",
    "capabilities",
    "contract"
  ],
  "properties": {
    "server_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "deployment_mode": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "image_version": {
      "type": "string"
    },
    "default_cwd": {
      "type": "string"
    },
    "clarp_version": {
      "type": "string"
    },
    "min_app_version": {
      "type": "string"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "version",
        "features"
      ],
      "properties": {
        "version": {
          "type": "integer"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "contract": {
      "type": "object",
      "description": "Client contract handshake. host: this Host's contract; min_ios: the oldest iOS client contract it serves; features: the Host contract at which each capability became available.",
      "additionalProperties": true,
      "required": ["host", "min_ios", "features"],
      "properties": {
        "host": {"type": "integer", "minimum": 1},
        "min_ios": {"type": "integer", "minimum": 1},
        "features": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      }
    },
    "client": {
      "type": "object",
      "description": "Verdict for the requesting client, from its X-Clarp-Client header. status is compatible, client_outdated, or unknown.",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "platform": {"type": "string"},
        "build": {"type": "string"},
        "contract": {"type": "integer"},
        "status": {"type": "string", "enum": ["compatible", "client_outdated", "unknown"]},
        "reason": {"type": "string"}
      }
    },
    "local_connection": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "certificate_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "service_type": {
          "type": "string"
        }
      }
    }
  }
}
