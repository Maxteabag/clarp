{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clarp.local/contract/schemas/log.json",
  "title": "GET /log",
  "description": "Conversation read model. Tail snapshot, after_revision delta, or before paging share one shape. replace_required is absent on some missing:true responses, so it stays optional.",
  "type": "object",
  "additionalProperties": true,
  "required": ["turns", "latest_revision", "has_more", "missing", "conversation_id"],
  "properties": {
    "conversation_id": {"type": "string"},
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "role", "text", "revision"],
        "properties": {
          "id": {"type": "string"},
          "role": {"type": "string"},
          "text": {"type": "string"},
          "timestamp": {"type": "string"},
          "revision": {"type": "integer"},
          "kind": {"type": ["string", "null"]},
          "tool_name": {"type": ["string", "null"]},
          "tools": {"type": "array"},
          "display_cells": {"type": "array"},
          "origin": {"type": "string"},
          "sender_agent_id": {"type": ["string", "null"]},
          "sender_name": {"type": ["string", "null"]},
          "sender_session": {"type": ["string", "null"]},
          "reply_to_agent_id": {"type": ["string", "null"]},
          "reply_to_name": {"type": ["string", "null"]},
          "reply_to_session": {"type": ["string", "null"]},
          "delivery": {"type": "string"},
          "automation_kind": {"type": ["string", "null"]},
          "audience": {"enum": ["user", "agents"], "description": "Host contract 108: 'agents' for a row of a turn another agent's message started (coordination between agents); a note (kind 'note') is always 'user'."},
          "trace_id": {"type": "string"},
          "phase": {"enum": ["commentary", "final", null]},
          "sent_at": {"type": "string", "description": "Host contract 109 (provisional), feature waited_send_order: on a user row that waited for a running turn, when it was sent; its timestamp is when its own turn started."},
          "turn": {
            "type": ["object", "null"],
            "description": "log_turn_summary: on a settled turn's last row, shaped like GET /live's turn.",
            "additionalProperties": true,
            "required": ["turn_id", "status"],
            "properties": {
              "turn_id": {"type": "string"},
              "status": {"enum": ["completed", "failed", "interrupted"]},
              "started_at_ms": {"type": ["integer", "null"]},
              "ended_at_ms": {"type": ["integer", "null"]},
              "worked_ms": {"type": ["integer", "null"]},
              "tool_count": {"type": ["integer", "null"]}
            }
          }
        }
      }
    },
    "latest_revision": {"type": "integer"},
    "has_more": {"type": "boolean"},
    "replace_required": {"type": "boolean"},
    "missing": {"type": "boolean"},
    "latest_ts": {"type": "string"},
    "cwd": {"type": "string"},
    "file": {"type": ["string", "null"]},
    "includes_automated": {"type": "boolean"}
  }
}
