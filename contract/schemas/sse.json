{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clarp.local/contract/schemas/sse.json",
  "title": "GET /events (SSE)",
  "description": "One text/event-stream per client. Durable events carry an SSE id: line; after replay the server always sends a bare agent-roster nudge. Top level validates the envelope; validate each data payload against the $def named by its wire type (see type-to-def in tests/contract/test_core_shapes.py). Enum values mirror server/lib/protocol.py.",
  "type": "object",
  "additionalProperties": true,
  "required": ["type"],
  "properties": {
    "type": {"type": "string"},
    "event_id": {"type": "integer"}
  },
  "$defs": {
    "transcript-updated": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "session"],
      "properties": {
        "type": {"const": "transcript-updated"},
        "session": {"type": "string"},
        "agent_id": {"type": "string"},
        "backend_session_id": {"type": "string"},
        "head_revision": {"type": "integer", "description": "feature roster_fields: the conversation's head revision as the agent's snapshot row has it (issue 809)"},
        "conversation_id": {"type": "string", "description": "feature roster_fields: the conversation that revision is of"}
      }
    },
    "agent-state": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "session", "agent_id", "kind"],
      "properties": {
        "type": {"const": "agent-state"},
        "session": {"type": "string"},
        "agent_id": {"type": "string"},
        "persona": {"type": "string"},
        "kind": {"$ref": "#/$defs/agent-state-kind"},
        "ts": {"type": "integer"},
        "detail": {"type": ["object", "string", "null"]},
        "status_text": {"type": "string"},
        "audience": {"enum": ["user", "agents"], "description": "Host contract 108: on a dispatch thinking state, 'agents' for a turn another agent's message started."},
        "sender_agent_id": {"type": "string"},
        "sender_name": {"type": "string"}
      }
    },
    "agent-state-kind": {
      "type": "string",
      "enum": ["thinking", "tool", "idle", "spawned", "stopped", "done", "compacting", "waiting", "interrupted", "background"]
    },
    "agent-activity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "session"],
      "properties": {
        "type": {"const": "agent-activity"},
        "session": {"type": "string"},
        "agent_id": {"type": "string"},
        "persona": {"type": "string"},
        "kind": {"type": "string"},
        "phase": {"type": "string"},
        "status": {"$ref": "#/$defs/activity-status"},
        "tool": {"type": "string"},
        "action": {"type": "string"},
        "summary": {"type": "string"},
        "file_path": {"type": "string"},
        "ts": {"type": "integer"},
        "stop_actor": {"type": "string", "description": "Contract 61: only when this state is a Stop that recorded its actor; absent is unknown."},
        "stop_actor_verified": {"type": "boolean"},
        "stop_reason": {"type": "string"},
        "repair_actor": {"type": "string", "description": "Contract 61: only on a slot_repair audit state."},
        "repair_actor_verified": {"type": "boolean"},
        "repair_reason": {"type": "string"},
        "released_trace": {"type": "string"}
      }
    },
    "activity-status": {
      "type": "string",
      "enum": ["running", "ok", "error", "recorded"]
    },
    "agent-roster": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {"const": "agent-roster"},
        "kind": {"type": "string"},
        "session": {"type": "string"},
        "voice_profile": {"type": "object", "description": "feature voice_profile: as on the snapshot agent row"},
        "chat_view": {"enum": ["conversation", "session"], "description": "feature chat_view: with kind chat_view, the agent's new chat view (issue 702)"},
        "agent_id": {"type": "string", "description": "feature roster_fields: with fields, the agent the event is about"},
        "fields": {"type": "object", "description": "feature roster_fields: the fields of the agent's snapshot row its change moved, as the row has them (kinds helper-state, mute-changed, chat_view, agent-transit as a change begins; issue 809)"},
        "parent": {"type": "object", "description": "feature roster_fields: with kind helper-state, the maker's session, agent_id and fields (child_count, running_children, background_jobs, latest_state, status_text)"}
      }
    },
    "agent-focus": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {"const": "agent-focus"},
        "session": {"type": "string"},
        "agent_id": {"type": "string"}
      }
    },
    "media-changed": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "session", "agent_id", "asset_id", "change", "at"],
      "properties": {
        "type": {"const": "media-changed"},
        "session": {"type": "string"},
        "agent_id": {"type": "string"},
        "asset_id": {"type": "string"},
        "change": {"enum": ["created", "deleted", "favorite"]},
        "favorite": {"type": "boolean"},
        "at": {"type": "integer"}
      }
    },
    "send-admission": {
      "type": "object",
      "required": ["type", "event_id", "session", "agent_id"],
      "properties": {
        "type": {"const": "send-admission"},
        "event_id": {"type": "integer"},
        "session": {"type": "string"},
        "agent_id": {"type": "string"},
        "client_msg_id": {"type": "string"},
        "admission_route": {"enum": ["conversation_fork", "waiting", "started"]},
        "admission_revision": {"type": "integer", "minimum": 1}
      },
      "if": {"required": ["words_withheld"], "properties": {"words_withheld": {"const": true}}},
      "then": {"not": {"anyOf": [{"required": ["client_msg_id"]}, {"required": ["admission_revision"]}, {"required": ["admission_route"]}]}},
      "else": {"required": ["client_msg_id", "admission_revision", "admission_route"]}
    },
    "queue-updated": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "session", "agent_id", "queue_depth", "queue_paused", "queue_revision"],
      "properties": {
        "type": {"const": "queue-updated"},
        "session": {"type": "string"},
        "agent_id": {"type": "string"},
        "queue_depth": {"type": "integer"},
        "queue_paused": {"type": "boolean"},
        "queue_started": {"type": "boolean"},
        "queue_revision": {"type": "integer"},
        "client_msg_id": {"type": "string"},
        "queue_change": {"enum": ["edited", "deleted"], "description": "Host contract 115, feature waited_send_order: what happened to the item client_msg_id; with edited, text is its new words."},
        "text": {"type": "string"}
      }
    },
    "user-notification": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "session", "notification_id"],
      "properties": {
        "type": {"const": "user-notification"},
        "notification_id": {"type": "string"},
        "session": {"type": "string"},
        "agent_id": {"type": "string"},
        "persona": {"type": "string"},
        "done_ts": {"type": "integer"},
        "source_message_id": {"type": "string"},
        "cause_message_id": {"type": "string"},
        "origin": {"type": "string"},
        "push": {"type": "boolean"},
        "badge": {"type": "boolean"},
        "unread": {"type": "boolean"},
        "muted": {"type": "boolean"},
        "preview": {"type": "string"},
        "reason": {"type": "string"}
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "url"],
      "properties": {
        "type": {"const": "audio"},
        "clip_id": {"type": "integer"},
        "url": {"type": "string"},
        "name": {"type": "string"},
        "session": {"type": "string"},
        "agent_id": {"type": "string"},
        "persona": {"type": "string"},
        "trace_id": {"type": "string"},
        "streamable": {"type": "boolean"},
        "delivery": {"type": "string"},
        "stream_url": {"type": "string"},
        "playlist_url": {"type": "string"},
        "complete_url": {"type": "string"},
        "audio_format": {"type": "string"},
        "preview": {"type": "string"}
      }
    },
    "tts-error": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "session"],
      "properties": {
        "type": {"const": "tts-error"},
        "session": {"type": "string"},
        "agent_id": {"type": "string"},
        "persona": {"type": "string"},
        "message": {"type": "string"},
        "error": {"type": "string"},
        "reason": {"type": "string", "description": "feature speech_outcome; open set: no_voice, not_configured, provider_off, provider_failed, host_failed"},
        "provider": {"type": "string"},
        "trace_id": {"type": "string", "description": "the turn whose reply was not spoken"}
      }
    },
    "server-version": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "version"],
      "properties": {
        "type": {"const": "server-version"},
        "version": {"type": "string"}
      }
    },
    "remote-action": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "action"],
      "allOf": [
        {
          "if": {
            "properties": {"action": {"const": "controller-event"}},
            "required": ["action"]
          },
          "then": {
            "required": [
              "controller_event_id", "button", "controller_event",
              "duration_ms", "age_ms", "queued", "ts"
            ]
          }
        }
      ],
      "properties": {
        "type": {"const": "remote-action"},
        "action": {"$ref": "#/$defs/client-action"},
        "controller_event_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "controller_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "button": {"enum": ["primary", "secondary"]},
        "controller_event": {
          "enum": [
            "down", "up", "single-click", "double-click", "hold",
            "swipe-left", "swipe-right", "swipe-up", "swipe-down",
            "rotate-clockwise", "rotate-counterclockwise"
          ]
        },
        "duration_ms": {"type": "integer", "minimum": 0, "maximum": 120000},
        "age_ms": {"type": "integer", "minimum": 0, "maximum": 120000},
        "queued": {"type": "boolean"},
        "ts": {"type": "integer"}
      }
    },
    "client-action": {
      "type": "string",
      "enum": ["record", "record-toggle", "stop-agent", "controller-event"]
    }
  }
}
