{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clarp",
  "version": "1.0.0",
  "identifier": "com.maxteabag.claude-pwa",
  "build": {
    "devUrl": "http://127.0.0.1:5174/",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../static"
  },
  "app": {
    "windows": [
      {
        "title": "Clarp Desktop",
        "width": 1360,
        "height": 900,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
