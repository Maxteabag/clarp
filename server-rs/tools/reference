def selftest():
    held = []

    def hold(what, condition):
        if not condition:
            raise SystemExit(f'reference selftest: FAILED: {what}')
        held.append(what)

    def refused(what, call, words):
        try:
            call()
        except Refused as refusal:
            hold(what, words in str(refusal))
        else:
            raise SystemExit(f'reference selftest: FAILED: {what}: not refused')

    def said(call):
        text = io.StringIO()
        with contextlib.redirect_stdout(text):
            code = call()
        return code, text.getvalue()

    with scratch.directory('clarp-reference-selftest-') as name:
        box = Path(name)
        repo, tmp, home = box / 'repo', box / 'tmp', box / 'home'
        for d in (repo, tmp, home):
            d.mkdir()
        saved = dict(os.environ)
        os.environ.update({'HOME': str(home), 'TMPDIR': str(tmp), 'GIT_CONFIG_NOSYSTEM': '1',
                           'GIT_CONFIG_GLOBAL': os.devnull, 'GIT_AUTHOR_NAME': 'Selftest',
                           'GIT_AUTHOR_EMAIL': 'selftest@example.invalid', 'GIT_COMMITTER_NAME': 'Selftest',
                           'GIT_COMMITTER_EMAIL': 'selftest@example.invalid'})
        trap = box / 'trap'
        os.environ.update({'CLAUDE_PWA_DB': str(trap / 'state.sqlite'), 'XDG_DATA_HOME': str(trap / 'data'),
                           'XDG_CONFIG_HOME': str(trap / 'config'), 'XDG_CACHE_HOME': str(trap / 'cache'),
                           'XDG_STATE_HOME': str(trap / 'state')})
        try:
            def put(path, text):
                p = repo / path
                p.parent.mkdir(parents=True, exist_ok=True)
                p.write_text(text)

            def commit(message, *paths):
                git(repo, 'add', '--', *paths)
                git(repo, 'commit', '-q', '--no-gpg-sign', '-m', message)
                return out(repo, 'rev-parse', 'HEAD')

            def scratch_empty():
                return not any(tmp.iterdir())

            fixture = 'server-rs/crates/k/tests/fixtures/ok.json'
            git(repo, 'init', '-q', '-b', 'main')
            put('server/value.txt', 'one\n')
            put('server-rs/tools/ok-vectors.py', "MARK = ''\n" + OK)
            put(fixture, '{"value": "one"}\n')
            put('server-rs/crates/k/tests/fixtures/hand.json', 'by hand\n')
            put('.gitignore', '__pycache__/\n')
            a = commit('the reference', '.')
            put('server-rs/REFERENCE', f'{a}\nThe reference.\n')
            b = commit('name the reference', 'server-rs/REFERENCE')
            put('server/value.txt', 'two\n')
            c = commit('the Python Host moves on', 'server/value.txt')
            put('server-rs/crates/k/src.rs', 'rust\n')
            d = commit('a train lands', 'server-rs/crates/k/src.rs')
            git(repo, 'update-ref', 'refs/remotes/origin/main', d)

            code, text = said(lambda: show(repo))
            hold('show names the reference', code == 0 and f'reference  {a}' in text)
            hold('show counts the debt: the commit outside server-rs/, not the one inside',
                 'debt: 1 commit(s)' in text and 'the Python Host moves on  [server]' in text
                 and 'a train lands' not in text and '2 commit(s) of origin/main beyond the reference touch server-rs/ alone' in text)
            hold('show says origin/main is stale when it was never fetched', 'never fetched here: STALE' in text)
            git(repo, 'worktree', 'add', '-q', '--detach', str(box / 'other'), d)
            fetched = Path(box / 'other', out(box / 'other', 'rev-parse', '--git-path', 'FETCH_HEAD'))
            fetched.write_text('')
            os.utime(fetched, (time.time() - 2 * STALE_AFTER,) * 2)
            code, text = said(lambda: show(repo))
            hold('show says origin/main is stale when its newest fetch is old', 'fetched 120 minutes ago: STALE' in text)
            os.utime(fetched)
            (repo / '.git/FETCH_HEAD').write_text('')
            os.utime(repo / '.git/FETCH_HEAD', (time.time() - 2 * STALE_AFTER,) * 2)
            code, text = said(lambda: show(repo))
            hold('the newest fetch from any worktree of the repository counts (origin/main is shared)',
                 'fetched 0 minutes ago\n' in text)
            git(repo, 'worktree', 'remove', '--force', str(box / 'other'))

            git(repo, 'switch', '-q', '-c', 'piece', d)
            put('server-rs/crates/k/src.rs', 'rust, more\n')
            e = commit('the piece', 'server-rs/crates/k/src.rs')
            gate = gate_commit(repo, 'HEAD')
            hold('commit is the same id for the same REV', gate == gate_commit(repo, e))
            hold('commit has one parent, the reference', out(repo, 'rev-list', '--parents', '-n1', gate).split()[1:] == [a])
            hold('commit: outside server-rs/ is the reference\'s tree',
                 outside(repo, a, gate) == [] and out(repo, 'rev-parse', f'{gate}:server') == out(repo, 'rev-parse', f'{a}:server'))
            hold('commit: server-rs/ is REV\'s tree', out(repo, 'rev-parse', f'{gate}:server-rs') == out(repo, 'rev-parse', f'{e}:server-rs'))
            hold('commit touched no checkout or index', out(repo, 'status', '--porcelain') == '' and out(repo, 'rev-parse', 'HEAD') == e)

            git(repo, 'switch', '-q', '-c', 'nowhere', d)
            put('server-rs/REFERENCE', 'f' * 40 + '\n')
            commit('a reference of nothing', 'server-rs/REFERENCE')
            refused('commit refuses a REFERENCE that names no commit', lambda: gate_commit(repo), 'no commit of this repository')
            put('server-rs/REFERENCE', 'main\n')
            refused('run refuses a REFERENCE that is not a full commit', lambda: run(repo, 'ok', [], sys.executable), 'does not name a commit')
            hold('the refused run left no scratch', scratch_empty())
            git(repo, 'checkout', '-q', '--', 'server-rs/REFERENCE')

            git(repo, 'switch', '-q', '-c', 'early', b)
            put('server-rs/REFERENCE', f'{c}\n')
            commit('a reference ahead of the piece', 'server-rs/REFERENCE')
            refused('commit refuses a REV whose history lacks the reference', lambda: gate_commit(repo), 'is not in the history of HEAD')

            git(repo, 'switch', '-q', '-c', 'wide', d)
            put('server/value.txt', 'three\n')
            commit('a piece that reaches outside', 'server/value.txt')
            refused('commit refuses a REV that touches a file outside server-rs/', lambda: gate_commit(repo), 'server/value.txt')

            git(repo, 'switch', '-q', 'piece')
            code, text = said(lambda: run(repo, 'ok', [], sys.executable))
            hold('run uses the reference\'s Python, not the working tree\'s (value one, not two)',
                 code == 0 and f'{"ok-vectors.py"}: unchanged' in text and (repo / fixture).read_text() == '{"value": "one"}\n')
            hold('run removed its scratch', scratch_empty())

            put('server-rs/tools/ok-vectors.py', "MARK = '!'\n" + OK)
            put(fixture, '{"value": "one!"}\n')
            put('server-rs/crates/k/tests/fixtures/hand.json', 'by hand, edited\n')
            stamp = (repo / fixture).stat().st_mtime_ns
            code, text = said(lambda: run(repo, 'ok-vectors.py', [], sys.executable))
            hold('uncommitted generator and fixture edits ride along and are not lost when nothing changed',
                 code == 0 and 'unchanged' in text and (repo / fixture).read_text() == '{"value": "one!"}\n'
                 and (repo / fixture).stat().st_mtime_ns == stamp
                 and (repo / 'server-rs/crates/k/tests/fixtures/hand.json').read_text() == 'by hand, edited\n')

            put('server-rs/tools/ok-vectors.py', "MARK = '?'\n" + OK)
            code, text = said(lambda: run(repo, 'ok', [], sys.executable))
            hold('run copies back a changed fixture and names it',
                 code == 0 and f'changed  {fixture}' in text and (repo / fixture).read_text() == '{"value": "one?"}\n')
            status = git(repo, 'status', '--porcelain', '--ignored', '--untracked-files=all').stdout.decode()
            hold('run copies back nothing else (no bytecode, no file outside server-rs/)',
                 sorted(status.splitlines()) == [' M server-rs/crates/k/tests/fixtures/hand.json',
                                                 ' M server-rs/crates/k/tests/fixtures/ok.json',
                                                 ' M server-rs/tools/ok-vectors.py'])

            put('server-rs/tools/ok-vectors.py', "MARK = '+'\n" + OK)
            put('server-rs/tools/reader-vectors.py', READER)
            put('server-rs/crates/k/tests/fixtures/reader.json', (repo / fixture).read_text())
            was, stamp = (repo / fixture).read_bytes(), (repo / fixture).stat().st_mtime_ns
            code, text = said(lambda: check(repo, sys.executable))
            hold('check names a fixture that would change and does not end 0',
                 code == 1 and f'ok-vectors.py: WOULD CHANGE {fixture}' in text and '1 fixture(s) would change' in text)
            hold('check puts the gate tree back after a change, so the generator after it reads what the working tree has',
                 'reader-vectors.py: unchanged' in text)
            hold('check never writes the working tree (bytes and mtime held)',
                 (repo / fixture).read_bytes() == was and (repo / fixture).stat().st_mtime_ns == stamp)
            hold('check removed its scratch', scratch_empty())
            code, text = said(lambda: sweep(repo, sys.executable, write=True))
            hold('run --all regenerates every generator, copies back what changed and names it',
                 code == 0 and f'ok-vectors.py: CHANGED {fixture}' in text and '2 fixture(s) changed, copied back' in text
                 and 'reader-vectors.py: CHANGED' in text
                 and (repo / fixture).read_text() == '{"value": "one+"}\n')
            hold('run --all removed its scratch', scratch_empty())
            code, text = said(lambda: check(repo, sys.executable))
            hold('check ends 0 when nothing fails and nothing changes', code == 0 and 'none failed, no fixture changed' in text)

            put('server-rs/tools/db-vectors.py', DB)
            for attempt in (1, 2):
                code, text = said(lambda: run(repo, 'db', [], sys.executable))
                hold(f'a generator that opens the default database gets a fresh scratch one, and its home and XDG '
                     f'directories are inside its scratch place (run {attempt})', code == 0 and 'unchanged' in text)
            hold('the home of whoever runs the tool is never touched', not any(home.iterdir()))
            hold('the runner\'s CLAUDE_PWA_DB and XDG directories (traps) are never reached', not trap.exists())
            hold('the scratch database and home are removed with the run', scratch_empty())

            put('server-rs/tools/fail-vectors.py', FAIL)
            kept = (repo / fixture).read_text()
            source = (repo / 'server-rs/tools/ok-vectors.py').read_text()
            code, text = said(lambda: run(repo, 'fail', [], sys.executable))
            hold('run of a failing generator says so with its exit',
                 code == 3 and 'fail-vectors.py: FAILED (exit 3); nothing copied back' in text)
            hold('a failing generator\'s fixtures are not copied back',
                 not (repo / 'server-rs/crates/k/tests/fixtures/fail.json').exists() and (repo / fixture).read_text() == kept
                 and (repo / 'server-rs/tools/ok-vectors.py').read_text() == source)
            hold('the failed run removed its scratch', scratch_empty())
            code, text = said(lambda: check(repo, sys.executable))
            hold('check names a failing generator, does not end 0, and the generator after it sees an unspoiled tree',
                 code == 1 and 'fail-vectors.py: FAILED (exit 3)' in text and 'ok-vectors.py: unchanged' in text
                 and 'db-vectors.py: unchanged' in text
                 and '1 failed (fail-vectors.py)' in text)
            hold('the failed check copied nothing back and removed its scratch',
                 not (repo / 'server-rs/crates/k/tests/fixtures/fail.json').exists()
                 and (repo / fixture).read_text() == kept and scratch_empty())
            code, text = said(lambda: sweep(repo, sys.executable, write=True))
            hold('run --all names a failing generator, does not end 0, and copies nothing of it back',
                 code == 1 and 'fail-vectors.py: FAILED (exit 3)' in text and '1 failed (fail-vectors.py)' in text
                 and not (repo / 'server-rs/crates/k/tests/fixtures/fail.json').exists()
                 and (repo / fixture).read_text() == kept and scratch_empty())
            refused('run refuses a generator that is not there', lambda: run(repo, 'absent', [], sys.executable), 'no generator')
        finally:
            os.environ.clear()
            os.environ.update(saved)
    for what in held:
        print(f'held: {what}')
    print(f'reference selftest: {len(held)} held')
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--main', default=MAIN, help='the fetched main to read (default origin/main)')
    parser.add_argument('--python', help='the interpreter for generators (default: the Python Host\'s)')
    sub = parser.add_subparsers(dest='command', required=True)
    sub.add_parser('show')
    one = sub.add_parser('commit')
    one.add_argument('rev', nargs='?', default='HEAD')
    gen = sub.add_parser('run')
    gen.add_argument('--all', action='store_true', help='every generator, copying back what changed')
    gen.add_argument('generator', nargs='?')
    gen.add_argument('args', nargs=argparse.REMAINDER)
    sub.add_parser('check')
    sub.add_parser('selftest')
    args = parser.parse_args()
    try:
        if args.command == 'show':
            return show(REPO, args.main)
        if args.command == 'commit':
            print(gate_commit(REPO, args.rev, args.main))
            return 0
        if args.command == 'run':
            if args.all == bool(args.generator):
                parser.error('run takes either a GENERATOR [ARGS] or --all')
            if args.all:
                return sweep(REPO, args.python or service_python(), write=True)
            return run(REPO, args.generator, args.args, args.python or service_python())
        if args.command == 'check':
            return check(REPO, args.python or service_python())
        return selftest()
    except Refused as refusal:
        print(f'reference: refused: {refusal}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
