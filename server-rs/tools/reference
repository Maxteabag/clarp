#!/usr/bin/env python3
"""The reference: the one commit of main the Rust Host is held to, and the gate tree made from it.

    server-rs/tools/reference show                    the reference, and the debt beyond it on origin/main
    server-rs/tools/reference commit [REV]            the gate commit of REV (default HEAD); prints its id
    server-rs/tools/reference run GENERATOR [ARGS]    one generator, run against the reference's Python;
                                                      copies back what it changed
    server-rs/tools/reference run --all               every generator so
    server-rs/tools/reference check                   every generator so, writing nothing back; 0 only when
                                                      none fails and no fixture would change
    server-rs/tools/reference selftest                holds each of the above by example, in scratch

server-rs/REFERENCE names the reference (line 1, the full commit). The gate tree of a candidate is the
reference's tree with server-rs/ replaced by the candidate's. The debt is what main has outside server-rs/
beyond the reference. Uses git alone; reaches no network; writes scratch only through tools/scratch.py.
"""
import argparse
import contextlib
import io
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time

sys.path.insert(0, str(Path(__file__).resolve().parent))
import scratch

TOOLS = Path(__file__).resolve().parent
REPO = TOOLS.parents[1]
PART = 'server-rs'
FILE = f'{PART}/REFERENCE'
MAIN = 'origin/main'
STALE_AFTER = 3600
SERVICE_PYTHON = Path.home() / '.local/share/clarp/current/SERVICE_PYTHON'
FULL = re.compile(r'[0-9a-f]{40}')


class Refused(Exception):
    """What the tool will not do, said in words."""


def git(repo, *args, env=None, data=None, check=True):
    result = subprocess.run(['git', *args], cwd=repo, input=data, capture_output=True,
                            env={**os.environ, **(env or {})})
    if check and result.returncode:
        raise Refused(f"git {' '.join(args)} failed: {result.stderr.decode(errors='replace').strip()}")
    return result


def out(repo, *args, **kwargs):
    return git(repo, *args, **kwargs).stdout.decode().strip()


def named(repo, text, where):
    """The commit a REFERENCE text names; refused when it names none of this repository."""
    first = text.splitlines()[0].strip() if text.strip() else ''
    if not FULL.fullmatch(first):
        raise Refused(f'{where} does not name a commit on its first line (40 hex): {first[:60]!r}')
    if git(repo, 'cat-file', '-e', f'{first}^{{commit}}', check=False).returncode:
        raise Refused(f'{where} names {first}, which is no commit of this repository (fetch origin?)')
    return first


def worktree_reference(repo):
    path = Path(repo) / FILE
    if not path.is_file():
        raise Refused(f'{FILE} is not in the working tree')
    return named(repo, path.read_text(), f'{FILE} of the working tree')


def short(repo, sha):
    return out(repo, 'log', '-1', '--format=%h %cs %s', sha)


def outside(repo, old, new):
    """The paths outside server-rs/ that differ between two commits."""
    listed = out(repo, 'diff', '--name-only', '--no-renames', old, new, '--', '.', f':(exclude){PART}')
    return [line for line in listed.splitlines() if line]


# --- show -------------------------------------------------------------------------------------

def fetched_age(repo):
    """Since the newest fetch from any worktree of this repository: FETCH_HEAD is kept per worktree, origin/main
    is shared by all of them."""
    common = Path(repo, out(repo, 'rev-parse', '--git-common-dir'))
    heads = [common / 'FETCH_HEAD', Path(repo, out(repo, 'rev-parse', '--git-path', 'FETCH_HEAD')),
             *common.glob('worktrees/*/FETCH_HEAD')]
    times = [head.stat().st_mtime for head in heads if head.is_file()]
    return time.time() - max(times) if times else None


def show(repo, main=MAIN):
    ref = worktree_reference(repo)
    print(f'reference  {ref}')
    print(f'           {short(repo, ref)}')
    if git(repo, 'rev-parse', '--verify', '--quiet', f'{main}^{{commit}}', check=False).returncode:
        raise Refused(f'{main} is not in this repository; fetch origin first')
    tip = out(repo, 'rev-parse', f'{main}^{{commit}}')
    age = fetched_age(repo)
    if age is None:
        print(f'{main} {tip[:12]}, never fetched here: STALE, run git fetch origin')
    elif age > STALE_AFTER:
        print(f'{main} {tip[:12]}, fetched {int(age // 60)} minutes ago: STALE, run git fetch origin')
    else:
        print(f'{main} {tip[:12]}, fetched {int(age // 60)} minutes ago')
    if git(repo, 'merge-base', '--is-ancestor', ref, tip, check=False).returncode:
        print(f'the reference is not in the history of {main}: a reference is a commit of main')
        return 1
    debt, rust = [], 0
    for sha in out(repo, 'rev-list', '--first-parent', '--reverse', f'{ref}..{tip}').split():
        paths = outside(repo, f'{sha}^1', sha)
        if paths:
            areas = sorted({p.split('/')[0] for p in paths})
            debt.append(f'  {short(repo, sha)}  [{", ".join(areas)}]')
        else:
            rust += 1
    print(f'debt: {len(debt)} commit(s) of {main} beyond the reference touch something outside {PART}/'
          + (':' if debt else ''))
    for line in debt:
        print(line)
    print(f'beside it: {rust} commit(s) of {main} beyond the reference touch {PART}/ alone')
    return 0


# --- commit -----------------------------------------------------------------------------------

def gate_commit(repo, rev='HEAD', main=MAIN):
    """Writes the gate commit of REV into the object store (no index, no checkout) and returns its id."""
    if git(repo, 'rev-parse', '--verify', '--quiet', f'{rev}^{{commit}}', check=False).returncode:
        raise Refused(f'{rev} is no commit of this repository')
    head = out(repo, 'rev-parse', f'{rev}^{{commit}}')
    text = git(repo, 'show', f'{head}:{FILE}', check=False)
    if text.returncode:
        raise Refused(f'{rev} has no {FILE}')
    ref = named(repo, text.stdout.decode(errors='replace'), f'{FILE} of {rev}')
    if git(repo, 'merge-base', '--is-ancestor', ref, head, check=False).returncode:
        raise Refused(f'the reference {ref[:12]} named in {rev} is not in the history of {rev}; '
                      f'rebase onto a main that contains it')
    if git(repo, 'rev-parse', '--verify', '--quiet', f'{main}^{{commit}}', check=False).returncode:
        raise Refused(f'{main} is not in this repository; fetch origin first')
    base = git(repo, 'merge-base', head, main, check=False)
    if base.returncode:
        raise Refused(f'{rev} has no merge base with {main}')
    touched = outside(repo, base.stdout.decode().strip(), head)
    if touched:
        listed = ', '.join(touched[:10]) + (f' and {len(touched) - 10} more' if len(touched) > 10 else '')
        raise Refused(f'{rev} changes {len(touched)} path(s) outside {PART}/ against its merge base with '
                      f'{main}: {listed}; a candidate touches {PART}/ alone')
    entries = git(repo, 'ls-tree', '-z', ref).stdout.split(b'\0')
    mine = out(repo, 'rev-parse', f'{head}:{PART}')
    tree = []
    for entry in filter(None, entries):
        meta, name = entry.split(b'\t', 1)
        if name != PART.encode():
            tree.append(entry)
    tree.append(b'040000 tree ' + mine.encode() + b'\t' + PART.encode())
    tree_id = out(repo, 'mktree', '-z', data=b'\0'.join(tree) + b'\0')
    who = out(repo, 'log', '-1', '--date=raw', '--format=%an%x00%ae%x00%ad%x00%cn%x00%ce%x00%cd', head).split('\0')
    env = dict(zip(['GIT_AUTHOR_NAME', 'GIT_AUTHOR_EMAIL', 'GIT_AUTHOR_DATE',
                    'GIT_COMMITTER_NAME', 'GIT_COMMITTER_EMAIL', 'GIT_COMMITTER_DATE'], who))
    message = f'gate tree: {PART}/ of {head[:12]} on the reference {ref[:12]}'
    return out(repo, 'commit-tree', '--no-gpg-sign', tree_id, '-p', ref, '-m', message, env=env)


# --- run and check ----------------------------------------------------------------------------

def service_python():
    try:
        first = SERVICE_PYTHON.read_text().splitlines()[0].strip()
    except (FileNotFoundError, IndexError):
        raise Refused(f'no Python Host interpreter named in {SERVICE_PYTHON}; give --python')
    return first


def stand_up(repo, ref, gate):
    """The reference's tree outside server-rs/, and the working tree's server-rs/ as it is now."""
    index = gate.parent / 'index'
    env = {'GIT_INDEX_FILE': str(index)}
    git(repo, 'read-tree', ref, env=env)
    paths = [p for p in git(repo, 'ls-files', '-z', env=env).stdout.split(b'\0')
             if p and not p.startswith(PART.encode() + b'/')]
    git(repo, 'checkout-index', '-z', '--stdin', f'--prefix={gate}/', env=env, data=b'\0'.join(paths))
    index.unlink()
    for name in worktree_files(repo):
        source, target = Path(repo, name), gate / name
        if not os.path.lexists(source):
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        if source.is_symlink():
            os.symlink(os.readlink(source), target)
        else:
            shutil.copy2(source, target)


def worktree_files(repo):
    listed = git(repo, 'ls-files', '-co', '--exclude-standard', '-z', '--', PART).stdout
    return [name.decode() for name in listed.split(b'\0') if name]


def survey(gate):
    seen = {}
    for directory, _, files in os.walk(gate / PART):
        for name in files:
            path = Path(directory, name)
            st = path.lstat()
            seen[path.relative_to(gate).as_posix()] = (st.st_mode, st.st_size, st.st_mtime_ns, st.st_ctime_ns, st.st_ino)
    return seen


def same(one, two):
    if os.path.lexists(one) != os.path.lexists(two):
        return False
    if not os.path.lexists(one):
        return True
    if one.is_symlink() or two.is_symlink():
        return one.is_symlink() and two.is_symlink() and os.readlink(one) == os.readlink(two)
    return (one.stat().st_mode & 0o111) == (two.stat().st_mode & 0o111) and one.read_bytes() == two.read_bytes()


def changes(repo, gate, before):
    """The paths under server-rs/ the run made differ from the working tree, ignored ones left out."""
    after = survey(gate)
    touched = sorted(name for name in before.keys() | after.keys() if before.get(name) != after.get(name))
    touched = [name for name in touched if not same(Path(repo, name), gate / name)]
    if touched:
        ignored = git(repo, 'check-ignore', '-z', '--stdin', data='\0'.join(touched).encode(),
                      check=False).stdout.decode().split('\0')
        touched = [name for name in touched if name not in ignored]
    return touched


def copy(source_root, target_root, names):
    for name in names:
        source, target = Path(source_root, name), Path(target_root, name)
        if os.path.lexists(target) or target.is_symlink():
            target.unlink()
        if not os.path.lexists(source):
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        if source.is_symlink():
            os.symlink(os.readlink(source), target)
        else:
            shutil.copy2(source, target)


def generator_path(repo, name):
    tools = Path(repo, PART, 'tools')
    base = Path(name).name
    for candidate in (base, f'{base}.py', f'{base}-vectors.py'):
        if (tools / candidate).is_file():
            return candidate
    raise Refused(f'no generator {name!r} in {PART}/tools of the working tree')


def generators(repo):
    tools = Path(repo, PART, 'tools')
    found = sorted(p.name for p in tools.glob('*-vectors.py'))
    if (tools / 'casefold-table.py').is_file():
        found.append('casefold-table.py')
    return sorted(found)


def own_place(place):
    """A home, a database and every XDG directory of the generator's own, all inside its scratch place.

    A generator that sets none of its own would otherwise reach the default database of whoever runs it as
    soon as the Python Host's code under it opens its store.
    """
    home = place / 'home'
    dirs = {'HOME': home, 'XDG_DATA_HOME': home / '.local/share', 'XDG_CONFIG_HOME': home / '.config',
            'XDG_CACHE_HOME': home / '.cache', 'XDG_STATE_HOME': home / '.local/state', 'TMPDIR': place / 'tmp'}
    for directory in [*dirs.values(), place / 'db']:
        directory.mkdir(parents=True, exist_ok=True)
    return {**{key: str(value) for key, value in dirs.items()}, 'CLAUDE_PWA_DB': str(place / 'db/state.sqlite')}


def execute(repo, gate, python, name, args, *, quiet, write=True):
    """One generator in the gate tree. Returns (exit code, changed paths).

    Copies what changed back into the working tree only on success and when told to write; otherwise puts the
    gate tree back as the working tree has it, so the next generator starts from the same place.
    """
    nice = ['nice'] if shutil.which('nice') else []
    before = survey(gate)
    with scratch.directory('clarp-reference-run-') as place:
        env = {'PATH': os.environ.get('PATH', os.defpath), 'LANG': 'C.UTF-8', 'TZ': 'UTC',
               'PYTHONDONTWRITEBYTECODE': '1', **own_place(Path(place))}
        result = subprocess.run([*nice, python, str(gate / PART / 'tools' / name), *args], cwd=gate, env=env,
                                capture_output=quiet)
    touched = changes(repo, gate, before)
    if result.returncode:
        copy(repo, gate, touched)
        if quiet:
            tail = result.stderr.decode(errors='replace').strip().splitlines()[-12:]
            for line in tail:
                print(f'    {line}')
        return result.returncode, touched
    if write:
        copy(gate, repo, touched)
    else:
        copy(repo, gate, touched)
    return 0, touched


@contextlib.contextmanager
def gate_tree(repo):
    ref = worktree_reference(repo)
    with scratch.directory('clarp-reference-') as name:
        box = Path(name)
        gate = box / 'tree'
        gate.mkdir()
        stand_up(repo, ref, gate)
        yield ref, gate


def run(repo, name, args, python):
    name = generator_path(repo, name)
    with gate_tree(repo) as (ref, gate):
        print(f'{name}: against the reference {ref[:12]}', flush=True)
        code, touched = execute(repo, gate, python, name, args, quiet=False)
    if code:
        print(f'{name}: FAILED (exit {code}); nothing copied back'
              + (f'; it had written {", ".join(touched)}' if touched else ''))
        return code
    for path in touched:
        print(f'changed  {path}')
    print(f'{name}: {len(touched)} fixture(s) changed' if touched else f'{name}: unchanged')
    return 0


def sweep(repo, python, *, write):
    """Every generator in one gate tree: 'run --all' (write) or 'check' (the working tree as it was)."""
    failed, changed = [], []
    names = generators(repo)
    word, command = ('CHANGED', 'run --all') if write else ('WOULD CHANGE', 'check')
    with gate_tree(repo) as (ref, gate):
        for name in names:
            code, touched = execute(repo, gate, python, name, [], quiet=True, write=write)
            if code:
                failed.append(name)
                print(f'{name}: FAILED (exit {code}); nothing copied back', flush=True)
                continue
            changed += touched
            print(f'{name}: ' + (f'{word} {", ".join(touched)}' if touched else 'unchanged'), flush=True)
    said = 'changed, copied back' if write else 'would change; the working tree is as it was'
    if failed or changed:
        print(f'reference {command}: {len(names)} generator(s) against {ref[:12]}: {len(failed)} failed'
              + (f' ({", ".join(failed)})' if failed else '')
              + f', {len(changed)} fixture(s) {said}' + (f' ({", ".join(changed)})' if changed else ''))
        return 1 if failed or not write else 0
    print(f'reference {command}: {len(names)} generator(s) against {ref[:12]}: none failed, no fixture changed')
    return 0


def check(repo, python):
    return sweep(repo, python, write=False)


