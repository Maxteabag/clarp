#!/usr/bin/env bash
# Installs the Rust Host for the user who runs this, from binaries that were built elsewhere
# (server-rs/tools/build release): the Host and its shim, a token of its own, and a systemd user
# unit. Nothing here compiles.
#
#   server-rs/tools/install-host [--from DIR] [--listen ADDR:PORT] [--name NAME] [--claude PATH] [--codex PATH]
#                                [--push-relay URL|off] [--whisper PYTHON|off] [--speech-keys FILE|off]
#                                [--transcription-engine NAME] [--start] [--files-only]
#
#   --from DIR     where clarp-host, clarp-shim and SHA256SUMS are (default: server-rs/dist)
#   --listen       where the Host listens (default 127.0.0.1:7690). Keep it on the loopback and put
#                  whatever the phone reaches in front of it: the Host's own token is only taken
#                  from the loopback
#   --name         what the apps call this Host (default: "<hostname> Rust")
#   --claude, --codex   the programs to run for a turn. Default: the ones the Python Host on this
#                  machine runs (read from its unit, clarp-runtime.service), so that an agent
#                  that moves is run by the same tool it was run by; without a Python Host, the
#                  ones on the path. Run this again after the Python Host changed its tools
#   --push-relay   the relay that carries pushes to phones (default: the one the Python Host
#                  uses, Clarp Audio Central), or `off`. A phone that gave this Host a grant of
#                  its own is reached with nothing more. To reach phones that gave none, the
#                  Host needs a credential of its own at the relay: put
#                  CLARP_PUSH_CREDENTIAL=... into ~/.config/clarp-host/env yourself. This script
#                  never copies one from another Host
#   --accounts     whether a turn whose account is out waits for another one: `follow` where
#                  someone else on this machine puts another login in place (a Python Host
#                  with an account selector: this Host never changes a login itself), `none`
#                  where nobody does and the turn ends and says so. Default: `follow` when the
#                  Python Host on this machine has a selector, else `none`
#   --whisper      the Python that runs the Host's own engine that listens (speech to text): one
#                  that has faster-whisper. Default: the Python Host's own on this machine, when it
#                  has the library; it is run where it is, with the model that Host is set to and
#                  the model's files that are on this machine already. `off`, or no such Python:
#                  this Host has no engine of its own. Run this again after the Python Host was
#                  updated: its Python is in a directory that Host makes anew each time
#   --speech-keys  the file in which the keys of engines reached over the network (ElevenLabs) are
#                  looked up each time a clip is to be heard. Default: the Python Host's own
#                  config, when it is there. Nothing of it is copied or kept: a key the owner
#                  changes there is the key this Host uses next. `off`: only the Host's own
#                  environment (ELEVEN_API_KEY in ~/.config/clarp-host/env) is asked
#   --transcription-engine   the engine that hears a clip no app named one for: `local` (the
#                  Host's own, the default) or a cloud engine's name (elevenlabs:scribe_v2)
#   --start        enable the unit and start it, or restart it when it runs (turns that are running
#                  go on: each is in a scope of its own)
#   --files-only   write the files and ask systemd nothing: to look at what would be installed
#
# What an installation was told (--listen, --name, --claude, --codex, --push-relay, --whisper,
# --speech-keys, --transcription-engine) is kept with
# it, in ~/.config/clarp-host/install.conf, so that an update is this command with no more than
# --start: a relay that was turned off stays off. What is said now replaces what was kept, and
# `default` forgets it (--push-relay default).
#
# It installs beside a Python Host and touches nothing of it: its own directories
# (~/.local/share/clarp-host, ~/.config/clarp-host), its own port, its own unit (clarp-host.service).
#
# An agent on this Host is fenced from the Python Host's state. The Python Host's Clarp tools
# (clarp-goal, clarp-agent-bg and the rest in ~/.local/share/clarp/bin, also linked from
# ~/.local/bin) write straight into that Host's database, whatever the environment says. Skills
# call them by name, so this Host's own directory of tools (~/.local/share/clarp-host/tools)
# comes first on the path an agent's commands run with. It holds every one of those names; each
# is a pipe to this Host, which answers the tools it has and says of the others that it does not
# have them yet.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
from="$here/dist"; start=0; files_only=0
declare -A said=()
while [ $# -gt 0 ]; do
    case "$1" in
        --from) from="$2"; shift 2 ;;
        --listen|--name|--claude|--codex|--push-relay|--accounts|--whisper|--speech-keys|--transcription-engine) said["${1#--}"]="$2"; shift 2 ;;
        --start) start=1; shift ;;
        --files-only) files_only=1; shift ;;
        *) echo "usage: install-host [--from DIR] [--listen ADDR:PORT] [--name NAME] [--claude PATH] [--codex PATH] [--push-relay URL|off] [--accounts follow|none] [--start] [--files-only]" >&2; exit 2 ;;
    esac
done

share="${XDG_DATA_HOME:-$HOME/.local/share}/clarp-host"
config="${XDG_CONFIG_HOME:-$HOME/.config}/clarp-host"
units="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

# What this installation was told before, then what it is told now. Only what somebody chose is
# kept: where nobody chose, the installer's own answer of the day holds.
kept="$config/install.conf"
declare -A chosen=()
if [ -f "$kept" ]; then
    while IFS= read -r line; do
        case "${line%%=*}" in
            listen|name|claude|codex|push-relay|accounts|whisper|speech-keys|transcription-engine) chosen["${line%%=*}"]="${line#*=}" ;;
        esac
    done < "$kept"
fi
for key in "${!said[@]}"; do
    if [ "${said[$key]}" = default ]; then unset "chosen[$key]"; else chosen[$key]="${said[$key]}"; fi
done
listen="${chosen[listen]:-127.0.0.1:7690}"; name="${chosen[name]:-$(hostname) Rust}"
claude="${chosen[claude]:-}"; codex="${chosen[codex]:-}"
push_relay="${chosen[push-relay]:-https://clarp-audio-central.peter-w-adams96.workers.dev}"
[ "$push_relay" = off ] && push_relay=""
port="${listen##*:}"; address="${listen%:*}"

# The world an agent's commands run in: the one the Python Host on this machine gives them, so
# that an agent that moves finds what it found before. Without a Python Host, a plain one.
tools_path="$(systemctl --user show clarp-runtime.service -p Environment --value 2>/dev/null | tr ' ' '\n' | sed -n 's/^PATH=//p' | head -1)"
tools_path="${tools_path:-$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin}"
# This Host's own tools first: a name found there is never looked for further.
tools_path="$share/tools:$tools_path"
# Where the Python Host on this machine keeps its tools, when there is one.
python_share="$(systemctl --user show clarp-runtime.service -p Environment --value 2>/dev/null | tr ' ' '\n' | sed -n 's/^CLARP_SHARE_DIR=//p' | head -1)"
python_share="${python_share:-$HOME/.local/share/clarp}"
claude="${claude:-$(PATH="$tools_path" command -v claude || true)}"
codex="${codex:-$(PATH="$tools_path" command -v codex || true)}"
# What a turn inherits from its Host's unit besides the path, as the Python Host's unit has it:
# how many files a process may hold open, and how glibc keeps its memory. Without a Python Host,
# the Python Host's own answers.
python_unit() {
    [ "$(systemctl --user show clarp-runtime.service -p LoadState --value 2>/dev/null)" = loaded ] || return 0
    systemctl --user show clarp-runtime.service -p "$1" --value 2>/dev/null
}
# Whether a turn whose account is out waits for another one. It does where a Python Host on
# this machine has an account selector: that Host puts another login in place, and this one
# follows. (The file is only asked whether it names a selector; nothing of it is read out.)
python_config="$(python_unit Environment | tr ' ' '\n' | sed -n 's/^CLARP_CONFIG_DIR=//p' | head -1)"
python_config="${python_config:-${XDG_CONFIG_HOME:-$HOME/.config}/clarp}/config.toml"
accounts="${chosen[accounts]:-}"
if [ -z "$accounts" ]; then
    if grep -q '^[a-z]*_account_switch_command' "$python_config" 2>/dev/null; then accounts=follow; else accounts=none; fi
fi
case "$accounts" in follow|none) ;; *) echo "install-host: --accounts $accounts: follow or none" >&2; exit 2 ;; esac
# Speech in. The Host's own engine is a worker run by a Python that has faster-whisper: the
# Python Host's own interpreter on this machine, where it is, unless another is named. Which
# model it runs is the one that Host is set to (its name and how its numbers are kept are read
# from that Host's config, nothing else), loaded from the files this machine has already.
whisper="${chosen[whisper]:-}"
if [ -z "$whisper" ]; then
    candidate="$(sed -n 1p "$python_share/current/SERVICE_PYTHON" 2>/dev/null || true)"
    if [ -n "$candidate" ] && "$candidate" -c 'import faster_whisper' > /dev/null 2>&1; then whisper="$candidate"; else whisper=off; fi
fi
whisper_model=small.en; whisper_compute=int8; whisper_source=""
if [ "$whisper" != off ]; then
    [ -x "$whisper" ] || { echo "install-host: --whisper $whisper: not a program" >&2; exit 2; }
    set_to="$("$whisper" -c 'import sys, tomllib
try:
    w = tomllib.load(open(sys.argv[1], "rb")).get("whisper", {})
except Exception:
    w = {}
print(str(w.get("model") or "small.en"), str(w.get("compute") or "int8"))' "$python_config" 2>/dev/null || true)"
    read -r model_named compute_named <<< "${set_to:-small.en int8}"
    case "$model_named" in ''|*[!A-Za-z0-9._-]*) ;; *) whisper_model="$model_named" ;; esac
    case "$compute_named" in ''|*[!A-Za-z0-9_]*) ;; *) whisper_compute="$compute_named" ;; esac
    models="${HF_HUB_CACHE:-${HF_HOME:-$HOME/.cache/huggingface}/hub}"
    for kept_as in "models--Systran--faster-whisper-$whisper_model" "models--mobiuslabsgmbh--faster-whisper-$whisper_model"; do
        for snapshot in "$models/$kept_as"/snapshots/*/; do
            [ -f "${snapshot}model.bin" ] && whisper_source="${snapshot%/}"
        done
    done
fi
# Where the keys of engines over the network are looked up when a clip is to be heard.
speech_keys="${chosen[speech-keys]:-}"
if [ -z "$speech_keys" ]; then
    if [ -f "$python_config" ]; then speech_keys="$python_config"; else speech_keys=off; fi
fi
[ "$speech_keys" = off ] && speech_keys=""
transcription_engine="${chosen[transcription-engine]:-local}"
case "$transcription_engine" in *[!A-Za-z0-9:._-]*|'') echo "install-host: --transcription-engine $transcription_engine: a name" >&2; exit 2 ;; esac
speech=""
if [ "$whisper" != off ]; then
    speech=" --whisper-python \"$whisper\" --whisper-worker \"$share/libexec/whisper-worker.py\" --whisper-model $whisper_model --whisper-compute $whisper_compute${whisper_source:+ --whisper-source \"$whisper_source\"}"
fi
speech="$speech${speech_keys:+ --speech-keys \"$speech_keys\"} --transcription-engine $transcription_engine"
open_files="$(python_unit LimitNOFILE)"
case "$open_files" in ''|*[!0-9]*) open_files=65536 ;; esac
arenas="$(python_unit Environment | tr ' ' '\n' | sed -n 's/^MALLOC_ARENA_MAX=//p' | head -1)"

for binary in clarp-host clarp-shim; do
    [ -x "$from/$binary" ] || { echo "install-host: $from/$binary is not there: build it with server-rs/tools/build release" >&2; exit 1; }
done
(cd "$from" && sha256sum --quiet -c SHA256SUMS) || { echo "install-host: the binaries in $from are not the ones that were built" >&2; exit 1; }

mkdir -p "$share/bin" "$share/tools" "$share/data" "$share/cache" "$share/logs" "$config" "$units"
# What the Host keeps is its user's alone: conversations, the phones' tokens. The unit below
# says so for everything the Host writes from now on; this says it for what is there already.
chmod -R go-rwx "$share/data" "$share/cache" "$share/logs"
(umask 077; for key in "${!chosen[@]}"; do printf '%s=%s\n' "$key" "${chosen[$key]}"; done | sort > "$kept")
# Put in place under another name and moved: a Host that is running keeps the file it has open.
for binary in clarp-host clarp-shim; do
    install -m 755 "$from/$binary" "$share/bin/.$binary.new"
    mv -f "$share/bin/.$binary.new" "$share/bin/$binary"
done
# An agent's own tools: each is the Host's binary under the tool's name, a pipe to the Host the
# agent runs on. There is one for every tool the Host answers and for every tool of the Python
# Host on this machine, so that the name is never looked for further along the path. What the
# Host does not have yet it says so itself, and does nothing.
tools=0
for tool in $( { printf '%s\n' clarp-agent-bg clarp-admin clarp-goal clarp-agent-artifacts; ls "$python_share"/bin 2>/dev/null | grep '^clarp-' || true; } | sort -u); do
    case "$tool" in clarp-sub-agent|clarp-media-publish) continue ;; esac
    cat > "$share/tools/.$tool.new" <<EOF
#!/bin/sh
# Written by install-host: one of an agent's own tools on the Rust Host.
exec "$share/bin/clarp-host" tool $tool "\$@"
EOF
    chmod 755 "$share/tools/.$tool.new"
    mv -f "$share/tools/.$tool.new" "$share/tools/$tool"
    tools=$((tools + 1))
done
# One tool is a program of its own: clarp-sub-agent, with which an agent starts helpers and
# workers that outlive its turn. It asks no Host anything itself: it calls clarp-admin and
# clarp-agent-bg, which are this Host's above, and systemd. It is the repository's own program
# (skills/clarp-sub-agents), copied here, so that a Python Host's copy is never the one run.
sub_agent="$here/../skills/clarp-sub-agents/scripts/sub_agent.py"
mkdir -p "$share/libexec" "$share/data/sub-agents"
if [ -f "$sub_agent" ]; then
    install -m 644 "$sub_agent" "$share/libexec/.sub_agent.py.new"
    mv -f "$share/libexec/.sub_agent.py.new" "$share/libexec/sub_agent.py"
    cat > "$share/tools/.clarp-sub-agent.new" <<EOF
#!/bin/sh
# Written by install-host: the program an agent on the Rust Host starts helpers with.
# What it keeps of its helpers is this Host's own, apart from a Python Host's on the same machine.
CLARP_SUB_AGENT_DIR="\${CLARP_SUB_AGENT_DIR:-$share/data/sub-agents}"; export CLARP_SUB_AGENT_DIR
exec python3 "$share/libexec/sub_agent.py" "\$@"
EOF
else
    # Installed without the repository beside it: the name is taken, and says so.
    cat > "$share/tools/.clarp-sub-agent.new" <<EOF
#!/bin/sh
# Written by install-host: one of an agent's own tools on the Rust Host.
exec "$share/bin/clarp-host" tool clarp-sub-agent "\$@"
EOF
fi
chmod 755 "$share/tools/.clarp-sub-agent.new"
mv -f "$share/tools/.clarp-sub-agent.new" "$share/tools/clarp-sub-agent"
tools=$((tools + 1))
# Another is a program of its own as well: clarp-media-publish, with which an agent publishes
# an image or a file for its user. It reads the file and sends its bytes to the Host, which a
# pipe of words cannot carry. It is the repository's own program (scripts/), the one the skills
# were written against. A turn tells it where its Host is and gives it the token of the agent's
# tools, which opens the door for tools and nothing else; a worker an agent left running finds
# its Host in the file written below. Called from anywhere else, it still speaks to this Host
# only: the name is never an action on another Host.
media_publish="$here/../scripts/clarp-media-publish.py"
if [ -f "$media_publish" ]; then
    install -m 644 "$media_publish" "$share/libexec/.clarp-media-publish.py.new"
    mv -f "$share/libexec/.clarp-media-publish.py.new" "$share/libexec/clarp-media-publish.py"
    cat > "$share/tools/.clarp-media-publish.new" <<EOF
#!/bin/sh
# Written by install-host: the program an agent on the Rust Host publishes an image or a file with.
if [ -n "\${CLARP_HOST_ADDR:-}" ] && [ -n "\${CLARP_TOOL_TOKEN:-}" ]; then
    CLAUDE_PWA_BASE_URL="http://\$CLARP_HOST_ADDR/tools"; CLAUDE_PWA_TOKEN="\$CLARP_TOOL_TOKEN"
    export CLAUDE_PWA_BASE_URL CLAUDE_PWA_TOKEN
else
    # No turn told it where its Host is. It reads the file an installation of this Host wrote,
    # and never another Host's: a file that is not this Host's is passed over.
    named="\${CLAUDE_PWA_CONFIG:-$config/config.toml}"
    grep -q '^kind = "clarp-host"' "\$named" 2>/dev/null || named="$config/config.toml"
    CLAUDE_PWA_CONFIG="\$named"; export CLAUDE_PWA_CONFIG
fi
exec python3 "$share/libexec/clarp-media-publish.py" "\$@"
EOF
else
    cat > "$share/tools/.clarp-media-publish.new" <<EOF
#!/bin/sh
# Written by install-host: one of an agent's own tools on the Rust Host.
exec "$share/bin/clarp-host" tool clarp-media-publish "\$@"
EOF
fi
chmod 755 "$share/tools/.clarp-media-publish.new"
mv -f "$share/tools/.clarp-media-publish.new" "$share/tools/clarp-media-publish"
tools=$((tools + 1))
# The battle test's own program (docs/battle-test.md), so that a run of a week does not depend
# on the checkout it was installed from.
install -m 755 "$here/tools/soak" "$share/libexec/.soak.new"
mv -f "$share/libexec/.soak.new" "$share/libexec/soak"
# The worker of the Host's own engine that listens: this Host's own program, run by the Python
# named above.
install -m 644 "$here/tools/whisper-worker.py" "$share/libexec/.whisper-worker.py.new"
mv -f "$share/libexec/.whisper-worker.py.new" "$share/libexec/whisper-worker.py"
version="$(cut -c1-12 "$from/COMMIT" 2>/dev/null || echo unknown)"
printf '%s\n' "$version" > "$share/data/DEPLOYED_VERSION"

# The administrator's token: made once, kept. The Host reads it from its environment.
if [ ! -s "$config/env" ]; then
    (umask 077; printf 'CLARP_HOST_TOKEN=%s\n' "$(head -c 48 /dev/urandom | base64 | tr -d '/+=\n' | cut -c1-48)" > "$config/env")
fi
token="$(sed -n 's/^CLARP_HOST_TOKEN=//p' "$config/env")"
# What the agents' Clarp tools read to find their Host: this one.
(umask 077; cat > "$config/config.toml" <<EOF
# Written by install-host. An agent on the Rust Host finds its Host here: a turn is told
# where its Host is, and a worker an agent left running reads it from this file.
[server]
kind = "clarp-host"
bind_addr = "$address"
port = $port
auth_token = "$token"
EOF
)

cat > "$units/clarp-host.service" <<EOF
# Written by server-rs/tools/install-host. The Rust Clarp Host, version $version.
[Unit]
Description=Clarp Host (Rust)
After=network-online.target

[Service]
Type=simple
# Private to its user, as the Python Host's unit is: what the Host writes and what a turn makes.
UMask=0077
LimitNOFILE=$open_files
EnvironmentFile=$config/env
# The world an agent's commands run in, and the programs that run a turn.
Environment="PATH=$tools_path"
${claude:+Environment="CLARP_CLAUDE_PROGRAM=$claude"}
${codex:+Environment="CLARP_CODEX_PROGRAM=$codex"}
# The fence: what a Clarp tool reads to find its Host names this Host, never a Python Host's files.
# (The Python Host's own tools do not read it. They are off the path above.)
Environment="CLARP_CONFIG_DIR=$config"
Environment="CLAUDE_PWA_CONFIG=$config/config.toml"
Environment="CLARP_SHARE_DIR=$share"
Environment="CLARP_CACHE_DIR=$share/cache"
Environment="CLAUDE_PWA_LOG_DIR=$share/logs"
Environment="CLAUDE_PWA_DB=$share/data/no-python-state.sqlite"
${arenas:+Environment="MALLOC_ARENA_MAX=$arenas"}
ExecStart=$share/bin/clarp-host --data $share/data --listen $listen --launcher systemd --name "$name" --accounts $accounts${push_relay:+ --push-relay $push_relay}$speech
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
EOF

echo "installed: $share/bin/clarp-host ($version), unit $units/clarp-host.service"
if [ -n "$push_relay" ]; then pushes="through $push_relay"; else pushes="nowhere (the relay is off)"; fi
echo "it listens on $listen as \"$name\"; pushes go $pushes"
if [ "$accounts" = follow ]; then
    echo "a turn whose account is out waits for another login (the other Host's selector puts it in place)"
else
    echo "a turn whose account is out ends and says so (nobody on this machine changes logins)"
fi
if [ "$whisper" != off ]; then
    echo "speech in: its own engine, the model $whisper_model ($whisper_compute), run by $whisper${whisper_source:+ from the files in $whisper_source}"
else
    echo "speech in: no engine of its own (no Python with faster-whisper was found or named)"
fi
if [ -n "$speech_keys" ]; then
    echo "keys of engines over the network are looked up in $speech_keys when they are needed, and copied nowhere"
else
    echo "keys of engines over the network are looked up in this Host's own environment only"
fi
echo "a clip no app names an engine for is heard by: $transcription_engine"
[ -s "$kept" ] && echo "kept with the installation: $(tr '\n' ' ' < "$kept")"
echo "turns run: claude = ${claude:-not found}, codex = ${codex:-not found}"
echo "the agents' own tools: $tools names in $share/tools"
[ "$files_only" = 1 ] && { echo "files only: systemd was not asked"; exit 0; }
systemctl --user daemon-reload
if [ "$start" = 1 ]; then
    systemctl --user enable --quiet clarp-host.service
    systemctl --user restart clarp-host.service
    for _ in $(seq 1 50); do
        curl -fsS -m 2 -H "Authorization: Bearer $token" "http://$listen/server-info" > /dev/null 2>&1 && break
        sleep 0.2
    done
    if curl -fsS -m 2 -H "Authorization: Bearer $token" "http://$listen/server-info" > /dev/null 2>&1; then
        echo "running: the Host answers on $listen"
    else
        echo "install-host: the unit was started and the Host does not answer on $listen" >&2
        journalctl --user -u clarp-host.service --no-pager -n 8 >&2 || true
        exit 1
    fi
else
    echo "not started: systemctl --user enable --now clarp-host.service starts it"
fi
echo "to pair a phone: CLARP_HOST_TOKEN=\$(sed -n 's/^CLARP_HOST_TOKEN=//p' $config/env) $share/bin/clarp-host pair --url <the address the phone reaches this Host at> --host $listen"
