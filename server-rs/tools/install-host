#!/usr/bin/env bash
# Installs the Rust Host for the user who runs this, from binaries that were built elsewhere
# (server-rs/tools/build release): the Host and its shim, a token of its own, and a systemd user
# unit. Nothing here compiles.
#
#   server-rs/tools/install-host [--from DIR] [--listen ADDR:PORT] [--name NAME] [--claude PATH] [--codex PATH] [--agy PATH] [--opencode PATH]
#                                [--push-relay URL|off] [--whisper PYTHON|off] [--speech-keys FILE|off]
#                                [--transcription-engine NAME] [--relay on|off] [--relay-config FILE|off] [--relay-also FILE|off]
#                                [--push-keys FILE|off] [--contact-pictures on|off]
#                                [--seats-tool PATH|off] [--skills-from DIR] [--start] [--files-only]
#
#   --from DIR     where clarp-host, clarp-shim and SHA256SUMS are (default: server-rs/dist)
#   --skills-from DIR  the tree of skills this release ships, with its manifest.json (default: the
#                  repository's skills/ beside server-rs). It is copied, whole, to a place of its own
#                  for this version and named to the Host. Where it is not named and the default is
#                  not there, no skills are shipped; a tree named without a manifest is refused
#   --listen       where the Host listens (default 127.0.0.1:7690). Keep it on the loopback and put
#                  whatever the phone reaches in front of it: the Host's own token is only taken
#                  from the loopback
#   --name         what the apps call this Host (default: "<hostname> Rust")
#   --claude, --codex, --agy, --opencode   the programs to run for a turn. Default: the ones this Host ran before
#                  (read from its unit); at a first install, the ones the Python Host on this
#                  machine runs (read from its unit, clarp-runtime.service), so that an agent
#                  that moves is run by the same tool it was run by; without either, the ones on
#                  the path. A toolchain of the Python Host's that this Host runs is copied to its
#                  own (~/.local/share/clarp-host/toolchains), and run from there. An update keeps
#                  the versions it has: to move the agents to another Claude Code or Codex, name
#                  it here. Claude Code must take --thinking-display (2.1.285 and later do)
#   --push-relay   the relay that carries pushes to phones (default: the one the Python Host
#                  uses, Clarp Audio Central), or `off`. A phone that gave this Host a grant of
#                  its own is reached with nothing more. To reach phones that gave none, the
#                  Host needs a credential of its own at the relay: put
#                  CLARP_PUSH_CREDENTIAL=... into ~/.config/clarp-host/env yourself. This script
#                  never copies one from another Host
#   --accounts     whether a turn whose account is out waits for another one: `follow` where
#                  someone else on this machine puts another login in place (a Python Host
#                  with an account selector: this Host never changes a login itself), `none`
#                  where nobody does and the turn ends and says so. Default: `follow` when the
#                  Python Host on this machine has a selector, else `none`. `select`: this
#                  Host runs the owner's selector itself (the commands the owner's file names,
#                  `--speech-keys`, under [agents]), for a machine on which it is the only
#                  Host: it then keeps the machine's tools, their logins, their providers'
#                  settings and their skills, and verifies logins and reads provider usage.
#                  Never chosen by itself, and refused while the Python Host of this machine
#                  runs (its unit is anything but stopped), with or without a selector.
#                  One Host keeps the machine's tools and links the skills at every update
#   --seats-tool   the owner's tool that knows the seats of the machine's accounts (Hotseat), which
#                  the Host runs when an app asks for a reading of the desk of seats, and at no
#                  other time. Default: `hotseat` where it is found on the path the agents' tools
#                  are found on or on the path of whoever runs this; `off`: the Host is told none
#                  and shows no desk. The Host reads
#                  with it and moves no seat; unless it keeps the logins itself (--accounts
#                  select) it tells the tool to renew none as it reads
#   --whisper      the Python that runs the Host's own engine that listens (speech to text): one
#                  that has faster-whisper. Default: the one this Host ran before, else the Python
#                  Host's own on this machine, when it has the library, copied to this Host's own
#                  place (~/.local/share/clarp-host/environments); it runs the model that Host is
#                  set to, from the model's files that are on this machine already. `off`, or no
#                  such Python: this Host has no engine of its own
#   --speech-keys  the file in which the keys of engines reached over the network (ElevenLabs) are
#                  looked up each time a clip is to be heard. Default: the Python Host's own
#                  config, when it is there. Nothing of it is copied or kept: a key the owner
#                  changes there is the key this Host uses next. `off`: only the Host's own
#                  environment (ELEVEN_API_KEY in ~/.config/clarp-host/env) is asked
#   --push-keys    the owner's APNs or FCM configuration. By default the installer uses
#                  ~/.config/clarp/config.toml (under XDG_CONFIG_HOME when set) if it has an
#                  [apns] or [fcm] section. An explicit FILE selects another file. Use off
#                  to disable the owner's push keys. This setting is independent of --speech-keys.
#   --transcription-engine   the engine that hears a clip no app named one for: `local` (the
#                  Host's own, the default) or a cloud engine's name (elevenlabs:scribe_v2)
#   --relay        whether phones reach this Host through the connection relay: `on` or `off` (the
#                  default). On, the Host dials the relay under the name that is in
#                  ~/.config/clarp-host/relay.json (the relay's address, this Host's name there and
#                  its key; for its owner only, mode 600; whoever keeps the relay writes it, and
#                  this script never copies one from another Host). The switch is written into
#                  this Host's own config, as [network] relay_enabled
#   --relay-config another file that says so instead: a config of the Python Host's kind with
#                  [network] relay_enabled in it and relay.json beside it. For the day this Host
#                  takes the Python Host's place: stop that Host, disable its unit, and name its
#                  file here (--relay-config ~/.config/clarp/config.toml): the phones keep their
#                  pairing. The relay gives a name's phones to whoever dialled last, so two Hosts
#                  must never dial with one name: this script refuses a file that names this Host
#                  as the Python Host is named while that Host runs or can come back by itself.
#                  `off`: the Host is told of no file at all. Never the Python Host's file by
#                  default, though the keys of speech are read there
#   --relay-also   keep serving an additional relay name with the private relay.json beside FILE.
#                  The Python Host must be stopped and disabled. Repeat for several names;
#                  off clears the list. New pairings still use the primary relay.
#   --contact-pictures whether a contact that has no picture is drawn one by the provider of
#                  pictures (OpenAI's gpt-image-2, with the owner's [openai] api_key, twenty a rolling
#                  day at most): `on` or `off` (the default). It spends, so it is said here and
#                  nowhere else: the Host starts with --contact-pictures only where this says on
#   --start        enable the unit and start it, or restart it when it runs (turns that are running
#                  go on: each is in a scope of its own)
#   --files-only   write the files and ask systemd nothing: to look at what would be installed
#
#   server-rs/tools/install-host --rollback
#   server-rs/tools/install-host --judge
#
#   --rollback     put back the last release that ran steady (below) and start it: for a Host that
#                  crash-loops right after an install. It says which release it left and which it
#                  started, and refuses, changing nothing, where no release is known to have run
#                  steady or that one is installed now. It puts back that release's binaries and
#                  its unit as they were installed; the config, the data and the agents' tools stay
#                  as they are. Also installed as ~/.local/share/clarp-host/libexec/install-host,
#                  for a machine with no checkout at hand
#   --judge        judge now whether the release installed now ran steady, and say so
#
# Every install keeps its binaries and its unit in ~/.local/share/clarp-host/releases/<version>,
# beside the skills it ships (issue 853). Pruning keeps the release installed now, the one installed
# before it, and the last one that ran steady: current for at least 30 minutes, with the unit's
# restart count unchanged and no core dump of the unit's in all the time it was current. It is
# judged when the next install replaces it, or by --judge. releases/steady names it and says how it
# was judged; releases/current says since when the release installed now has run, and with what
# count.
#
# What an installation was told (--listen, --name, --claude, --codex, --push-relay, --whisper,
# --speech-keys, --push-keys, --transcription-engine, --relay, --relay-config, --relay-also, --seats-tool,
# --contact-pictures) is kept with
# it, in ~/.config/clarp-host/install.conf, so that an update is this command with no more than
# --start: a relay that was turned off stays off. What is said now replaces what was kept, and
# `default` forgets it (--push-relay default).
#
# It installs beside a Python Host and touches nothing of it: its own directories
# (~/.local/share/clarp-host, ~/.config/clarp-host), its own port, its own unit (clarp-host.service).
#
# An agent on this Host is fenced from the Python Host's state. The Python Host's Clarp tools
# (clarp-goal, clarp-agent-bg and the rest in ~/.local/share/clarp/bin, also linked from
# ~/.local/bin) write straight into that Host's database, whatever the environment says. Skills
# call them by name, so this Host's own directory of tools (~/.local/share/clarp-host/tools)
# comes first on the path an agent's commands run with. It holds every one of those names; each
# is a pipe to this Host, which answers the tools it has and says of the others that it does not
# have them yet.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
from="$here/dist"; start=0; files_only=0
skills_from="$here/../skills"; skills_named=0
declare -A said=()
said_relays=()
only=""
case "${1:-}" in
    --rollback|--judge)
        [ "$#" = 1 ] || { echo "install-host: $1 takes no other option" >&2; exit 2; }
        only="${1#--}"; shift ;;
esac
while [ $# -gt 0 ]; do
    case "$1" in
        --from) from="$2"; shift 2 ;;
        --skills-from) skills_from="$2"; skills_named=1; shift 2 ;;
        --listen|--name|--claude|--codex|--agy|--opencode|--push-relay|--accounts|--whisper|--speech-keys|--push-keys|--transcription-engine|--relay|--relay-config|--seats-tool|--contact-pictures) said["${1#--}"]="$2"; shift 2 ;;
        --relay-also)
            [ "$#" -ge 2 ] && [ -n "$2" ] || { echo "install-host: --relay-also needs a file or off" >&2; exit 2; }
            said_relays+=("$2"); shift 2 ;;
        --start) start=1; shift ;;
        --files-only) files_only=1; shift ;;
        *) echo "usage: install-host [--from DIR] [--listen ADDR:PORT] [--name NAME] [--claude PATH] [--codex PATH] [--agy PATH] [--opencode PATH] [--push-relay URL|off] [--push-keys FILE|off] [--accounts follow|none|select] [--relay on|off] [--relay-config FILE|off] [--relay-also FILE|off] [--seats-tool PATH|off] [--contact-pictures on|off] [--skills-from DIR] [--start] [--files-only]" >&2
           echo "       install-host --rollback | --judge" >&2; exit 2 ;;
    esac
done
if [ "$skills_named" = 1 ] && [ ! -f "$skills_from/manifest.json" ]; then
    echo "install-host: --skills-from $skills_from: no manifest.json there" >&2
    exit 2
fi

share="${XDG_DATA_HOME:-$HOME/.local/share}/clarp-host"
config="${XDG_CONFIG_HOME:-$HOME/.config}/clarp-host"
units="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

# The releases kept for a rollback (issue 853). On 25 Nov 2026 a Host crash-looped for 22 minutes
# after an install, and the two releases it kept both had the fault: there was nothing to go back
# to. So each install keeps its binaries and its unit under releases/<version>, and pruning never
# removes the last release that ran steady. Two small files beside the releases say what is known:
# `current` the release installed now, since when it has run and the unit's restart count then;
# `steady` the last release that ran steady and how that was judged.
releases="$share/releases"
host_unit=clarp-host.service
# The unit that holds the Host's port while the Host is restarted (issue 935), and the address
# start_host last started it on with the socket's run (its InvocationID) then: the port in effect.
# A unit written with --files-only is not in effect until start_host starts the socket on it, and
# a socket started again by anyone else is a run of its own that start_host did not record.
socket_unit=clarp-host.socket
socket_listening="$releases/socket-listening"
steady_minutes=30
# A value of one of those files, or nothing.
kept_value() {
    [ -f "$1" ] || return 0
    sed -n "/^$2=/{s/^$2=//p;q}" "$1"
}
restart_count() {
    local count
    count="$(systemctl --user show "$host_unit" -p NRestarts --value 2>/dev/null || true)"
    case "$count" in ''|*[!0-9]*) echo unknown ;; *) echo "$count" ;; esac
}
# Says the release named has run as installed now: from now on, with the unit's restart count now.
write_current() {
    (
        umask 077
        cat > "$releases/.current.new" <<EOF
# Written by install-host (issue 853): the release installed now, since when it has run, and the
# unit's restart count when it started. The next install or install-host --judge judges
# whether it ran steady.
version=$1
since=$(date +%s)
since_text=$(date -Is)
restarts=$(restart_count)
EOF
    )
    mv -f "$releases/.current.new" "$releases/current"
}
# Whether the release installed now ran steady: current for at least $steady_minutes minutes, its
# unit active, with the restart count it started with and no core dump of the unit's since. A
# release judged steady stays the steady one until another is.
judge_current() {
    local version since restarts now count state cores ran_steady
    version="$(kept_value "$releases/current" version)"
    [ -n "$version" ] || { echo "install-host: no release has a start on record to judge"; return 0; }
    if [ "$version" != "$(cat "$share/data/DEPLOYED_VERSION" 2>/dev/null || true)" ]; then
        echo "install-host: $version, on record as current, is not the release installed now: not judged"
        return 0
    fi
    if [ "$version" = "$(kept_value "$releases/steady" version)" ]; then
        echo "install-host: $version is the steady release already"
        return 0
    fi
    if [ ! -x "$releases/$version/bin/clarp-host" ]; then
        echo "install-host: $version's binaries were not kept: not judged"
        return 0
    fi
    since="$(kept_value "$releases/current" since)"
    restarts="$(kept_value "$releases/current" restarts)"
    case "$since" in ''|*[!0-9]*) echo "install-host: $version's start is not on record: not judged"; return 0 ;; esac
    now="$(date +%s)"
    if [ $((now - since)) -lt $((steady_minutes * 60)) ]; then
        echo "install-host: $version has run $(((now - since) / 60)) of $steady_minutes minutes: not judged yet"
        return 0
    fi
    state="$(systemctl --user show "$host_unit" -p ActiveState --value 2>/dev/null || true)"
    count="$(restart_count)"
    if command -v coredumpctl > /dev/null 2>&1; then
        cores="$(coredumpctl --no-pager --no-legend --quiet list --since "@$since" "COREDUMP_USER_UNIT=$host_unit" 2>/dev/null | grep -c . || true)"
    else
        cores="not checked (coredumpctl is not installed)"
    fi
    ran_steady=1
    [ "$state" = active ] || ran_steady=0
    { [ "$restarts" != unknown ] && [ "$count" = "$restarts" ]; } || ran_steady=0
    case "$cores" in 0|"not checked"*) ;; *) ran_steady=0 ;; esac
    if [ "$ran_steady" = 0 ]; then
        echo "install-host: $version did not run steady: unit $state, restarts $restarts at its start and $count now, core dumps since: $cores"
        return 0
    fi
    (
        umask 077
        cat > "$releases/.steady.new" <<EOF
# Written by install-host (issue 853): the last release that ran steady. Pruning never removes it,
# and install-host --rollback starts it. Steady: current for at least $steady_minutes minutes, with
# $host_unit's restart count unchanged and no core dump of the unit's in all that time.
version=$version
current_since=$(kept_value "$releases/current" since_text)
judged_at=$(date -Is)
minutes_current=$(((now - since) / 60))
restarts_at_start=$restarts
restarts_when_judged=$count
core_dumps=$cores
EOF
    )
    mv -f "$releases/.steady.new" "$releases/steady"
    echo "install-host: $version ran steady for $(((now - since) / 60)) minutes: it is the release a rollback starts"
}
# Starts the Host's unit as it is written, or starts it again where it runs (issue 935). A release
# stops one Host and then starts the next; a Host that binds its port itself leaves it closed in
# between, and Tailscale Serve answered the apps 502 all that time. So the unit takes its port from
# clarp-host.socket. Where that socket already listens as written, only the Host is restarted: the
# port stays open, and what comes in meanwhile waits in its queue for the next Host. The first time,
# or when the port changed, the Host that holds the port is stopped first, the socket takes the port,
# and the Host starts on it: the port is closed for that moment only. Where the socket cannot take the
# port, the Host is started binding it itself, as before, so that it never stays down. A unit of a
# release from before the socket (a rollback) gets the port back: the socket is stopped and removed.
# $1 is 1 when this run wrote the socket's unit anew.
start_host() {
    if ! grep -qx 'StandardInput=socket' "$units/$host_unit"; then
        rm -f "$socket_listening"
        if [ -f "$units/$socket_unit" ] || systemctl --user is-active --quiet "$socket_unit"; then
            systemctl --user stop "$host_unit" "$socket_unit" 2> /dev/null || true
            systemctl --user disable --quiet "$socket_unit" 2> /dev/null || true
            rm -f "$units/$socket_unit"
            systemctl --user daemon-reload
        fi
        systemctl --user enable --quiet "$host_unit"
        systemctl --user restart "$host_unit"
        return
    fi
    systemctl --user enable --quiet "$socket_unit" "$host_unit"
    # Only the Host is restarted where the socket's run now is the one start_host last started,
    # on the address its unit says now: what a file on disk says is not what is in effect, and a
    # socket started again by anyone else may hold another address.
    local wanted run
    wanted="$(sed -n 's/^ListenStream=//p' "$units/$socket_unit" | head -1)"
    run="$(systemctl --user show "$socket_unit" -p InvocationID --value 2> /dev/null || true)"
    if [ "$1" = 0 ] && [ -n "$wanted" ] && [ -n "$run" ] &&
        systemctl --user is-active --quiet "$socket_unit" &&
        [ "$(cat "$socket_listening" 2> /dev/null)" = "$wanted $run" ]; then
        systemctl --user restart "$host_unit"
        return
    fi
    # The Host that holds the port lets go of it the moment it is told to stop, and then finishes
    # what it was answering. The socket takes the port as soon as it can, not once that Host is
    # gone: the port is closed only between the two (175 to 645 ms in the disposable trials of
    # 26 Nov 2026), and the next Host starts once the old one has ended, so one Host at a time
    # writes the data.
    systemctl --user stop "$host_unit" &
    local stopping=$! taken=0
    rm -f "$socket_listening"
    if port_free "$wanted" && systemctl --user restart "$socket_unit"; then
        taken=1
    fi
    wait "$stopping" || true
    if [ "$taken" = 0 ] && systemctl --user restart "$socket_unit"; then
        taken=1
    fi
    if [ "$taken" = 1 ]; then
        mkdir -p "$releases"
        run="$(systemctl --user show "$socket_unit" -p InvocationID --value 2> /dev/null || true)"
        # A socket whose run cannot be told is recorded as none: the next install starts it again.
        [ -n "$run" ] && printf '%s %s\n' "$wanted" "$run" > "$socket_listening"
        systemctl --user start "$host_unit"
        return
    fi
    echo "install-host: $socket_unit could not take the port: the Host binds it itself, as before" >&2
    journalctl --user -u "$socket_unit" --no-pager -n 4 >&2 || true
    sed -i -e "/^Requires=${socket_unit//./\\.}\$/d" -e '/^StandardInput=socket$/d' \
        -e "s/^After=network-online\.target ${socket_unit//./\\.}\$/After=network-online.target/" "$units/$host_unit"
    systemctl --user disable --quiet "$socket_unit" 2> /dev/null || true
    rm -f "$units/$socket_unit"
    systemctl --user daemon-reload
    systemctl --user restart "$host_unit"
}
# Waits until ADDR:PORT can be bound (the Host that held it let go), thirty seconds at most.
port_free() {
    python3 - "$1" <<'PY'
import socket, sys, time
host, port = sys.argv[1].rsplit(":", 1)
host = host.strip("[]")
family = socket.AF_INET6 if ":" in host else socket.AF_INET
until = time.monotonic() + 30
while time.monotonic() < until:
    probe = socket.socket(family, socket.SOCK_STREAM)
    probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        probe.bind((host, int(port)))
        sys.exit(0)
    except OSError:
        time.sleep(0.002)
    finally:
        probe.close()
sys.exit(1)
PY
}
# Waits until the run of the Host that answers first says its whole start is done (issue 935). A
# Host answers that it is there before its start is done, so an answer alone is no success: the
# run that answered must reach `started` itself. Another run answering (that one failed late in
# its start and was started again), no answer for 30 s after one came, no answer within three
# minutes or a start not done within ten is a failure. A Host of issue 935 or later says both its
# run and its stage, or its answer is a failure; one from before says neither and answers only once
# its start is done: its valid answer (its counts) is its start done. Prints the run.
host_started() {
    local began=$SECONDS first="" heard="" said instance stage
    while [ $((SECONDS - began)) -lt 600 ]; do
        if said="$(curl -fsS -m 5 -H "Authorization: Bearer $2" "http://$1/host/start" 2> /dev/null)"; then
            heard=$SECONDS
            read -r instance stage < <(printf '%s' "$said" | python3 -c '
import json, sys
try:
    said = json.load(sys.stdin)
except ValueError:
    print("unreadable unreadable")
    raise SystemExit
if not isinstance(said, dict):
    print("invalid invalid")
elif "instance" not in said and "stage" not in said:
    # A Host from before issue 935 answers only once its start is done: a valid answer of its
    # kind (its three counts) is its start done.
    old = all(isinstance(said.get(key), int) and not isinstance(said.get(key), bool)
              for key in ("agents", "opening", "broken"))
    print("before-935 started" if old else "invalid invalid")
else:
    # A Host of issue 935 or later says both, or its answer is not one to trust.
    run, stage = said.get("instance"), said.get("stage")
    fine = isinstance(run, str) and run.isalnum() and stage in ("starting", "agents", "started")
    print(f"{run} {stage}" if fine else "invalid invalid")' 2> /dev/null || echo "unreadable unreadable")
            if [ "$instance" = invalid ]; then
                echo "install-host: the Host answered /host/start with what is neither a start of issue 935 or later (instance and stage) nor one from before: $said" >&2
                return 1
            fi
            if [ "$instance" != unreadable ]; then
                if [ -z "$first" ]; then
                    first="$instance"
                elif [ "$instance" != "$first" ]; then
                    echo "install-host: another run answers: $first did not finish its start, $instance was started" >&2
                    return 1
                fi
                if [ "$stage" = started ]; then
                    echo "$instance"
                    return 0
                fi
            fi
        elif [ -z "$heard" ] && [ $((SECONDS - began)) -gt 180 ]; then
            echo "install-host: the Host does not answer" >&2
            return 1
        elif [ -n "$heard" ] && [ $((SECONDS - heard)) -gt 30 ]; then
            echo "install-host: the run $first stopped answering before its start was done ($stage)" >&2
            return 1
        fi
        sleep 0.2
    done
    echo "install-host: the start of run ${first:-none} was not done within ten minutes (${stage:-no answer})" >&2
    return 1
}
# Puts the last release that ran steady back in place, binaries and unit, and starts it.
rollback() {
    local steady left kept listen token name
    steady="$(kept_value "$releases/steady" version)"
    left="$(cat "$share/data/DEPLOYED_VERSION" 2>/dev/null || echo unknown)"
    if [ -z "$steady" ]; then
        echo "install-host: --rollback: no release is known to have run steady ($releases/steady names none). Nothing was changed." >&2
        echo "  A release is judged steady once it has been current for $steady_minutes minutes without a restart or a core dump, when the next install replaces it." >&2
        exit 1
    fi
    kept="$releases/$steady"
    if [ "$steady" = "$left" ]; then
        echo "install-host: --rollback: the steady release $steady is the one installed now; there is nothing older known to be steady. Nothing was changed." >&2
        exit 1
    fi
    for name in bin/clarp-host bin/clarp-shim bin/SHA256SUMS "$host_unit"; do
        [ -f "$kept/$name" ] || { echo "install-host: --rollback: $kept/$name is missing. Nothing was changed." >&2; exit 1; }
    done
    (cd "$kept/bin" && sha256sum --quiet -c SHA256SUMS) || { echo "install-host: --rollback: the binaries kept in $kept/bin are not the ones that were installed. Nothing was changed." >&2; exit 1; }
    # The release left is not judged: whoever rolls back does not trust it.
    for name in clarp-host clarp-shim; do
        install -m 755 "$kept/bin/$name" "$share/bin/.$name.new"
        mv -f "$share/bin/.$name.new" "$share/bin/$name"
    done
    cp "$kept/$host_unit" "$units/.$host_unit.new"
