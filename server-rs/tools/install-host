    if [ "${{CLARP_WRAPPER_HANDOVER+x}}" != x ]; then
        case "${{CLARP_SHARE_DIR:-}}" in
            /*)
                tool="$CLARP_SHARE_DIR/tools/{name}"
                if [ -f "$tool" ] && [ -x "$tool" ]; then
                    if {{ [ "$tool" -ef "$0" ]; [ "$?" -eq 1 ]; }} 2>/dev/null; then
                        export CLARP_WRAPPER_HANDOVER=1
                        exec "$tool" "$@"
                    fi
                fi
                ;;
        esac
    fi
    printf '%s\\n' {wrong_host} >&2
    exit 69
fi
export CLAUDE_PWA_CONFIG={config}
exec {shlex.quote(str(target))} "$@"
""")
    replacement = Path(temporary.name)
    try:
        replacement.chmod(0o700)
        replacement.replace(path)
    finally:
        replacement.unlink(missing_ok=True)
PYTHON
    done
fi

echo "installed: $share/bin/clarp-host ($version), unit $units/clarp-host.service"
if [ -n "$push_keys" ]; then
    pushes="directly with the owner's APNs/FCM keys"
    if [ -n "$push_relay" ]; then
        pushes="$pushes and through $push_relay for phones that gave a grant"
    fi
elif [ -n "$push_relay" ]; then
    pushes="through $push_relay for phones that gave a grant"
else
    pushes="nowhere (neither direct keys nor a relay are configured)"
fi
echo "it listens on $listen as \"$name\"; pushes go $pushes"
if [ "$accounts" = follow ]; then
    echo "a turn whose account is out waits for another login (the other Host's selector puts it in place)"
elif [ "$accounts" = select ]; then
    echo "a turn whose account is out waits while this Host runs the owner's selector (the commands under [agents] in the owner's file)"
else
    echo "a turn whose account is out ends and says so (nobody on this machine changes logins)"
fi
if [ "$whisper" != off ]; then
    echo "speech in: its own engine, the model $whisper_model ($whisper_compute), run by $whisper${whisper_source:+ from the files in $whisper_source}"
else
    echo "speech in: no engine of its own (no Python with faster-whisper was found or named)"
fi
if [ -n "$speech_keys" ]; then
    echo "keys of engines over the network are looked up in $speech_keys when they are needed, and copied nowhere"
else
    echo "keys of engines over the network are looked up in this Host's own environment only"
fi
echo "a clip no app names an engine for is heard by: $transcription_engine"
if [ -n "$relay_as" ]; then
    echo "phones reach it through the connection relay as \"$relay_as\" (by $relay_config)"
elif [ -n "$relay_config" ]; then
    echo "the primary connection relay is off (--relay on turns it on)"
else
    echo "the primary connection relay has no configuration file"
fi
for name_also in "${extra_names[@]}"; do
    echo "phones already paired through relay name $name_also can reach this Host there"
done
if [ "$contact_pictures" = on ]; then
    echo "contact pictures: on: a contact with no picture is drawn one by OpenAI, with the owner's key (--contact-pictures off turns it off)"
else
    echo "contact pictures: off (--contact-pictures on turns it on): nothing is drawn, nothing is spent"
fi
[ -s "$kept" ] && echo "kept with the installation: $(tr '\n' ' ' < "$kept")"
echo "turns run: claude = ${claude:-not found}, codex = ${codex:-not found}, agy = ${agy:-not found}, opencode/deepseek = ${opencode:-not found}"
echo "the agents' own tools: $tools names in $share/tools"
[ "$files_only" = 1 ] && { echo "files only: systemd was not asked"; exit 0; }
systemctl --user daemon-reload
if [ "$start" = 1 ]; then
    start_host "$socket_written"
    if run="$(host_started "$listen" "$token")"; then
        echo "running: the Host answers on $listen, its start done (run $run)"
        # From now on it is the release whose run the next install or --judge judges.
        [ "$version" = unknown ] || write_current "$version"
        # How its start went: asked until no agent is still being opened (a minute at most). What
        # is broken or could not be read is said, and the install ends with a code of its own;
        # the Host stays up as it is, and whoever installed it decides what to do.
        started=""
        for _ in $(seq 1 120); do
            started=$(curl -fsS -m 2 -H "Authorization: Bearer $token" "http://$listen/host/start" 2>/dev/null) || started=""
            opening=$(printf '%s' "$started" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("opening", 0))' 2>/dev/null || echo 1)
            [ "$opening" = 0 ] && break
            sleep 0.5
        done
        report=$(printf '%s' "$started" | python3 -c '
import json, sys
said = json.load(sys.stdin)
parts = []
if said.get("opening"):
    parts.append("still opening=%d" % said.get("opening"))
if said.get("broken"):
    parts.append("broken agents=%d" % said.get("broken"))
parts += [f"{kind}={count}" for kind, count in sorted((said.get("left_out") or {}).items()) if count]
print(" ".join(parts))' 2>/dev/null || echo "its start could not be read")
        if [ -n "$report" ]; then
            echo "install-host: the Host started, and not all of it: $report" >&2
            echo "install-host: nothing was written over; the journal names what was left out (journalctl --user -u clarp-host.service)" >&2
            exit 3
        fi
    else
        echo "install-host: the unit was started and the Host did not finish its start on $listen" >&2
        journalctl --user -u clarp-host.service --no-pager -n 8 >&2 || true
        exit 1
    fi
else
    echo "not started: systemctl --user enable --now clarp-host.socket clarp-host.service starts it"
fi
echo "to pair a phone: CLARP_HOST_TOKEN=\$(sed -n 's/^CLARP_HOST_TOKEN=//p' $config/env) $share/bin/clarp-host pair --url <the address the phone reaches this Host at> --host $listen (or pair --relay, where it is reached through the relay)"
