HOME = pathlib.Path.home()
RELEASE_BIN = HOME / ".local/share/clarp-host/bin"
OUT = pathlib.Path("/var/tmp/turn-timings")
BACKENDS = ("codex", "codex-lane", "claude", "agy")
# A row is a backend, or a backend run another way: `codex-lane` is Codex with the Host's
# `codex_chat_lane` on, so its chat turns run on the agent's long-lived app-server lane.
TOOL_OF = {"codex-lane": "codex"}
