def make_agent(host: Host, backend: str, model: str, effort: str, row: str = "", suffix: str = "") -> Agent:
    body = {"name": f"tt-{row or backend}{'-' + suffix if suffix else ''}", "backend": backend,
            "cwd": str(host.root / "ws")}
    if model:
        body["model"] = model
    if effort:
        body["effort"] = effort
    status, answer = host.ask("POST", "/agents", body, timeout=60)
    if status != 200 or not isinstance(answer, dict) or not answer.get("session"):
        raise RuntimeError(f"could not make the {backend} agent: {status} {str(answer)[:300]}")
    session = answer["session"]
    agent_id = answer.get("agent_id") or (answer.get("agent") or {}).get("agent_id") or ""
    if not agent_id:
        status, snap = host.ask("GET", "/agents/snapshot")
        for row in (snap.get("agents") or []) if isinstance(snap, dict) else []:
            if row.get("session") == session:
                agent_id = row.get("agent_id") or row.get("id") or ""
    agent = Agent(host, backend, session, agent_id, row)
    agent.model, agent.effort = model, effort
    return agent


def lane_settings(args) -> dict:
    out = {}
    if args.lane_idle_minutes is not None:
        out["codex_lane_idle_minutes"] = str(args.lane_idle_minutes)
    if args.lane_most is not None:
        out["codex_lane_most"] = str(args.lane_most)
    if args.lane_memory_mb is not None:
        out["lane_memory_mb"] = str(args.lane_memory_mb)
    # A count or a budget given is a fixed limit: auto, the default, would not use them.
    if args.lane_most is not None or args.lane_memory_mb is not None:
        out["lane_limits"] = '"fixed"'
    return out


def pairs(given: list) -> dict:
    out = {}
    for item in given or []:
        key, _, value = item.partition("=")
        out[key.strip()] = value.strip()
    return out


def run(args) -> int:
    run_id = time.strftime("%Y%m%d-%H%M%S")
    folder = pathlib.Path(args.out) / run_id
    folder.mkdir(parents=True, exist_ok=True)
    root = folder / "host"
    bin_dir = pathlib.Path(args.bin).expanduser() if args.bin else RELEASE_BIN
    backends = [b for b in args.backends.split(",") if b]
    if args.codex_lane and "codex-lane" not in backends:
        backends.insert(backends.index("codex") + 1 if "codex" in backends else len(backends), "codex-lane")
    if args.claude_lane and "claude-lane" not in backends:
        backends.insert(backends.index("claude") + 1 if "claude" in backends else len(backends), "claude-lane")
    cases = [c for c in args.cases.split(",") if c]
    models = {**MODELS, **pairs(args.model)}
    efforts = {**EFFORTS, **pairs(args.effort)}
    settings_before = mentions(root)
    claude_mtime = live_claude_mtime()
    result = {"run_id": run_id, "started": load(), "bin": str(bin_dir), "rounds": args.rounds,
              "host_version": "", "backends": {}, "settings": {"before": settings_before}}
    commit = bin_dir / "COMMIT"
    if commit.exists():
        result["commit"] = commit.read_text().strip()
    elif bin_dir == RELEASE_BIN:
        result["commit"] = installed_release()
    host = Host(root, bin_dir, args.port)
    out_json = folder / "timings.json"

    def save():
        out_json.write_text(json.dumps(result, indent=1))

    try:
        host.start()
        status, peers = host.ask("GET", "/peers")
        result["peers"] = peers
        if status != 200 or peers != []:
            raise SystemExit(f"GET /peers did not answer [] ({status} {str(peers)[:200]}): stopping")
        status, info = host.ask("GET", "/server-info")
        result["host_version"] = str(info.get("version") or info.get("host_version") or info.get("build") or "") \
            if isinstance(info, dict) else ""
        result["host_contract"] = info.get("host_contract") if isinstance(info, dict) else None
        print(f"disposable Host {host.address} pid {host.proc.pid} version {result['host_version']}", flush=True)
        for backend in backends:
            row, backend = backend, TOOL_OF.get(backend, backend)
            entry = result["backends"][row] = {"model": models.get(row, ""), "backend": backend,
                                               "effort": efforts.get(row, ""), "cases": []}
            settings = {**SETTINGS_OF.get(row, {}), **(lane_settings(args) if row in SETTINGS_OF else {})}
            host.configure(settings)
            entry["settings"] = settings
            try:
                agent = make_agent(host, backend, models.get(row, ""), efforts.get(row, ""), row)
            except RuntimeError as failed:
                entry["error"] = str(failed)
                print(failed, flush=True)
                save()
                continue
            entry["session"], entry["agent_id"] = agent.session, agent.agent_id
            row_cases = list(cases)
            if row in SETTINGS_OF:
                # A lane's first turn starts it: make that turn now, unmeasured, so that `plain`
                # measures a warm lane; `cold` measures the first turn of new agents.
                warm = agent.send("Warm-up. Reply with exactly one word: ok")
                agent.wait_ended(warm["t_send"])
                agent.wait_idle()
                # A Claude lane is started once the first turn's own process is gone: the
                # cases wait for it, so that they measure a warm lane.
                settle = time.monotonic() + 20
                while row == "claude-lane" and time.monotonic() < settle and not lane_of(agent, lanes(host)):
                    time.sleep(0.2)
                if "cold" not in row_cases:
                    row_cases.append("cold")
            for n in range(1, args.rounds + 1):
                for case in row_cases:
                    started = load()
                    began = time.monotonic()
                    case_began = now_ms()
                    lanes_before = lanes(host) if row in SETTINGS_OF else []
                    try:
                        found = RUNNERS[case](agent, n)
                    except Exception as failed:  # One case failing is a result, not the end of the run.
                        found = {"error": f"{type(failed).__name__}: {failed}"}
                        agent.wait_idle()
                    found["events"] = compact_events(host, agent.session, case_began)
                    if row in SETTINGS_OF:
                        lanes_after = lanes(host)
                        owner = agent
                        if found.get("agent_id"):
                            owner = Agent(host, backend, "", found["agent_id"], row)
                        was, now = lane_of(owner, lanes_before), lane_of(owner, lanes_after)
                        found.setdefault("measures", {})
                        found["measures"]["lane_seen"] = now is not None
                        found["measures"]["lane_new"] = now is not None and (was is None or was["pid"] != now["pid"])
                    found.update({"case": case, "round": n, "load_before": started, "load_after": load(),
                                  "seconds": round(time.monotonic() - began, 1)})
                    entry["cases"].append(found)
                    host.remember()
                    shown = {k: v for k, v in (found.get("measures") or {}).items()}
                    print(f"{row} {case} #{n} load {started['load1']:.2f}: {json.dumps(shown)}", flush=True)
                    save()
            if row in SETTINGS_OF:
                # The lanes left idle: this agent's and one per `cold` agent, on the owner's own
                # Codex configuration (its MCP servers included), now and a little later.
                agent.wait_idle()
                entry["lanes_idle"] = [{"at": int(now_ms()), "lanes": lanes(host)}]
                time.sleep(args.lane_settle)
                entry["lanes_idle"].append({"at": int(now_ms()), "lanes": lanes(host)})
                save()
            host.configure({})
    finally:
        result["ended"] = load()
        result["left_after_host"] = host.stop()
        result["login_links"] = login_links(root)
        result["live_claude"] = live_claude_check(root, claude_mtime)
        result["unowned_in_folder"] = host.unowned
        result["settings"]["after"] = mentions(root)
        result["settings"]["undone"] = undo_mentions(root) + drop_claude_sessions(root)
        save()
        if not args.keep_host and root.exists():
            shutil.rmtree(root, ignore_errors=True)
    (folder / "summary.md").write_text(summary(result))
    print(f"wrote {out_json} and {folder / 'summary.md'}", flush=True)
    return 0


