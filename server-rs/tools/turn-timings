def p90(values: list) -> float:
    ordered = sorted(values)
    if len(ordered) == 1:
        return ordered[0]
    rank = 0.9 * (len(ordered) - 1)
    low = int(rank)
    high = min(low + 1, len(ordered) - 1)
    return ordered[low] + (ordered[high] - ordered[low]) * (rank - low)


def summary(result: dict) -> str:
    lines = [f"# Turn timings {result['run_id']}", "",
             f"Host {result.get('host_version', '')} from `{result.get('bin', '')}`"
             + (f", commit {result['commit']}" if result.get("commit") else "")
             + f"; {result.get('rounds')} rounds per case.",
             f"Load at start: {result['started']['uptime']}",
             f"Load at end: {(result.get('ended') or {}).get('uptime', '')}", "",
             "Seconds; median and p90 over the rounds that measured it (n). Load is the one-minute load "
             "average before each case: its range is given per backend.", ""]
    for backend, entry in result["backends"].items():
        lines.append(f"## {backend} ({entry.get('model') or 'default model'}, effort {entry.get('effort') or 'default'})")
        lines.append("")
        if entry.get("error"):
            lines += [f"Not measured: {entry['error']}", ""]
            continue
        loads = [c["load_before"]["load1"] for c in entry["cases"] if c.get("load_before")]
        if loads:
            lines += [f"Load (1 min) over its cases: {min(loads):.2f} to {max(loads):.2f}.", ""]
        lines.append("| case | measure | median | p90 | n |")
        lines.append("|---|---|---|---|---|")
        groups = []
        for case, measures in SHOWN.items():
            rows = [c for c in entry["cases"] if c.get("case") == case]
            # A lane row says of each turn whether it started its lane: a turn that did is cold,
            # whatever case it was, and is shown apart from the warm ones.
            if any(isinstance(c.get("measures"), dict) and c["measures"].get("lane_seen") for c in rows):
                warm = [c for c in rows if not c["measures"].get("lane_new")]
                cold = [c for c in rows if c["measures"].get("lane_new")]
                groups.append((f"{case} (warm lane)", measures, warm) if case != "cold" else (case, measures, rows))
                if cold and case != "cold":
                    groups.append((f"{case} (lane started)", measures, cold))
            else:
                groups.append((case, measures, rows))
        for case, measures, rows in groups:
            if not rows:
                continue
            for measure in measures:
                values = [c["measures"][measure] for c in rows
                          if isinstance(c.get("measures"), dict) and isinstance(c["measures"].get(measure), (int, float))
                          and not isinstance(c["measures"].get(measure), bool)]
                if values:
                    lines.append(f"| {case} | {measure} | {statistics.median(values):.2f} | {p90(values):.2f} | {len(values)} |")
                else:
                    lines.append(f"| {case} | {measure} | - | - | 0 |")
        modes = [c["measures"].get("steer_mode") for c in entry["cases"]
                 if c.get("case") == "steer" and isinstance(c.get("measures"), dict)]
        kinds = [c["measures"].get("first_activity_kind") for c in entry["cases"]
                 if c.get("case") == "plain" and isinstance(c.get("measures"), dict)]
        errors = [f"{c.get('case')} #{c.get('round')}: {c['error']}" for c in entry["cases"] if c.get("error")]
        lines.append("")
        if modes:
            lines.append("Steer: " + ", ".join(f"{m} {modes.count(m)}" for m in sorted(set(map(str, modes)))) + ".")
        if kinds:
            lines.append("First activity was: " + ", ".join(f"{k or 'none'} {kinds.count(k)}" for k in sorted(set(kinds), key=str)) + ".")
        for error in errors:
            lines.append(f"Error: {error}")
        seen = [c["measures"].get("lane_seen") for c in entry["cases"] if isinstance(c.get("measures"), dict)
                and "lane_seen" in c["measures"]]
        if seen and not any(seen):
            lines.append("No lane was seen: this Host ran these turns on exec, not on a lane.")
        kept = [c["measures"].get("process_kept") for c in entry["cases"]
                if c.get("case") == "stop" and isinstance(c.get("measures"), dict) and "process_kept" in c["measures"]]
        if any(kept):
            lines.append(f"Stop: the spool's process outlived the turn in {sum(1 for k in kept if k)} of {len(kept)} "
                         "(a lane's app-server stays).")
        commands = [c["measures"] for c in entry["cases"] if c.get("case") == "stop" and isinstance(c.get("measures"), dict)
                    and "command_seen" in c["measures"]]
        if commands:
            seen = [m for m in commands if m["command_seen"]]
            kept = [m for m in seen if m.get("command_kept")]
            at5 = sum(1 for m in seen if m.get("command_alive_5s"))
            at15 = sum(1 for m in seen if m.get("command_alive_15s"))
            lost = sorted({name for m in commands for name in m.get("lane_helpers_lost") or []})
            lines.append(f"Stop on the lane: the turn's command was found in {len(seen)} of {len(commands)} stops; "
                         f"command_kept in {len(kept)} (alive 5 s after the Stop in {at5}, 15 s after in {at15}). "
                         f"Lane processes that died with the Stop: {', '.join(lost) if lost else 'none'}.")
            if len(seen) < len(commands):
                lines.append("A stop whose command was not found says nothing of command_kept: look at it.")
        for look in entry.get("lanes_idle") or []:
            found = look["lanes"]
            if not found:
                lines.append("Idle lanes: none found.")
                continue
            rss = [lane["rss_kb"] / 1024 for lane in found]
            pss = [lane["pss_kb"] / 1024 for lane in found]
            names = sorted({name for lane in found for name in lane["names"]})
            idle = [lane["idle_ms"] for lane in found if isinstance(lane.get("idle_ms"), (int, float))]
            lines.append(
                f"Idle lanes at {time.strftime('%H:%M:%S', time.localtime(look['at'] / 1000))}: {len(found)}; "
                f"RSS per lane median {statistics.median(rss):.0f} MiB (from {min(rss):.0f} to {max(rss):.0f}), "
                f"total {sum(rss):.0f} MiB; PSS per lane median {statistics.median(pss):.0f} MiB, total {sum(pss):.0f} MiB; "
                f"processes per lane {statistics.median([lane['processes'] for lane in found]):.0f} ({', '.join(names)})"
                + (f"; idle_ms from {min(idle)} to {max(idle)}" if idle else "; no idle_ms from Inspect") + ".")
        lines.append("")
    settings = result.get("settings") or {}
    lines.append("## The tools' settings")
    lines.append("")
    live = result.get("live_claude")
    if live:
        if live["run_wrote_live_claude"]:
            lines.append("The run's Claude WROTE the live ~/.claude: "
                         + ("~/.claude.json names the run's folder. " if live["names_run_folder"] else "")
                         + ("~/.claude/projects got a folder for the run. " if live["live_projects_folder_made"] else "")
                         + "CLAUDE_CONFIG_DIR did not hold.")
        else:
            lines.append("The run's Claude wrote nothing to the live ~/.claude: ~/.claude.json does not name the run's "
                         "folder and ~/.claude/projects has no folder for it. Its mtime "
                         + ("moved during the run (other Claude sessions on the machine write it)."
                            if live["mtime_moved"] else "did not move."))
        lines.append("")
    for said in result.get("login_links") or []:
        lines.append(f"- Login link {said}")
    if result.get("login_links"):
        lines.append("")
    if settings.get("undone"):
        lines += [f"- {u}" for u in settings["undone"]]
    else:
        lines.append("No settings file of claude, codex or agy named the run's folder after the run.")
    lines.append("")
    lines.append("Codex and agy keep their own record of the test conversations among all others; those are left.")
    lines.append("")
    lines.append("## Measures")
    lines.append("")
    lines += [
        "- host_ack: send to the Host's first `agent-activity` of the turn (its own `thinking`, made at dispatch).",
        "- first_activity: send to the first `agent-activity` that comes from the tool (a tool call, a reply, "
        "the end), not the dispatch's `thinking`.",
        "- first_reply_in_log: send to the reply row appearing in `GET /log` (polled every 0.1 s).",
        "- end_to_end: send to the `agent-state` event that ends the turn.",
        "- send_to_spawned: send to the shim's `spawned` (the tool's process up), from the spool.",
        "- send_to_ready: send to the tool being ready for the model (Codex `turn.started`): the launch overhead "
        "a user waits for.",
        "- cold: a plain turn of a new agent; on the lane row its first turn, which starts the lane and its thread. "
        "On the lane row every other case is split into warm-lane turns and turns that started a lane.",
        "- host_queue: send to the spool being made (its birth time): the Host's own part.",
        "- launch: spool made to `spawned`: the shim starting the tool.",
        "- tool_start: `spawned` to the tool's first line of output: the tool's own start.",
        "- tool_ready: `spawned` to the tool saying it is ready for the model (Codex `turn.started`, "
        "Claude's `system` init line, agy's `init`).",
        "- model_reply_in_spool: tool ready to its first reply line: the model's own time.",
        "- tool_turn_to_host_end: the tool's own end of turn line to the Host's end of turn event.",
        "- process_exit_after_end: the Host's end of turn to the shim's `exited` (negative: the process left first).",
        "- tool_round_trip_host: the `agent-activity` that shows the command running to the turn's next activity "
        "(the Host shows a finished call so).",
        "- tool_round_trip_spool: the same span in the tool's own lines in the spool.",
        "- tool_shown_after_spool: the tool's own line that the command started to the Host showing it; "
        "tool_end_shown_after_spool the same for its end.",
        "- first_row_in_log: send to the first row after the message in `GET /log` (a tool row or the reply).",
        "- steer_to_effect: the second send to its row in `GET /log` (polled every 0.1 s).",
        "- steer_to_read: the second send to the lane's `steer.read` line in the spool; steer_to_next_item: to "
        "Codex's first item after it.",
        "- Idle lanes: each lane's `clarp-shim codex-goal-lane`, its app-server child and that child's process "
        "group (an MCP server it started), RSS and PSS from /proc smaps_rollup, read twice, `--lane-settle` apart.",
        "- steer_wait_for_own_turn: for a send that waited, the second send to its own turn starting.",
        "- stop_to_command_gone (lane row): Stop to the turn's command (the `sleep`, found before the Stop below "
        "the lane's shim, in its app-server's group, or working in the run's folder; matched by pid and start "
        "time) being gone, polled every 20 ms for up to 40 s (empty: it outlived that). command_alive_5s and command_alive_15s: is it still running 5 s and "
        "15 s after the Stop; command_kept: either.",
        "- stop_to_turn_over: Stop to the `agent-state` that ends the turn; stop_to_process_gone: Stop to the "
        "tool's process id being gone (polled every 20 ms).",
    ]
    return "\n".join(lines) + "\n"


def first_activity_again(case: dict):
    """A plain case's first activity, read again from its stored events (the run's own reading
    may have closed its window before the end's activity arrived)."""
    sent, ended = case.get("sent") or {}, case.get("t_ended")
    if not sent or case.get("case") != "plain" or not isinstance(case.get("measures"), dict):
        return
    until = (ended or float("inf")) + 1000
    for e in case.get("events") or []:
        if e.get("type") == "agent-activity" and e["at"] >= sent["t_send"] and e["at"] <= until and \
                ((e.get("state") or e.get("kind")) != "thinking" or e.get("phase") == "tool_finished"):
            case["measures"]["first_activity"] = seconds(sent["t_send"], e["at"])
            case["measures"]["first_activity_kind"] = str(e.get("state") or e.get("kind") or "")
            return


def report(args) -> int:
    folder = pathlib.Path(args.run_dir)
    result = json.loads((folder / "timings.json").read_text())
    for entry in result["backends"].values():
        for case in entry.get("cases") or []:
            first_activity_again(case)
    (folder / "timings.json").write_text(json.dumps(result, indent=1))
    (folder / "summary.md").write_text(summary(result))
    print(folder / "summary.md")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n", 1)[0])
    sub = parser.add_subparsers(dest="command", required=True)
    go = sub.add_parser("run")
    go.add_argument("--backends", default=",".join(BACKENDS))
    go.add_argument("--cases", default=",".join(CASES))
    go.add_argument("--rounds", type=int, default=5)
    go.add_argument("--bin", default="", help="a folder with clarp-host and clarp-shim (default: the installed release)")
    go.add_argument("--out", default=str(OUT))
    go.add_argument("--model", action="append", help="BACKEND=MODEL")
    go.add_argument("--effort", action="append", help="BACKEND=EFFORT")
    go.add_argument("--keep-host", action="store_true", help="keep the disposable Host's folders afterwards")
    go.add_argument("--codex-lane", action="store_true",
                    help="add the codex-lane row: Codex with codex_chat_lane on in the disposable Host's config")
    go.add_argument("--claude-lane", action="store_true",
                    help="add the claude-lane row: Claude with claude_chat_lane on in the disposable Host's config")
    go.add_argument("--port", type=int, default=0, help="the disposable Host's port (default: any free one)")
    go.add_argument("--lane-idle-minutes", type=int, default=None, help="codex_lane_idle_minutes for the lane row")
    go.add_argument("--lane-most", type=int, default=None, help="codex_lane_most for the lane row")
    go.add_argument("--lane-memory-mb", type=int, default=None,
                    help="lane_memory_mb for the lane row: what all lanes may hold together (2200 unless set)")
    go.add_argument("--lane-settle", type=float, default=30.0,
                    help="seconds between the two looks at the idle lanes' memory")
    again = sub.add_parser("report")
    again.add_argument("run_dir")
    args = parser.parse_args()
    return run(args) if args.command == "run" else report(args)


if __name__ == "__main__":
    sys.exit(main())
