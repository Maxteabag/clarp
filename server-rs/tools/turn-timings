# agy folds its effort into the model's name.
EFFORTS = {"codex": "low", "codex-lane": "low", "claude": "low", "agy": ""}
TURN_TIMEOUT = 180.0
ENDED = {"done", "idle", "stopped", "interrupted", "error", "failed"}


def now_ms() -> float:
    return time.time() * 1000.0


def load() -> dict:
    one, five, fifteen = os.getloadavg()
    try:
        said = subprocess.run(["uptime"], capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        said = ""
    return {"at": int(now_ms()), "load1": one, "load5": five, "load15": fifteen, "uptime": said}


