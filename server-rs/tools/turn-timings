# Codex lanes: the long-lived `clarp-shim codex-goal-lane` of an agent and its app-server
# ---------------------------------------------------------------------------------------------

def in_folder(path: str, folder: pathlib.Path) -> bool:
    """Is `path` the folder or inside it, by whole path components (`/a/b-c` is not in `/a/b`)?"""
    return path == str(folder) or path.startswith(str(folder) + "/")


def names_folder(text: str, folder: pathlib.Path) -> bool:
    """Does `text` name the folder, or a path inside it, as a whole path?"""
    return re.search(re.escape(str(folder)) + r"(?=/|\s|$)", text) is not None


def command_line(pid: int) -> str:
    try:
        return pathlib.Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode("utf-8", "replace")
    except OSError:
        return ""


def proc_stat(pid: int) -> dict:
    """A process's parent, group and name, from /proc/<pid>/stat."""
    try:
        raw = pathlib.Path(f"/proc/{pid}/stat").read_text()
    except OSError:
        return {}
    name = raw[raw.index("(") + 1:raw.rindex(")")]
    fields = raw[raw.rindex(")") + 2:].split()
    return {"pid": pid, "name": name, "ppid": int(fields[1]), "pgid": int(fields[2])}


def started_at(pid: int):
    """A process's start time in clock ticks since boot, which tells it from a later process
    that got the same id; None when it is gone."""
    try:
        raw = pathlib.Path(f"/proc/{pid}/stat").read_text()
        return int(raw[raw.rindex(")") + 2:].split()[19])
    except (OSError, ValueError, IndexError):
        return None


def alive(command: tuple) -> bool:
    """Is this (pid, start) still the same running process? A zombie is not running."""
    pid, start = command
    if started_at(pid) != start:
        return False
    return not pid_gone(pid)


def commands_of(host: "Host", lane, name: str) -> list:
    """The turn's command, as (pid, start): the processes called `name` below the lane's shim or
    in its app-server's group, and any other of this user's called so that work in the run's
    folder (a command that left the lane's tree is still the turn's)."""
    found = {m["pid"] for m in (lane or {}).get("members", []) if m["name"] == name}
    for entry in pathlib.Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            if entry.stat().st_uid != os.getuid() or proc_stat(int(entry.name)).get("name") != name:
                continue
            cwd = os.readlink(entry / "cwd")
        except OSError:
            continue
        if in_folder(cwd, host.root):
            found.add(int(entry.name))
    return [(pid, started_at(pid)) for pid in sorted(found) if started_at(pid) is not None]


def memory_kb(pid: int) -> tuple:
    """RSS and PSS of one process in KiB (PSS shares a shared page out among its users)."""
    rss = pss = 0
    try:
        for line in pathlib.Path(f"/proc/{pid}/smaps_rollup").read_text().splitlines():
            if line.startswith("Rss:"):
                rss = int(line.split()[1])
            elif line.startswith("Pss:"):
                pss = int(line.split()[1])
    except (OSError, ValueError, IndexError):
        pass
    return rss, pss


def lane_inspect(socket_path: str) -> dict:
    """The lane's own answer to Inspect (`{"op":"inspect"}`), or {} when it does not answer."""
    import socket as sockets
    try:
        with sockets.socket(sockets.AF_UNIX, sockets.SOCK_STREAM) as conn:
            conn.settimeout(3)
            conn.connect(socket_path)
            conn.sendall(b'{"op":"inspect"}\n')
            data = b""
            while not data.endswith(b"\n"):
                chunk = conn.recv(65536)
                if not chunk:
                    break
                data += chunk
        answer = json.loads(data.decode("utf-8", "replace").strip() or "{}")
    except (OSError, ValueError):
        return {}
    return answer if isinstance(answer, dict) else {}


def find_key(value, key: str):
    if isinstance(value, dict):
        if key in value:
            return value[key]
        for child in value.values():
            found = find_key(child, key)
            if found is not None:
                return found
    return None


def lanes(host: Host) -> list:
    """Every lane of the disposable Host: the shim, its app-server child, that child's process
    group (an MCP server the app-server started is in it), their memory, and the lane's idle_ms.
    Found by the run's folder in the shim's command line; nothing outside the run is looked at
    beyond reading /proc."""
    stats = {}
    for entry in pathlib.Path("/proc").iterdir():
        if entry.name.isdigit():
            info = proc_stat(int(entry.name))
            if info:
                stats[info["pid"]] = info
    found = []
    for pid, info in stats.items():
        line = command_line(pid)
        if not ("codex-goal-lane" in line or "claude-lane" in line) or not names_folder(line, host.root):
            continue
        socket_path = next((word for word in line.split() if word.endswith(LANE_SOCKETS)), "")
        children = [p for p, i in stats.items() if i["ppid"] == pid]
        groups = {stats[c]["pgid"] for c in children}
        # The app-server's group, and every process below the shim besides: a helper the
        # app-server put in a group of its own is still the lane's.
        below, frontier = set(), set(children)
        while frontier:
            below |= frontier
            frontier = {p for p, i in stats.items() if i["ppid"] in frontier} - below
        group = sorted({p for p, i in stats.items() if i["pgid"] in groups} | below)
        members = [pid] + group
        rss = pss = 0
        for member in members:
            one_rss, one_pss = memory_kb(member)
            rss, pss = rss + one_rss, pss + one_pss
        inspected = lane_inspect(socket_path) if socket_path else {}
        found.append({"pid": pid, "socket": pathlib.Path(socket_path).name, "group": group,
                      "names": sorted({stats[m]["name"] for m in group if m in stats}),
                      "processes": len(members), "rss_kb": rss, "pss_kb": pss,
                      "shim_rss_kb": memory_kb(pid)[0], "idle_ms": find_key(inspected, "idle_ms"),
                      "thread": bool(find_key(inspected, "thread")),
                      "members": [{"pid": m, "name": stats[m]["name"]} for m in group if m in stats]})
    return found


def lane_of(agent, found: list):
    """The lane of this agent among `found` (its socket is named after the agent), or None."""
    for lane in found:
        if agent.agent_id and agent.agent_id in lane["socket"]:
            return lane
    return None


def read_spool(path: pathlib.Path) -> list:
    """A spool's records as {t, s, event?, type?, item?}: structure and times only, no text."""
    out = []
    try:
        lines = path.read_text(errors="replace").splitlines()
    except OSError:
        return out
    for line in lines:
        try:
            record = json.loads(line)
        except ValueError:
            continue
        data, kept = record.get("d"), {"t": record.get("t"), "s": record.get("s")}
        if isinstance(data, dict) and "event" in data:
            kept["event"] = data["event"]
            if "pid" in data:
                kept["pid"] = data["pid"]
            if data.get("signal") is not None:
                kept["signal"] = data["signal"]
        elif record.get("s") == "out" and isinstance(data, str):
            try:
                inner = json.loads(data)
            except ValueError:
                inner = None
            if isinstance(inner, dict):
                # The line's kind: `type` (Codex, Claude, grok), `method`, agy's `event`, muse's
                # `payload_type`.
                named = [inner.get(key) for key in ("type", "method", "event", "payload_type")]
                kept["type"] = next((str(word) for word in named if isinstance(word, str) and word), "")
                # agy: a step's kind and state. Claude: a streamed event's kind and its block's.
                update = inner.get("step_update")
                if isinstance(update, dict):
                    kept["item"] = f"{update.get('step_type') or ''}:{update.get('state') or ''}"
                streamed = inner.get("event")
                if inner.get("type") == "stream_event" and isinstance(streamed, dict):
                    block = streamed.get("content_block") if isinstance(streamed.get("content_block"), dict) else {}
                    kept["item"] = f"{streamed.get('type') or ''}:{block.get('type') or ''}"
                item = inner.get("item") if isinstance(inner.get("item"), dict) else \
                    (inner.get("params") or {}).get("item") if isinstance(inner.get("params"), dict) else None
                if isinstance(item, dict):
                    kept["item"] = str(item.get("type") or "")
                if inner.get("type") in ("assistant", "user") and isinstance(inner.get("message"), dict):
                    kinds = [c.get("type") for c in inner["message"].get("content") or [] if isinstance(c, dict)]
                    kept["item"] = ",".join(str(k) for k in kinds)
                if inner.get("subtype"):
                    kept["subtype"] = str(inner["subtype"])
        out.append(kept)
    return out


def spool_birth(path: pathlib.Path):
    """When the shim made the spool, in ms since the epoch (statx birth time), or None."""
    try:
        said = subprocess.run(["stat", "-c", "%.6W", str(path)], capture_output=True, text=True,
                              timeout=5).stdout.strip()
        value = float(said)
        return value * 1000.0 if value > 0 else None
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


def new_spools(agent: Agent, before: dict) -> list:
    """The spools made since `before`, oldest first."""
    made = [p for p in agent.spools() if p not in before]
    return sorted(made, key=lambda p: (spool_birth(p) or 0, p.name))


def spool_marks(path: pathlib.Path) -> dict:
    """The launch's steps as the spool tells them: made, spawned, first output, the first tool
    call started and finished, the end of the tool's turn, stopping and exited."""
    records = read_spool(path)
    marks = {"spool": path.name, "made": spool_birth(path)}
    for r in records:
        t, event, kind, item = r.get("t"), r.get("event"), r.get("type", ""), r.get("item", "")
        if event == "spawned":
            marks.setdefault("spawned", t)
            marks["pid"] = r.get("pid")
        elif event == "stopping":
            marks.setdefault("stopping", t)
        elif event == "exited":
            marks.setdefault("exited", t)
        elif r.get("s") == "out":
            marks.setdefault("first_out", t)
            marks.setdefault("first_out_type", kind)
            # A tool call starting and finishing, in each tool's own words.
            starts = (kind in ("item.started", "item/started") and item in ("command_execution", "commandExecution")) \
                or (kind == "stream_event" and item == "content_block_start:tool_use") \
                or (kind == "assistant" and "tool_use" in item) \
                or (kind == "step_update" and item == "tool:ACTIVE")
            ends = (kind in ("item.completed", "item/completed") and item in ("command_execution", "commandExecution")) \
                or (kind == "user" and "tool_result" in item) \
                or (kind == "step_update" and item == "tool:DONE")
            if starts:
                marks.setdefault("tool_started", t)
            if ends:
                marks.setdefault("tool_finished", t)
            # The tool ready for the model: Codex's turn started, Claude's init line.
            if kind in ("turn.started", "turn/started", "init") or (kind == "system" and r.get("subtype") == "init"):
                marks.setdefault("ready", t)
            if (kind in ("item.completed", "item/completed") and item in ("agent_message", "agentMessage")) \
                    or (kind == "stream_event" and item == "content_block_start:text") \
                    or (kind == "assistant" and "text" in item) \
                    or (kind == "step_update" and item.startswith("agent_response:")) \
                    or kind in ("text", "run.output.delta"):
                marks.setdefault("first_reply", t)
            if kind in ("turn.completed", "turn/completed", "result", "end") or kind.startswith("run.terminal."):
                marks.setdefault("turn_completed", t)
            # A lane's receipt that the running turn read a steered message, and Codex's first
            # item after it.
            if kind == "steer.read":
                marks.setdefault("steer_read", t)
            elif "steer_read" in marks and kind.startswith("item"):
                marks.setdefault("after_steer_item", t)
    marks["records"] = [{k: v for k, v in r.items() if k in ("t", "s", "event", "type", "item", "subtype")}
                        for r in records][:200]
    return marks


def pid_gone(pid) -> bool:
    if not pid:
        return True
    try:
        os.kill(int(pid), 0)
    except ProcessLookupError:
        return True
    except PermissionError:
        return False
    # A zombie is gone for this purpose.
    try:
        return pathlib.Path(f"/proc/{pid}/stat").read_text().split(") ", 1)[1].startswith("Z")
    except (OSError, IndexError):
        return True


def first_activity(agent: Agent, since: float, until: float):
    """The Host's first sign of the turn (its own `thinking`, made at dispatch), and the first
    sign that comes from the tool itself: an `agent-activity` other than the dispatch's
    `thinking` (a tool call, a reply streaming, the turn's end)."""
    events = [(at, e) for at, e in agent.host.events_since(since, agent.session)
              if at <= until and e.get("type") == "agent-activity"]
    ack = events[0][0] if events else None
    for at, e in events:
        if (e.get("state") or e.get("kind")) != "thinking" or e.get("phase") == "tool_finished":
            return ack, at, str(e.get("state") or e.get("kind") or "")
    return ack, None, ""


def watch_turn(agent: Agent, sent: dict, timeout: float = TURN_TIMEOUT):
    """Wait for the turn's end, looking at `GET /log` every 0.1 s meanwhile: the time the first
    row after the user's message appeared (a tool row or the reply), and the first reply."""
    first_row = first_reply = None
    deadline = time.monotonic() + timeout
    ended = None
    while time.monotonic() < deadline:
        ended = agent.wait_ended(sent["t_send"], timeout=0.01)
        status, body = agent.host.ask("GET", f"/log?session={urllib.parse.quote(agent.session)}&limit=30")
        if status == 200 and isinstance(body, dict):
            rows = body.get("turns") or []
            ids = [row.get("id") for row in rows]
            mine = f"u-{sent['client_msg_id']}"
            if mine in ids:
                after = [row for row in rows[ids.index(mine) + 1:] if row.get("role") != "user"]
                if after and first_row is None:
                    first_row = now_ms()
                if first_reply is None and any(row.get("role") == "assistant" and not row.get("kind")
                                               and row.get("origin") != "system" for row in after):
                    first_reply = now_ms()
        if ended is not None:
            break
        time.sleep(0.1)
    return ended, first_row, first_reply


def compact_events(host: Host, session: str, since: float) -> list:
    """The case's live events for its agent, without text: type, the fields that say what
    happened, and the time each arrived here."""
    keep = ("type", "kind", "state", "phase", "status", "tool", "call_id", "client_msg_id", "queue_depth",
            "queue_change", "started_at_ms", "turn_started_ms", "ts")
    return [{"at": round(at), **{k: e[k] for k in keep if k in e}} for at, e in host.events_since(since, session)]


def seconds(a, b):
    return round((b - a) / 1000.0, 3) if a is not None and b is not None else None


# ---------------------------------------------------------------------------------------------
# The cases
# ---------------------------------------------------------------------------------------------

def case_plain(agent: Agent, n: int) -> dict:
    before = agent.spools()
    sent = agent.send(f"Timing check {n}. Reply with exactly one word: ok")
    ended, first_row, first_reply = watch_turn(agent, sent)
    agent.wait_idle(60)
    found = {"sent": sent, "t_ended": ended}
    spools = new_spools(agent, before)
    marks = spool_marks(spools[0]) if spools else {}
    found["spool"] = marks
    # The end's own activity comes a moment after the state that ended the wait: include it.
    ack, tool_sign, kind = first_activity(agent, sent["t_send"], (ended or now_ms()) + 1000)
    found["measures"] = {
        "host_ack": seconds(sent["t_send"], ack),
        "first_activity": seconds(sent["t_send"], tool_sign),
        "first_activity_kind": kind,
        "first_reply_in_log": seconds(sent["t_send"], first_reply),
        "end_to_end": seconds(sent["t_send"], ended),
        "host_queue": seconds(sent["t_send"], marks.get("made")),
        "launch": seconds(marks.get("made"), marks.get("spawned")),
        "tool_start": seconds(marks.get("spawned"), marks.get("first_out")),
        "tool_ready": seconds(marks.get("spawned"), marks.get("ready")),
        "send_to_spawned": seconds(sent["t_send"], marks.get("spawned")),
        "send_to_ready": seconds(sent["t_send"], marks.get("ready")),
        "send_to_first_output": seconds(sent["t_send"], marks.get("first_out")),
        "model_reply_in_spool": seconds(marks.get("ready"), marks.get("first_reply")),
        "tool_turn_to_host_end": seconds(marks.get("turn_completed"), ended),
        "process_exit_after_end": seconds(ended, marks.get("exited")),
    }
    return found


def case_tool(agent: Agent, n: int) -> dict:
    before = agent.spools()
    sent = agent.send(f"Timing check {n}. Run the shell command `ls` once, then reply with exactly one word: done")
    ended, first_row, first_reply = watch_turn(agent, sent)
    agent.wait_idle(60)
    events = [(at, e) for at, e in agent.host.events_since(sent["t_send"], agent.session)
              if e.get("type") == "agent-activity"]
    # The Host shows a call running, and its end as the next activity of the turn (a finished
    # call is `thinking` with phase `tool_finished`, or whatever the turn does next).
    running = finished = None
    for at, e in events:
        if running is None:
            if e.get("status") == "running" and e.get("tool"):
                running = at
        else:
            finished = at
            break
    spools = new_spools(agent, before)
    marks = spool_marks(spools[0]) if spools else {}
    return {"sent": sent, "t_ended": ended, "spool": marks, "measures": {
        "tool_round_trip_host": seconds(running, finished),
        "tool_round_trip_spool": seconds(marks.get("tool_started"), marks.get("tool_finished")),
        "tool_shown_after_spool": seconds(marks.get("tool_started"), running),
        "tool_end_shown_after_spool": seconds(marks.get("tool_finished"), finished),
        "send_to_tool_shown": seconds(sent["t_send"], running),
        "first_row_in_log": seconds(sent["t_send"], first_row),
        "end_to_end": seconds(sent["t_send"], ended),
        "host_showed_tool": running is not None,
    }}


def case_steer(agent: Agent, n: int) -> dict:
    before = agent.spools()
    sent = agent.send(f"Timing check {n}. Run the shell command `sleep 20`, then reply with exactly one word: slept")
    running, _ = agent.wait_tool_running(sent["t_send"])
    found = {"sent": sent, "t_tool_shown": running}
    if running is None:
        agent.wait_ended(sent["t_send"])
        agent.wait_idle()
        found["measures"] = {"steer_mode": "no_tool_shown"}
        return found
    time.sleep(1.0)
    steer = agent.send("Also add the word steered to your reply.")
    found["steer"] = steer
    seen = None
    first_end = None
    deadline = time.monotonic() + TURN_TIMEOUT
    while time.monotonic() < deadline:
        if first_end is None:
            first_end = agent.wait_ended(sent["t_send"], timeout=0.01)
        if agent.row_seen(steer["client_msg_id"]):
            seen = now_ms()
            break
        time.sleep(0.1)
    # Did its own turn start (a queued send) or did the running turn take it?
    own_start = None
    for at, e in agent.host.events_since(steer["t_send"], agent.session):
        if e.get("type") == "agent-state" and e.get("client_msg_id") == steer["client_msg_id"] \
                and e.get("kind") not in ENDED:
            own_start = at
            break
    if first_end is None:
        first_end = agent.wait_ended(sent["t_send"], timeout=0.01)
    steered = seen is not None and (first_end is None or seen < first_end) and own_start is None
    agent.wait_ended(sent["t_send"], count=1 if steered else 2)
    agent.wait_idle()
    spools = new_spools(agent, before)
    found["spools"] = [spool_marks(p) for p in spools]
    first = found["spools"][0] if found["spools"] else {}
    found["measures"] = {
        "steer_mode": "steered" if steered else ("queued" if seen is not None else "not_seen"),
        "steer_answer_queued": steer["queued"],
        "steer_to_effect": seconds(steer["t_send"], seen),
        "steer_to_read": seconds(steer["t_send"], first.get("steer_read")),
        "steer_to_next_item": seconds(steer["t_send"], first.get("after_steer_item")),
        "steer_wait_for_own_turn": seconds(steer["t_send"], own_start),
        "first_turn_end_after_steer": seconds(steer["t_send"], first_end),
        "turns": len(spools),
    }
    return found


def case_stop(agent: Agent, n: int) -> dict:
    before = agent.spools()
    sent = agent.send(f"Timing check {n}. Run the shell command `sleep 30`, then reply with exactly one word: woke")
    running, _ = agent.wait_tool_running(sent["t_send"])
    found = {"sent": sent, "t_tool_shown": running}
    if running is None:
        agent.wait_ended(sent["t_send"])
        agent.wait_idle()
        found["measures"] = {"stop_mode": "no_tool_shown"}
        return found
    time.sleep(1.0)
    spools = new_spools(agent, before)
    pid = spool_marks(spools[0]).get("pid") if spools else None
    # On a lane the turn's command runs inside the lane's app-server group: note it (the `sleep`
    # asked for) and the lane's other processes, to see the command end and the lane's own stay.
    lane = lane_of(agent, lanes(agent.host)) if agent.row in SETTINGS_OF else None
    commands = commands_of(agent.host, lane, "sleep") if lane is not None else []
    helpers = [m for m in (lane or {}).get("members", []) if m["name"] not in ("sleep", "sh", "bash", "zsh")]
    t_stop = now_ms()
    status, answer = agent.host.ask("POST", "/stop", {"session": agent.session})
    t_answered = now_ms()
    # An exec turn's process ends with the turn. A lane's app-server is meant to stay: once the
    # spool says the turn's attempt exited, it is given three seconds more and then counted kept.
    # The turn's command is watched in the same loop, and looked at again 5 s and 15 s after the
    # Stop: on a lane it must end with the turn, as an exec turn's whole group does.
    gone = exited_at = command_gone = None
    alive_at = {}
    began = time.monotonic()
    while time.monotonic() - began < 40:
        settled = gone is not None or (exited_at is not None and time.monotonic() - exited_at > 3)
        if not settled:
            if pid_gone(pid):
                gone = now_ms()
            elif exited_at is None and spools and spool_marks(spools[0]).get("exited"):
                exited_at = time.monotonic()
        if commands and command_gone is None and not any(alive(c) for c in commands):
            command_gone = now_ms()
        for mark in (5, 15):
            if mark not in alive_at and time.monotonic() - began >= mark:
                alive_at[mark] = any(alive(c) for c in commands)
        # A command that is kept is watched on, up to 40 s, so its lifetime is known too.
        done_with_command = not commands or command_gone is not None
        if settled and done_with_command:
            break
        time.sleep(0.02)
    ended = agent.wait_ended(t_stop, timeout=60)
    agent.wait_idle(60)
    lost = [m["name"] for m in helpers if pid_gone(m["pid"])]
    marks = spool_marks(spools[0]) if spools else {}
    found.update({"t_stop": t_stop, "stop_status": status,
                  "terminated": answer.get("terminated") if isinstance(answer, dict) else None,
                  "spool": marks})
    found["measures"] = {
        "stop_answered": seconds(t_stop, t_answered),
        "stop_to_turn_over": seconds(t_stop, ended),
        "stop_to_process_gone": seconds(t_stop, gone),
        "stop_to_spool_exited": seconds(t_stop, marks.get("exited")),
        "stop_to_signal": seconds(t_stop, marks.get("stopping")),
        "process_kept": gone is None,
    }
    if lane is not None:
        found["measures"].update({
            "stop_to_command_gone": seconds(t_stop, command_gone),
            "command_seen": bool(commands),
            "command_alive_5s": alive_at.get(5, False) if commands else None,
            "command_alive_15s": alive_at.get(15, False) if commands else None,
            "command_kept": (alive_at.get(5, False) or alive_at.get(15, False)) if commands else None,
            "lane_helpers_lost": lost,
        })
    return found


def case_queued(agent: Agent, n: int) -> dict:
    """A second message that waits behind a running turn (sent with `queue_if_busy`, so it waits
    on every backend), and the steps from the first turn's last output to the second turn's
    first activity: the tool's last line, its process gone (the spool's `exited`), the Host
    settling the turn (its ending `agent-state`), the Host starting the next turn (the
    `agent-state` that names the second message), the next spool made, `spawned`, the tool's
    first line, and the first activity the Host shows of it."""
    before = agent.spools()
    # A first turn that writes a list for some seconds, as a person's long answer does, and a
    # second message sent two seconds in.
    sent = agent.send(f"Timing check {n}. Write the numbers from 1 to 50, one per line, each followed by "
                      "the name of a different animal. Nothing else.")
    time.sleep(2.0)
    if agent.wait_ended(sent["t_send"], timeout=0.01) is not None:
        agent.wait_idle()
        return {"sent": sent, "measures": {"queued_mode": "first_turn_ended_early"}}
    second = agent.send("Reply with exactly one word: next", queue_if_busy=True)
    ends = agent.wait_ended(sent["t_send"], count=2)
    agent.wait_idle()
    events = agent.host.events_since(sent["t_send"], agent.session)
    settled = next((at for at, e in events if e.get("type") == "agent-state" and e.get("kind") in ENDED), None)
    started = next((at for at, e in events if e.get("type") == "agent-state"
                    and e.get("client_msg_id") == second["client_msg_id"] and e.get("kind") not in ENDED), None)
    # The Host tells the first turn's end just after it starts the second: the second turn's
    # activity is what comes after its own `thinking` (the one that carries its start time).
    activity = None
    if started is not None:
        opened = False
        for at, e in events:
            if at < started or e.get("type") != "agent-activity":
                continue
            state = e.get("state") or e.get("kind")
            if not opened:
                opened = state == "thinking" and bool(e.get("turn_started_ms"))
                continue
            if state != "thinking" or e.get("phase") == "tool_finished":
                activity = at
                break
    second_end = ends
    spools = new_spools(agent, before)
    first = spool_marks(spools[0]) if spools else {}
    nxt = spool_marks(spools[1]) if len(spools) > 1 else {}
    last_line = None
    if spools:
        outs = [r["t"] for r in read_spool(spools[0]) if r.get("s") == "out"]
        last_line = outs[-1] if outs else None
    found = {"sent": sent, "second": second, "spools": [first, nxt], "t_settled": settled, "t_started": started,
             "t_activity": activity}
    found["measures"] = {
        "queued_mode": "queued" if len(spools) > 1 else ("steered" if spools else "no_spool"),
        "second_answer_queued": second["queued"],
        "last_line_to_exited": seconds(last_line, first.get("exited")),
        "exited_to_settled": seconds(first.get("exited"), settled),
        "settled_to_next_start": seconds(settled, started),
        "next_start_to_spool": seconds(started, nxt.get("made")),
        "spool_to_spawned": seconds(nxt.get("made"), nxt.get("spawned")),
        "spawned_to_first_output": seconds(nxt.get("spawned"), nxt.get("first_out")),
        "first_output_to_activity": seconds(nxt.get("first_out"), activity),
        "last_line_to_next_activity": seconds(last_line, activity),
        "last_line_to_next_spawned": seconds(last_line, nxt.get("spawned")),
        "next_model_reply": seconds(nxt.get("first_out"), nxt.get("first_reply")),
        "last_line_to_next_reply_line": seconds(last_line, nxt.get("first_reply")),
        "last_line_to_next_end": seconds(last_line, second_end),
        "both_ended": ends is not None,
    }
    return found


def case_cold(agent: Agent, n: int) -> dict:
    """A plain turn of a new agent: for a lane, its first turn starts the lane and its thread."""
    fresh = make_agent(agent.host, agent.backend, agent.model, agent.effort, agent.row, f"cold{n}")
    found = case_plain(fresh, n)
    found["agent_id"] = fresh.agent_id
    return found


RUNNERS = {"plain": case_plain, "tool": case_tool, "steer": case_steer, "stop": case_stop, "cold": case_cold,
           "queued": case_queued}

