def tool_programs() -> dict:
    """Where the tools are: the installed Host's own choice when its unit names one, else PATH."""
    found = {}
    try:
        unit = subprocess.run(["systemctl", "--user", "cat", "clarp-host.service"], capture_output=True,
                              text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        unit = ""
    for name in ("CLAUDE", "CODEX", "AGY"):
        match = re.search(rf"^Environment=\"?CLARP_{name}_PROGRAM=([^\"\n]+)", unit, re.M)
        if match and pathlib.Path(match.group(1)).exists():
            found[f"CLARP_{name}_PROGRAM"] = match.group(1)
        elif shutil.which(name.lower()):
            found[f"CLARP_{name}_PROGRAM"] = shutil.which(name.lower())
    match = re.search(r"^Environment=\"PATH=([^\"\n]+)\"", unit, re.M)
    if match:
        found["PATH"] = match.group(1)
    return found


def installed_release() -> str:
    """The release the installed Host runs, as its unit names its skills folder."""
    try:
        unit = subprocess.run(["systemctl", "--user", "cat", "clarp-host.service"], capture_output=True,
                              text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return ""
    match = re.search(r"/releases/([0-9a-f]{7,40})/skills", unit)
    return match.group(1) if match else ""


def own_environment(root: pathlib.Path, secret: str) -> dict:
    """The environment of the disposable Host: the machine's HOME and PATH (the tools' logins),
    nothing of the Clarp session this script may run in, and folders of its own for the rest."""
    env = {key: value for key, value in os.environ.items()
           if not key.startswith(("CLARP_", "CLAUDE_PWA_", "CLAUDE_CODE_", "CODEX_"))
           and key not in ("CLAUDECODE", "CLAUDE_PID", "CLAUDE_EFFORT")}
    env.update(tool_programs())
    config = root / "config"
    env.update({
        "XDG_CONFIG_HOME": str(config),
        "CLARP_CONFIG_DIR": str(config / "clarp-host"),
        "CLAUDE_PWA_CONFIG": str(config / "clarp-host" / "config.toml"),
        "CLARP_SHARE_DIR": str(root / "share"),
        "CLARP_CACHE_DIR": str(root / "share" / "cache"),
        "CLAUDE_PWA_LOG_DIR": str(root / "share" / "logs"),
        "CLAUDE_PWA_DB": str(root / "share" / "no-python-state.sqlite"),
        "CLARP_HOST_TOKEN": secret,
        "CLARP_HEARTBEATS_DISABLED": "1",
    })
    return env


class Host:
    """One disposable Host: started here, spoken to on its own port, stopped by its own pid."""

    def __init__(self, root: pathlib.Path, bin_dir: pathlib.Path):
        self.root, self.bin_dir = root, bin_dir
        self.secret = secrets.token_hex(24)
        self.proc = None
        self.address = ""
        self.events: list = []
        self.events_lock = threading.Lock()
        self.stream_stop = threading.Event()

    def start(self):
        for name in ("data", "run", "config/clarp-host", "share/logs", "ws"):
            (self.root / name).mkdir(parents=True, exist_ok=True)
        binary = self.bin_dir / "clarp-host"
        shim = self.bin_dir / "clarp-shim"
        command = [str(binary), "--data", str(self.root / "data"), "--run", str(self.root / "run"),
                   "--listen", "127.0.0.1:0", "--launcher", "direct", "--shim", str(shim),
                   "--name", "turn-timings", "--cwd", str(self.root / "ws"), "--accounts", "none",
                   "--keep-spools"]
        self.log = open(self.root / "host.log", "w")
        self.proc = subprocess.Popen(command, cwd=self.root, env=own_environment(self.root, self.secret),
                                     stdin=subprocess.DEVNULL, stdout=self.log, stderr=subprocess.STDOUT,
                                     start_new_session=True)
        deadline = time.monotonic() + 60
        while time.monotonic() < deadline and not self.address:
            if self.proc.poll() is not None:
                raise SystemExit(f"the disposable Host exited at start (code {self.proc.returncode}); "
                                 f"see {self.root / 'host.log'}")
            for line in (self.root / "host.log").read_text(errors="replace").splitlines():
                if line.startswith("clarp-host listens on "):
                    self.address = line.split("listens on ", 1)[1].strip()
            time.sleep(0.2)
        if not self.address:
            raise SystemExit("the disposable Host did not say where it listens within a minute")
        threading.Thread(target=self.stream, daemon=True).start()

    def configure(self, settings: dict):
        """The Host's own settings file, in its own configuration folder. The Host reads the
        lane's settings at each turn, so no restart is needed."""
        text = "".join(f"{key} = {value}\n" for key, value in settings.items())
        (self.root / "config" / "clarp-host" / "config.toml").write_text(text)

    def stop(self) -> list:
        """Stop the Host by its own pid (hard rule 6), then whatever it started that outlived it.
        A shim is made to outlive its Host, so the processes still working in the run's folder
        are found by their working directory, captured, and ended by those ids. Says which."""
        self.stream_stop.set()
        if self.proc and self.proc.poll() is None:
            os.kill(self.proc.pid, signal.SIGTERM)
            try:
                self.proc.wait(timeout=20)
            except subprocess.TimeoutExpired:
                os.kill(self.proc.pid, signal.SIGKILL)
                self.proc.wait(timeout=10)
        left = self.processes_in_root()
        for lane in lanes(self):
            left += [pid for pid in [lane["pid"]] + lane["group"] if pid not in left]
        for pid in left:
            try:
                os.kill(pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline and any(not pid_gone(pid) for pid in left):
            time.sleep(0.2)
        for pid in left:
            if not pid_gone(pid):
                try:
                    os.kill(pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
        return left

    def processes_in_root(self) -> list:
        """The ids of this user's processes whose working directory is in the run's folder."""
        found, mine = [], str(self.root)
        for entry in pathlib.Path("/proc").iterdir():
            if not entry.name.isdigit() or int(entry.name) == os.getpid():
                continue
            try:
                if entry.stat().st_uid != os.getuid():
                    continue
                cwd = os.readlink(entry / "cwd")
            except OSError:
                continue
            if cwd == mine or cwd.startswith(mine + "/") or mine in command_line(int(entry.name)):
                found.append(int(entry.name))
        return found

    def ask(self, method: str, path: str, body=None, timeout: float = 30):
        host, port = self.address.rsplit(":", 1)
        conn = http.client.HTTPConnection(host, int(port), timeout=timeout)
        try:
            data = json.dumps(body) if body is not None else None
            conn.request(method, path, data, {"Content-Type": "application/json",
                                              "Authorization": f"Bearer {self.secret}"})
            answer = conn.getresponse()
            raw = answer.read()
            try:
                return answer.status, json.loads(raw)
            except ValueError:
                return answer.status, raw.decode("utf-8", "replace")
        except (OSError, http.client.HTTPException) as failed:
            return 0, str(failed)
        finally:
            conn.close()

    def stream(self):
        """The Host's live events, each kept with the time it arrived here."""
        host, port = self.address.rsplit(":", 1)
        while not self.stream_stop.is_set():
            try:
                conn = http.client.HTTPConnection(host, int(port), timeout=40)
                conn.request("GET", "/events", headers={"Authorization": f"Bearer {self.secret}",
                                                        "Accept": "text/event-stream"})
                answer = conn.getresponse()
                while not self.stream_stop.is_set():
                    line = answer.fp.readline()
                    if not line:
                        break
                    line = line.decode("utf-8", "replace").rstrip("\r\n")
                    if line.startswith("data:"):
                        try:
                            event = json.loads(line[5:].strip())
                        except ValueError:
                            continue
                        if isinstance(event, dict):
                            with self.events_lock:
                                self.events.append((now_ms(), event))
            except (OSError, http.client.HTTPException):
                time.sleep(0.5)

    def events_since(self, t: float, session: str) -> list:
        with self.events_lock:
            return [(at, e) for at, e in self.events if at >= t and e.get("session") == session]


