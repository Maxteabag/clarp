class Agent:
    def __init__(self, host: Host, backend: str, session: str, agent_id: str, row: str = ""):
        self.host, self.backend, self.session, self.agent_id = host, backend, session, agent_id
        self.row = row or backend
        self.sent = 0

    def spool_dir(self) -> pathlib.Path:
        return self.host.root / "data" / "agents" / self.agent_id / "spool"

    def spools(self) -> dict:
        found = {}
        for path in self.spool_dir().glob("*.jsonl"):
            try:
                found[path] = path.stat().st_mtime
            except OSError:
                pass
        return found

    def send(self, text: str, queue_if_busy: bool = False) -> dict:
        self.sent += 1
        client_id = f"tt-{self.backend}-{int(now_ms())}-{self.sent}"
        at = now_ms()
        body = {"session": self.session, "text": text, "client_msg_id": client_id, "synthesize_audio": False}
        if queue_if_busy:
            body["queue_if_busy"] = True
        status, answer = self.host.ask("POST", "/send", body)
        return {"client_msg_id": client_id, "t_send": at, "t_accepted": now_ms(), "status": status,
                "queued": bool(isinstance(answer, dict) and answer.get("queued")),
                "dispatch": answer.get("dispatch") if isinstance(answer, dict) else None,
                "trace_id": answer.get("trace_id") if isinstance(answer, dict) else None}

    def row_seen(self, client_id: str) -> bool:
        status, body = self.host.ask("GET", f"/log?session={urllib.parse.quote(self.session)}&limit=30")
        if status != 200 or not isinstance(body, dict):
            return False
        return any(row.get("id") == f"u-{client_id}" for row in body.get("turns") or [])

    def wait_ended(self, since: float, timeout: float = TURN_TIMEOUT, count: int = 1):
        """The time of the `count`th agent-state that ends a turn after `since`, or None."""
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            ends = [at for at, e in self.host.events_since(since, self.session)
                    if e.get("type") == "agent-state" and e.get("kind") in ENDED]
            if len(ends) >= count:
                return ends[count - 1]
            time.sleep(0.1)
        return None

    def wait_idle(self, timeout: float = TURN_TIMEOUT) -> bool:
        """Nothing runs and nothing waits: the agent is ready for the next case."""
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            status, snap = self.host.ask("GET", "/agents/snapshot")
            row = None
            if status == 200 and isinstance(snap, dict):
                for candidate in snap.get("agents") or []:
                    if candidate.get("session") == self.session:
                        row = candidate
            busy = True
            if row is not None:
                state = (row.get("latest_state") or {}).get("kind") if isinstance(row.get("latest_state"), dict) \
                    else row.get("state")
                busy = bool(row.get("busy")) or state in ("thinking", "working", "responding", "tool")
                busy = busy or bool(row.get("queue_depth"))
            if not busy and not self.live_shim():
                return True
            time.sleep(0.5)
        return False

    def live_shim(self) -> bool:
        """A spool of this agent without `exited`: its tool still runs."""
        for path in self.spools():
            records = read_spool(path)
            if records and not any(r.get("event") == "exited" for r in records if r.get("s") == "shim"):
                if not any(r.get("event") == "spawn-failed" for r in records):
                    return True
        return False

    def wait_tool_running(self, since: float, timeout: float = 90.0):
        """The time the Host first showed a running tool call in this turn, or None: also at once
        when the turn ended without one (the model answered without running the command)."""
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            for at, e in self.host.events_since(since, self.session):
                if e.get("type") == "agent-activity" and e.get("status") == "running" and e.get("tool"):
                    return at, e
                if e.get("type") == "agent-state" and e.get("kind") in ENDED:
                    return None, None
            time.sleep(0.05)
        return None, None


