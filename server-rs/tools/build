#!/usr/bin/env bash
# Compile and test server-rs on the build machine.
# fleet-load-build compiles the release Host for the manual fleet benchmark.
# fleet-load <private-remote-dir> <move|empty|full> runs one time-bounded slice.
# Jobs of different checkouts start at once and run side by side. One checkout's jobs take turns, since they
# share its copy and target there. For a whole landing, use tools/build lease ./landing-driver: while it runs,
# its build commands go before any other job of this checkout started on this machine. CLARP_BUILD_FIRST is
# accepted and changes nothing.
#
#   server-rs/tools/build check            type-check the workspace (the inner loop: seconds once warm)
#   server-rs/tools/build test [args...]   cargo test --workspace [args...], the shim built first
#   server-rs/tools/build clippy           the lint gate, as CI runs it
#   server-rs/tools/build fmt              format the sources in place here (runs rustfmt remotely on a private
#                                          copy, brings back only what it changed; exits 3 when a file it
#                                          formatted was changed here meanwhile and was left alone)
#   server-rs/tools/build voice-timeline-read   time two GETs on a disposable release Host on the build machine
#   server-rs/tools/build snapshot-read    time GET /agents/snapshot with thirty agents on a disposable release Host,
#                                          then the snapshot and artifact list at 310 agents, plain and gzipped
#   server-rs/tools/build wire-read        what one short answer costs a client on the wire (issue 879), on a
#                                          disposable release Host with a stand-in for Claude Code
#   server-rs/tools/build release          build the Host and the shim for release, and bring both home to
#                                          server-rs/dist/ (not committed): what a Host is installed from
#   server-rs/tools/build lease COMMAND [args...]   keep this checkout's builds for a local landing driver
#   server-rs/tools/build status           the jobs running there, by checkout and for how long, the machine's
#                                          load and free build space
#   server-rs/tools/build drop             remove this checkout's copy and its target from the build machine,
#                                          once its branch has landed (a copy is 5 to 14 GB there); waits for
#                                          a job of this checkout still running there
# A build that needs another free-space floor sets CLARP_BUILD_MIN_FREE_BYTES to its own byte count,
# higher or lower.
#
# Peter, 26 Nov 2026: no queue and no arbitrary limits. This script copies this checkout's server-rs/
# to the build machine and runs cargo there at once, at ordinary priority, in that checkout's copy
# with a target directory per checkout, so a second run is incremental. Only a job of the same
# checkout waits, for the copy (build-queue.py's own_copy), which it holds from publishing its
# uploaded sources until what this script fetches is set aside. A checkout's first build
# starts from a reflink clone of the target of the latest checkout whose last build succeeded with
# the Host's library built (build-queue.py's seed_target): the clone shares that target's data on
# disk (du counts it in full for each; df does not), and cargo builds only the workspace's crates
# again. Where the filesystem cannot clone, the first build starts cold.
set -euo pipefail

# 25 Nov 2026 (the owner): all heavy work runs on the ai-swarm build VM (ssh host ecit-buildbox), never on the
# owner's machines. The VM is untrusted: it gets source only, never a secret (skill: buildbox). Its ssh login uses
# the master that `buildbox-cargo status` opens. CLARP_BUILD_HOST still names another host when one is needed.
HOST="${CLARP_BUILD_HOST:-ecit-buildbox}"
case "$HOST" in
    xps15|xps) echo "The XPS is retired (25 Nov 2026): Rust builds on the build VM, the default CLARP_BUILD_HOST=ecit-buildbox" >&2; exit 1 ;;
esac
if [ "$HOST" = ecit-buildbox ]; then
    JOBS="${CLARP_BUILD_JOBS:-12}"
    # The VM's /build is encrypted and locked after each reboot: unlock it (a no-op when it is open), then open the
    # ssh master that the BatchMode logins below reuse.
    if command -v buildbox-cargo >/dev/null 2>&1; then
        buildbox-cargo unlock >/dev/null 2>&1 || true
        buildbox-cargo status >/dev/null 2>&1 || true
    fi
else
    JOBS="${CLARP_BUILD_JOBS:-6}"
fi
# A build frees room (other checkouts' targets not in use, oldest built first) below this much free space. The
# build machine's disk is shared with other builds (Android, since 23 Nov 2026), and at 10 GiB it filled.
floor="${CLARP_BUILD_MIN_FREE_BYTES:-25769803776}" # 24 GiB
# Extra environment for the remote cargo, as NAME=value words. The tests that run a real tool
# only run when asked this way, for example:
#   CLARP_BUILD_ENV="CLARP_TEST_CLAUDE=1" server-rs/tools/build test --test host -- --ignored
EXTRA_ENV="${CLARP_BUILD_ENV:-}"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"           # .../server-rs
name="$(basename "$(dirname "$here")")"                            # the worktree's name keys the remote copy
# The build machine's copies of this version are in .v2, out of the older tools' reach (build-queue.py's ROOT); the
# copy a checkout built before 26 Nov 2026 stays at legacy until it is dropped.
root=/var/tmp/clarp-build/.v2
remote="$root/$name"
legacy="/var/tmp/clarp-build/$name"
# Each invocation uploads to a stage of its own beside the copy (build-queue.py's new_stage), which its job on the
# build machine holds for as long as it lives and publishes into the copy only while it holds the copy. So no other
# machine's upload, fetch or drop, and no later invocation here after this one's client was lost while its job ran
# on, meets the sources a job compiles or what it sets aside.
machine="$(hostname | tr -c 'A-Za-z0-9-\n' -)"
if [ -r /etc/machine-id ]; then machine+="-$(head -c 8 /etc/machine-id)"; fi
# Two checkouts of one name on this machine share that copy (a working tree and the clean checkout a
# landing is built from). One of them at a time uploads its sources and builds: the other waits here.
if [ "${1:-}" = lease ]; then
    shift
    exec python3 "$here/tools/build-queue.py" --drive "$name" "$@"
fi
if [ "${1:-}" != status ]; then
    if [[ -z "${CLARP_BUILD_LEASE:-}" || "${CLARP_BUILD_LEASE_CHECKOUT:-}" != "$name" ]]; then
        exec 9>"/var/tmp/clarp-build-$name.lock"
        flock 9
    fi
    # A step outliving its driver still owns its copy until it finishes.
    exec 8>"/var/tmp/clarp-build-$name.step.lock"
    flock 8
fi
ssh_opts=(-o BatchMode=yes -o ConnectTimeout=15)
# The VM wants a key and a password, so a batch login there only works through the master `buildbox-cargo status`
# opens, which lives under buildbox-cargo's own ControlPath, not ~/.ssh's (review of 25 Nov 2026). rsync follows
# through its -e.
if [ "$HOST" = ecit-buildbox ]; then
    ssh_opts+=(-o "ControlPath=${XDG_STATE_HOME:-$HOME/.local/state}/buildbox-cargo/cm-%C")
fi
cmd="${1:-check}"; shift || true

if [ "$cmd" = status ]; then
    exec ssh "${ssh_opts[@]}" "$HOST" 'echo "load: $(cut -d" " -f1-3 /proc/loadavg)"; python3 - status && df -h --output=avail /var/tmp/clarp-build | tail -1 | xargs printf "build disk: %s free\n"' < "$here/tools/build-queue.py"
fi
if [ "$cmd" = drop ]; then
    # A landed branch's copy is only disk there. This checkout's locks are held (above), and so is its
    # copy's lock there, which a job of this checkout started elsewhere holds while it runs and another
    # checkout's build takes before it frees room in it or clones from it. This machine's stages go too,
    # but for one a job still holds; another machine's stay, with whatever it is uploading or fetching. The copy
    # the older tools made under this name goes as they dropped it, under their eviction lock.
    # The name reaches a remote shell: only a plain checkout name is removed, never a lock or a marker.
    if ! [[ "$name" =~ ^[A-Za-z0-9_-][A-Za-z0-9._-]*$ ]] || [[ "$name" == lock || "$name" == holder || "$name" == *-lock || "$name" == first-* || "$name" == wait-* ]]; then
        echo "refusing to drop a copy under this checkout name: $name" >&2
        exit 2
    fi
    copy_lock="$root/.copy-locks/$name.lock"
    stages="for d in $root/.stage/$name@$machine.????????; do [ ! -d \"\$d\" ] || flock -n \"\$d/.lock\" rm -rf -- \"\$d\" || true; done"
    exec ssh "${ssh_opts[@]}" "$HOST" "mkdir -p $root/.copy-locks && { flock -n $copy_lock true || echo 'waiting for the job of this checkout running there' >&2; } && flock $copy_lock rm -rf -- $remote && { $stages; } && echo 'dropped $remote' && { [ ! -e $legacy ] || { flock /var/tmp/clarp-build/eviction-lock rm -rf -- $legacy && echo 'dropped $legacy'; }; } && df -h --output=avail /var/tmp/clarp-build | tail -1 | xargs printf 'build disk: %s free\\n'"
fi

if ! [[ "$floor" =~ ^(0|[1-9][0-9]*)$ ]] || ! [ "$floor" -ge 0 ] 2>/dev/null; then
    echo "CLARP_BUILD_MIN_FREE_BYTES must be a nonnegative byte count." >&2
    exit 2
fi

case "$cmd" in
    check)  cargo_cmd="cargo check --workspace --all-targets -j $JOBS" ;;
    # The shim a test Host launches its turns through is found beside the Host: build it first,
    # since a test run named by package or file (-p clarp-host --test host) builds no other binary.
    test)   cargo_cmd="cargo build -j $JOBS -p clarp-shim --bins && cargo test --workspace -j $JOBS $(printf '%q ' "$@")" ;;
    clippy) cargo_cmd="cargo clippy --workspace --all-targets --locked --keep-going -j $JOBS -- -D warnings" ;;
    fmt)    cargo_cmd="cargo fmt --all" ;;
    voice-timeline-read)
        cargo_cmd="cargo build --locked --release -j $JOBS -p clarp-host --bin clarp-host && systemd-run --user --scope --quiet -p MemoryMax=8G -p MemorySwapMax=0 unshare --user --map-root-user --net sh -ec 'ip link set lo up; exec python3 tools/measure-voice-timeline.py target/release/clarp-host'"
        ;;
    snapshot-read)
        cargo_cmd="cargo build --locked --release -j $JOBS -p clarp-host --bin clarp-host && systemd-run --user --scope --quiet -p MemoryMax=8G -p MemorySwapMax=0 unshare --user --map-root-user --net sh -ec 'ip link set lo up; exec python3 tools/measure-snapshot.py target/release/clarp-host'"
        ;;
    wire-read)
        cargo_cmd="cargo build --locked --release -j $JOBS -p clarp-host -p clarp-shim --bins && systemd-run --user --scope --quiet -p MemoryMax=8G -p MemorySwapMax=0 unshare --user --map-root-user --net sh -ec 'ip link set lo up; exec python3 tools/measure-wire.py target/release/clarp-host'"
        ;;
    fleet-load-build) cargo_cmd="timeout 175 cargo build --locked --release -j $JOBS -p clarp-host -p clarp-shim --bins" ;;
    fleet-load)
        [[ $# = 2 && $1 == /var/tmp/* && $1 != *$'\n'* && $2 =~ ^(move|empty|full|populate|observe)$ ]] || exit 2
        # A campaign with less than one full slice left may lower its hard timeout.
        slice_seconds="${CLARP_FLEET_SLICE_SECONDS:-170}"
        [[ "$slice_seconds" =~ ^[1-9][0-9]{0,2}$ ]] && (( slice_seconds <= 170 )) || exit 2
        printf -v cargo_cmd '%q ' systemd-run --user --scope --quiet -p MemoryMax=8G -p MemorySwapMax=0 timeout -k 3 "$slice_seconds" unshare --user --map-root-user --net --pid --fork --kill-child --mount-proc sh -ec 'ip link set lo up; exec python3 tools/fleet-load "$@"' fleet-load "$1" "$2"
        ;;
    release) cargo_cmd="cargo build --release -j $JOBS -p clarp-host -p clarp-shim" ;;
    *) echo "usage: build check|test [args]|clippy|fmt|release|status|drop" >&2; exit 2 ;;
esac

# Keep source lines for backtraces without embedding full type and variable
# information in each test executable. Explicit remote Cargo settings win.
job_mode=--build
job_env=
case "$cmd" in
    check|test|clippy)
        # Prepare the target and compile with the same effective profile, including caller overrides.
        job_env="CARGO_PROFILE_DEV_DEBUG=line-tables-only CARGO_PROFILE_TEST_DEBUG=line-tables-only $EXTRA_ENV"
        job_mode=--build-debug
        EXTRA_ENV= ;;
esac

if [ "$cmd" = fmt ]; then
    # fmt formats a copy of its own in a stage of its own, not this checkout's shared copy: another job of
    # the same checkout may publish its tree there while fmt runs, and fmt would then format, and bring home,
    # a tree it was not given. Only what cargo fmt reads goes up: the manifests, the lockfile, a rustfmt.toml
    # and the crates' Rust sources.
    stage=$(ssh "${ssh_opts[@]}" "$HOST" "python3 - stage --bare $name $machine" < "$here/tools/build-queue.py")
    if [[ "$stage" != "$root/.stage/$name@$machine".???????? ]]; then
        echo "could not make a private copy for fmt on $HOST" >&2
        exit 2
    fi
    copy="$stage/fmt"
    ssh "${ssh_opts[@]}" "$HOST" "mkdir $(printf '%q' "$copy")"
    work=$(mktemp -d /var/tmp/clarp-fmt-XXXXXXXX)
    # A fmt job that outlives this client keeps its stage; a later invocation removes it once it has ended.
    trap 'rm -rf -- "$work"; ssh "${ssh_opts[@]}" "$HOST" "flock -n $(printf "%q" "$stage/.lock") rm -rf -- $(printf "%q" "$stage")" || true' EXIT
    rsync -rlp --prune-empty-dirs --exclude target/ --include '*/' --include '*.rs' --include Cargo.toml \
        --include rustfmt.toml --include .rustfmt.toml --exclude '*' \
        -e "ssh ${ssh_opts[*]}" "$here/crates/" "$HOST:$copy/crates/"
    top=("$here/Cargo.toml" "$here/tools/build-queue.py")
    for f in Cargo.lock rustfmt.toml .rustfmt.toml; do
        if [ -e "$here/$f" ]; then top+=("$here/$f"); fi
    done
    rsync -lp -e "ssh ${ssh_opts[*]}" "${top[@]}" "$HOST:$copy/"
    # What fmt was given is hashed in its copy just before it runs, and again after: a file whose
    # hash moved is one fmt changed.
    hashes="find crates -name '*.rs' -type f -print0 | xargs -0 -r sha256sum -z"
    who="${CLAUDE_PWA_SESSION:-$(whoami)}@$(hostname) $name $cmd"
    # fmt builds nothing, so it runs without the build disk's floor, which belongs to a checkout's target.
    printf -v job '%q ' python3 build-queue.py --fmt "$name" "$stage" "$who" bash -c "$hashes > .fmt-sent && CARGO_TERM_COLOR=never $EXTRA_ENV $cargo_cmd && $hashes > .fmt-done"
    ssh "${ssh_opts[@]}" "$HOST" "cd $(printf '%q' "$copy") && exec env $job" || exit $?
    ssh "${ssh_opts[@]}" "$HOST" "cat $(printf '%q' "$copy")/.fmt-sent" > "$work/sent"
    ssh "${ssh_opts[@]}" "$HOST" "cat $(printf '%q' "$copy")/.fmt-done" > "$work/done"
    declare -A sent=()
    while IFS= read -r -d '' line; do sent["${line:66}"]="${line:0:64}"; done < "$work/sent"
    changed=()
    while IFS= read -r -d '' line; do
        p="${line:66}"
        if [[ -v sent["$p"] && "${sent["$p"]}" != "${line:0:64}" ]]; then changed+=("$p"); fi
    done < "$work/done"
    if [ ${#changed[@]} -eq 0 ]; then exit 0; fi
    printf '%s\0' "${changed[@]}" > "$work/list"
    rsync -r --from0 --files-from="$work/list" -e "ssh ${ssh_opts[*]}" "$HOST:$copy/" "$work/formatted/"
    # A formatted file comes home only over the very file that was sent. One edited here since
    # (while fmt ran, say) is left as it is and named, and fmt then exits 3, so
    # a script that formats and then commits stops there. The check is made again just before
    # the formatted file takes the name, which it takes whole, by a rename.
    left=0
    for p in "${changed[@]}"; do
        f="$here/$p"
        now=$(sha256sum < "$f" 2>/dev/null) || now=
        if [ "${now%% *}" = "${sent["$p"]}" ]; then
            tmp="$f.fmt-$$"
            cat "$work/formatted/$p" > "$tmp"
            chmod --reference="$f" "$tmp"
            now=$(sha256sum < "$f" 2>/dev/null) || now=
            if [ "${now%% *}" = "${sent["$p"]}" ]; then
                mv -f -- "$tmp" "$f"
                echo "formatted: server-rs/$p"
                continue
            fi
            rm -f -- "$tmp"
        fi
        echo "changed here since it was sent: not formatted: server-rs/$p" >&2
        left=1
    done
    if [ $left -ne 0 ]; then exit 3; fi
    exit 0
fi

# Everything goes to this invocation's stage; the job puts it in the copy (build-queue.py's publish), by the same rules.
stage=$(ssh "${ssh_opts[@]}" "$HOST" "python3 - stage $name $machine" < "$here/tools/build-queue.py")
if [[ "$stage" != "$root/.stage/$name@$machine".???????? ]]; then
    echo "could not make a stage for the upload on $HOST" >&2
    exit 2
fi
src="$stage/src"
printf -v src_q '%q' "$src"
ssh "${ssh_opts[@]}" "$HOST" "mkdir -p $src_q/server-rs"
# What goes up is what differs in content, and it arrives with the time of its arrival, not with
# the time it has here. cargo decides what to compile by comparing a source's time with the time
# of its last build: a file copied with an older time than that build (another checkout of the
# same name, a file put back as it was) would be passed over, and the build would be of code that
# is no longer there. Seen on 15 Nov 2026: a release was refused for a module the build did not
# know, after the landing checkout and the working tree had taken turns in one copy.
up=(rsync -rlpD --checksum)
"${up[@]}" --delete --exclude target/ --exclude conformance/out/ --exclude dist/ -e "ssh ${ssh_opts[*]}" "$here/" "$HOST:$src/server-rs/"
# The contract's schemas and fixtures sit beside server-rs in the repository; tests read them.
"${up[@]}" --delete -e "ssh ${ssh_opts[*]}" "$here/../contract/" "$HOST:$src/contract/"
# So does the program an agent starts helpers with; a test runs it against the Rust Host.
ssh "${ssh_opts[@]}" "$HOST" "mkdir -p $src_q/skills/clarp-sub-agents $src_q/scripts"
"${up[@]}" --delete --exclude __pycache__ -e "ssh ${ssh_opts[*]}" "$here/../skills/clarp-sub-agents/" "$HOST:$src/skills/clarp-sub-agents/"
# And the program an agent publishes a file with; a test publishes with it.
"${up[@]}" -e "ssh ${ssh_opts[*]}" "$here/../scripts/clarp-media-publish.py" "$HOST:$src/scripts/"
# The background-task test runs the repository's goal launcher.
ssh "${ssh_opts[@]}" "$HOST" "mkdir -p $src_q/skills/clarp-background-jobs/scripts"
"${up[@]}" -e "ssh ${ssh_opts[*]}" "$here/../skills/clarp-background-jobs/scripts/run_detached_job.sh" "$HOST:$src/skills/clarp-background-jobs/scripts/"
who="${CLAUDE_PWA_SESSION:-$(whoami)}@$(hostname) $name $cmd"
# The job gives up its copy before rsync fetches what it set aside in its stage's out/, which only it writes. A
# release's binaries are copies of their own (reflinks where the disk has them), so a later build in the copy, from
# any machine, never changes what is fetched.
out="$stage/out"
if [ "$cmd" = release ]; then
    printf -v out_q '%q' "$out"
    trap 'ssh "${ssh_opts[@]}" "$HOST" "rm -f -- $out_q/clarp-host $out_q/clarp-shim"' EXIT
    cargo_cmd+=" && cp --reflink=auto target/release/clarp-host target/release/clarp-shim $out_q/"
fi
set +e
printf -v job '%q ' python3 tools/build-queue.py "$job_mode" "$floor" "$name" "$stage" "$who" bash -c "CARGO_TERM_COLOR=never $EXTRA_ENV $cargo_cmd"
ssh "${ssh_opts[@]}" "$HOST" "cd $src_q/server-rs && exec env $job_env $job"
code=$?
set -e
if [ "$cmd" = release ] && [ $code -eq 0 ]; then
    mkdir -p "$here/dist"
    rsync -a -e "ssh ${ssh_opts[*]}" "$HOST:$out/clarp-host" "$HOST:$out/clarp-shim" "$here/dist/"
    (cd "$here/dist" && sha256sum clarp-host clarp-shim > SHA256SUMS && git -C "$here" rev-parse HEAD > COMMIT)
fi
# The lockfile is made by the first build; bring it home so it is committed.
rsync -a -e "ssh ${ssh_opts[*]}" "$HOST:$out/Cargo.lock" "$here/Cargo.lock" 2>/dev/null || true
exit $code
