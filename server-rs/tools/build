#!/usr/bin/env bash
# Compile and test server-rs on the build machine, one job at a time.
# fleet-load-build compiles the release Host for the manual fleet benchmark.
# fleet-load <private-remote-dir> <move|empty|full> runs one time-bounded slice.
# Set CLARP_BUILD_FIRST=1 for a single priority step. For a whole landing, use
# tools/build lease ./landing-driver; its build and repo-gates commands inherit the reservation.
# If the driver's machine disappears, its lease can last until SSH detects the disconnect (about two hours).
# To release the reservation sooner, end the keeper PID shown by build status on the build machine.
#
#   server-rs/tools/build check            type-check the workspace (the inner loop: seconds once warm)
#   server-rs/tools/build test [args...]   cargo test --workspace [args...], the shim built first
#   server-rs/tools/build clippy           the lint gate, as CI runs it
#   server-rs/tools/build fmt              format the sources in place here (runs rustfmt remotely, copies back)
#   server-rs/tools/build conform [args]   build the Host and compare it with the Python Host's written-down
#                                          answers (server-rs/conformance); starts only the Rust Host
#   server-rs/tools/build answers [args]   build the Host, run the corpus against it and bring home what it
#                                          answered, compared with nothing: for a scenario without a reference yet
#   server-rs/tools/build voice-timeline-read   time two GETs on a disposable release Host on the build machine
#   server-rs/tools/build snapshot-read    time GET /agents/snapshot with thirty agents on a disposable release Host
#   server-rs/tools/build release          build the Host and the shim for release, and bring both home to
#                                          server-rs/dist/ (not committed): what a Host is installed from
#   server-rs/tools/build lease COMMAND [args...]   reserve the queue while a local landing driver runs
#   server-rs/tools/build status           who holds the queue, the machine's load and free build space
# A build that needs more free space sets CLARP_BUILD_MIN_FREE_BYTES to its required byte count.
#
# Peter, 15 Nov 2026: Rust for the Host compiles on the XPS 15, never on elitebook or laptopstudio,
# and never several builds at once. This script is that rule: it copies this checkout's server-rs/
# to the build machine, waits for the one build slot (flock), and runs cargo there at lowest priority
# with a target directory per checkout, so a second run is incremental.
set -euo pipefail

HOST="${CLARP_BUILD_HOST:-xps15}"
JOBS="${CLARP_BUILD_JOBS:-6}"
floor="${CLARP_BUILD_MIN_FREE_BYTES:-10737418240}" # 10 GiB
# Extra environment for the remote cargo, as NAME=value words. The tests that run a real tool
# only run when asked this way, for example:
#   CLARP_BUILD_ENV="CLARP_TEST_CLAUDE=1" server-rs/tools/build test --test host -- --ignored
EXTRA_ENV="${CLARP_BUILD_ENV:-}"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"           # .../server-rs
name="$(basename "$(dirname "$here")")"                            # the worktree's name keys the remote copy
remote="/var/tmp/clarp-build/$name"
# Two checkouts of one name share that copy (a working tree and the clean checkout a landing is
# built from). One of them at a time copies its sources and builds: the other waits here, so
# that nothing is built from the sources of both.
if [ "${1:-}" = lease ]; then
    shift
    exec python3 "$here/tools/build-queue.py" --drive "$HOST" "$name" "${CLAUDE_PWA_SESSION:-$(whoami)} $name" "$@"
fi
if [ "${1:-}" != status ]; then
    if [[ -z "${CLARP_BUILD_LEASE:-}" || "${CLARP_BUILD_LEASE_CHECKOUT:-}" != "$name" ]]; then
        exec 9>"/var/tmp/clarp-build-$name.lock"
        flock 9
    fi
    # A step outliving its driver still owns its copy until it finishes.
    exec 8>"/var/tmp/clarp-build-$name.step.lock"
    flock 8
fi
ssh_opts=(-o BatchMode=yes -o ConnectTimeout=15)
cmd="${1:-check}"; shift || true

if [ "$cmd" = status ]; then
    exec ssh "${ssh_opts[@]}" "$HOST" 'echo "load: $(cut -d" " -f1-3 /proc/loadavg)"; python3 - status && df -h --output=avail /var/tmp/clarp-build | tail -1 | xargs printf "build disk: %s free\n"' < "$here/tools/build-queue.py"
fi

if ! [[ "$floor" =~ ^(0|[1-9][0-9]*)$ ]] || ! [ "$floor" -ge 0 ] 2>/dev/null; then
    echo "CLARP_BUILD_MIN_FREE_BYTES must be a nonnegative byte count." >&2
    exit 2
fi

case "$cmd" in
    check)  cargo_cmd="cargo check --workspace --all-targets -j $JOBS" ;;
    # The shim a test Host launches its turns through is found beside the Host: build it first,
    # since a test run named by package or file (-p clarp-host --test host) builds no other binary.
    test)   cargo_cmd="cargo build -j $JOBS -p clarp-shim --bins && cargo test --workspace -j $JOBS $(printf '%q ' "$@")" ;;
    clippy) cargo_cmd="cargo clippy --workspace --all-targets --keep-going -j $JOBS -- -D warnings" ;;
    fmt)    cargo_cmd="cargo fmt --all" ;;
    conform) cargo_cmd="cargo build -j $JOBS -p clarp-host -p clarp-shim && rm -rf conformance/out && python3 conformance/conform.py compare --rust target/debug/clarp-host --out conformance/out $(printf '%q ' "$@")" ;;
    answers) cargo_cmd="cargo build -j $JOBS -p clarp-host -p clarp-shim && rm -rf conformance/out && python3 conformance/conform.py rust --rust target/debug/clarp-host --out conformance/out $(printf '%q ' "$@")" ;;
    voice-timeline-read)
        cargo_cmd="cargo build --locked --release -j $JOBS -p clarp-host --bin clarp-host && systemd-run --user --scope --quiet -p MemoryMax=8G -p MemorySwapMax=0 unshare --user --map-root-user --net sh -ec 'ip link set lo up; exec python3 tools/measure-voice-timeline.py target/release/clarp-host'"
        ;;
    snapshot-read)
        cargo_cmd="cargo build --locked --release -j $JOBS -p clarp-host --bin clarp-host && systemd-run --user --scope --quiet -p MemoryMax=8G -p MemorySwapMax=0 unshare --user --map-root-user --net sh -ec 'ip link set lo up; exec python3 tools/measure-snapshot.py target/release/clarp-host'"
        ;;
    fleet-load-build) cargo_cmd="timeout 175 cargo build --locked --release -j $JOBS -p clarp-host -p clarp-shim --bins" ;;
    fleet-load)
        [[ $# = 2 && $1 == /var/tmp/* && $1 != *$'\n'* && $2 =~ ^(move|empty|full|populate|observe)$ ]] || exit 2
        # A campaign with less than one full slice left may lower its hard timeout.
        slice_seconds="${CLARP_FLEET_SLICE_SECONDS:-170}"
        [[ "$slice_seconds" =~ ^[1-9][0-9]{0,2}$ ]] && (( slice_seconds <= 170 )) || exit 2
        printf -v cargo_cmd '%q ' systemd-run --user --scope --quiet -p MemoryMax=8G -p MemorySwapMax=0 timeout -k 3 "$slice_seconds" unshare --user --map-root-user --net --pid --fork --kill-child --mount-proc sh -ec 'ip link set lo up; exec python3 tools/fleet-load "$@"' fleet-load "$1" "$2"
        ;;
    release) cargo_cmd="cargo build --release -j $JOBS -p clarp-host -p clarp-shim" ;;
    *) echo "usage: build check|test [args]|clippy|fmt|conform [args]|answers [args]|release|status" >&2; exit 2 ;;
esac

# Keep source lines for backtraces without embedding full type and variable
# information in each test executable. Explicit remote Cargo settings win.
queue_mode=--build
queue_env=
case "$cmd" in
    check|test|clippy|conform|answers)
        # Admit and compile with the same effective profile, including caller overrides.
        queue_env="CARGO_PROFILE_DEV_DEBUG=line-tables-only CARGO_PROFILE_TEST_DEBUG=line-tables-only $EXTRA_ENV"
        queue_mode=--build-debug
        EXTRA_ENV= ;;
esac

ssh "${ssh_opts[@]}" "$HOST" "mkdir -p $remote/server-rs"
# What goes up is what differs in content, and it arrives with the time of its arrival, not with
# the time it has here. cargo decides what to compile by comparing a source's time with the time
# of its last build: a file copied with an older time than that build (another checkout of the
# same name, a file put back as it was) would be passed over, and the build would be of code that
# is no longer there. Seen on 15 Nov 2026: a release was refused for a module the build did not
# know, after the landing checkout and the working tree had taken turns in one copy.
up=(rsync -rlpD --checksum)
"${up[@]}" --delete --exclude target/ --exclude conformance/out/ --exclude dist/ -e "ssh ${ssh_opts[*]}" "$here/" "$HOST:$remote/server-rs/"
# The contract's schemas and fixtures sit beside server-rs in the repository; tests read them.
"${up[@]}" --delete -e "ssh ${ssh_opts[*]}" "$here/../contract/" "$HOST:$remote/contract/"
# So does the program an agent starts helpers with; a test runs it against the Rust Host.
ssh "${ssh_opts[@]}" "$HOST" "mkdir -p $remote/skills/clarp-sub-agents $remote/scripts"
"${up[@]}" --delete --exclude __pycache__ -e "ssh ${ssh_opts[*]}" "$here/../skills/clarp-sub-agents/" "$HOST:$remote/skills/clarp-sub-agents/"
# And the program an agent publishes a file with; a test publishes with it.
"${up[@]}" -e "ssh ${ssh_opts[*]}" "$here/../scripts/clarp-media-publish.py" "$HOST:$remote/scripts/"
# The background-task test runs the repository's goal launcher.
ssh "${ssh_opts[@]}" "$HOST" "mkdir -p $remote/skills/clarp-background-jobs/scripts"
"${up[@]}" -e "ssh ${ssh_opts[*]}" "$here/../skills/clarp-background-jobs/scripts/run_detached_job.sh" "$HOST:$remote/skills/clarp-background-jobs/scripts/"
if [ "$cmd" = conform ] || [ "$cmd" = answers ]; then
    # The conformance driver is the replay harness run against the Rust Host: it needs the
    # harness, and the server's source for the words its report may print.
    ssh "${ssh_opts[@]}" "$HOST" "mkdir -p $remote/tests/replay $remote/server"
    rsync -a --delete --exclude __pycache__ -e "ssh ${ssh_opts[*]}" "$here/../tests/replay/" "$HOST:$remote/tests/replay/"
    rsync -a --delete --exclude __pycache__ -e "ssh ${ssh_opts[*]}" "$here/../server/" "$HOST:$remote/server/"
fi
who="${CLAUDE_PWA_SESSION:-$(whoami)}@$(hostname) $name $cmd"
# Cargo releases the slot before rsync fetches the binaries. Keep links for the
# transfer so a later build can evict this target without interrupting the fetch.
if [ "$cmd" = release ]; then
    export_dir=$(ssh "${ssh_opts[@]}" "$HOST" "mktemp -d $remote/.release-XXXXXXXX")
    trap 'ssh "${ssh_opts[@]}" "$HOST" "rm -f -- $export_dir/clarp-host $export_dir/clarp-shim && rmdir -- $export_dir"' EXIT
    cargo_cmd+=" && ln target/release/clarp-host target/release/clarp-shim $export_dir/"
fi
set +e
printf -v queued '%q ' "CLARP_BUILD_LEASE=${CLARP_BUILD_LEASE:-}" "CLARP_BUILD_FIRST=${CLARP_BUILD_FIRST:-0}" python3 tools/build-queue.py "$queue_mode" "$floor" "$who" bash -c "CARGO_TERM_COLOR=never $EXTRA_ENV nice -n 19 ionice -c3 $cargo_cmd"
ssh "${ssh_opts[@]}" "$HOST" "cd $remote/server-rs && exec env $queue_env $queued"
code=$?
set -e
if [ "$cmd" = fmt ] && [ $code -eq 0 ]; then
    rsync -a --exclude target/ --exclude Cargo.lock -e "ssh ${ssh_opts[*]}" "$HOST:$remote/server-rs/crates/" "$here/crates/"
fi
if [ "$cmd" = release ] && [ $code -eq 0 ]; then
    mkdir -p "$here/dist"
    rsync -a -e "ssh ${ssh_opts[*]}" "$HOST:$export_dir/clarp-host" "$HOST:$export_dir/clarp-shim" "$here/dist/"
    (cd "$here/dist" && sha256sum clarp-host clarp-shim > SHA256SUMS && git -C "$here" rev-parse HEAD > COMMIT)
fi
if [ "$cmd" = conform ] || [ "$cmd" = answers ]; then
    # What the Rust Host answered, to read beside what is written down (not committed).
    rsync -a --delete -e "ssh ${ssh_opts[*]}" "$HOST:$remote/server-rs/conformance/out/" "$here/conformance/out/" 2>/dev/null || true
fi
# The lockfile is made by the first build; bring it home so it is committed.
rsync -a -e "ssh ${ssh_opts[*]}" "$HOST:$remote/server-rs/Cargo.lock" "$here/Cargo.lock" 2>/dev/null || true
exit $code
