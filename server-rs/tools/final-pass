#!/usr/bin/env bash
# The one final pass before the Rust Host is installed (issue 704; Peter's rule of 22 Nov 2026: "skip long checks in
# iOS and all other things", a few minutes at most). The focused tests of what Peter touches all the time (sending,
# Stop, the queue: stop, paused, delivery), run once in one call of the build tool (the test compile included, one
# slot of the build machine's queue), under one hard time budget of five minutes. The list is here and nowhere else, so nothing an agent adds can extend the pass. The test compile
# cannot be shared with the release build: the two use different profiles and share no compiled artifacts, and the
# build machine runs one build at a time.
#
# A failing check blocks the install. A pass that runs over its budget blocks it too, and names the test binary that
# was running when the budget ran out, to be moved to the post-release job. The release build and the install are outside the budget: they are the
# build, not checks. The conformance run, the planted rules, the whole Rust suite and the Python Host's critical tests
# and guards run after the release, as a job someone starts by hand that the install never waits for; what they find
# ships as a follow-up.
#
#   server-rs/tools/final-pass
#
# Runs on the checkout's HEAD through server-rs/tools/build (its environment settings apply). Exit 0: every check
# passed within the budget. Exit 1: a check failed. Exit 2: the pass ran over its budget.
set -u
here="$(cd "$(dirname "$0")/.." && pwd)"
checks=(stop paused delivery)
budget_seconds=300

log="$(mktemp)"
trap 'rm -f "$log"' EXIT
start=$(date +%s)
echo "final pass on $(git -C "$here" rev-parse HEAD) from $(date +%H:%M:%S): ${checks[*]} in one run; budget ${budget_seconds} s"
timeout --kill-after=30 "$budget_seconds" "$here/tools/build" test -- "${checks[@]}" 2>&1 | tee "$log"
code=${PIPESTATUS[0]}
took=$(($(date +%s) - start))
echo "checks=${checks[*]} exit=$code seconds=$took"
if [ "$code" = 124 ] || [ "$code" = 137 ]; then
    running=$(grep -E '^[[:space:]]*Running ' "$log" | tail -1 | sed -E 's/^[[:space:]]*Running //')
    echo "over budget after ${took} s, in ${running:-the compile}: move it to the post-release job; the install is blocked"
    exit 2
fi
if [ "$code" != 0 ]; then
    echo "a check failed: the install is blocked"
    exit 1
fi
echo "final pass green in ${took} s"
