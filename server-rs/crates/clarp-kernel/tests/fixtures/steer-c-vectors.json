{
  "streams": [
    {
      "name": "ordinary answer",
      "steps": [
        {
          "event": {
            "type": "user",
            "isReplay": true,
            "uuid": "one"
          },
          "can_offer": true,
          "echo": "one"
        },
        {
          "event": {
            "type": "stream_event",
            "parent_tool_use_id": null,
            "event": {
              "type": "content_block_start",
              "content_block": {
                "type": "text"
              }
            }
          },
          "can_offer": true,
          "echo": null
        },
        {
          "event": {
            "type": "result",
            "is_error": false,
            "user_message_uuids": [
              "one"
            ]
          },
          "can_offer": false,
          "echo": null
        }
      ]
    },
