    "codex",
    "agy",
    "grok",
    "opencode",
    "deepseek",
    "muse"
   ],
   "options": [
    {
     "key": "interval_seconds",
     "label": "Check interval (seconds)",
     "type": "integer",
     "default": 300,
     "min": 60,
     "max": 86400
    },
    {
     "key": "remaining_threshold",
     "label": "Notify at remaining percent",
     "type": "integer",
     "default": 25,
     "min": 0,
     "max": 100
    },
    {
     "key": "recovery_mode",
     "label": "Account recovery",
     "type": "choice",
     "default": "notify",
     "choices": [
      {
       "value": "notify",
       "label": "Notify only"
      },
      {
       "value": "ask",
       "label": "Ask before recovery"
      },
      {
       "value": "automatic",
       "label": "Use configured runtime account selector"
      }
     ]
    },
    {
     "key": "max_interval_seconds",
     "label": "Longest interval when idle (seconds)",
     "type": "integer",
     "default": 0,
     "min": 0,
     "max": 604800,
     "description": "Each run that finds nothing to do doubles the wait, up to this; a run that does something returns to the configured interval. 0 keeps the interval fixed."
    }
   ]
  },
  {
