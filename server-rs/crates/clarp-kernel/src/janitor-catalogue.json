{
 "templates": [
  {
   "id": "heartbeat-decider",
   "name": "Heartbeat keeper",
   "description": "Decide whether, when and how an idle agent should continue current commitments.",
   "recommended_backend": "codex",
   "recommended_model": "gpt-6-sol",
   "recommended_effort": "low",
   "allowed_effects": [
    "heartbeat_decision"
   ],
   "creatable": true,
   "supported_trigger_ids": [
    "heartbeat-decision-requested"
   ],
   "default_trigger_id": "heartbeat-decision-requested",
   "supported_providers": [
    "openai",
    "claude",
    "codex",
    "agy",
    "grok",
    "opencode",
    "deepseek",
    "muse"
   ],
   "options": [
    {
     "key": "review_interval_seconds",
     "label": "Minimum review interval (seconds)",
     "type": "integer",
     "default": 300,
     "min": 60,
     "max": 86400
    },
    {
     "key": "timeout_ms",
     "label": "Decision timeout (milliseconds)",
     "type": "integer",
     "default": 30000,
     "min": 1000,
     "max": 120000
    }
   ]
  },
  {
   "id": "quota-monitor",
   "name": "Quota keeper",
   "description": "Monitor provider quota, notify and coordinate authorized runtime account recovery.",
   "recommended_backend": "codex",
   "recommended_model": "gpt-6-sol",
   "recommended_effort": "low",
   "allowed_effects": [
    "quota_monitor"
   ],
   "creatable": true,
   "supported_trigger_ids": [
    "quota-check-requested"
   ],
   "default_trigger_id": "quota-check-requested",
   "supported_providers": [
    "openai",
