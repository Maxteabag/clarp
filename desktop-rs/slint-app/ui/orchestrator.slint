import { Palette, Look } from "theme.slint";
import { ComboBox, Slider, SpinBox, Switch } from "std-widgets.slint";
import { Field, Editor } from "fields.slint";
import { Modal } from "dialogs.slint";
import { IconButton, Busy } from "agent_controls.slint";

// The orchestrator dialog's fields (set from the Host's settings when they
// load) and commands.
export global OrchestratorBridge {
    in-out property <bool> enabled;
    in-out property <bool> fallback-only: true;
    in-out property <float> confidence: 0.78;
    in-out property <int> provider-index;
    in-out property <int> effort-index;
    in-out property <string> model;
    in-out property <int> timeout-ms: 30000;
    in property <bool> loading;
    in property <bool> loaded;
    in property <string> last-decision;
    in property <[string]> providers: ["openai", "claude", "codex", "agy"];
    // The first effort is the provider's own (QML's empty entry).
    in property <[string]> efforts: ["default", "minimal", "low", "medium", "high", "xhigh"];
    in property <bool> reduced-motion;
    callback close();
    callback save();
}

// OrchestratorDialog.qml: whether and how a routing model resolves
// delegations that name matching cannot.
export component OrchestratorDialog inherits Modal {
    card-width: 590px;
    card-height: 600px;
    dismissed => { OrchestratorBridge.close(); }
    // The panel's own surface (Theme.raised), under the card's contents.
    Rectangle {
        x: 1px;
        y: 1px;
        width: Math.min(root.card-width, root.width - 40px) - 2px;
        height: Math.min(root.card-height, root.height - 40px) - 2px;
        border-radius: 3px;
        background: Palette.raised;
    }
    VerticalLayout {
        padding: 28px;
        spacing: 11px;
        HorizontalLayout {
            spacing: 8px;
            // i18n: Orchestrator dialog (Orchestrator is a feature name, left as is: a model that routes requests to agents), title
            Text { text: @tr("Orchestrator"); color: Palette.text; font-size: 17 * Look.unit; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
            if OrchestratorBridge.loading: Busy { reduced-motion: OrchestratorBridge.reduced-motion; }
            // i18n: Orchestrator dialog, tooltip of the close button at the top (verb)
            IconButton { icon: @image-url("icons/close.svg"); tip: @tr("Close"); clicked => { OrchestratorBridge.close(); } }
        }
        HorizontalLayout {
            spacing: 8px;
            // i18n: Orchestrator dialog, accessibility label of the switch that turns AI routing on (noun: an AI model picks which agent gets a request)
            Switch { checked <=> OrchestratorBridge.enabled; accessible-label: @tr("AI routing"); }
            // i18n: Orchestrator dialog, label beside the switch that turns AI routing on (noun)
            Text { text: @tr("AI routing"); color: Palette.chrome-text; font-size: 12 * Look.unit; vertical-alignment: center; horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 8px;
            // i18n: Orchestrator dialog, accessibility label of the switch: use AI routing only when name matching finds no agent
            Switch { checked <=> OrchestratorBridge.fallback-only; accessible-label: @tr("Fallback only"); }
            // i18n: Orchestrator dialog, label beside the switch: use AI routing only when name matching finds no agent
            Text { text: @tr("Fallback only"); color: Palette.chrome-text; font-size: 12 * Look.unit; vertical-alignment: center; horizontal-stretch: 1; }
        }
        Text {
            // i18n: Orchestrator dialog, label over the slider (noun: how sure the routing model must be); {} is the value, 0.50 to 0.99
            text: @tr("Confidence  {}", Math.round(OrchestratorBridge.confidence * 100) / 100);
            color: Palette.chrome-text;
            font-size: 12 * Look.unit;
        }
        Slider {
            minimum: 0.5;
            maximum: 0.99;
            step: 0.01;
            value <=> OrchestratorBridge.confidence;
            // i18n: Orchestrator dialog, accessibility label of the confidence slider (noun)
            accessible-label: @tr("Confidence");
        }
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                // i18n: Orchestrator dialog, label over the list of AI providers (noun)
                Text { text: @tr("Provider"); color: Palette.chrome-text; font-size: 12 * Look.unit; }
                // i18n: Orchestrator dialog, accessibility label of the AI provider list (noun)
                ComboBox { model: OrchestratorBridge.providers; current-index <=> OrchestratorBridge.provider-index; accessible-label: @tr("Provider"); }
            }
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                // i18n: Orchestrator dialog, label over the reasoning effort list (noun: how hard the model thinks)
                Text { text: @tr("Effort"); color: Palette.chrome-text; font-size: 12 * Look.unit; }
                // i18n: Orchestrator dialog, accessibility label of the reasoning effort list (noun)
                ComboBox { model: OrchestratorBridge.efforts; current-index <=> OrchestratorBridge.effort-index; accessible-label: @tr("Effort"); }
            }
        }
        // i18n: Orchestrator dialog, label over the field that names a model to use instead of the provider's default (noun)
        Text { text: @tr("Model override"); color: Palette.chrome-text; font-size: 12 * Look.unit; }
        Field {
            text <=> OrchestratorBridge.model;
            // i18n: Orchestrator dialog, placeholder of the model override field: empty means the provider's default model (noun/adjective)
            placeholder-text: @tr("Default");
            // i18n: Orchestrator dialog, accessibility label of the model override field (noun)
            accessible-label: @tr("Model override");
        }
        // i18n: Orchestrator dialog, label over the timeout box (noun); ms is milliseconds
        Text { text: @tr("Timeout (ms)"); color: Palette.chrome-text; font-size: 12 * Look.unit; }
        HorizontalLayout {
            alignment: start;
            SpinBox {
                width: 160px;
                minimum: 250;
                maximum: 60000;
                step-size: 250;
                value <=> OrchestratorBridge.timeout-ms;
                // i18n: Orchestrator dialog, accessibility label of the timeout box (noun); ms is milliseconds
                accessible-label: @tr("Timeout (ms)");
            }
        }
        if OrchestratorBridge.last-decision != "": Rectangle {
            border-radius: 2px;
            background: Palette.window;
            VerticalLayout {
                padding: 9px;
                // i18n: Orchestrator dialog, line at the bottom; {} is what the routing model decided last (which agent it picked and why)
                Text { text: @tr("Last decision: {}", OrchestratorBridge.last-decision); color: Palette.muted; font-size: 11 * Look.unit; wrap: word-wrap; }
            }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            // i18n: Orchestrator dialog, tooltip of the button that closes without saving (verb)
            IconButton { icon: @image-url("icons/close.svg"); tip: @tr("Cancel"); clicked => { OrchestratorBridge.close(); } }
            IconButton {
                icon: @image-url("icons/save.svg");
                // i18n: Orchestrator dialog, tooltip of the save button (verb)
                tip: @tr("Save");
                enabled: OrchestratorBridge.loaded && !OrchestratorBridge.loading;
                clicked => { OrchestratorBridge.save(); }
            }
        }
    }
}
