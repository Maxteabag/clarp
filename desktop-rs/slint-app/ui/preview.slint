import { Button } from "std-widgets.slint";
import { Palette, Focus, FocusRing, Look, ChromeText } from "theme.slint";
import { Modal } from "dialogs.slint";

export struct PreviewVersion {
    hash: string,
    label: string,
}

// PreviewVersionPanel.qml: the worktree preview's builds; choosing one
// pins it and reopens the window on the same Host and conversation.
// i18n-screen: preview versions
export component PreviewPanel inherits Modal {
    in property <[PreviewVersion]> versions;
    in property <bool> can-restart: true;
    in property <bool> busy;
    in property <bool> pinned;
    in property <string> error;
    in property <string> notice;
    in-out property <int> current;
    callback choose(string);
    callback done();
    public function open() { keys.focus(); }
    card-width: 620px;
    card-height: 520px;
    dismissed => { root.done(); }
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.DownArrow) { root.current = Math.min(root.current + 1, root.versions.length - 1); return accept; }
            if (event.text == Key.UpArrow) { root.current = Math.max(root.current - 1, 0); return accept; }
            if (event.text == Key.Return && root.can-restart && !root.busy && root.current >= 0 && root.current < root.versions.length) {
                root.choose(root.versions[root.current].hash);
                return accept;
            }
            reject
        }
        VerticalLayout {
            padding: 22px;
            spacing: 12px;
            // i18n: preview versions window (pick which preview build of the app to run), title
            Text { text: @tr("Preview versions"); color: Palette.text; font-size: 17 * Look.unit; }
            if !root.can-restart: Text {
                font-size: ChromeText.body;
                // i18n: preview versions window, warning when agents are still working and the app cannot restart yet
                text: @tr("Finish active tasks before switching versions.");
                color: Palette.warning;
                wrap: word-wrap;
            }
            // i18n: preview versions window, status line: the app is held at one version, so automatic updates are paused
            if root.pinned: Text { font-size: ChromeText.body; text: @tr("Pinned · updates paused"); color: Palette.warning; }
            VerticalLayout {
                vertical-stretch: 1;
                spacing: 4px;
                alignment: start;
                for version[index] in root.versions: Rectangle {
                    height: 34px;
                    border-radius: 3px;
                    background: index == root.current && keys.has-focus ? Focus.cursor : Palette.border;
                    opacity: root.busy || !root.can-restart ? 0.5 : 1;
                    Text { font-size: ChromeText.body; x: 10px; text: version.label; color: Palette.text; vertical-alignment: center; }
                    TouchArea {
                        enabled: !root.busy && root.can-restart;
                        clicked => { root.current = index; root.choose(version.hash); }
                    }
                }
            }
            if root.error != "": Text { font-size: ChromeText.body; text: root.error; color: Palette.danger; wrap: word-wrap; }
            if root.notice != "": Text { font-size: ChromeText.body; text: root.notice; color: Palette.success; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 8px;
                Button {
                    // i18n: preview versions window, button: switch to the newest version and turn automatic updates back on
                    text: @tr("Latest · resume updates");
                    enabled: !root.busy && root.can-restart;
                    clicked => { root.choose("latest"); }
                }
                Rectangle { horizontal-stretch: 1; }
                // i18n: preview versions window, button (verb): close the window; "Esc" is the key that does the same, a key name left as is
                Button { text: @tr("Close · Esc"); clicked => { root.done(); } }
            }
        }
    }
}

// The line over the window when a newer preview is installed, it is
// pinned, or the updater failed.
export component PreviewBanner inherits Rectangle {
    in property <string> update-label;
    in property <bool> pinned;
    in property <string> error;
    in property <bool> can-update;
    callback update();
    callback versions();
    height: 36px;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        Text {
            font-size: ChromeText.body;
            text: root.error != "" ? root.error
                // i18n: banner over the main window when a newer preview build is installed (noun phrase)
                : root.update-label != "" ? @tr("Update available")
                // i18n: banner over the main window: the app is held at one preview version, so automatic updates are paused
                : @tr("Pinned · updates paused");
            color: root.error != "" ? Palette.danger : Palette.muted;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.update-label != "": Button {
            // i18n: banner over the main window, button (verb): update to the new preview version; {} is its version label; Ctrl+Alt+U is the shortcut, key names left as is
            text: @tr("Update {} · Ctrl+Alt+U", root.update-label);
            enabled: root.can-update;
            clicked => { root.update(); }
        }
        // i18n: banner over the main window, button: opens the preview versions window (noun, plural)
        Button { text: @tr("Versions…"); clicked => { root.versions(); } }
    }
}

// PreviewVersionWindow.qml: `--preview-versions`, the manager on its own.
export component PreviewWindow inherits Window {
    in property <[PreviewVersion]> versions;
    in property <bool> busy;
    in property <bool> pinned;
    in property <string> error;
    in property <string> notice;
    in-out property <int> current;
    callback choose(string);
    callback done();
    // i18n: preview versions window, the window's title in the window manager; Clarp is the product name
    title: @tr("Clarp preview versions");
    preferred-width: 660px;
    preferred-height: 560px;
    background: Palette.raised;
    default-font-family: "JetBrains Mono";
    panel := PreviewPanel {
        versions: root.versions;
        busy: root.busy;
        pinned: root.pinned;
        error: root.error;
        notice: root.notice;
        current <=> root.current;
        choose(hash) => { root.choose(hash); }
        done => { root.done(); }
    }
    init => { panel.open(); }
}
