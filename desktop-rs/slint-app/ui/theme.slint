// The reading theme's colours (set from Rust per theme), like Theme.qml.
export global Palette {
    in property <color> window: #1a1b26;
    in property <color> raised: #20212e;
    in property <color> sunken: #12131a;
    in property <color> control: #292b3a;
    in property <color> hover: #22232f;
    in property <color> border: #41445a;
    in property <color> rule: #303342;
    in property <color> text: #e7e1dc;
    in property <color> chrome-text: #c0caf5;
    in property <color> muted: #8f96bc;
    in property <color> faint: #8085a0;
    in property <color> accent: #bb9af7;
    // The focused pane's frame (the theme's "focus", else its accent).
    in property <color> focus: #bb9af7;
    in property <color> accent-text: #1a1b26;
    in property <color> bubble: #20212e;
    in property <color> success: #9ece6a;
    in property <color> warning: #e0af68;
    in property <color> danger: #c98a98;
    in property <color> danger-surface: #2b2028;
    in property <color> link: #7aa2f7;
    // A working row's shimmer per tone (live_view::shimmer_colours): its
    // letters rest at the low colour and the glow passing through brings
    // them to the high one.
    in property <color> shimmer-accent-low: #a587d9;
    in property <color> shimmer-accent-high: #d4c2f0;
    in property <color> shimmer-muted-low: #7980a2;
    in property <color> shimmer-muted-high: #c0bdd0;
    in property <length> body-size: 15px;
    in property <string> body-family: "JetBrains Mono";
    // Code blocks and tool output: the reader's own font when it is
    // monospace, else JetBrains Mono.
    in property <string> code-family: "JetBrains Mono";
}

// What the chats show and animate, set from Rust: the live status line
// (Settings, off by default), Reduce Motion, and whether the window is on
// screen at all (covered or minimised: nothing animates).
export global ChatLook {
    in property <bool> live-status-line;
    in property <bool> reduced-motion;
    in property <bool> window-shown: true;
    // Settings → Send animation (on by default): a sent message flies from
    // the composer to its place in the chat.
    in property <bool> send-animation: true;
}

// A send as it is drawn (workspace.slint): how its animations move, the
// grace period before an unsent message or a queued send says so (Rust's
// SEND_STATUS_GRACE), and the last send's animation, for the checks: its
// row, "flight" (the text flies to the bubble), "settle" (landed: the
// bubble shows under the copy as it fades), "fade" (the bubble fades in)
// or "" once it is over, where it started and where it is (in the window).
// The numbers are the iPhone's (clarp-ios 7bdc0d3), so both move alike.
export global SendFlight {
    // The flight: a spring of 0.32 s with a little bounce (SwiftUI's
    // spring(duration:bounce:)), from the composer field's shape (radius
    // 24, no wash) to the bubble's.
    out property <duration> flight: 320ms;
    out property <float> flight-bounce: 0.12;
    out property <length> from-radius: 24px;
    // Landed, the copy fades over the real bubble.
    out property <duration> settle: 140ms;
    // The composer clears and shrinks with a 0.3 s spring (no bounce).
    out property <duration> composer: 300ms;
    out property <float> composer-bounce: 0;
    // Reduce Motion, and a send that cannot fly: a plain fade.
    out property <duration> fade: 200ms;
    in property <duration> status-grace: 1750ms;
    in-out property <string> id;
    in-out property <string> phase;
    in-out property <int> started;
    in-out property <int> landed;
    in-out property <length> from-x;
    in-out property <length> from-y;
    in-out property <length> from-width;
    in-out property <length> from-height;
    // Each frame of the animation: how far it is (0 to 1, sprung), the
    // flying text's box and the composer's height.
    in-out property <float> progress;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <length> width;
    in-out property <length> height;
    in-out property <length> composer-height;
}

// The reader's own look (Settings → Typography and Layout; clarp_core::prefs),
// set from Rust (look.rs). The defaults are the window as it was before any
// of it was a setting.
export global Look {
    // Interface text: a label written "12 * Look.unit" is 12px at 100%.
    in property <length> unit: 1px;
    // Code blocks' size relative to the message text.
    in property <float> code-scale: 0.9;
    // Between a message's paragraphs, lists, code and headings.
    in property <length> paragraph-spacing: 8px;
    // A top-level heading's size relative to the text (smaller levels follow).
    in property <float> heading-scale: 1.4;
    // The longest line of message text, 0px for the pane's width.
    in property <length> measure: 0px;
    in property <int> weight: 400;
    // Extra padding per side of list rows: compact < 0 < spacious.
    in property <length> density-pad: 0px;
    in property <length> explorer-width: 320px;
    // The widest your own bubble gets, as a share of the chat.
    in property <float> bubble-share: 0.75;
    in property <length> message-spacing: 14px;
    in property <length> pane-gap: 4px;
    in property <length> border-width: 1.5px;
    in property <length> focus-border-width: 2.5px;
    in property <length> radius: 6px;
    in property <length> scrollbar-width: 3px;
    // "auto", "always" or "never".
    in property <string> scrollbar: "auto";
    // New rows keep the chat at its end while the reader is there.
    in property <bool> follow: true;
    // Up/Down's step in the chat.
    in property <length> line-step: 40px;
    // Changes whenever something that changes a row's height does, so the
    // chat measures its rows again.
    in property <int> generation;
    // Settings → Chat zoom: the chats' text, code, cards and spacing, apart
    // from the window's own scale; "120%" for a moment as it changes.
    in property <float> zoom: 1.0;
    in property <string> zoom-note;
    // Ctrl is down (Ctrl+wheel over a chat zooms it).
    in-out property <bool> ctrl-held;
    // Ctrl+wheel: a step in (1) or out (-1).
    callback zoom-by(int);
}

// The chat rows' sizes: tool calls, live rows, the Worked-for fold,
// reasoning, plans, receipts, prompts, cards and their stamps and names.
// They follow the reading size (Font size × Chat zoom), not Interface
// size, each at the ratio it had to the default theme's 15px text: a tool
// row's 12px beside 15px text stays 0.8 of it at any size.
export global ChatText {
    // The message text itself.
    out property <length> body: Palette.body-size * Look.zoom;
    // How far the reading size is from the default's 15px: a row's marks,
    // avatars, line heights and padding that sit against its text.
    out property <float> scale: Palette.body-size * Look.zoom / 15px;
    // A receipt's question, a card's title (14px beside 15px).
    out property <length> lead: Palette.body-size * Look.zoom * 14 / 15;
    // A live row's label, reasoning and plan lines, a prompt's line (13).
    out property <length> label: Palette.body-size * Look.zoom * 13 / 15;
    // Tool rows, explanations, a live row's time and second line, the
    // activity toggle, names (12).
    out property <length> detail: Palette.body-size * Look.zoom * 12 / 15;
    // Stamps, output tails, tool details, "more" lines (11).
    out property <length> note: Palette.body-size * Look.zoom * 11 / 15;
    // A receipt's or card's kind line (10).
    out property <length> caption: Palette.body-size * Look.zoom * 10 / 15;
    // A card's smallest label (9).
    out property <length> tiny: Palette.body-size * Look.zoom * 9 / 15;
}

// The chrome's own text (explorer, tabs, panels, Ctrl+K, settings, the
// status bar, dialogs and overlays): Interface size, never Font size, which
// is the chat's reading text and the composer's alone. The window's default
// size, so a chrome text without its own size takes it too.
export global ChromeText {
    out property <length> body: 15 * Look.unit;
}

// Where the keyboard is: the keyboard map's state (commands::context), set
// from Rust with the shortcut bar. Every region that owns a state draws the
// one FocusRing when it is the one; lists mark their cursor with Cursor.
export global Focus {
    in property <string> mode: "pane";
    out property <color> cursor: Palette.accent.with-alpha(0.16);
}

// Vim mode: its mode ("" while it is off) and the chat row its cursor is on.
export global VimBridge {
    in property <string> mode;
    in property <string> cursor;
}

// The focus style: a ring over the region the keyboard is in. Place it last
// in the region so it draws on top (it fills its parent unless placed); it
// takes no input.
export component FocusRing inherits Rectangle {
    in property <bool> shown;
    border-width: root.shown ? Math.max(1px, Look.focus-border-width - 0.5px) : 0px;
    border-color: Palette.focus;
    border-radius: Look.radius;
}

// A keyboard region as sqlit draws its panes: a rounded grey outline with
// "[key] Label" set into the top-left of the border; the outline and title
// take the accent while the region has the keyboard. Place it last in the
// region (it fills it) and keep the content FRAME-INSET inside.
export global Frame {
    out property <length> top: 16px;
    out property <length> side: 6px;
    out property <length> bottom: 6px;
}

export component PaneFrame inherits Rectangle {
    in property <string> key;
    in property <string> label;
    in property <bool> active;
    // What shows behind the title, so it cuts the border line.
    in property <color> surface: Palette.window;
    // An optional title on the right of the border: a name (clickable) and
    // muted details, as the chat frame shows its agent.
    in property <string> info-name;
    in property <string> info;
    callback info-clicked();
    property <color> tone: root.active ? Palette.focus : Palette.border;
    // Thicker when focused, so which pane has the keyboard shows by width
    // as well as colour.
    Rectangle {
        x: 0;
        y: 7px;
        width: root.width;
        height: root.height - 7px;
        border-width: root.active ? Look.focus-border-width : Look.border-width;
        border-color: root.tone;
        border-radius: Look.radius;
    }
    Rectangle {
        x: 10px;
        y: 0;
        width: title.preferred-width + 8px;
        height: 14px;
        background: root.surface;
        title := Text {
            x: 4px;
            height: parent.height;
            text: "[" + root.key + "] " + root.label;
            color: root.active ? Palette.focus : Palette.muted;
            font-size: 11 * Look.unit;
            font-weight: root.active ? 700 : 400;
            vertical-alignment: center;
        }
    }
    // Sized from its two texts' own widths (not from a layout sized by
    // this box, which could settle on a stale width and leave the title
    // mid-border with the line missing after it).
    property <length> info-gap: root.info-name != "" && root.info != "" ? 6px : 0px;
    property <length> info-room: Math.max(0px, root.width - 40px - 2 * 10px - 60px);
    property <length> info-want: (root.info-name != "" ? name-text.preferred-width : 0px) + root.info-gap + (root.info != "" ? info-text.preferred-width : 0px);
    if root.info-name != "" || root.info != "": Rectangle {
        width: Math.min(root.info-want, root.info-room) + 8px;
        height: 14px;
        x: root.width - self.width - 10px;
        y: 0;
        background: root.surface;
    }
    name-text := Text {
        visible: root.info-name != "";
        x: root.width - 10px - 4px - Math.min(root.info-want, root.info-room);
        y: 0;
        height: 14px;
        width: Math.min(self.preferred-width, root.info-room);
        text: root.info-name;
        color: name-touch.has-hover ? Palette.accent : Palette.chrome-text;
        font-size: 11 * Look.unit;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: button;
        accessible-label: "Agent profile";
        name-touch := TouchArea { mouse-cursor: pointer; clicked => { root.info-clicked(); } }
    }
    info-text := Text {
        visible: root.info != "";
        x: name-text.x + (root.info-name != "" ? name-text.width : 0px) + root.info-gap;
        y: 0;
        height: 14px;
        width: Math.max(0px, root.width - 10px - 4px - self.x);
        text: root.info;
        color: Palette.muted;
        font-size: 11 * Look.unit;
        vertical-alignment: center;
        overflow: elide;
    }
}
