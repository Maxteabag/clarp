import { ListView } from "std-widgets.slint";
import { Field, Editor } from "fields.slint";
import { Palette, Focus, FocusRing, Frame, PaneFrame, Look, ChatLook, ChromeText, RevealText, Motion } from "theme.slint";
import { CompactWork, ProcessIndicator } from "processes.slint";
import { ProfileBridge } from "profile.slint";
import { AgentAvatar, AvatarArt } from "avatar.slint";

export struct ChatRow {
    session: string,
    name: string,
    initial: string,
    stamp: string,
    preview: string,
    activity: string,
    depth: int,
    queued: int,
    queue-paused: bool,
    busy: bool,
    unread: bool,
    muted: bool,
    selected: bool,
    // Background work (ProcessIndicator.qml): jobs, sub-agents, helpers.
    jobs: int,
    sub-agents: int,
    children: int,
    // What runs, as both views count it (view.rs `running_work`): running
    // sub-agents and helpers, and background processes.
    running-helpers: int,
    running-processes: int,
    // The agent's portrait (empty until made), a pair room's two in one.
    portrait: image,
    // Snoozed: until when ("14:30", "next message"; triage.rs), else "".
    snoozed: string,
    // Finished helpers folded under this row ("N helpers done").
    done-parent: string,
    done-count: int,
    done-expanded: bool,
    // Its place in the Ctrl+J queue (1 is next), or 0.
    queue: int,
    // A working agent's name, letter by letter, for the shimmer.
    letters: [string],
    // Sub-agents under this row, and whether they are folded away.
    fold-count: int,
    folded: bool,
    // An archived agent: Restore instead of opening.
    archived: bool,
    // Its Host badge ("Show the Host on each chat", #651), "" for none.
    host: string,
    // "Moved to <Host>" for an agent that moved (Host contract 125).
    moved: string,
}

// A chat row's right-click menu: snooze (or wake) the chat. Rust fills
// the choices for `session` when it opens (triage.rs); "" is closed.
export struct RowChoice {
    value: string,
    label: string,
}

export global RowMenu {
    in-out property <string> session;
    in property <string> title;
    in property <[RowChoice]> choices;
    // Where it opens, in the explorer.
    in-out property <length> x;
    in-out property <length> y;
    callback opened(string);
    callback pick(string, string);
}

// A small labelled toggle, like the QML scope chips; `count` after the
// label when above 0.
component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    in property <int> count;
    property <string> words: root.count > 0 ? root.label + " " + root.count : root.label;
    callback clicked();
    height: 24px;
    width: text.preferred-width + 14px;
    border-radius: 12px;
    background: root.on ? Palette.accent : touch.has-hover ? Palette.hover : Palette.control;
    accessible-role: button;
    accessible-label: root.words;
    accessible-checked: root.on;
    accessible-action-default => { root.clicked(); }
    text := Text {
        text: root.words;
        color: root.on ? Palette.accent-text : Palette.chrome-text;
        font-size: 12 * Look.unit;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// One entry row ("Agent conversations", "Archived") that swaps the list.
component ListSwitch inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <string> count;
    in property <int> unread;
    callback clicked();
    height: 36px;
    background: touch.has-hover ? Palette.hover : transparent;
    touch := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        Text { font-size: ChromeText.body; text: root.glyph; color: Palette.muted; vertical-alignment: center; }
        Text { font-size: ChromeText.body; text: root.label; color: Palette.chrome-text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        if root.unread > 0: Rectangle {
            width: 20px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            background: Palette.accent;
            Text { text: root.unread; color: Palette.accent-text; font-size: 11 * Look.unit; }
        }
        Text { text: root.count; color: Palette.faint; font-size: 12 * Look.unit; vertical-alignment: center; }
    }
}

component Row inherits Rectangle {
    in property <ChatRow> chat;
    // The keyboard cursor is on this row.
    in property <bool> cursor;
    // Compact explorer: the avatar and the name only.
    in property <bool> compact;
    in property <bool> reduced-motion;
    // Shown and scrolled into view: its process spinner may turn.
    in property <bool> on-screen: true;
    property <bool> shimmering: root.chat.busy && !root.reduced-motion && ChatLook.window-shown && root.chat.letters.length > 0;
    // The cursor is here and the list is bringing it into view: its place
    // in the list (again as the list places the row), to scroll it there.
    in property <bool> seeking;
    callback reveal(length, length);
    property <string> cursor-place: root.cursor && root.seeking ? (root.y / 1px) + ":" + (root.height / 1px) : "";
    changed cursor-place => { if (self.cursor && self.seeking) { root.reveal(self.y, self.height); } }
    init => { if (self.cursor && self.seeking) { root.reveal(self.y, self.height); } }
    callback clicked();
    // A right-click: where, in the window.
    callback menu(length, length);
    // The process indicator was clicked: its bottom right, in the window.
    callback processes(length, length);
    callback done-toggled(string);
    callback fold-toggled();
    callback restore();
    // The avatar's line: room for the avatar size chosen.
    property <length> top-height: root.compact ? Math.max(40px, AvatarArt.compact + 8px) : Math.max(58px, AvatarArt.row + 16px);
    // Settings → Density pads it above and below.
    height: (root.compact
        ? root.top-height
        : root.top-height + (root.chat.activity != "" ? 14px : 0px) + (root.chat.done-count > 0 ? 22px : 0px)) + 2 * Look.density-pad;
    opacity: root.chat.archived ? 0.65 : 1;
    background: root.cursor ? Focus.cursor : root.chat.selected ? Palette.control : touch.has-hover ? Palette.hover : transparent;
    accessible-role: list-item;
    // "Rachel on laptopstudio" when the row names its Host (as on iOS).
    accessible-label: root.chat.host != "" ? root.chat.name + " on " + root.chat.host : root.chat.name;
    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    HorizontalLayout {
        padding-left: 10px + root.chat.depth * 18px;
        padding-right: 10px;
        spacing: 10px;
        // Made round at its device size in Rust (a pair room's two in one).
        AgentAvatar {
            size: root.compact ? AvatarArt.compact : AvatarArt.row;
            y: (root.top-height - self.height) / 2 + Look.density-pad;
            portrait: root.chat.portrait;
            name: root.chat.name;
            initial: root.chat.initial;
            initial-color: Palette.chrome-text;
            // Working, or next in the attention queue.
            ringed: root.chat.busy || root.chat.queue > 0;
            ring-color: root.chat.queue > 0 ? Palette.accent : Palette.success;
        }
        VerticalLayout {
            padding-top: (root.compact ? (root.top-height - 20px) / 2 : 8px) + Look.density-pad;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                // The attention queue: 1 is where Ctrl+J goes next.
                if root.chat.queue > 0: Rectangle {
                    width: Math.max(16px, number.preferred-width + 8px);
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 8px;
                    background: root.chat.queue == 1 ? Palette.accent : Palette.accent.with-alpha(0.25);
                    accessible-role: text;
                    accessible-label: "Next attention, number " + root.chat.queue;
                    number := Text {
                        text: root.chat.queue;
                        color: root.chat.queue == 1 ? Palette.accent-text : Palette.accent;
                        font-size: 10 * Look.unit;
                        font-weight: 700;
                    }
                }
                // A working agent's name is green, and a glow travels through
                // its letters (still green, with Reduce Motion). Scrolled out
                // of view the glow holds still (the phase only: the row's
                // layout must not depend on where it is).
                if !root.shimmering: Text {
                    font-size: ChromeText.body;
                    text: root.chat.name;
                    color: root.chat.busy ? Palette.success : Palette.chrome-text;
                    font-weight: root.chat.unread || root.chat.busy ? 700 : 500;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.shimmering: shimmer := Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    clip: true;
                    // The glow's centre runs a little past both ends.
                    property <float> phase: root.on-screen ? Math.mod(Motion.spin / 1800ms, 1.0) * 1.6 - 0.3 : -0.3;
                    property <int> count: root.chat.letters.length;
                    HorizontalLayout {
                        alignment: start;
                        spacing: 0px;
                        for letter[i] in root.chat.letters: Text {
                            font-size: ChromeText.body;
                            property <float> at: (i + 0.5) / shimmer.count;
                            property <float> glow: Math.max(0, 1 - Math.abs(self.at - shimmer.phase) * 4);
                            text: letter;
                            color: Palette.success.mix(#ffffff, 1 - self.glow * 0.75);
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
                // Background jobs and sub-agents, each its own icon; Right
                // unfolds the sub-agents' chats into the list.
                if !root.compact: ProcessIndicator {
                    y: 3px;
                    only: "jobs";
                    jobs: root.chat.running-processes;
                    running: root.on-screen;
                    clicked => { root.processes(self.absolute-position.x + self.width, self.absolute-position.y + self.height); }
                }
                if !root.compact: ProcessIndicator {
                    y: 3px;
                    only: "agents";
                    children: root.chat.running-helpers;
                    clicked => { root.processes(self.absolute-position.x + self.width, self.absolute-position.y + self.height); }
                }
                // Compact has no preview line: a snoozed row's "z" sits here.
                if root.compact && root.chat.snoozed != "": Text {
                    text: "z";
                    color: Palette.faint;
                    font-size: 11 * Look.unit;
                    vertical-alignment: center;
                    accessible-role: text;
                    accessible-id: "row-snoozed";
                    accessible-label: "Snoozed until " + root.chat.snoozed;
                }
                // Compact: a glyph and a count per kind, after the name, which
                // elides to make room.
                if root.compact && root.chat.running-helpers > 0: CompactWork {
                    y: (parent.height - self.height) / 2;
                    kind: "agent";
                    count: root.chat.running-helpers;
                    clicked => { root.processes(self.absolute-position.x + self.width, self.absolute-position.y + self.height); }
                }
                if root.compact && root.chat.running-processes > 0: CompactWork {
                    y: (parent.height - self.height) / 2;
                    kind: "process";
                    count: root.chat.running-processes;
                    running: root.on-screen;
                    clicked => { root.processes(self.absolute-position.x + self.width, self.absolute-position.y + self.height); }
                }
                // The Host badge: a capsule in the time's colour on a faint
                // fill of it, before the time; the name elides first.
                if !root.compact && root.chat.host != "": Rectangle {
                    horizontal-stretch: 0;
                    min-width: badge-text.preferred-width + 12px;
                    height: badge-text.preferred-height + 4px;
                    y: 1px;
                    border-radius: self.height / 2;
                    background: Palette.faint.with-alpha(0.12);
                    accessible-role: text;
                    accessible-id: "row-host";
                    accessible-label: root.chat.host;
                    badge-text := Text {
                        x: 6px;
                        text: root.chat.host;
                        color: Palette.faint;
                        font-size: 11 * Look.unit;
                    }
                }
                // A snoozed row says until when in place of its time, so
                // the preview below keeps its full width.
                if !root.compact && root.chat.snoozed == "": Text { text: root.chat.stamp; color: Palette.faint; font-size: 11 * Look.unit; }
                if !root.compact && root.chat.snoozed != "": Text {
                    horizontal-stretch: 0;
                    text: "z " + root.chat.snoozed;
                    color: Palette.faint;
                    font-size: 11 * Look.unit;
                    accessible-role: text;
                    accessible-id: "row-snoozed";
                    accessible-label: "Snoozed until " + root.chat.snoozed;
                }
            }
            if !root.compact: HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.chat.preview;
                    color: Palette.muted;
                    font-size: 12 * Look.unit;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.chat.muted: Text { text: "⊘"; color: Palette.faint; font-size: 12 * Look.unit; }
                if root.chat.queued > 0: RevealText { text: root.chat.queued + (root.chat.queue-paused ? " queued · paused" : " queued"); color: Palette.warning; font-size: 11 * Look.unit; }
                if root.chat.unread: Rectangle {
                    width: 8px;
                    height: 8px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 4px;
                    background: Palette.accent;
                }
            }
            if !root.compact && root.chat.moved != "": Text {
                text: root.chat.moved;
                color: Palette.faint;
                font-size: 11 * Look.unit;
                overflow: elide;
                accessible-role: text;
                accessible-id: "row-moved";
                accessible-label: root.chat.moved;
            }
            if !root.compact && root.chat.activity != "": Text {
                text: root.chat.activity;
                color: Palette.warning;
                font-size: 11 * Look.unit;
                overflow: elide;
            }
            if !root.compact && root.chat.done-count > 0: Rectangle {
                height: 20px;
                accessible-role: button;
                accessible-label: root.chat.done-count + " helpers done";
                Text {
                    x: 0;
                    text: (root.chat.done-expanded ? "▾ " : "▸ ") + root.chat.done-count + (root.chat.done-count == 1 ? " helper done" : " helpers done");
                    color: done-touch.has-hover ? Palette.muted : Palette.faint;
                    font-size: 11 * Look.unit;
                }
                done-touch := TouchArea { clicked => { root.done-toggled(root.chat.done-parent); } }
            }
        }
        if root.chat.archived: Rectangle {
            width: 30px;
            height: 30px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: restore-touch.has-hover ? Palette.hover : transparent;
            accessible-role: button;
            accessible-label: "Restore " + root.chat.name;
            Image { source: @image-url("icons/restore.svg"); width: 16px; height: 16px; colorize: Palette.muted; }
            restore-touch := TouchArea { clicked => { root.restore(); } }
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <[ChatRow]> rows;
    in property <[ChatRow]> rooms;
    in property <[ChatRow]> archived;
    in property <int> unread-rooms;
    // The triage chips' counts: working, needing you, snoozed.
    in property <int> triage-working;
    in property <int> triage-needs;
    in property <int> triage-snoozed;
    // Empty while the agent list is current; else when it is from and that
    // it is retrying, with why in `roster-note-detail`.
    in property <string> roster-note;
    in property <string> roster-note-detail;
    in-out property <bool> showing-pairs;
    in-out property <bool> showing-archive;
    in-out property <string> scope: "all";
    out property <string> query: search.text;
    out property <bool> search-has-focus: search.has-focus;
    in property <string> cursor;
    out property <bool> list-has-focus: list.has-focus;
    // The pointer is over the list. While it is, or the list has the
    // keyboard, the app keeps the rows' order and rows change only in place.
    out property <bool> pointer-in-list: hover.has-hover;
    public function focus-list() { list.focus(); }
    // The All/Unread chips, as a click does.
    public function choose-scope(scope: string) { root.scope = scope; root.filter-changed(); }
    // The archive list, as its row's click does.
    public function show-archive(on: bool) { root.showing-archive = on; root.showing-pairs = false; }
    // The agent-to-agent rooms, as their switch's click does.
    public function show-pairs(on: bool) { root.showing-pairs = on; root.showing-archive = false; }
    callback chosen(string);
    callback processes(string, length, length);
    callback filter-changed();
    callback restore(string);
    callback done-toggled(string);
    callback fold-toggled(string);
    callback hide();
    callback new-agent();
    // Where `session` is in the list shown ("chats", "rooms" or "archived"),
    // or -1.
    pure callback row-index(string, string) -> int;
    // Minimal UI hides the hide button (Ctrl+B still works).
    in property <bool> minimal;
    in property <bool> compact;
    // The search shows only while in use: / opens it, and leaving it empty
    // hides it again.
    property <bool> searching;
    property <bool> search-focus: search.has-focus;
    changed search-focus => { if (!self.search-focus && search.text == "") { root.searching = false; } }
    public function focus-search() { root.searching = true; search.focus(); }
    public function clear-search() { search.text = ""; root.searching = search.has-focus; root.filter-changed(); }
    background: Palette.raised;
    property <string> shown-kind: root.showing-pairs ? "rooms" : root.showing-archive ? "archived" : "chats";
    property <[ChatRow]> shown: root.showing-pairs ? root.rooms : root.showing-archive ? root.archived : root.rows;
    // The cursor's row reveals itself once the list has made it. The list
    // makes only the rows in view, so for one it has not (J past the last
    // row in view, a cursor far down) it scrolls there by its estimate of
    // the rows' heights, a frame at a time, until the row is made. Then the
    // row's own report (where it is, `cursor-placed`) puts it in view.
    property <string> cursor-drawn;
    property <string> cursor-placed;
    property <length> cursor-y;
    property <length> cursor-h;
    property <bool> revealing: list.has-focus && root.visible && root.cursor != "" && root.cursor-drawn != root.cursor;
    property <int> reveal-ticks;
    changed revealing => { root.reveal-ticks = 0; }
    changed shown-kind => { root.cursor-drawn = ""; }
    Timer {
        interval: 16ms;
        running: root.revealing;
        triggered => {
            root.reveal-ticks += 1;
            if (root.cursor-placed == root.cursor) {
                if (root.cursor-y + flick.content-y >= -0.5px && root.cursor-y + root.cursor-h + flick.content-y <= flick.visible-height + 0.5px) {
                    root.cursor-drawn = root.cursor;
                } else if (root.cursor-y + flick.content-y < 0px) {
                    flick.content-y = -root.cursor-y;
                } else {
                    flick.content-y = flick.visible-height - root.cursor-y - root.cursor-h;
                }
                return;
            }
            let index = root.row-index(root.cursor, root.shown-kind);
            // As long as the transcript's seek (120 frames): on slow frames
            // 30 gave up before the list had made the row, and the cursor
            // stayed out of view for good.
            if (index < 0 || root.reveal-ticks > 120) {
                root.cursor-drawn = root.cursor;
                return;
            }
            // The list places row n at about n times the rows' average
            // height: just into view by that, or, once that has not made
            // it, in the middle.
            let each = flick.content-height / Math.max(1, root.shown.length);
            let top = index * each;
            let y = top + flick.content-y < 0px ? -top
                : top + each + flick.content-y > flick.visible-height ? flick.visible-height - top - each
                : root.reveal-ticks > 2 ? -(top - (flick.visible-height - each) / 2)
                : flick.content-y;
            flick.content-y = Math.max(Math.min(0px, flick.visible-height - flick.content-height), Math.min(0px, y));
        }
    }
    // The [e] Explorer frame holds the whole sidebar: search, New agent,
    // scope and the list.
    property <bool> explorer-active: Focus.mode == "sidebar" || Focus.mode == "search";
    VerticalLayout {
        padding-top: 2px + Frame.top;
        padding-left: 8px;
        padding-right: 8px;
        padding-bottom: 8px + Frame.bottom;
        spacing: 8px;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            vertical-stretch: 0;
            spacing: 6px;
            visible: root.searching || search.text != "";
            height: self.visible ? 34px : 0px;
            Rectangle {
                height: 34px;
                horizontal-stretch: 1;
                opacity: root.explorer-active ? 1 : 0.45;
                min-width: 0px;
                search := Field {
                    width: parent.width;
                    height: parent.height;
                    placeholder-text: root.compact ? "Search" : "Search agents · /";
                    edited => { root.filter-changed(); }
                }
                FocusRing { shown: Focus.mode == "search"; }
            }
            // Hide sidebar and New agent are keys (Ctrl+B, Ctrl+N) in the
            // shortcut bar, not buttons.
        }
        // Minimal UI keeps the list alone: scope, rooms and the archive stay
        // in Ctrl+K.
        // Triage: Working, Needs you and Done split the fleet by where each
        // chat stands; Snoozed lists the chats put off (triage.rs). Chips
        // that do not fit the explorer's width wrap onto the next line, so
        // none is ever cut.
        if !root.minimal: scopes := Rectangle {
            vertical-stretch: 0;
            property <length> gap: 4px;
            property <length> line: 26px;
            property <length> room: self.width - 20px;
            // Each chip follows the one before it, or starts a new line.
            property <length> x1: c0.x + c0.width + self.gap;
            property <bool> w1: self.x1 + c1.width > self.room;
            property <length> x2: (self.w1 ? 0px : self.x1) + c1.width + self.gap;
            property <bool> w2: self.x2 + c2.width > self.room;
            property <length> x3: (self.w2 ? 0px : self.x2) + c2.width + self.gap;
            property <bool> w3: self.x3 + c3.width > self.room;
            property <length> x4: (self.w3 ? 0px : self.x3) + c3.width + self.gap;
            property <bool> w4: self.x4 + c4.width > self.room;
            property <length> x5: (self.w4 ? 0px : self.x4) + c4.width + self.gap;
            property <bool> w5: self.x5 + c5.width > self.room;
            property <int> l1: self.w1 ? 1 : 0;
            property <int> l2: self.l1 + (self.w2 ? 1 : 0);
            property <int> l3: self.l2 + (self.w3 ? 1 : 0);
            property <int> l4: self.l3 + (self.w4 ? 1 : 0);
            property <int> l5: self.l4 + (self.w5 ? 1 : 0);
            height: (self.l5 + 1) * self.line - 2px;
            accessible-role: AccessibleRole.list;
            accessible-id: "explorer-scopes";
            Rectangle {
                x: 10px;
                width: scopes.room;
                c0 := Chip { x: 0px; y: 0px; label: "All"; on: root.scope == "all"; clicked => { root.choose-scope("all"); } }
                c1 := Chip { x: scopes.w1 ? 0px : scopes.x1; y: scopes.l1 * scopes.line; label: "Needs you"; count: root.triage-needs; on: root.scope == "needs-you"; accessible-id: "scope-needs-you"; clicked => { root.choose-scope("needs-you"); } }
                c2 := Chip { x: scopes.w2 ? 0px : scopes.x2; y: scopes.l2 * scopes.line; label: "Working"; count: root.triage-working; on: root.scope == "working"; accessible-id: "scope-working"; clicked => { root.choose-scope("working"); } }
                c3 := Chip { x: scopes.w3 ? 0px : scopes.x3; y: scopes.l3 * scopes.line; label: "Done"; on: root.scope == "done"; accessible-id: "scope-done"; clicked => { root.choose-scope("done"); } }
                c4 := Chip { x: scopes.w4 ? 0px : scopes.x4; y: scopes.l4 * scopes.line; label: "Unread"; on: root.scope == "unread"; accessible-id: "scope-unread"; clicked => { root.choose-scope("unread"); } }
                c5 := Chip { x: scopes.w5 ? 0px : scopes.x5; y: scopes.l5 * scopes.line; label: "Snoozed"; count: root.triage-snoozed; on: root.scope == "snoozed"; accessible-id: "scope-snoozed"; clicked => { root.choose-scope("snoozed"); } }
            }
        }
        // Each label is its own row, not one row's text swapped: the swap
        // could leave the longer label's tail drawn behind the shorter one.
        if !root.showing-archive && !root.showing-pairs && !root.minimal: ListSwitch {
            glyph: "↔";
            label: "Agent conversations";
            // What it counts is the rooms behind it, not the chats below:
            // none shows no number (a 0 above a list of chats read as one).
            count: root.rooms.length > 0 ? "\{root.rooms.length}" : "";
            accessible-role: button;
            accessible-id: "list-rooms";
            accessible-label: root.rooms.length > 0 ? "Agent conversations, " + root.rooms.length : "Agent conversations, none yet";
            unread: root.unread-rooms;
            clicked => { root.showing-pairs = true; }
        }
        if !root.showing-archive && root.showing-pairs: ListSwitch {
            glyph: "‹";
            label: "Back to chats";
            count: "";
            unread: root.unread-rooms;
            clicked => { root.showing-pairs = false; }
        }
        if root.roster-note != "": HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            vertical-stretch: 0;
            Text {
                text: root.roster-note;
                color: Palette.faint;
                font-size: 11 * Look.unit;
                overflow: elide;
                accessible-role: text;
                accessible-id: "roster-note";
                accessible-label: root.roster-note;
                accessible-description: root.roster-note-detail;
            }
        }
        // Holds the keyboard for J/K/Enter navigation (the keyboard map).
        list := FocusScope {
          vertical-stretch: 1;
          // While the pointer is over the rows their order holds still
          // (`pointer-in-list`); the rows' own areas take the clicks.
          hover := TouchArea {
          width: parent.width;
          height: parent.height;
          // A ListView makes only the rows in view, so a frame walks a
          // screenful of rows, not the whole fleet.
          flick := ListView {
            width: parent.width;
            height: parent.height;
            vertical-scrollbar-policy: always-off;
            for row in root.shown: Row {
                chat: row;
                cursor: list.has-focus && row.session == root.cursor;
                compact: root.compact;
                reduced-motion: ProfileBridge.reduced-motion;
                seeking: root.revealing;
                on-screen: root.visible && self.y + self.height + flick.content-y > 0px && self.y + flick.content-y < flick.visible-height;
                // J/K keep the cursor's row in view.
                reveal(y, h) => {
                    root.cursor-y = y;
                    root.cursor-h = h;
                    root.cursor-placed = root.cursor;
                    if (y + flick.content-y < 0px) {
                        flick.content-y = -y;
                    } else if (y + h + flick.content-y > flick.visible-height) {
                        flick.content-y = flick.visible-height - y - h;
                    }
                }
                clicked => { if (!row.archived) { root.chosen(row.session); } }
                done-toggled(parent) => { root.done-toggled(parent); }
                fold-toggled => { root.fold-toggled(row.session); }
                restore => { root.restore(row.session); }
                processes(x, y) => { root.processes(row.session, x, y); }
                menu(x, y) => {
                    if (!row.archived && root.shown-kind == "chats") {
                        RowMenu.x = x - root.absolute-position.x;
                        RowMenu.y = y - root.absolute-position.y;
                        RowMenu.opened(row.session);
                    }
                }
            }
          }
          }
          // A triage view with nothing in it says so.
          if !root.showing-pairs && !root.showing-archive && root.rows.length == 0 && (root.scope == "working" || root.scope == "needs-you" || root.scope == "done" || root.scope == "snoozed"): Text {
              y: 8px;
              width: parent.width;
              text: root.scope == "needs-you" ? "Nothing needs you." : root.scope == "working" ? "No agent is working." : root.scope == "snoozed" ? "No snoozed chats." : "No finished chats.";
              color: Palette.muted;
              font-size: 12 * Look.unit;
              horizontal-alignment: center;
              accessible-id: "scope-empty";
          }
          if root.showing-pairs && root.rooms.length == 0: Text {
              y: 0;
              width: parent.width;
              text: "No agent-to-agent conversations yet.";
              color: Palette.muted;
              font-size: 12 * Look.unit;
              horizontal-alignment: center;
          }
        }
        if !root.showing-pairs && !root.showing-archive && !root.minimal: ListSwitch {
            glyph: "≡";
            label: "Archived";
            count: root.archived.length;
            clicked => { root.showing-archive = true; }
        }
        if !root.showing-pairs && root.showing-archive: ListSwitch {
            glyph: "‹";
            label: "Back to chats";
            count: root.archived.length;
            clicked => { root.showing-archive = false; }
        }
    }
    // Level with the panes' frames (their pane pads 2px).
    PaneFrame {
        x: 4px;
        y: 2px;
        width: parent.width - 8px;
        height: parent.height - 4px;
        key: Focus.mode == "composer" ? "ctrl+e" : "e";
        label: "Explorer";
        active: root.explorer-active;
        surface: Palette.raised;
    }
    // The row's right-click menu, over the list; a click elsewhere or Esc
    // closes it.
    if RowMenu.session != "": Rectangle {
        TouchArea {
            clicked => { RowMenu.session = ""; }
            pointer-event(event) => {
                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) { RowMenu.session = ""; }
            }
        }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) { RowMenu.session = ""; return accept; }
                reject
            }
        }
        row-menu := Rectangle {
            width: Math.min(230px, parent.width - 16px);
            height: row-menu-list.preferred-height;
            x: Math.max(8px, Math.min(RowMenu.x, parent.width - self.width - 8px));
            y: Math.max(8px, Math.min(RowMenu.y, parent.height - self.height - 8px));
            border-radius: 2px;
            border-width: 1px;
            border-color: Palette.border;
            background: Palette.window;
            accessible-role: AccessibleRole.list;
            accessible-id: "row-menu";
            accessible-label: RowMenu.title;
            // Clicks inside stay inside.
            TouchArea { }
            row-menu-list := VerticalLayout {
                padding: 3px;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    height: 22px;
                    Text {
                        text: RowMenu.title;
                        color: Palette.faint;
                        font-size: 11 * Look.unit;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                for choice in RowMenu.choices: Rectangle {
                    height: 26px;
                    background: item-touch.has-hover ? Palette.hover : transparent;
                    accessible-role: button;
                    accessible-id: "row-menu:" + choice.value;
                    accessible-label: choice.label;
                    accessible-action-default => { RowMenu.pick(RowMenu.session, choice.value); }
                    Text { x: 10px; text: choice.label; color: Palette.text; font-size: 12 * Look.unit; vertical-alignment: center; height: parent.height; }
                    item-touch := TouchArea { clicked => { RowMenu.pick(RowMenu.session, choice.value); } }
                }
            }
        }
    }
}
