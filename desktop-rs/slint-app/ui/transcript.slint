import { Palette, Focus } from "theme.slint";
import { ListView } from "std-widgets.slint";
import { DisplayCell, DisplayCellCard } from "cells.slint";
import { ArtifactItem, ArtifactCard, ArtifactBridge, KeyHint } from "artifacts.slint";
import { AgentAvatar } from "avatar.slint";

export struct TableRow {
    cells: [styled-text],
    header: bool,
}

// An image in a message (iOS MediaImageBlock / MediaGalleryBlock): its
// caption, and the picture once fetched from the Host.
export struct MessageImage {
    url: string,
    alt: string,
    image: image,
    loaded: bool,
    // Could not be fetched, or not from the Host: "Image unavailable".
    failed: bool,
    // Not on the Host, so never fetched: a line, not a box.
    foreign: bool,
}

export struct MessageBlock {
    // prose, heading, code, quote, table, rule, images (one image or a
    // gallery: gallery true)
    kind: string,
    images: [MessageImage],
    gallery: bool,
    // An image block in the chat: what the keyboard calls it ("" for none).
    key: string,
    styled: styled-text,
    text: string,
    level: int,
    rows: [TableRow],
}

export struct ToolRow {
    name: string,
    summary: string,
    status: string,
    detail: string,
    // Plain-English tools on: the Host's explanation ("" while it comes).
    narrated: bool,
    explanation: string,
}

// A row of the open turn's live items (docs/live-items.md §7.3): its
// kind (message, reasoning, tool, explore, plan, diff, compaction, fold),
// the key the keyboard selects it by ("" for an ordinary row), its status
// and its lines.
export struct LiveRow {
    kind: string,
    key: string,
    status: string,
    title: string,
    meta: string,
    secondary: string,
    // Keep the second line even while it is empty (an explanation coming).
    reserve: bool,
    // The explanation is on its way: the reserved line says Explaining….
    explaining: bool,
    lines: [string],
    more: string,
    // A message's text as revealed so far.
    text: string,
    expandable: bool,
    expanded: bool,
}

// The Host's resolved-decision prompt, shown as what the user decided
// (core `decision_receipt`): the key the keyboard selects it by ("" for an
// ordinary row), the question asked, the outcome's mark and words, its
// tone (success, danger, answer, muted), whose question and what it was
// (Decision or Question), and the decision card it answers.
export struct ReceiptRow {
    key: string,
    question: string,
    mark: string,
    outcome: string,
    tone: string,
    kind: string,
    agent: string,
    artifact-id: string,
    // Its decision card is in the chat: O goes to it.
    linked: bool,
}

// A message another agent sent into the chat: folded to one line,
// "<sender> prompted · <line>", until O (or a click) opens it by its key.
export struct PromptRow {
    // "" for a row that is not another agent's prompt.
    key: string,
    sender: string,
    initial: string,
    line: string,
    expanded: bool,
}

export struct MessageRow {
    id: string,
    // user, assistant, activity
    author: string,
    blocks: [MessageBlock],
    stamp: string,
    meta: string,
    pending: bool,
    failed: bool,
    // Tool activity: the toggle's label, whether the cards show, the cards.
    activity-label: string,
    group-id: string,
    expanded: bool,
    tools: [ToolRow],
    // The Host's display cells, shown with the tool cards.
    cells: [DisplayCell],
    // Artifacts the agent made while writing this reply.
    artifacts: [ArtifactItem],
    // A live item row (author "live", or an assistant message item).
    live: LiveRow,
    receipt: ReceiptRow,
    prompt: PromptRow,
}

// A row handed to the transcript to measure off screen, and the batch it
// was asked for in (a row asked for again is reported again).
export struct MeasureRow {
    row: MessageRow,
    batch: int,
}

// The chat's row heights, kept by the app per pane (scroll_book.rs): the
// scrollbar's size and place come from them, not from the list's estimate.
export global ScrollBook {
    // A row measured off screen: the pane, the batch, the row's id, its
    // height and the width it was measured at.
    callback measured(string, int, string, length, length);
    // A row drawn in the chat, at its height and the chat's width.
    callback shown(string, string, length, length);
    // The chat's text size or width changed: every row is measured again.
    callback relayout(string);
    // The row a distance from the chat's top falls on.
    pure callback row-at(string, length) -> int;
}

// One tool call (ToolCard.qml): name, summary, status; details on request.
component ToolCard inherits Rectangle {
    in property <ToolRow> tool;
    property <bool> open;
    background: Palette.raised;
    border-radius: 2px;
    VerticalLayout {
        padding: 6px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 6px;
                height: 6px;
                y: (parent.height - self.height) / 2;
                border-radius: 3px;
                background: root.tool.status == "error" ? Palette.danger : root.tool.status == "running" ? Palette.warning : Palette.success;
            }
            if !root.tool.narrated: Text { text: root.tool.name; color: Palette.chrome-text; font-size: 12px; font-weight: 600; }
            if !root.tool.narrated: Text { text: root.tool.summary; color: Palette.muted; font-size: 12px; overflow: elide; horizontal-stretch: 1; }
            // ActivityExplanation.qml: the explanation in place of the call,
            // dots until it arrives; a failed one falls back to the call.
            if root.tool.narrated: Text {
                text: root.tool.explanation != "" ? root.tool.explanation : "…";
                color: Palette.text;
                font-size: 12px;
                wrap: word-wrap;
                horizontal-stretch: 1;
                accessible-label: root.tool.explanation != "" ? root.tool.explanation : "Explaining " + root.tool.name;
            }
            if root.tool.detail != "": TouchArea {
                width: 60px;
                clicked => { root.open = !root.open; }
                Text { text: root.open ? "Hide" : "Details"; color: Palette.link; font-size: 12px; }
            }
        }
        if root.open: Text {
            text: root.tool.detail;
            font-family: "JetBrains Mono";
            font-size: 11px;
            color: Palette.text;
            wrap: word-wrap;
        }
    }
}

// A decision the user resolved, in their own column: what was asked, and
// their answer as a chip whose mark and words say it (the colour only
// repeats them). J/K reach it like a card; O (or a click) goes to the
// decision card it answers.
component DecisionReceipt inherits Rectangle {
    in property <ReceiptRow> receipt;
    in property <length> view-top;
    in property <length> view-bottom;
    // A copy measured off screen: it reports nothing.
    in property <bool> measuring;
    property <bool> selected: ArtifactBridge.cursor == root.receipt.key;
    property <color> tone: root.receipt.tone == "success" ? Palette.success
        : root.receipt.tone == "danger" ? Palette.danger
        : root.receipt.tone == "answer" ? Palette.accent : Palette.muted;
    background: touch.has-hover && root.receipt.linked ? Palette.bubble.mix(root.tone, 0.9) : Palette.bubble;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Palette.accent : root.tone.with-alpha(0.35);
    border-radius: 8px;
    accessible-role: groupbox;
    accessible-id: root.measuring ? "" : "receipt";
    accessible-label: root.receipt.kind + " " + root.receipt.question;
    accessible-description: root.receipt.outcome;
    Timer {
        interval: 150ms;
        running: !root.measuring;
        triggered => { ArtifactBridge.card-shown(root.receipt.key, root.absolute-position.x, root.absolute-position.y, root.width, root.height, root.view-top, root.view-bottom); }
    }
    touch := TouchArea {
        enabled: root.receipt.linked;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { ArtifactBridge.open(root.receipt.key); }
    }
    // A stripe in the outcome's tone down the leading edge.
    Rectangle {
        x: 0;
        width: 3px;
        height: parent.height;
        border-top-left-radius: 8px;
        border-bottom-left-radius: 8px;
        background: root.tone;
    }
    VerticalLayout {
        padding-left: 14px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 11px;
        spacing: 7px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: "?";
                color: Palette.warning;
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Text {
                text: root.receipt.agent != "" ? root.receipt.kind + " · " + root.receipt.agent : root.receipt.kind;
                color: Palette.faint;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 0.8px;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            if root.selected && Focus.mode == "pane" && root.receipt.linked: KeyHint {
                key: "O";
                label: "Show decision";
                emphasised: true;
                clicked => { ArtifactBridge.open(root.receipt.key); }
            }
        }
        Text {
            text: root.receipt.question;
            color: Palette.text;
            font-size: 14px;
            font-weight: 600;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            Rectangle {
                min-height: 22px;
                border-radius: 11px;
                background: root.tone.with-alpha(0.16);
                border-width: 1px;
                border-color: root.tone.with-alpha(0.4);
                accessible-role: text;
                accessible-id: root.measuring ? "" : "receipt-outcome";
                accessible-label: root.receipt.outcome;
                HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 10px;
                    padding-top: 2px;
                    padding-bottom: 2px;
                    spacing: 6px;
                    Text {
                        text: root.receipt.mark;
                        color: root.tone;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.receipt.outcome;
                        color: root.tone;
                        font-size: 12px;
                        font-weight: 600;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// One live item row (docs/live-items.md §7.3): a status mark, the label
// (verb + label, "Thought for 4s: …", "Explored 2 files", "Worked for 12s"),
// its time or diff stats on the right, an explanation or command under it
// (a reserved line while an explanation comes, saying Explaining…, so
// landing never moves the chat), and an output tail, diff, plan or members in monospace. J/K reach
// it like a card; O (or a click) opens and folds it.
component LiveItem inherits Rectangle {
    in property <LiveRow> live;
    in property <length> view-top;
    in property <length> view-bottom;
    in property <bool> measuring;
    property <bool> selected: root.live.expandable && ArtifactBridge.cursor == root.live.key;
    property <bool> running: root.live.status == "running" || root.live.status == "pending";
    property <color> mark: root.live.status == "failed" ? Palette.danger
        : root.live.status == "interrupted" ? Palette.warning
        : root.running ? Palette.accent : Palette.success;
    border-radius: 3px;
    border-width: root.selected ? 1px : 0px;
    border-color: Palette.accent;
    background: root.live.kind == "plan" || root.live.kind == "diff" ? Palette.raised : transparent;
    accessible-role: list-item;
    accessible-label: root.live.title + (root.live.meta != "" ? " " + root.live.meta : "");
    // Reports where it is, as a card does, so J/K reach it.
    Timer {
        interval: 150ms;
        running: root.live.expandable && !root.measuring;
        triggered => { ArtifactBridge.card-shown(root.live.key, root.absolute-position.x, root.absolute-position.y, root.width, root.height, root.view-top, root.view-bottom); }
    }
    if root.live.expandable: TouchArea {
        mouse-cursor: pointer;
        clicked => { ArtifactBridge.open(root.live.key); }
    }
    VerticalLayout {
        padding-left: 4px;
        padding-right: 4px;
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 2px;
        HorizontalLayout {
            spacing: 8px;
            height: 20px;
            Rectangle {
                width: 7px;
                height: 7px;
                y: (parent.height - self.height) / 2;
                border-radius: root.live.kind == "fold" ? 1px : 3.5px;
                background: root.running ? root.mark : transparent;
                border-width: 1px;
                border-color: root.live.kind == "fold" ? Palette.faint : root.mark;
            }
            Text {
                text: root.live.title;
                color: root.live.kind == "reasoning" || root.live.kind == "fold" ? Palette.muted : Palette.chrome-text;
                font-size: 13px;
                font-weight: root.live.kind == "fold" || root.live.kind == "reasoning" ? 400 : 600;
                font-italic: root.live.kind == "reasoning";
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            if root.live.meta != "": Text {
                text: root.live.meta;
                color: root.live.status == "failed" ? Palette.danger : Palette.faint;
                font-size: 12px;
                font-family: "JetBrains Mono";
                vertical-alignment: center;
            }
            if root.live.expandable: Text {
                text: root.live.expanded ? "▾" : "▸";
                color: Palette.faint;
                font-size: 12px;
                vertical-alignment: center;
            }
            // Its key only while it works: selected, in the focused chat.
            if root.selected && Focus.mode == "pane": KeyHint {
                key: "O";
                label: root.live.expanded ? "Collapse" : "Expand";
                emphasised: true;
                clicked => { ArtifactBridge.open(root.live.key); }
            }
        }
        // Under the label, indented past the mark.
        VerticalLayout {
            padding-left: 15px;
            spacing: 2px;
            if root.live.secondary != "" || root.live.reserve: Text {
                height: 17px;
                text: root.live.secondary != "" ? root.live.secondary : root.live.explaining ? "Explaining…" : "";
                color: root.live.secondary != "" ? Palette.muted : Palette.faint;
                font-size: 12px;
                font-italic: root.live.secondary == "";
                overflow: elide;
            }
            if root.live.lines.length > 0: Rectangle {
                background: root.live.kind == "plan" || root.live.kind == "reasoning" ? transparent : Palette.sunken;
                border-radius: 2px;
                VerticalLayout {
                    padding: root.live.kind == "plan" || root.live.kind == "reasoning" ? 0px : 6px;
                    spacing: 0px;
                    // Each line is as tall as it wraps at the width it is
                    // drawn at (laid out, it was measured at its one-line
                    // width: see Block's code and quote).
                    for line in root.live.lines: Rectangle {
                        min-width: line-text.min-width;
                        preferred-width: line-text.preferred-width;
                        height: line-text.preferred-height;
                        line-text := Text {
                            width: parent.width;
                            height: parent.height;
                            text: line;
                            font-family: root.live.kind == "plan" || root.live.kind == "reasoning" ? Palette.body-family : "JetBrains Mono";
                            font-size: root.live.kind == "plan" || root.live.kind == "reasoning" ? 13px : 11px;
                            color: root.live.kind == "plan" || root.live.kind == "reasoning" ? Palette.muted : Palette.text;
                            wrap: root.live.kind == "plan" || root.live.kind == "reasoning" ? word-wrap : no-wrap;
                            overflow: elide;
                        }
                    }
                }
            }
            if root.live.more != "": Text {
                text: root.live.more;
                color: Palette.faint;
                font-size: 11px;
            }
        }
    }
}

// Another agent's message (iOS labels it "<Name> prompted"): one line, the
// sender and its first line elided, until O (or a click) opens it to the
// whole message; the line stays on top, so opening never moves it. J/K
// reach it like a card.
component PromptLine inherits Rectangle {
    in property <PromptRow> prompt;
    in property <length> view-top;
    in property <length> view-bottom;
    in property <bool> measuring;
    property <bool> selected: ArtifactBridge.cursor == root.prompt.key;
    height: 22px;
    border-radius: 3px;
    border-width: root.selected ? 1px : 0px;
    border-color: Palette.accent;
    accessible-role: button;
    accessible-label: root.prompt.sender + " prompted" + (root.prompt.expanded || root.prompt.line == "" ? "" : " · " + root.prompt.line);
    accessible-action-default => { ArtifactBridge.open(root.prompt.key); }
    Timer {
        interval: 150ms;
        running: !root.measuring;
        triggered => { ArtifactBridge.card-shown(root.prompt.key, root.absolute-position.x, root.absolute-position.y, root.width, root.height, root.view-top, root.view-bottom); }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { ArtifactBridge.open(root.prompt.key); }
    }
    HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        spacing: 6px;
        AgentAvatar {
            y: (parent.height - self.height) / 2;
            size: 18px;
            name: root.prompt.sender;
            initial: root.prompt.initial;
        }
        Text {
            text: root.prompt.sender;
            color: Palette.accent;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            text: root.prompt.expanded || root.prompt.line == "" ? "prompted" : "prompted ·";
            color: Palette.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
        // The rest of the line: its first line, elided to the bubble.
        Text {
            text: root.prompt.expanded ? "" : root.prompt.line;
            color: Palette.text;
            font-size: 13px;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 0px;
            vertical-alignment: center;
        }
        Text {
            text: root.prompt.expanded ? "▾" : "▸";
            color: Palette.faint;
            font-size: 12px;
            vertical-alignment: center;
        }
        // Its key only while it works: selected, in the focused chat.
        if root.selected && Focus.mode == "pane": KeyHint {
            y: (parent.height - self.height) / 2;
            key: "O";
            label: root.prompt.expanded ? "Collapse" : "Expand";
            emphasised: true;
            clicked => { ArtifactBridge.open(root.prompt.key); }
        }
    }
}

export component Block inherits VerticalLayout {
    in property <MessageBlock> block;
    // The chat's visible band (an image block in the chat reports where it
    // is, like a card, so J/K reach it).
    in property <length> view-top;
    in property <length> view-bottom;
    in property <bool> measuring;
    property <bool> selected: root.block.key != "" && ArtifactBridge.cursor == root.block.key;
    in property <length> body-size;
    in property <brush> body-color;
    callback link-clicked(string);
    if root.block.kind == "prose": StyledText {
        text: root.block.styled;
        default-color: root.body-color;
        default-font-size: root.body-size;
        default-font-family: Palette.body-family;
        link-color: Palette.link;
        link-clicked(url) => { root.link-clicked(url); }
    }
    if root.block.kind == "heading": StyledText {
        text: root.block.styled;
        default-color: Palette.chrome-text;
        default-font-size: root.body-size * (root.block.level <= 1 ? 1.4 : root.block.level == 2 ? 1.25 : 1.1);
        default-font-family: Palette.body-family;
        link-color: Palette.link;
        link-clicked(url) => { root.link-clicked(url); }
    }
    // A block whose text sits inside a box (code, quote) takes its height
    // from that text at the width it is drawn at. Laid out in a layout, the
    // box measured the text at its one-line width when the chat sized the
    // row: a wrapped quote or code line came out lines short and the next
    // message was drawn over it (Slint 1.18 measures a conditional layout
    // at its preferred width).
    if root.block.kind == "code": Rectangle {
        background: Palette.sunken;
        border-radius: 2px;
        min-width: code-text.min-width + 20px;
        preferred-width: code-text.preferred-width + 20px;
        height: code-text.preferred-height + 20px;
        code-text := Text {
            x: 10px;
            y: 10px;
            width: parent.width - 20px;
            height: parent.height - 20px;
            text: root.block.text;
            font-family: "JetBrains Mono";
            font-size: root.body-size * 0.9;
            color: Palette.text;
            wrap: word-wrap;
        }
    }
    if root.block.kind == "quote": Rectangle {
        min-width: quote-text.min-width + 13px;
        preferred-width: quote-text.preferred-width + 13px;
        height: quote-text.preferred-height;
        Rectangle { x: 0; width: 3px; height: parent.height; background: Palette.accent; }
        quote-text := StyledText {
            x: 13px;
            width: parent.width - 13px;
            height: parent.height;
            text: root.block.styled;
            default-color: Palette.muted;
            default-font-size: root.body-size;
            default-font-family: Palette.body-family;
            link-color: Palette.link;
            link-clicked(url) => { root.link-clicked(url); }
        }
    }
    if root.block.kind == "table": Rectangle {
        border-width: 1px;
        border-color: Palette.border;
        VerticalLayout {
            for table-row in root.block.rows: HorizontalLayout {
                spacing: 0px;
                for cell in table-row.cells: Rectangle {
                    // Equal columns, so every row lines up: content never
                    // decides a column's width.
                    horizontal-stretch: 1;
                    preferred-width: 0px;
                    min-width: 0px;
                    border-width: 1px;
                    border-color: Palette.rule;
                    background: table-row.header ? Palette.raised : transparent;
                    VerticalLayout {
                        padding: 6px;
                        StyledText {
                            text: cell;
                            default-color: table-row.header ? Palette.chrome-text : root.body-color;
                            default-font-size: root.body-size * 0.95;
                            default-font-family: Palette.body-family;
                            link-color: Palette.link;
                            link-clicked(url) => { root.link-clicked(url); }
                        }
                    }
                }
            }
        }
    }
    if root.block.kind == "rule": Rectangle { height: 1px; background: Palette.rule; }
    // An image keeps its space before it arrives (iOS: up to 360 tall; a
    // gallery's tiles 120): landing never moves the chat.
    if root.block.kind == "images": images := HorizontalLayout {
        spacing: 6px;
        alignment: start;
        Timer {
            interval: 150ms;
            running: root.block.key != "" && !root.measuring;
            triggered => { ArtifactBridge.card-shown(root.block.key, images.absolute-position.x, images.absolute-position.y, images.width, images.height, root.view-top, root.view-bottom); }
        }
        for picture[index] in root.block.images: Rectangle {
            // The layout sizes them: a gallery's tiles up to 150 wide, an
            // image up to 480, both shrinking to fit.
            preferred-width: root.block.gallery ? 140px : 480px;
            max-width: root.block.gallery ? 150px : 480px;
            min-width: 48px;
            height: picture.foreign && !root.block.gallery ? 36px : root.block.gallery ? 120px : 270px;
            border-radius: 6px;
            clip: true;
            background: Palette.sunken;
            accessible-role: image;
            accessible-label: picture.alt;
            // The keyboard's tile (a single image is its own).
            property <bool> on-tile: root.selected && (!root.block.gallery || ArtifactBridge.tile == index);
            border-width: self.on-tile ? 2px : 0px;
            border-color: Palette.accent;
            if picture.loaded: Image {
                width: parent.width;
                height: parent.height;
                source: picture.image;
                image-fit: root.block.gallery ? cover : contain;
            }
            // A click enlarges it, as Enter does.
            if root.block.key != "": TouchArea {
                mouse-cursor: pointer;
                clicked => { ArtifactBridge.image-clicked(root.block.key, index); }
            }
            // Its keys only while they work: the chat has the keyboard.
            if self.on-tile && Focus.mode == "pane": Rectangle {
                x: 6px;
                y: parent.height - self.height - 6px;
                width: hint-row.preferred-width + 8px;
                height: 22px;
                border-radius: 4px;
                background: Palette.window.with-alpha(0.85);
                hint-row := HorizontalLayout {
                    padding-left: 4px;
                    spacing: 6px;
                    // A tile is narrow: its keys, briefly.
                    KeyHint { key: "O"; label: root.block.gallery ? "Open" : "Enlarge"; emphasised: true; clicked => { ArtifactBridge.image-clicked(root.block.key, index); } }
                    if root.block.gallery: KeyHint { key: "←/→"; label: ""; emphasised: true; }
                }
            }
            if !picture.loaded: Text {
                width: parent.width - 16px;
                x: 8px;
                height: parent.height;
                text: picture.failed ? "Image unavailable" + (picture.alt != "" ? " · " + picture.alt : "") : picture.alt;
                color: picture.failed ? Palette.warning : Palette.faint;
                font-size: 12px;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// One message of the chat as the transcript draws it, and as it is
// measured off screen (the same component, so a row measured there is as
// tall as it is drawn).
component TranscriptRow inherits HorizontalLayout {
    in property <MessageRow> message;
    // The chat's width, and its visible band (cards and images report
    // where they are against it).
    in property <length> list-width;
    in property <length> view-top;
    in property <length> view-bottom;
    // A copy laid out off screen to measure: its cards, receipts and images
    // report nothing and take no keyboard, and it is no list item.
    in property <bool> measuring;
    callback link-clicked(string);
    callback toggle-activity(string, string);
    callback copy-message(string);
    // The widest the message's content is drawn. Slint measures a
    // repeated or conditional layout in a row (opened tool calls, a
    // card) at its preferred width when it sizes the row, so one
    // whose text wraps prefers the width it is drawn at: measured at
    // its one-line width, its height came out lines short and the
    // next row was drawn over it.
    property <length> content-width: Math.min(root.list-width - 32px, root.message.author == "user" ? root.list-width * 0.75 : root.list-width)
        - 2 * (root.message.receipt.key != "" ? 0px : root.message.prompt.key != "" && !root.message.prompt.expanded ? 5px : root.message.author == "user" ? 10px : 2px);
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 7px;
    padding-bottom: 7px;
    alignment: root.message.author == "user" ? end : stretch;
    Rectangle {
        // One message of the list; the id finds it in the checks.
        accessible-role: list-item;
        accessible-id: root.measuring ? "" : "row:" + root.message.id;
        background: root.message.author == "user" && root.message.receipt.key == "" ? Palette.bubble : transparent;
        border-radius: 2px;
        max-width: root.message.author == "user" ? root.list-width * 0.75 : root.list-width;
        // Hovering a message offers its copy button (Slint's rich text
        // cannot be selected: the message's text is copied whole).
        hover := TouchArea { }
        if root.message.author != "activity" && root.message.author != "live" && root.message.receipt.key == "": Rectangle {
            x: parent.width - 20px;
            y: 2px;
            width: 18px;
            height: 18px;
            opacity: hover.has-hover || copy.has-hover ? 1 : 0;
            accessible-role: button;
            accessible-label: "Copy message";
            Image { source: @image-url("icons/copy.svg"); width: 14px; height: 14px; colorize: Palette.faint; }
            copy := TouchArea { clicked => { root.copy-message(root.message.id); } }
        }
        VerticalLayout {
            // A folded prompt is one line in a slim bubble.
            padding: root.message.receipt.key != "" ? 0px : root.message.prompt.key != "" && !root.message.prompt.expanded ? 5px : root.message.author == "user" ? 10px : 2px;
            spacing: 8px;
            if root.message.receipt.key != "": DecisionReceipt {
                receipt: root.message.receipt;
                preferred-width: 420px;
                view-top: root.view-top;
                view-bottom: root.view-bottom;
                measuring: root.measuring;
            }
            if root.message.prompt.key != "": PromptLine {
                prompt: root.message.prompt;
                view-top: root.view-top;
                view-bottom: root.view-bottom;
                measuring: root.measuring;
            }
            if root.message.author == "live": LiveItem {
                live: root.message.live;
                view-top: root.view-top;
                view-bottom: root.view-bottom;
                measuring: root.measuring;
            }
            for block in root.message.blocks: Block {
                block: block;
                view-top: root.view-top;
                view-bottom: root.view-bottom;
                measuring: root.measuring;
                body-size: root.message.author == "activity" ? 13px : Palette.body-size;
                body-color: root.message.author == "activity" ? Palette.muted : Palette.text;
                link-clicked(url) => { root.link-clicked(url); }
            }
            // A stopped answer says so under its text.
            if root.message.live.kind == "message" && root.message.live.meta != "": Text {
                text: "■ " + root.message.live.meta;
                color: Palette.warning;
                font-size: 11px;
            }
            if root.message.activity-label != "": TouchArea {
                height: 20px;
                clicked => { root.toggle-activity(root.message.id, root.message.group-id); }
                Text {
                    text: (root.message.expanded ? "Hide · " : "Show · ") + root.message.activity-label;
                    color: Palette.faint;
                    font-size: 12px;
                    x: 0;
                }
            }
            if root.message.expanded: VerticalLayout {
                preferred-width: content-width;
                spacing: 1px;
                for cell in root.message.cells: DisplayCellCard { cell: cell; }
                for tool in root.message.tools: ToolCard { tool: tool; }
            }
            for artifact in root.message.artifacts: HorizontalLayout {
                // Measured at the width the card is drawn at.
                preferred-width: Math.min(640px, content-width);
                alignment: start;
                ArtifactCard {
                    artifact: artifact;
                    preferred-width: 640px;
                    max-width: 640px;
                    view-top: root.view-top;
                    view-bottom: root.view-bottom;
                    measuring: root.measuring;
                }
            }
            if (root.message.pending || root.message.failed || root.message.stamp != "") && (root.message.prompt.key == "" || root.message.prompt.expanded): Text {
                text: root.message.failed ? "Not delivered" : root.message.pending ? "Sending…" : root.message.stamp;
                color: root.message.failed ? Palette.danger : Palette.faint;
                font-size: 11px;
                horizontal-alignment: root.message.author == "user" ? right : left;
            }
        }
    }
}

// The transcript (TranscriptView/MessageDelegate in QML): a virtualised
// list of Markdown messages, the user's in bubbles, tool activity folded
// behind a toggle. It follows the latest while the reader is at the end;
// scrolling up pauses it, and returning to the end (or End) resumes it.
export component Transcript inherits FocusScope {
    in property <[MessageRow]> rows;
    // The pane (the scroll book's key), the rows it asks to have measured
    // and, from their heights, how far down the chat each row starts (one
    // more: the chat's whole height).
    in property <string> pane-id;
    in property <[MeasureRow]> measure;
    in property <[float]> before;
    in-out property <bool> follow: true;
    out property <length> offset: list.content-y;
    out property <bool> at-end: list.content-y <= list.visible-height - list.content-height + 2px;
    callback link-clicked(string);
    callback toggle-activity(string, string);
    callback copy-message(string);
    // The reader reached the oldest loaded row: time for the page before.
    callback reached-top();
    // The scroll journal: a move of the offset that was not the reader's
    // own wheel or touchpad (its cause), or a jump of over a viewport no
    // one asked for ("unexplained"): the cause, the old and new offset,
    // where both are in the chat (0 the top, 1 the end), the content and
    // viewport heights, at-end, follow and the row count.
    callback journal(string, length, length, float, float, length, length, bool, bool, int);
    // The reader reached the top and an older page was asked for: the
    // oldest row and the row count then. Nothing moves until the page has
    // landed above (the oldest row is another and there are more rows).
    property <bool> holding;
    property <string> held-first;
    property <int> held-count;
    Rectangle { background: Palette.window; }
    // The cards' clock: the chat ticks with them, so a card whose row the
    // list dropped lapses even when no other card is drawn.
    Timer {
        interval: 150ms;
        running: true;
        triggered => { ArtifactBridge.card-shown("", 0, 0, 0, 0, 0, 0); }
    }
    // Mirrors the list's height so a streaming row that grows is followed.
    property <length> list-height: list.content-height;
    list := ListView {
        scrolled => { root.reader-scrolled(); }
        width: parent.width;
        height: parent.height;
        // The list's own bar sizes its thumb from its estimate of the rows'
        // heights (the average of those drawn), which changes as the reader
        // scrolls: the transcript draws its own from the measured heights.
        vertical-scrollbar-policy: always-off;
        for row[index] in root.rows: TranscriptRow {
            message: row;
            list-width: list.visible-width;
            view-top: root.absolute-position.y;
            view-bottom: root.absolute-position.y + root.height;
            link-clicked(url) => { root.link-clicked(url); }
            toggle-activity(id, group) => { root.toggle-activity(id, group); }
            copy-message(id) => { root.copy-message(id); }
            // Where the row is drawn in the viewport (a ListView row's y is
            // in the list's estimated coordinates): the one across the
            // viewport's top tells the scrollbar where the reader is.
            // Not as the row is created: the list has not placed it yet.
            property <length> on-screen: self.y + list.content-y;
            property <bool> on-top: self.on-screen <= 0 && self.on-screen + self.height > 0;
            property <int> at: index;
            property <length> scrolled-to: list.content-y;
            function mark() {
                if (self.on-top) {
                    root.top-index = index;
                    root.top-y = self.on-screen;
                }
            }
            changed on-screen => { self.mark(); }
            changed on-top => { self.mark(); }
            changed at => { self.mark(); }
            changed scrolled-to => { self.mark(); }
            // Drawn, the row's height is the truth (an artifact card that
            // grows in place changes it without a new row), and a row that
            // changes on screen needs no measuring off screen.
            changed height => { ScrollBook.shown(root.pane-id, row.id, self.height, list.visible-width); }
            changed message => { ScrollBook.shown(root.pane-id, row.id, self.height, list.visible-width); }
        }
    }
    // Rows measured off screen, a batch at a time, at the chat's width:
    // each reports its height once laid out.
    Rectangle {
        visible: false;
        // Far below the viewport, so nothing that looks for what is on
        // screen (link hints, the checks) meets the copies.
        y: root.height + 100000px;
        width: list.visible-width;
        height: 0;
        for m in root.measure: TranscriptRow {
            measuring: true;
            x: 0;
            y: 0;
            width: list.visible-width;
            message: m.row;
            list-width: list.visible-width;
            property <length> natural: self.preferred-height;
            property <string> report: m.batch + ":" + m.row.id + ":" + (self.natural / 1px) + ":" + (list.visible-width / 1px);
            init => { ScrollBook.measured(root.pane-id, m.batch, m.row.id, self.natural, list.visible-width); }
            changed report => { ScrollBook.measured(root.pane-id, m.batch, m.row.id, self.natural, list.visible-width); }
        }
    }
    property <string> layout-key: (list.visible-width / 1px) + "/" + (Palette.body-size / 1px);
    changed layout-key => { ScrollBook.relayout(root.pane-id); }

    // The scrollbar. The chat's height is the sum of its rows' measured
    // heights, and the reader's place is the measured height of the rows
    // above the one across the viewport's top plus how far into it they
    // are: neither changes as the list re-estimates rows while scrolling,
    // so the thumb keeps its size and moves only as the reader does.
    property <int> top-index;
    property <length> top-y;
    property <bool> measured: root.before.length > 1;
    property <length> total: root.measured ? root.before[root.before.length - 1] * 1px : list.content-height;
    property <length> above: root.measured ? root.before[Math.min(root.top-index, root.before.length - 1)] * 1px - root.top-y : -list.content-y;
    property <length> range: Math.max(1px, root.total - list.visible-height);
    property <float> scroll-place: root.at-end ? 1 : list.content-y >= 0 ? 0 : Math.clamp(root.above / root.range, 0, 1);
    track := Rectangle {
        x: root.width - self.width;
        y: 4px;
        width: 14px;
        height: root.height - 8px;
        visible: root.total > list.visible-height + 1px;
        border-radius: 7px;
        background: bar.has-hover || root.dragging ? Palette.raised.with-alpha(0.9) : transparent;
        property <length> thumb-height: Math.min(self.height, Math.max(24px, self.height * list.visible-height / Math.max(1px, root.total)));
        thumb := Rectangle {
            width: bar.has-hover || root.dragging ? 6px : 3px;
            x: parent.width - 4px - self.width;
            height: parent.thumb-height;
            y: (parent.height - self.height) * root.scroll-place;
            border-radius: self.width / 2;
            background: root.dragging ? Palette.muted : Palette.faint;
            animate width { duration: 150ms; easing: ease-out; }
        }
        bar := TouchArea {
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    if (self.mouse-y >= thumb.y && self.mouse-y <= thumb.y + thumb.height) {
                        // The thumb follows the pointer.
                        root.drag-from = self.mouse-y;
                        root.drag-above = root.above;
                        root.drag-target = root.above;
                        root.dragging = true;
                        root.reader-scrolled();
                    } else {
                        // A click on the track pages towards it.
                        ArtifactBridge.reader-moved();
                        root.scroll-by(self.mouse-y < thumb.y ? -list.visible-height * 0.9 : list.visible-height * 0.9, self.mouse-y < thumb.y ? "bar:PageUp" : "bar:PageDown");
                    }
                }
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                    root.dragging = false;
                }
            }
            moved => {
                if (root.dragging && self.pressed) {
                    root.drag-target = Math.clamp(root.drag-above + (self.mouse-y - root.drag-from) * root.range / Math.max(1px, parent.height - parent.thumb-height), 0, root.range);
                    root.reader-scrolled();
                    root.seek(root.drag-target);
                }
            }
        }
    }
    property <bool> dragging;
    property <length> drag-from;
    property <length> drag-above;
    property <length> drag-target;
    // Brings the reader to `target` px down the chat: within a viewport the
    // list moves by exactly that much; further, it seeks the row there by
    // its estimate and the rest is made up on the next frames.
    function seek(target: length) {
        let delta = target - root.above;
        if (Math.abs(delta / 1px) < 0.5) {
            return;
        }
        if (Math.abs(delta) <= list.visible-height) {
            list.content-y = Math.max(list.visible-height - list.content-height, Math.min(0px, list.content-y - delta));
        } else {
            list.content-y = -(ScrollBook.row-at(root.pane-id, target) + 0.5) * list.content-height / Math.max(1, root.rows.length);
        }
    }
    Timer {
        interval: 16ms;
        running: root.dragging;
        triggered => { root.seek(root.drag-target); }
    }

    changed rows => {
        if (root.follow) { root.pin("follow"); }
    }
    // Following also tracks rows that grow while streaming.
    changed list-height => {
        if (root.follow) {
            root.pin("follow");
        } else if (root.holding && root.rows.length > root.held-count && root.rows[0].id != root.held-first) {
            // The page landed: the reader's row is now the one after it.
            // The list places a row by its estimate (its index times the
            // rows' average height), so that is where the reader goes, once.
            // (Holding on to the distance from the bottom moved them each
            // time the estimate changed, over and over, while no page came.)
            root.holding = false;
            root.move-to(-(root.rows.length - root.held-count) * list.content-height / root.rows.length - 1px, "load-older");
        }
    }
    // The reader's own scroll (wheel, touchpad, the scrollbar): following
    // stops at once. A wheel notch animates: this runs as it starts, before
    // the list has moved, so whether they ended at the end (follow again)
    // or the top (load the page before) is decided once it has settled.
    function reader-scrolled() {
        ArtifactBridge.reader-moved();
        root.holding = false;
        root.follow = false;
        if (!root.settling) { root.start-y = list.content-y; }
        root.settled-y = list.content-y;
        root.still-ticks = 0;
        root.settling = true;
    }
    function check-top() {
        if (!root.follow && list.content-y >= -40px) {
            root.holding = true;
            root.held-first = root.rows[0].id;
            root.held-count = root.rows.length;
            root.reached-top();
        }
    }
    // Watches a scroll until the list holds still (within half a pixel for
    // ten frames: the list keeps correcting its estimates for a while).
    // Once it has moved and shows the end, the reader follows again.
    property <bool> settling;
    property <length> start-y;
    property <length> settled-y;
    property <int> still-ticks;
    Timer {
        interval: 16ms;
        running: root.settling;
        triggered => {
            if (list.content-y != root.start-y) {
                root.follow = root.at-end;
            }
            if (Math.abs((list.content-y - root.settled-y) / 1px) > 0.5) {
                root.settled-y = list.content-y;
                root.still-ticks = 0;
                return;
            }
            root.still-ticks += 1;
            if (root.still-ticks >= 10) {
                root.settling = false;
                root.follow = root.at-end;
                root.check-top();
            }
        }
    }
    // The list estimates the height of rows it has not drawn yet and
    // corrects it as they appear; while following, keep pinning the end
    // until the estimate settles.
    Timer {
        interval: 16ms;
        running: root.follow && !root.at-end;
        triggered => { root.pin("follow"); }
    }
    // Where the offset is in the chat, 0 the top and 1 the end: unlike the
    // offset, it holds while the list corrects its estimate of the rows'
    // heights.
    function place() -> float {
        return list.content-height > list.visible-height ? -list.content-y / (list.content-height - list.visible-height) : 1;
    }
    // The offset the journal last saw, and where it was.
    property <length> seen-y;
    property <float> seen-place: 1;
    function move-to(y: length, cause: string) {
        let old-y = list.content-y;
        let old-place = root.place();
        list.content-y = y;
        root.journal(cause, old-y, list.content-y, old-place, root.place(), list.content-height, list.visible-height, root.at-end, root.follow, root.rows.length);
        root.seen-y = list.content-y;
        root.seen-place = root.place();
    }
    // A move nobody made here (the list resetting or re-estimating) that
    // carried the reader over a viewport, unless it was their own scroll.
    changed offset => {
        if (!root.settling && Math.abs(root.place() - root.seen-place) * Math.max(0px, list.content-height - list.visible-height) > list.visible-height) {
            root.journal("unexplained", root.seen-y, list.content-y, root.seen-place, root.place(), list.content-height, list.visible-height, root.at-end, root.follow, root.rows.length);
        }
        root.seen-y = list.content-y;
        root.seen-place = root.place();
    }
    function pin(cause: string) {
        root.follow = true;
        root.move-to(Math.min(0px, list.visible-height - list.content-height), cause);
    }
    // The latest, asked for (End, Ctrl+End, a chat opened): following
    // again, and a card J/K were still bringing into view is let go.
    public function scroll-to-latest() {
        ArtifactBridge.reader-moved();
        root.holding = false;
        root.pin("jump-latest");
    }
    public function scroll-by(delta: length, cause: string) {
        root.move-to(Math.max(list.visible-height - list.content-height, Math.min(0px, list.content-y - delta)), cause);
        root.holding = false;
        root.follow = root.at-end;
        root.check-top();
    }
    // After Escape the transcript has the keyboard: Up/Down, Page Up/Down,
    // Home and End scroll it.
    key-pressed(event) => {
        if (event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.PageUp || event.text == Key.PageDown || event.text == Key.Home || event.text == Key.End) {
            ArtifactBridge.reader-moved();
        }
        if (event.text == Key.UpArrow) { root.scroll-by(-40px, "key:Up"); return accept; }
        if (event.text == Key.DownArrow) { root.scroll-by(40px, "key:Down"); return accept; }
        if (event.text == Key.PageUp) { root.scroll-by(-list.visible-height * 0.9, "key:PageUp"); return accept; }
        if (event.text == Key.PageDown) { root.scroll-by(list.visible-height * 0.9, "key:PageDown"); return accept; }
        if (event.text == Key.Home) { root.scroll-by(-list.content-height, "key:Home"); return accept; }
        if (event.text == Key.End) { root.scroll-to-latest(); return accept; }
        reject
    }
}
