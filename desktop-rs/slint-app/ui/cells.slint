import { Palette, Look, ChatText, Motion } from "theme.slint";

export struct CellLine {
    // diff_old, diff_new, error, or ""
    kind: string,
    text: string,
}

// One display cell (DisplayCellCard.qml): the Host's summary of an activity,
// a harness sub-agent's phase and task, and its detail lines on request.
export struct DisplayCell {
    title: string,
    summary: string,
    status: string,
    lines: [CellLine],
    more: int,
    subagent: bool,
    phase: string,
}

export component DisplayCellCard inherits Rectangle {
    in property <DisplayCell> cell;
    property <bool> open;
    property <bool> has-detail: root.cell.lines.length > 0 || root.cell.more > 0;
    property <color> status-color: root.cell.status == "error" ? Palette.danger
        : root.cell.status == "running" || root.cell.status == "ok" ? Palette.chrome-text : Palette.muted;
    property <color> phase-color: root.cell.phase == "failed" ? Palette.danger : root.cell.phase == "finished" ? Palette.muted : Palette.link;
    background: touch.has-hover ? Palette.control : transparent;
    border-radius: 2px;
    accessible-role: list-item;
    accessible-label: root.cell.title + " " + root.cell.summary;
    touch := TouchArea {
        enabled: root.has-detail;
        clicked => { root.open = !root.open; }
    }
    VerticalLayout {
        padding: 3px * ChatText.scale;
        spacing: 3px * ChatText.scale;
        HorizontalLayout {
            spacing: 7px * ChatText.scale;
            if !root.cell.subagent: Rectangle {
                width: 6px * ChatText.scale;
                height: 6px * ChatText.scale;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                background: root.status-color;
            }
            if root.cell.subagent: Text {
                // ProcessGlyph's "agent" kind.
                text: "◆";
                color: root.phase-color;
                font-size: ChatText.note;
                vertical-alignment: center;
            }
            if root.cell.subagent: Text {
                text: root.cell.phase == "activity" ? "sub-agent" : root.cell.phase;
                color: root.phase-color;
                font-family: "JetBrains Mono";
                font-size: ChatText.note;
                vertical-alignment: center;
            }
            Text {
                text: root.cell.title;
                color: Palette.text;
                font-family: "JetBrains Mono";
                font-size: ChatText.detail;
                font-weight: 600;
                overflow: elide;
                max-width: root.cell.subagent ? 240px * ChatText.scale : 100000px;
                vertical-alignment: center;
            }
            Text {
                text: root.cell.summary;
                color: Palette.muted;
                font-size: ChatText.detail;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            if root.has-detail: Text {
                text: root.open ? "−" : "+";
                color: Palette.chrome-text;
                font-size: ChatText.label;
                vertical-alignment: center;
            }
        }
        if root.open: VerticalLayout {
            padding-left: 15px * ChatText.scale;
            // As tall as its text wraps at the width it is drawn at (laid out,
            // a repeated line was measured at its one-line width and the
            // chat's next row was drawn over it).
            for line in root.cell.lines: Rectangle {
                border-radius: 2px;
                background: line.kind == "diff_old" ? Palette.danger-surface : line.kind == "diff_new" ? Palette.success.with-alpha(0.16) : transparent;
                min-width: line-text.min-width + 4px;
                preferred-width: line-text.preferred-width + 4px;
                height: line-text.preferred-height + 4px;
                line-text := Text {
                    x: 2px;
                    y: 2px;
                    width: parent.width - 4px;
                    height: parent.height - 4px;
                    text: line.text;
                    color: line.kind == "error" ? Palette.danger : Palette.chrome-text;
                    font-family: "JetBrains Mono";
                    font-size: ChatText.detail;
                    wrap: word-wrap;
                }
            }
            if root.cell.more > 0: Text {
                text: root.cell.more + " more details available";
                color: Palette.muted;
                font-family: "JetBrains Mono";
                font-size: ChatText.note;
            }
        }
    }
}

// TypingIndicator.qml: "Working…" and three dots while the agent works and
// its reply waits to be shown whole ("Show when ready").
export component TypingIndicator inherits Rectangle {
    in property <bool> reduced-motion;
    property <float> phase: root.reduced-motion ? 0.0 : Math.mod(Motion.glow / 1200ms, 1.0);
    width: 132px;
    height: 32px;
    border-radius: 2px;
    background: Palette.window;
    accessible-role: text;
    accessible-label: "Agent is working";
    HorizontalLayout {
        alignment: center;
        spacing: 5px;
        Text { text: "Working…"; color: Palette.text; font-size: 12 * Look.unit; vertical-alignment: center; }
        for index in 3: Rectangle {
            width: 6px;
            height: 6px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: Palette.accent;
            // Each dot brightens in turn, 140 ms after the one before.
            opacity: root.reduced-motion ? 0.7 : 0.4 + 0.6 * Math.max(0, 1 - Math.abs(root.phase * 3 - index - 0.5) * 2);
        }
    }
}

// One helper on a helpers card (helpers_card.rs): its name and one folded
// line, its task while it runs and its result once done. A helper agent
// opens to its chat (`chat`); one inside the agent's own process to its
// detail lines.
export struct HelperLine {
    key: string,
    name: string,
    line: string,
    // running, done or failed
    state: string,
    chat: string,
    lines: [CellLine],
}

// A turn's helpers as one card: "2 helpers working · 5 s" while they run,
// "2 helpers finished" with a line per helper once done. `started` is on
// the window's clock (ArtifactBridge.now), when `timed`.
export struct HelpersCard {
    key: string,
    running: int,
    total: int,
    failed: int,
    timed: bool,
    started: int,
    helpers: [HelperLine],
}

export global HelpersBridge {
    // The card's title: running, total, failed, seconds elapsed (-1: unknown).
    pure callback title(int, int, int, int) -> string;
    // Opens a helper agent's chat.
    callback open-chat(string);
}

component HelperItem inherits Rectangle {
    in property <HelperLine> helper;
    property <bool> open;
    property <bool> has-detail: root.helper.chat != "" || root.helper.lines.length > 0;
    property <color> tone: root.helper.state == "failed" ? Palette.danger : root.helper.state == "running" ? Palette.link : Palette.success;
    background: touch.has-hover && root.has-detail ? Palette.hover : transparent;
    border-radius: 3px;
    accessible-role: button;
    accessible-id: "helper:" + root.helper.key;
    accessible-label: root.helper.name + " " + root.helper.state + (root.helper.line == "" ? "" : " · " + root.helper.line);
    accessible-action-default => { touch.clicked(); }
    touch := TouchArea {
        enabled: root.has-detail;
        mouse-cursor: root.has-detail ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.helper.chat != "") {
                HelpersBridge.open-chat(root.helper.chat);
            } else {
                root.open = !root.open;
            }
        }
    }
    VerticalLayout {
        padding: 3px * ChatText.scale;
        spacing: 3px * ChatText.scale;
        HorizontalLayout {
            spacing: 7px * ChatText.scale;
            Text {
                text: root.helper.state == "failed" ? "✕" : root.helper.state == "running" ? "◆" : "✓";
                color: root.tone;
                font-size: ChatText.note;
                vertical-alignment: center;
            }
            Text {
                text: root.helper.name;
                color: Palette.text;
                font-size: ChatText.detail;
                font-weight: 600;
                overflow: elide;
                max-width: 220px * ChatText.scale;
                vertical-alignment: center;
            }
            Text {
                text: root.helper.line;
                color: Palette.muted;
                font-size: ChatText.detail;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            if root.has-detail: Text {
                text: root.helper.chat != "" ? "Open chat ›" : root.open ? "−" : "+";
                color: root.helper.chat != "" ? Palette.link : Palette.chrome-text;
                font-size: root.helper.chat != "" ? ChatText.note : ChatText.label;
                vertical-alignment: center;
            }
        }
        if root.open: VerticalLayout {
            padding-left: 18px * ChatText.scale;
            for line in root.helper.lines: Rectangle {
                min-width: line-text.min-width + 4px;
                preferred-width: line-text.preferred-width + 4px;
                height: line-text.preferred-height + 4px;
                line-text := Text {
                    x: 2px;
                    y: 2px;
                    width: parent.width - 4px;
                    height: parent.height - 4px;
                    text: line.text;
                    color: line.kind == "error" ? Palette.danger : Palette.chrome-text;
                    font-family: "JetBrains Mono";
                    font-size: ChatText.detail;
                    wrap: word-wrap;
                }
            }
        }
    }
}

export component HelpersCardView inherits Rectangle {
    in property <HelpersCard> card;
    // The window's clock, in seconds (ArtifactBridge.now).
    in property <int> now;
    property <string> title: HelpersBridge.title(root.card.running, root.card.total, root.card.failed,
        root.card.timed ? Math.max(0, root.now - root.card.started) : -1);
    background: Palette.raised;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.card.running > 0 ? Palette.link.with-alpha(0.5) : Palette.rule;
    accessible-role: list;
    accessible-id: "helpers:" + root.card.key;
    accessible-label: root.title;
    VerticalLayout {
        padding: 6px * ChatText.scale;
        spacing: 2px * ChatText.scale;
        HorizontalLayout {
            spacing: 7px * ChatText.scale;
            padding-left: 3px * ChatText.scale;
            Text {
                text: root.title;
                color: root.card.running > 0 ? Palette.link : root.card.failed > 0 ? Palette.danger : Palette.chrome-text;
                font-size: ChatText.label;
                font-weight: 600;
                vertical-alignment: center;
                accessible-role: text;
                accessible-id: "helpers-title:" + root.card.key;
                accessible-label: self.text;
            }
        }
        for helper in root.card.helpers: HelperItem { helper: helper; }
    }
}
