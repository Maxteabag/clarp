import { Palette as WidgetPalette } from "std-widgets.slint";
import { Palette } from "theme.slint";
import { Sidebar, ChatRow } from "sidebar.slint";
import { NavRail } from "navrail.slint";
import { Attachment } from "composer.slint";
import { MessageRow, MessageBlock, TableRow, ToolRow } from "transcript.slint";
import { Workspace, PaneView, SplitView, WorkspaceTab } from "workspace.slint";
import { Switcher, SwitcherRow } from "switcher.slint";
import { Settings, SettingRow } from "settings.slint";

export { Palette, ChatRow, MessageRow, MessageBlock, TableRow, ToolRow, WidgetPalette, Attachment, PaneView, SplitView, WorkspaceTab, SwitcherRow, SettingRow }

export struct Hint {
    label: string,
    keys: string,
}

// ShortcutBar.qml: where the keyboard is, and what it can do there.
component ShortcutBar inherits Rectangle {
    in property <string> mode;
    in property <[Hint]> hints;
    in property <string> connection;
    height: 30px;
    background: Palette.sunken;
    Rectangle { y: 0; height: 1px; background: Palette.border; }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 16px;
        Text {
            text: root.mode;
            color: Palette.accent;
            font-size: 10px;
            font-weight: 700;
            vertical-alignment: center;
        }
        for hint in root.hints: HorizontalLayout {
            spacing: 5px;
            Text { text: hint.label + ":"; color: Palette.muted; font-size: 11px; vertical-alignment: center; }
            Text { text: hint.keys; color: Palette.accent; font-size: 11px; font-weight: 700; vertical-alignment: center; }
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: root.connection;
            color: root.connection == "live" ? Palette.success : Palette.warning;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    title: root.selected-name == "" ? "Clarp" : root.selected-name + " — Clarp";
    preferred-width: 1100px;
    preferred-height: 700px;
    background: Palette.window;
    // The chrome keeps the terminal face; the reading theme styles the
    // transcript and the composer (as in the Qt app).
    default-font-family: "JetBrains Mono";
    default-font-size: Palette.body-size;

    in property <[ChatRow]> chats;
    in property <[ChatRow]> rooms;
    in property <[ChatRow]> archived;
    in property <int> unread-rooms;
    in property <int> attention;
    in property <bool> muted;
    in property <string> server-initial;
    in-out property <string> surface: "chats";
    out property <string> query: sidebar.query;
    out property <string> scope: sidebar.scope;
    in property <string> selected-name;
    in property <string> connection;
    in property <string> error;
    in property <[PaneView]> panes;
    in property <[SplitView]> splits;
    in property <[WorkspaceTab]> workspaces;
    in property <string> save-warning;
    in property <bool> workspace-bar;
    in-out property <bool> sidebar-visible: true;
    in-out property <bool> shortcuts-visible: true;
    in property <string> keyboard-mode;
    in property <[Hint]> hints;
    // The chat the sidebar's keyboard cursor is on.
    in property <string> sidebar-cursor;
    out property <bool> search-focused: sidebar.search-has-focus;
    out property <bool> sidebar-focused: sidebar.list-has-focus;
    public function focus-search() { sidebar.focus-search(); }
    public function focus-sidebar() { sidebar.focus-list(); }

    callback chat-chosen(string);
    callback filter-changed();
    callback toggle-muted();
    callback open-switcher();
    callback link-clicked(string);
    callback dismiss-error();
    // Every key reaches the keyboard map first; true when it ran a command.
    callback shortcut(string, bool, bool, bool) -> bool;
    // Tells the map where the keyboard went.
    callback focus-moved();
    // Pane events carry the pane's id.
    callback pane-activated(string);
    callback send(string, string, bool);
    callback stop(string);
    callback draft-edited(string, string);
    callback attach(string);
    callback remove-attachment(string, string);
    callback load-older(string);
    callback toggle-activity(string, string, string);
    callback pane-reported(string, bool, bool, length, bool, bool);
    callback switch-workspace(string);
    callback create-workspace();
    callback save-layout-instead();
    callback resize-split(string, float);
    callback balance();
    in property <[SettingRow]> setting-rows;
    in-out property <int> setting-current;
    in property <bool> minimal-ui;
    out property <bool> settings-focused: settings.list-focused;
    public function focus-settings() { settings.focus-list(); }
    callback setting-changed(string, int);
    callback surface-chosen(string);
    callback sidebar-hide();
    callback run-command(string);
    in property <bool> switcher-open;
    in property <[SwitcherRow]> switcher-rows;
    in property <int> switcher-current;
    out property <string> switcher-query: switcher.query;
    callback switcher-edited(string);
    callback switcher-chosen(int);
    callback switcher-moved(int);
    callback switcher-dismissed();
    public function show-switcher() { switcher.open(); }

    changed search-focused => { root.focus-moved(); }
    changed sidebar-focused => { root.focus-moved(); }

    keys := FocusScope {
        focus-on-click: false;
        capture-key-pressed(event) => {
            if (root.shortcut(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift)) {
                return accept;
            }
            reject
        }
        HorizontalLayout {
            NavRail {
                surface: root.surface;
                attention: root.attention;
                muted: root.muted;
                server-initial: root.server-initial;
                select-surface(surface) => { root.surface-chosen(surface); }
                toggle-muted => { root.toggle-muted(); }
                open-switcher => { root.open-switcher(); }
            }
            sidebar := Sidebar {
                visible: root.sidebar-visible;
                width: root.sidebar-visible ? 320px : 0px;
                rows: root.chats;
                rooms: root.rooms;
                archived: root.archived;
                unread-rooms: root.unread-rooms;
                cursor: root.sidebar-cursor;
                minimal: root.minimal-ui;
                hide => { root.run-command("sidebar"); }
                new-agent => { root.run-command("new"); }
                chosen(session) => { root.chat-chosen(session); }
                filter-changed => { root.filter-changed(); }
            }
            if root.sidebar-visible: Rectangle { width: 1px; background: Palette.rule; }
            VerticalLayout {
                if root.error != "": Rectangle {
                    height: 36px;
                    background: Palette.danger-surface;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Text {
                            text: root.error;
                            color: Palette.danger;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            width: 28px;
                            accessible-role: button;
                            accessible-label: "Dismiss";
                            Image {
                                source: @image-url("../../../desktop/resources/icons/rail-close.svg");
                                width: 16px;
                                height: 16px;
                                colorize: Palette.danger;
                            }
                            TouchArea { clicked => { root.dismiss-error(); } }
                        }
                    }
                }
                // The surfaces share this area; the workspace stays alive
                // (its panes keep their place) while another shows.
                Rectangle {
                    vertical-stretch: 1;
                    Workspace {
                    visible: root.surface != "settings";
                    width: parent.width;
                    height: parent.height;
                    panes: root.panes;
                    splits: root.splits;
                    workspaces: root.workspaces;
                    save-warning: root.save-warning;
                    bar-visible: root.workspace-bar;
                    activate(id) => { root.pane-activated(id); }
                    send(id, text, queue) => { root.send(id, text, queue); }
                    stop(id) => { root.stop(id); }
                    draft-edited(id, text) => { root.draft-edited(id, text); }
                    attach(id) => { root.attach(id); }
                    remove-attachment(id, attachment) => { root.remove-attachment(id, attachment); }
                    link-clicked(url) => { root.link-clicked(url); }
                    load-older(id) => { root.load-older(id); }
                    toggle-activity(id, message, group) => { root.toggle-activity(id, message, group); }
                    reported(id, follows, at-end, offset, transcript, composer) => {
                        root.pane-reported(id, follows, at-end, offset, transcript, composer);
                    }
                    switch-workspace(id) => { root.switch-workspace(id); }
                    create-workspace => { root.create-workspace(); }
                    save-layout-instead => { root.save-layout-instead(); }
                    resize-split(id, ratio) => { root.resize-split(id, ratio); }
                    balance => { root.balance(); }
                }
                settings := Settings {
                    visible: root.surface == "settings";
                    width: parent.width;
                    height: parent.height;
                    rows: root.setting-rows;
                    current: root.setting-current;
                    moved(index) => { root.setting-current = index; }
                    activated(id) => { root.setting-changed(id, 1); }
                    adjusted(id, delta) => { root.setting-changed(id, delta); }
                }
                }
                if root.shortcuts-visible: ShortcutBar {
                    mode: root.keyboard-mode;
                    connection: root.connection;
                    hints: root.hints;
                }
            }
        }
        switcher := Switcher {
            visible: root.switcher-open;
            width: parent.width;
            height: parent.height;
            rows: root.switcher-rows;
            current: root.switcher-current;
            edited(text) => { root.switcher-edited(text); }
            chosen(index) => { root.switcher-chosen(index); }
            moved(index) => { root.switcher-moved(index); }
            dismissed => { root.switcher-dismissed(); }
        }
    }
}
