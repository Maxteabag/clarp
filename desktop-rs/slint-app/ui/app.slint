import { TextEdit, Button, Palette as WidgetPalette } from "std-widgets.slint";
import { Palette } from "theme.slint";
import { Sidebar, ChatRow } from "sidebar.slint";
import { NavRail } from "navrail.slint";
import { Transcript, MessageRow, MessageBlock, TableRow, ToolRow } from "transcript.slint";

export { Palette, ChatRow, MessageRow, MessageBlock, TableRow, ToolRow, WidgetPalette }

export component AppWindow inherits Window {
    title: root.selected-name == "" ? "Clarp" : root.selected-name + " — Clarp";
    preferred-width: 1100px;
    preferred-height: 700px;
    background: Palette.window;
    default-font-family: Palette.body-family;
    default-font-size: Palette.body-size;

    in property <[ChatRow]> chats;
    in property <[ChatRow]> rooms;
    in property <[ChatRow]> archived;
    in property <int> unread-rooms;
    in property <int> attention;
    in property <bool> muted;
    in property <string> server-initial;
    in-out property <string> surface: "chats";
    in property <string> selected-model;
    in property <string> selected-effort;
    out property <string> query: sidebar.query;
    out property <string> scope: sidebar.scope;
    in property <[MessageRow]> messages;
    in property <string> selected-name;
    in property <string> selected-detail;
    in property <string> connection;
    in property <string> error;
    in property <bool> sending;
    in property <bool> busy;
    in-out property <string> draft;
    callback chat-chosen(string);
    callback filter-changed();
    callback toggle-muted();
    callback open-switcher();
    callback link-clicked(string);
    callback toggle-activity(string, string);
    out property <bool> transcript-follows: transcript.follow;
    out property <bool> transcript-at-end: transcript.at-end;
    out property <length> transcript-offset: transcript.offset;
    out property <bool> transcript-focused: transcript.has-focus;
    public function focus-transcript() { transcript.focus(); }
    public function focus-composer() { composer.focus(); }
    callback send(string);
    callback stop();
    callback dismiss-error();

    forward-focus: composer;

    HorizontalLayout {
        NavRail {
            surface: root.surface;
            attention: root.attention;
            muted: root.muted;
            server-initial: root.server-initial;
            select-surface(surface) => { root.surface = surface; }
            toggle-muted => { root.toggle-muted(); }
            open-switcher => { root.open-switcher(); }
        }
        sidebar := Sidebar {
            width: 320px;
            rows: root.chats;
            rooms: root.rooms;
            archived: root.archived;
            unread-rooms: root.unread-rooms;
            chosen(session) => { root.chat-chosen(session); }
            filter-changed => { root.filter-changed(); }
        }
        Rectangle { width: 1px; background: Palette.rule; }
        VerticalLayout {
            // Header: the open chat and the connection.
            Rectangle {
                height: 48px;
                background: Palette.window;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 12px;
                    Text {
                        text: root.selected-name;
                        color: Palette.chrome-text;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.selected-detail;
                        color: Palette.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if root.selected-model != "": Text {
                        text: "model " + root.selected-model;
                        color: Palette.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    if root.selected-effort != "": Text {
                        text: "effort " + root.selected-effort;
                        color: Palette.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.connection;
                        color: root.connection == "live" ? Palette.success : Palette.warning;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }
            Rectangle { height: 1px; background: Palette.rule; }
            if root.error != "": Rectangle {
                height: 36px;
                background: Palette.danger-surface;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    Text {
                        text: root.error;
                        color: Palette.danger;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    TouchArea {
                        width: 80px;
                        clicked => { root.dismiss-error(); }
                        Text { text: "Dismiss"; color: Palette.chrome-text; }
                    }
                }
            }
            transcript := Transcript {
                vertical-stretch: 1;
                rows: root.messages;
                link-clicked(url) => { root.link-clicked(url); }
                toggle-activity(id, group) => { root.toggle-activity(id, group); }
            }
            Rectangle { height: 1px; background: Palette.rule; }
            // Composer: Enter sends, Shift+Enter is a new line.
            Rectangle {
                height: 96px;
                background: Palette.sunken;
                HorizontalLayout {
                    padding: 10px;
                    spacing: 10px;
                    keys := FocusScope {
                        horizontal-stretch: 1;
                        capture-key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                transcript.focus();
                                return accept;
                            }
                            if (event.text == Key.Return && !event.modifiers.shift) {
                                if (composer.text != "") {
                                    root.send(composer.text);
                                    composer.text = "";
                                }
                                return accept;
                            }
                            reject
                        }
                        composer := TextEdit {
                            text <=> root.draft;
                            wrap: word-wrap;
                            font-size: Palette.body-size;
                        }
                    }
                    Button {
                        text: root.busy ? "Stop" : "Send";
                        enabled: root.busy || composer.text != "";
                        clicked => {
                            if (root.busy) { root.stop(); }
                            else if (composer.text != "") { root.send(composer.text); composer.text = ""; }
                        }
                    }
                }
            }
        }
    }
}
