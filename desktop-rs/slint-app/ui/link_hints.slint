import { Palette } from "theme.slint";

// One link on screen with its number, drawn just above the link's first
// letters (window coordinates). A link shown twice carries its number at
// each place.
export struct LinkBadge {
    label: string,
    url: string,
    x: length,
    y: length,
    // The digits typed so far rule it out: hidden.
    dim: bool,
}

// Link hints (Vimium's): every link in the active chat's viewport gets a
// number; typing it opens the link. The badges float over the chat, so
// nothing moves or re-lays out while they show.
export global LinkHints {
    in property <bool> active;
    in property <[LinkBadge]> badges;
    // The digits typed so far ("1" of "12").
    in property <string> typed;
}

export component LinkHintLayer inherits Rectangle {
    // A number the typed digits rule out goes (its link shows whole again).
    for badge in LinkHints.badges: Rectangle {
        visible: !badge.dim;
        x: badge.x - 2px;
        y: badge.y;
        width: Math.max(16px, label.preferred-width + 8px);
        height: 16px;
        border-radius: 3px;
        background: Palette.accent;
        border-width: 1px;
        border-color: Palette.window;
        accessible-role: text;
        accessible-label: "Link " + badge.label + ": " + badge.url;
        label := Text {
            text: badge.label;
            color: Palette.accent-text;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}
