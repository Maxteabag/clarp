import { Button, ComboBox, ListView, Spinner } from "std-widgets.slint";
import { Field, Editor } from "fields.slint";
import { Palette, Look } from "theme.slint";
import { Modal } from "dialogs.slint";
import { IconButton } from "updates.slint";

export struct TeamView {
    id: string,
    name: string,
    initial: string,
    colour: color,
    depth: int,
    unread: int,
    subtitle: string,
    selected: bool,
}

export struct TeamMessageView {
    source: string,
    text: string,
    session: string,
}

export struct TeamMemberView {
    id: string,
    name: string,
}

// TeamsPanel.qml: the team list, and the selected team's members and
// messages. Team actions (edit, leader nudging, delete) are icon buttons in
// its header; create, edit, add member and delete open dialogs.
// i18n-screen: teams
export component Teams inherits Rectangle {
    in property <[TeamView]> teams;
    in property <[TeamMessageView]> messages;
    in property <[TeamMemberView]> members;
    in property <string> selected;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> nudging;
    in property <bool> loading;
    in property <string> error;
    in property <bool> grouped: true;
    callback select(string);
    callback refresh();
    callback toggle-grouping();
    callback create();
    callback edit();
    callback toggle-nudging();
    callback delete();
    callback add-member();
    callback remove-member(string);
    callback open-chat(string);
    background: Palette.window;
    // Holds the keyboard while the surface shows (keys go to the keyboard map).
    public function take-focus() { keys.focus(); }
    out property <bool> focused: keys.has-focus;
    keys := FocusScope { }
    VerticalLayout {
        HorizontalLayout {
            height: 54px;
            padding-left: 16px;
            padding-right: 12px;
            spacing: 9px;
            Text {
                // i18n: Teams page, title at the top (noun), written in capitals where the script has them
                text: @tr("TEAMS");
                color: Palette.text;
                font-size: 17 * Look.unit;
                font-weight: 600;
                letter-spacing: 1.5px;
                vertical-alignment: center;
            }
            // i18n: Teams page, count beside the title; {n} is how many teams there are
            Text { text: @tr("{n} team" | "{n} teams" % root.teams.length); color: Palette.muted; font-size: 11 * Look.unit; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            if root.loading: Spinner { width: 18px; height: 18px; y: 18px; indeterminate: true; }
            Button {
                text: root.grouped
                    // i18n: Teams page, header button showing the current layout of the team list: teams nested under their parent team (adjective); clicking switches to Flat
                    ? @tr("team layout" => "Grouped")
                    // i18n: Teams page, header button showing the current layout of the team list: all teams in one plain list (adjective); clicking switches to Grouped
                    : @tr("Flat");
                // i18n: Teams page, accessibility label of the Grouped/Flat button (an action: switch between nested and flat team list)
                accessible-label: @tr("Switch team grouping");
                y: 11px;
                height: 32px;
                clicked => { root.toggle-grouping(); }
            }
            IconButton {
                y: 13px;
                icon: @image-url("icons/plus.svg");
                // i18n: Teams page, header icon button tooltip and accessibility label: creates a new team
                label: @tr("New team");
                clicked => { root.create(); }
            }
            IconButton {
                y: 13px;
                icon: @image-url("icons/refresh.svg");
                // i18n: Teams page, header icon button tooltip and accessibility label: reloads the team list (an action)
                label: @tr("Refresh teams");
                clicked => { root.refresh(); }
            }
        }
        Rectangle { height: 1px; background: Palette.border; }
        if root.error != "": Rectangle {
            height: 34px;
            background: Palette.danger-surface;
            Text {
                x: 8px;
                width: parent.width - 16px;
                text: root.error;
                color: Palette.danger;
                font-size: 12 * Look.unit;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            ListView {
                width: 280px;
                for team in root.teams: Rectangle {
                    height: 66px;
                    Rectangle {
                        x: 8px;
                        y: 4px;
                        width: parent.width - 16px;
                        height: 62px;
                        border-radius: 3px;
                        background: team.selected ? Palette.border : touch.has-hover ? Palette.control : transparent;
                        border-width: team.selected ? 1px : 0px;
                        border-color: Palette.muted;
                        accessible-role: list-item;
                        accessible-label: team.name;
                        touch := TouchArea { clicked => { root.select(team.id); } }
                        HorizontalLayout {
                            padding-left: 8px + Math.min(team.depth, 5) * 14px;
                            padding-right: 8px;
                            spacing: 9px;
                            Rectangle {
                                width: 34px;
                                height: 34px;
                                y: 14px;
                                border-radius: 3px;
                                background: team.colour;
                                Text { text: team.initial; color: Palette.text; font-size: 15 * Look.unit; font-weight: 600; }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text { text: team.name; color: Palette.text; font-size: 13 * Look.unit; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
                                    if team.unread > 0: Rectangle {
                                        width: 18px;
                                        height: 16px;
                                        border-radius: 3px;
                                        background: Palette.chrome-text;
                                        Text { text: team.unread; color: Palette.window; font-size: 11 * Look.unit; }
                                    }
                                }
                                Text { text: team.subtitle; color: Palette.muted; font-size: 11 * Look.unit; overflow: elide; }
                            }
                        }
                    }
                }
            }
            Rectangle { width: 1px; background: Palette.rule; }
            Rectangle {
                horizontal-stretch: 1;
                background: Palette.raised;
                VerticalLayout {
                    Rectangle {
                        height: 54px;
                        background: Palette.control;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 10px;
                            spacing: 6px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                Text { text: root.title; color: Palette.text; font-size: 14 * Look.unit; font-weight: 600; overflow: elide; }
                                if root.subtitle != "": Text { text: root.subtitle; color: Palette.muted; font-size: 11 * Look.unit; overflow: elide; }
                            }
                            if root.selected != "": IconButton {
                                y: 13px;
                                icon: @image-url("icons/edit.svg");
                                // i18n: Teams page, selected team's header, icon button tooltip and accessibility label: opens the edit dialog (an action)
                                label: @tr("Edit team");
                                clicked => { root.edit(); }
                            }
                            if root.selected != "": IconButton {
                                y: 13px;
                                icon: root.nudging ? @image-url("icons/nudge.svg") : @image-url("icons/nudge-off.svg");
                                tint: root.nudging ? Palette.accent : Palette.muted;
                                label: root.nudging
                                    // i18n: Teams page, selected team's header, icon button tooltip (an action): stops prompting the team leader to act on new team activity or stalled work
                                    ? @tr("Disable leader nudging")
                                    // i18n: Teams page, selected team's header, icon button tooltip (an action): starts prompting the team leader to act on new team activity or stalled work
                                    : @tr("Enable leader nudging");
                                clicked => { root.toggle-nudging(); }
                            }
                            if root.selected != "": IconButton {
                                y: 13px;
                                icon: @image-url("icons/delete.svg");
                                tint: Palette.danger;
                                // i18n: Teams page, selected team's header, icon button tooltip (an action): opens a confirmation to delete the team
                                label: @tr("Delete team…");
                                clicked => { root.delete(); }
                            }
                        }
                    }
                    if root.selected != "": Rectangle {
                        height: 42px;
                        background: Palette.raised;
                        border-width: 1px;
                        border-color: Palette.border;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: start;
                            for member in root.members: Rectangle {
                                y: 8px;
                                height: 25px;
                                border-radius: 3px;
                                background: Palette.border;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 2px;
                                    spacing: 2px;
                                    Text { text: member.name; color: Palette.text; font-size: 11 * Look.unit; vertical-alignment: center; }
                                    IconButton {
                                        y: 3px;
                                        size: 19px;
                                        icon: @image-url("icons/rail-close.svg");
                                        // i18n: Teams page, member chip, small close button tooltip and accessibility label (an action); {} is the agent's name
                                        label: @tr("Remove member {}", member.name);
                                        clicked => { root.remove-member(member.id); }
                                    }
                                }
                            }
                            Rectangle {
                                y: 8px;
                                height: 25px;
                                width: add.preferred-width + 16px;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Palette.border;
                                background: add-touch.has-hover ? Palette.hover : transparent;
                                accessible-role: button;
                                // i18n: Teams page, accessibility label of the "+ member" button after the member chips (an action: add an agent to the team)
                                accessible-label: @tr("Add team member");
                                // i18n: Teams page, small button after the member chips: adds an agent to the team; keep it short, the + means add
                                add := Text { text: @tr("+ member"); color: Palette.chrome-text; font-size: 11 * Look.unit; }
                                add-touch := TouchArea { clicked => { root.add-member(); } }
                            }
                        }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for message in root.messages: VerticalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 7px;
                            Rectangle {
                                background: Palette.control;
                                border-radius: 3px;
                                VerticalLayout {
                                    padding: 9px;
                                    spacing: 5px;
                                    HorizontalLayout {
                                        Text { text: message.source; color: Palette.chrome-text; font-size: 12 * Look.unit; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                                        // i18n: Teams page, button on a team message (verb): opens the chat with the agent that sent it
                                        if message.session != "": Button { text: @tr("Open chat"); clicked => { root.open-chat(message.session); } }
                                    }
                                    Text { text: message.text; color: Palette.chrome-text; font-size: 13 * Look.unit; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                }
                if root.messages.length == 0 && !root.loading: Text {
                    y: parent.height / 2;
                    horizontal-alignment: center;
                    text: root.selected != ""
                        // i18n: Teams page, empty state in the message list when the selected team has no messages
                        ? @tr("No team messages yet")
                        // i18n: Teams page, empty state when no team is selected: asks the user to pick one from the list
                        : @tr("Choose a team");
                    color: Palette.muted;
                    font-size: 12 * Look.unit;
                }
            }
        }
    }
}

// Create team: a name (Enter or the check creates it).
// i18n-screen: create team
export component TeamCreateDialog inherits Modal {
    callback create(string);
    callback done();
    public function open() { name.text = ""; name.focus(); }
    card-width: 380px;
    card-height: 190px;
    dismissed => { root.done(); }
    VerticalLayout {
        padding: 20px;
        spacing: 10px;
        // i18n: Create team dialog, title
        Text { text: @tr("Create team"); color: Palette.text; font-size: 17 * Look.unit; font-weight: 600; }
        // i18n: Create team dialog, label above the name field (noun)
        Text { text: @tr("Team name"); color: Palette.muted; font-size: 12 * Look.unit; }
        name := Field {
            // i18n: Create team dialog, placeholder in the name field: an example team name
            placeholder-text: @tr("e.g. Release crew");
            // i18n: Create team dialog, accessibility label of the name field (noun)
            accessible-label: @tr("Team name");
            accepted => { root.create(self.text); }
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            // i18n: Team dialog, close icon button tooltip (verb): closes the dialog without changes
            IconButton { icon: @image-url("icons/rail-close.svg"); label: @tr("Cancel"); clicked => { root.done(); } }
            // i18n: Create team dialog, check icon button tooltip (verb): creates the team
            IconButton { icon: @image-url("icons/check.svg"); tint: Palette.accent; label: @tr("Create"); clicked => { root.create(name.text); } }
        }
    }
}

// Edit team: name, colour and leader (one of its members, or none).
// i18n-screen: edit team
export component TeamEditDialog inherits Modal {
    in property <[string]> leaders;
    in-out property <int> leader-index;
    callback save(string, string, int);
    callback done();
    public function open(team-name: string, team-colour: string) {
        name.text = team-name;
        colour.text = team-colour;
        name.focus();
    }
    card-width: 400px;
    card-height: 330px;
    dismissed => { root.done(); }
    VerticalLayout {
        padding: 20px;
        spacing: 8px;
        // i18n: Edit team dialog, title
        Text { text: @tr("Edit team"); color: Palette.text; font-size: 17 * Look.unit; font-weight: 600; }
        // i18n: Edit team dialog, label above the team name field (noun)
        Text { text: @tr("Name"); color: Palette.muted; font-size: 12 * Look.unit; }
        // i18n: Edit team dialog, accessibility label of the team name field (noun)
        name := Field { accessible-label: @tr("Name"); accepted => { root.save(name.text, colour.text, root.leader-index); } }
        // i18n: Edit team dialog, label above the team colour field (noun); the colour is typed as a hex code like #8f96bc
        Text { text: @tr("Color"); color: Palette.muted; font-size: 12 * Look.unit; }
        // i18n: Edit team dialog, accessibility label of the team colour field (noun)
        colour := Field { placeholder-text: "#8f96bc"; accessible-label: @tr("Color"); accepted => { root.save(name.text, colour.text, root.leader-index); } }
        // i18n: Edit team dialog, label above the picker of the team's leader (noun: the member agent who leads the team)
        Text { text: @tr("team" => "Leader"); color: Palette.muted; font-size: 12 * Look.unit; }
        ComboBox {
            model: root.leaders;
            current-index <=> root.leader-index;
            // i18n: Edit team dialog, accessibility label of the leader picker (noun)
            accessible-label: @tr("team" => "Leader");
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            // i18n: Team dialog, close icon button tooltip (verb): closes the dialog without changes
            IconButton { icon: @image-url("icons/rail-close.svg"); label: @tr("Cancel"); clicked => { root.done(); } }
            // i18n: Edit team dialog, check icon button tooltip (verb): saves the changes
            IconButton { icon: @image-url("icons/check.svg"); tint: Palette.accent; label: @tr("Save"); clicked => { root.save(name.text, colour.text, root.leader-index); } }
        }
    }
}

// Add team member: one of the roster's agents.
// i18n-screen: add team member
export component TeamMemberDialog inherits Modal {
    in property <[string]> agents;
    in-out property <int> agent-index;
    callback add(int);
    callback done();
    card-width: 380px;
    card-height: 190px;
    dismissed => { root.done(); }
    VerticalLayout {
        padding: 20px;
        spacing: 10px;
        // i18n: Add team member dialog, title
        Text { text: @tr("Add team member"); color: Palette.text; font-size: 17 * Look.unit; font-weight: 600; }
        // i18n: Add team member dialog, label above the picker of agents (noun)
        Text { text: @tr("Agent"); color: Palette.muted; font-size: 12 * Look.unit; }
        // i18n: Add team member dialog, accessibility label of the agent picker (noun)
        ComboBox { model: root.agents; current-index <=> root.agent-index; accessible-label: @tr("Agent"); }
        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            // i18n: Team dialog, close icon button tooltip (verb): closes the dialog without changes
            IconButton { icon: @image-url("icons/rail-close.svg"); label: @tr("Cancel"); clicked => { root.done(); } }
            // i18n: Add team member dialog, check icon button tooltip (verb): adds the chosen agent to the team
            IconButton { icon: @image-url("icons/check.svg"); tint: Palette.accent; label: @tr("Add"); clicked => { root.add(root.agent-index); } }
        }
    }
}

// Delete team?: removes the team and its history.
// i18n-screen: delete team
export component TeamDeleteDialog inherits Modal {
    in property <string> team;
    callback confirm();
    callback done();
    card-width: 380px;
    card-height: 160px;
    dismissed => { root.done(); }
    VerticalLayout {
        padding: 20px;
        spacing: 10px;
        // i18n: Delete team dialog, title: asks to confirm deleting the team
        Text { text: @tr("Delete team?"); color: Palette.text; font-size: 17 * Look.unit; font-weight: 600; }
        // i18n: Delete team dialog, explanation under the title
        Text { text: @tr("This removes the team and its history."); color: Palette.chrome-text; font-size: 13 * Look.unit; wrap: word-wrap; }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            // i18n: Team dialog, close icon button tooltip (verb): closes the dialog without changes
            IconButton { icon: @image-url("icons/rail-close.svg"); label: @tr("Cancel"); clicked => { root.done(); } }
            // i18n: Delete team dialog, red delete icon button tooltip (an action); {} is the team's name
            IconButton { icon: @image-url("icons/delete.svg"); tint: Palette.danger; label: @tr("Delete {}", root.team); clicked => { root.confirm(); } }
        }
    }
}
