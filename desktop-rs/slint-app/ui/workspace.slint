import { Palette, Focus, FocusRing, Frame, PaneFrame, ChatLook, Look, VimBridge, ChatText, SendFlight, ChromeText } from "theme.slint";
import { Composer, Attachment, MentionRow, TipButton, ComposerKeys, QueueStrip, WaitingTurn } from "composer.slint";
import { Transcript, MessageRow, MeasureRow } from "transcript.slint";
import { AgentDialogs } from "agent_dialogs.slint";
import { TypingIndicator } from "cells.slint";
import { ProfileBridge } from "profile.slint";
import { KeyHint } from "artifacts.slint";

// Typing in one pane shows in the others on the same chat: the text goes
// here (bumping `set`) for each pane on `session` but `except`, so a key
// changes the composers' text, not every pane's whole row.
export global DraftMirror {
    in-out property <string> session;
    in-out property <string> except;
    in-out property <string> text;
    in-out property <int> set;
}

// A choice in the chat's "⋯" menu (#653): its value, its words, and
// whether it is the chat's choice now.
export struct ChatChoice {
    value: string,
    label: string,
    current: bool,
}

// The chat's "⋯" menu on its pane's frame (#653): the chat's own Tool
// activity (this device's) and, on a Host that offers it, its own choice
// for messages between agents (the Host's), each a submenu that shows its
// current value. Filled when it opens.
export global ChatMenu {
    // The pane whose menu is open ("" for none), and its open submenu
    // ("", "activity" or "coordination").
    in-out property <string> open;
    in-out property <string> submenu;
    in property <bool> coordination-shown;
    in property <string> coordination-label;
    in property <string> activity-label;
    in property <[ChatChoice]> coordination-choices;
    in property <[ChatChoice]> activity-choices;
    // Conversation or Session view (#702), on a Host that offers it; Tool
    // activity applies only in Session view, so Conversation leaves it out.
    in property <bool> view-shown;
    in property <string> view-label;
    in property <[ChatChoice]> view-choices;
    in property <bool> activity-shown: true;
    // Snooze (triage.rs): "Off" or until when, and its choices.
    in property <string> snooze-label;
    in property <[ChatChoice]> snooze-choices;
    callback opened(string);
    callback pick(string, string);
    // Opens the chat's agent's artifacts (its profile's Artifacts).
    callback artifacts();
}

component ChatMenuItem inherits Rectangle {
    in property <string> text;
    in property <string> value;
    in property <string> id;
    in property <image> icon;
    callback clicked();
    height: 26px;
    background: touch.has-hover ? Palette.hover : transparent;
    accessible-role: button;
    accessible-id: root.id;
    accessible-label: root.value != "" ? root.text + ": " + root.value : root.text;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        if root.icon.width > 0: Image { source: root.icon; width: 12 * Look.unit; height: 12 * Look.unit; colorize: Palette.muted; y: (parent.height - self.height) / 2; }
        Text { text: root.text; color: Palette.text; font-size: 12 * Look.unit; vertical-alignment: center; horizontal-stretch: 1; }
        if root.value != "": Text { text: root.value + "  ›"; color: Palette.muted; font-size: 12 * Look.unit; vertical-alignment: center; }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// One pane of the workspace: where it sits (fractions of the workspace),
// the chat it shows, and that chat's composer state. The counters ask the
// pane to act (focus its composer or transcript, jump to the latest) when
// they change.
export struct PaneView {
    id: string,
    session: string,
    name: string,
    workspace-kind: string,
    workspace-label: string,
    model: string,
    effort: string,
    // The agent's status line and the effort its provider runs at unset.
    status: string,
    // Its Host badge ("" for none) and "Moved to <Host>" (both start the
    // status line).
    host: string,
    moved: string,
    // "Moving to Codex… Starting" while the agent changes backend (#723).
    moving: string,
    default-effort: string,
    busy: bool,
    // "Working…" under the transcript (Show when ready, agent working).
    working: bool,
    // Live items' status line ("" when idle), whether the agent works (the
    // interrupt key works) and that key.
    live-status: string,
    live-busy: bool,
    live-stop-key: string,
    pair: bool,
    x: float,
    y: float,
    width: float,
    height: float,
    shown: bool,
    active: bool,
    messages: [MessageRow],
    // The scroll book's: rows to measure, and where each row starts (px).
    measure: [MeasureRow],
    before: [float],
    draft: string,
    // Bumped when `draft` should replace what the composer holds (another
    // chat, a send, the same chat typed in another pane).
    draft-set: int,
    attachments: [Attachment],
    queued: int,
    // A Stop paused the queue: its messages wait until sent.
    queue-paused: bool,
    // The waiting messages the queue strip lists (the open chat's, once
    // its queue is loaded; at most three), and the Host's answer to a
    // refused Send now.
    waiting: [WaitingTurn],
    waiting-refused: string,
    // The waiting line's action ("steer", "take-over", "send" or ""), the
    // message it acts on and its word.
    chip-kind: string,
    chip-target: string,
    chip-label: string,
    // The user's own waiting messages (#920), the dim reason before Stop and
    // send, and whether the line's action runs now.
    chip-count: int,
    chip-reason: string,
    chip-acting: bool,
    // The composer frame's meter: the context the agent's conversation
    // holds ("21K / 1M · 2%"), and its account's limit when near or used
    // up; "" when unknown. `meter-warn` draws it in the warning colour.
    meter: string,
    meter-warn: bool,
    quota-notice: string,
    // What the last Stop did, who stopped it and why (engine stop_notice).
    stop-notice: string,
    // The working indicator while the turn seems stuck and the Host offers
    // Stop (#249; the words are core stall.rs's), and the Stop button's label.
    stall: string,
    stall-stop: string,
    // Why the agent cannot answer now (#918; the words are core
    // availability.rs's): "Restarting · back in ~20 s", "" while it can.
    // It takes the place of the header's status and "working".
    availability: string,
    can-send: bool,
    transcribing: int,
    recording: bool,
    playing: bool,
    focus-composer: int,
    focus-transcript: int,
    to-latest: int,
    // Bumped to scroll the transcript by `scroll-amount` px (J/K bringing
    // a card into view: an explicit keypress, never activity).
    scroll-request: int,
    scroll-amount: float,
    // Bumped to bring row `seek-index` into view by the rows' measured
    // heights (J/K to a card the list has not drawn; `seek-down`: going
    // down the chat).
    seek-request: int,
    seek-index: int,
    seek-down: bool,
    // Bumped when the reader stops the chat's turn: what the stop settles
    // never moves them (#846).
    stopped: int,
    // Message search: the row drawn marked, and a request (bumped) to
    // bring the row at `reveal-index` into view.
    marked: string,
    reveal-request: int,
    reveal-index: int,
    // @-mentions: the agents matching the `@` being typed, the chosen one,
    // and the agent Enter sends to ("" for this chat).
    mentions: [MentionRow],
    mention-current: int,
    route: string,
    // One more than where the cursor goes when `draft-set` replaces the
    // draft (a completed mention); 0 leaves it.
    draft-cursor: int,
    // Scrolled up from the end, the chat's latest row changed (a new
    // message, a reply still being written): the jump button says so.
    news: bool,
    // What the amount counts: px (""), "pages" of the view, or the "row"
    // to bring to the top (vim mode's jumps).
    scroll-kind: string,
}

export struct SplitView {
    id: string,
    vertical: bool,
    x: float,
    y: float,
    width: float,
    height: float,
    ratio: float,
}

export struct WorkspaceTab {
    id: string,
    name: string,
    active: bool,
}

// PaneLeaf.qml + ConversationPane.qml.
export component Pane inherits Rectangle {
    // The header's quiet line: what is set, joined by dots, none trailing.
    property <string> header-info: root.join-info(root.join-info(root.join-info(root.pane.host, root.pane.moved), root.pane.moving),
        root.pane.availability != "" ? root.pane.availability : root.join-info(root.pane.status, root.pane.busy ? "working" : ""));
    pure function join-info(a: string, b: string) -> string {
        return a == "" ? b : b == "" ? a : a + "  ·  " + b;
    }
    // A pane may shrink to whatever the window gives it (min-width 0): its
    // chat and composer wrap or clip inside instead of widening the layout.
    min-width: 0px;
    in property <PaneView> pane;
    callback activate();
    // Sends the draft; the id of the message's row in this chat, or "" (not
    // sent, or sent to another agent's chat).
    callback send(string, bool) -> string;
    callback stop();
    callback draft-edited(string);
    callback attach();
    callback remove-attachment(string);
    callback link-clicked(string);
    callback load-older();
    // The transcript's scroll journal (Transcript.journal).
    callback scroll-journal(string, length, length, float, float, length, length, bool, bool, int);
    callback toggle-activity(string, string);
    callback copy-message(string);
    callback select-message(string);
    callback silence();
    callback cancel-transcription();
    callback paste-image() -> bool;
    // The transcript and composer tell the window where the keyboard is and
    // whether the reader follows, for shortcuts and checks.
    callback reported(bool, bool, length, bool, bool, int);
    background: root.pane.active ? Palette.control : Palette.raised;
    border-width: 0px;
    border-radius: 3px;
    clip: true;
    opacity: root.pane.active ? 1 : 0.76;
    animate opacity { duration: 120ms; }

    function report() {
        root.reported(transcript.follow, transcript.at-end, transcript.offset, transcript.has-focus, composer.editor-focused, transcript.top-row);
    }
    // A pane made for a request (a split's focus) acts on it at once.
    // An old scroll request is not replayed into a pane made later.
    init => { root.scroll-request-seen = root.pane.scroll-request; root.seek-request-seen = root.pane.seek-request; root.reveal-request-seen = root.pane.reveal-request; root.stopped-seen = root.pane.stopped; root.apply-requests(); }
    changed pane => { root.apply-requests(); }
    property <int> mirror-set: DraftMirror.set;
    changed mirror-set => {
        if (DraftMirror.session == root.pane.session && DraftMirror.except != root.pane.id) {
            composer.draft = DraftMirror.text;
        }
    }
    function apply-requests() {
        if (root.draft-set-seen != root.pane.draft-set) {
            root.draft-set-seen = root.pane.draft-set;
            composer.draft = root.pane.draft;
            if (root.pane.draft-cursor > 0) {
                composer.set-cursor(root.pane.draft-cursor - 1);
            }
        }
        if (root.focus-composer-seen != root.pane.focus-composer) {
            root.focus-composer-seen = root.pane.focus-composer;
            root.pending-focus = "composer";
        }
        if (root.focus-transcript-seen != root.pane.focus-transcript) {
            root.focus-transcript-seen = root.pane.focus-transcript;
            root.pending-focus = "transcript";
        }
        if (root.to-latest-seen != root.pane.to-latest) {
            root.to-latest-seen = root.pane.to-latest;
            transcript.scroll-to-latest();
        }
        if (root.scroll-request-seen != root.pane.scroll-request) {
            root.scroll-request-seen = root.pane.scroll-request;
            if (root.pane.scroll-kind == "row") {
                transcript.go-to-row(Math.round(root.pane.scroll-amount));
            } else if (root.pane.scroll-kind == "pages") {
                transcript.scroll-pages(root.pane.scroll-amount);
            } else {
                transcript.scroll-by(root.pane.scroll-amount * 1px, "seek");
            }
        }
        if (root.seek-request-seen != root.pane.seek-request) {
            root.seek-request-seen = root.pane.seek-request;
            transcript.seek-row(root.pane.seek-index, root.pane.seek-down);
        }
        if (root.stopped-seen != root.pane.stopped) {
            root.stopped-seen = root.pane.stopped;
            transcript.reader-stopped();
        }
        if (root.reveal-request-seen != root.pane.reveal-request) {
            root.reveal-request-seen = root.pane.reveal-request;
            transcript.reveal(root.pane.reveal-index);
        }
    }
    // Focus moves once the pane is live: a new pane's composer, or one just
    // enabled by its chat, cannot take the keyboard in the same update.
    property <string> pending-focus;
    Timer {
        interval: 1ms;
        running: root.pending-focus != "";
        triggered => {
            if (root.pending-focus == "composer") { composer.focus(); } else { transcript.focus(); }
            root.pending-focus = "";
        }
    }
    // The send animation (Telegram's, timed as the iPhone's: SendFlight).
    // A copy of the composer's text waits on the composer until the new
    // bubble is laid out, then springs to the bubble's frame, taking on its
    // corners, text size and wash; landed, the real bubble shows at once
    // under it and the copy fades out. The composer clears and shrinks with
    // a spring of its own. One overlay moves; the chat's rows stay as they
    // are laid out (the new one hidden until the copy lands on it). Reduce
    // Motion, a send with no text, one with attachments or a draft longer
    // than the box shows fades the bubble in instead. No bubble laid out
    // in time: no copy, the bubble shows. A reader scrolled up gets the
    // usual jump to the latest, with no copy.
    property <string> flight-id;
    // A copy flies (else the bubble fades in).
    property <bool> copying;
    // The clocks start on the first frame after the send (the send itself
    // and the frame that lays out the new row can take a while on a slow
    // machine): the first frame drawn shows the copy still in the box.
    property <bool> armed;
    property <duration> sent-at;
    // The bubble is laid out (where the copy goes is known), and when.
    property <bool> placed;
    property <duration> placed-at;
    // The composer is shrinking after a send.
    property <bool> boxing;
    property <duration> since-send: root.armed && (root.flight-id != "" || root.boxing) ? animation-tick() - root.sent-at : 0ms;
    property <duration> since-placed: root.placed && root.flight-id != "" ? animation-tick() - root.placed-at : 0ms;
    // A damped spring's progress `elapsed` into one of `length` and
    // `bounce` (as SwiftUI's spring(duration:bounce:): a period of
    // `length`, damping 1 - bounce), taken as there at `length`.
    pure function spring(elapsed: duration, length: duration, bounce: float) -> float {
        if (elapsed >= length) { return 1; }
        if (elapsed <= 0ms) { return 0; }
        let w = 2 * 3.14159265 / (length / 1s);
        let z = 1 - bounce;
        let t = elapsed / 1s;
        if (z >= 1) { return 1 - Math.exp(-w * t) * (1 + w * t); }
        let wd = w * Math.sqrt(1 - z * z);
        return 1 - Math.exp(-z * w * t) * (Math.cos(wd * t * 1rad) + z * w / wd * Math.sin(wd * t * 1rad));
    }
    // Where the copy is between the composer and the bubble.
    property <float> flight-t: !root.copying ? 1 : !root.placed ? 0 : root.spring(root.since-placed, SendFlight.flight, SendFlight.flight-bounce);
    property <float> box-t: root.spring(root.since-send, SendFlight.composer, SendFlight.composer-bounce);
    // Landed: the bubble shows under the copy, which fades and is gone.
    property <bool> settled: root.copying && root.placed && root.since-placed >= SendFlight.flight;
    property <float> copy-opacity: root.settled ? Math.clamp(1 - (root.since-placed - SendFlight.flight) / SendFlight.settle-fade, 0, 1) : 1;
    // Drawn from the send until 0.2 s after landing, to the frame.
    property <bool> copy-shown: root.copying && !(root.settled && root.since-placed >= SendFlight.flight + SendFlight.settle);
    // A fade's progress.
    property <float> fade-t: root.copying ? 1 : SendFlight.ease-out(root.since-send / SendFlight.fade);
    property <bool> flight-done: root.armed && (root.copying ? root.settled && root.since-placed >= SendFlight.flight + SendFlight.settle : root.since-send >= SendFlight.fade);
    // Where it flies from (in the pane) and the box's height then.
    property <length> from-x;
    property <length> from-y;
    property <length> from-width;
    property <length> from-height;
    property <length> box-from;
    property <string> flown-text;
    property <string> sent-id;
    // Where the bubble is drawn, once the chat has drawn it (else where
    // the copy started).
    property <bool> landing: transcript.flight-drawn-id == root.flight-id && root.flight-id != "";
    property <length> to-x: root.landing ? transcript.flight-x - root.absolute-position.x : root.from-x;
    property <length> to-y: root.landing ? transcript.flight-y - root.absolute-position.y : root.from-y;
    property <length> to-width: root.landing ? transcript.flight-width : root.from-width;
    property <length> to-height: root.landing ? transcript.flight-height : root.from-height;
    property <length> fly-x: root.from-x + (root.to-x - root.from-x) * root.flight-t;
    property <length> fly-y: root.from-y + (root.to-y - root.from-y) * root.flight-t;
    property <length> fly-width: root.from-width + (root.to-width - root.from-width) * root.flight-t;
    property <length> fly-height: root.from-height + (root.to-height - root.from-height) * root.flight-t;
    function sent(text: string, queue: bool) {
        // A copy needs text, all of it in view, and to be the bubble's
        // text: an attachment adds its path, and a draft longer than the
        // box shows fades in instead.
        let can-fly = text != "" && composer.attachments.length == 0 && composer.editor-text-height <= composer.editor-height + 1px;
        let at-end = transcript.follow && transcript.at-end;
        root.from-x = composer.editor-x - root.absolute-position.x;
        root.from-y = composer.editor-y - root.absolute-position.y;
        root.from-width = composer.editor-width;
        root.from-height = Math.min(composer.editor-text-height, composer.editor-height);
        root.box-from = composer-box.height;
        root.flown-text = text;
        root.land();
        root.sent-id = root.send(text, queue);
        if (root.sent-id == "" || !ChatLook.send-animation) {
            return;
        }
        root.boxing = !ChatLook.reduced-motion;
        root.armed = false;
        if (!at-end) {
            return;
        }
        root.copying = can-fly && !ChatLook.reduced-motion;
        root.placed = false;
        root.flight-id = root.sent-id;
        SendFlight.id = root.sent-id;
        SendFlight.phase = root.copying ? "wait" : "fade";
        SendFlight.from-x = composer.editor-x;
        SendFlight.from-y = composer.editor-y;
        SendFlight.from-width = root.from-width;
        SendFlight.from-height = root.from-height;
        SendFlight.started += 1;
    }
    // The animation is over (or another send takes its place): the row
    // shows as it is.
    function land() {
        root.boxing = false;
        if (root.flight-id != "") {
            SendFlight.gone-at = animation-tick();
            root.flight-id = "";
            root.copying = false;
            root.placed = false;
            SendFlight.phase = "";
            SendFlight.landed += 1;
        }
    }
    Timer {
        interval: 16ms;
        running: root.flight-id != "" || root.boxing;
        triggered => {
            if (!root.armed) {
                root.sent-at = animation-tick();
                root.armed = true;
                SendFlight.sent-at = root.sent-at;
            }
            if (root.copying && !root.placed) {
                if (root.landing) {
                    root.placed = true;
                    root.placed-at = animation-tick();
                    SendFlight.placed-at = root.placed-at;
                    SendFlight.phase = "flight";
                } else if (root.since-send >= SendFlight.destination-wait) {
                    // No bubble to fly to: no copy, the bubble shows.
                    SendFlight.dropped += 1;
                    root.land();
                    return;
                }
            }
            SendFlight.progress = root.flight-t;
            SendFlight.x = root.absolute-position.x + root.fly-x;
            SendFlight.y = root.absolute-position.y + root.fly-y;
            SendFlight.width = root.fly-width;
            SendFlight.height = root.fly-height;
            SendFlight.composer-height = composer-box.height;
            // Its spring is done by 0.3 s; the height follows a send's
            // spring only within 0.6 s of it.
            if (root.boxing && root.since-send >= SendFlight.composer-window) {
                root.boxing = false;
            }
            // The bookkeeping follows a frame behind what is drawn: the
            // moment it landed is the spring's end.
            if (root.settled && SendFlight.phase == "flight") {
                SendFlight.phase = "settle";
                SendFlight.settled-at = root.placed-at + SendFlight.flight;
                SendFlight.settle-seen-at = animation-tick();
            }
            if (root.flight-id != "" && root.flight-done) { root.land(); }
        }
    }
    property <int> draft-set-seen;
    property <int> focus-composer-seen;
    property <int> focus-transcript-seen;
    property <int> to-latest-seen;
    property <int> scroll-request-seen;
    property <int> seek-request-seen;
    property <int> stopped-seen;
    property <int> reveal-request-seen;
    property <bool> follows: transcript.follow;
    property <bool> at-end: transcript.at-end;
    property <length> offset: transcript.offset;
    property <bool> transcript-focused: transcript.has-focus;
    property <bool> composer-focused: composer.editor-focused;
    changed follows => { root.report(); }
    changed at-end => { root.report(); }
    changed offset => { root.report(); }
    property <int> top-row: transcript.top-row;
    changed top-row => { root.report(); }
    changed transcript-focused => { root.report(); if (self.transcript-focused) { root.activate(); } }
    changed composer-focused => { root.report(); if (self.composer-focused) { root.activate(); } }

    // A click anywhere but the composer makes the pane active.
    TouchArea {
        clicked => { ChatMenu.open = ""; root.activate(); }
    }
    // Folded, the composer is a line 16px high: a click that misses it by
    // a little (in the chat frame's bottom margin, the pane's padding under
    // it) still gives it the keyboard, rather than leaving Normal mode to
    // take the letters typed next as its keys. Under everything else, so
    // the chat, its rows and the working row's Stop keep their own clicks.
    if composer-box.folded && root.pane.session != "" && !root.pane.pair: TouchArea {
        x: composer-box.absolute-position.x - root.absolute-position.x;
        y: composer-box.absolute-position.y - root.absolute-position.y - Frame.bottom - 2px;
        width: composer-box.width;
        height: root.height - self.y;
        mouse-cursor: text;
        clicked => { composer.focus(); }
    }
    VerticalLayout {
        padding: 2px;
        // [c] Chat and [i] Insert: the pane's two keyboard regions, framed
        // as sqlit frames its panes.
        Rectangle {
          vertical-stretch: 1;
          // The pane may shrink to the window: the chat wraps inside it
          // rather than widening the layout past the window's edge.
          min-width: 0px;
          transcript := Transcript {
            // The pane's chat, found by link hints and the checks.
            accessible-role: list;
            accessible-id: "chat:" + root.pane.id;
            x: Frame.side;
            y: Frame.top;
            width: parent.width - 2 * Frame.side;
            height: parent.height - Frame.top - Frame.bottom;
            rows: root.pane.messages;
            pane-id: root.pane.id;
            measure: root.pane.measure;
            before: root.pane.before;
            marked: root.pane.marked;
            flight-id: root.flight-id;
            flight-reveal: root.copying ? (root.settled ? 1 : 0) : root.fade-t;
            busy: root.pane.busy;
            link-clicked(url) => { root.link-clicked(url); }
            toggle-activity(id, group) => { root.toggle-activity(id, group); }
            copy-message(id) => { root.copy-message(id); }
            select-message(id) => { root.select-message(id); }
            reached-top => { root.load-older(); }
            journal(cause, old, new, old-place, new-place, content, viewport, at-end, follow, rows) => { root.scroll-journal(cause, old, new, old-place, new-place, content, viewport, at-end, follow, rows); }
          }
          // In the composer letters type: Ctrl+H is the way back to the chat.
          // The agent's name sits on the right of the frame's border (there is
          // no separate header), with only what matters while reading: its
          // Host where there are several, a move, its status, working. The
          // folder, model and effort are one click away in its profile (the
          // owner's rubric: no detail every reader has to read past).
          PaneFrame {
            info-name: root.pane.session == "" ? "No agent selected" : root.pane.name;
            info: root.pane.session == "" || root.pane.pair ? root.pane.workspace-label
                : root.header-info;
            info-color: root.pane.session != "" && !root.pane.pair && root.pane.availability != "" ? Palette.warning : Palette.muted;
            info-id: "pane-info:" + root.pane.id;
            info-clicked => { if (root.pane.session != "" && !root.pane.pair) { ProfileBridge.open-for-pane(root.pane.id); } }
            // In vim mode the title says the mode, as Vim's last line does.
            key: root.pane.active && Focus.mode == "composer" ? (VimBridge.mode != "" ? "esc" : "ctrl+h") : "h";
            label: "Chat";
            right-room: root.pane.session != "" && !root.pane.pair ? 22px : 0px;
            active: root.pane.active && Focus.mode == "pane"; surface: root.background; }
          // The chat's "⋯" menu (#653), at the right end of the frame.
          if root.pane.session != "" && !root.pane.pair: Rectangle {
            x: parent.width - 10px - self.width;
            y: 0;
            width: 20px;
            height: 14px;
            background: root.background;
            accessible-role: button;
            accessible-id: "chat-menu:" + root.pane.id;
            accessible-label: "Chat menu";
            accessible-action-default => { ChatMenu.opened(root.pane.id); }
            Text {
                text: "⋯";
                color: menu-touch.has-hover || ChatMenu.open == root.pane.id ? Palette.accent : Palette.muted;
                font-size: 13 * Look.unit;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            menu-touch := TouchArea { mouse-cursor: pointer; clicked => { ChatMenu.opened(root.pane.id); } }
          }
          // Scrolled up from the end: a button back to the latest, as
          // Ctrl+End. It floats over the chat's corner and moves no row.
          if root.pane.session != "" && !transcript.at-end && root.pane.messages.length > 0: Rectangle {
            x: parent.width - Frame.side - self.width - 14px;
            y: parent.height - Frame.bottom - self.height - 10px;
            width: 34px;
            height: 34px;
            border-radius: 17px;
            background: Palette.raised;
            border-width: 1px;
            border-color: Palette.border;
            drop-shadow-blur: 6px;
            drop-shadow-color: #00000050;
            TipButton {
                x: 1px;
                y: 1px;
                icon: @image-url("icons/latest.svg");
                label: root.pane.news ? "Jump to latest, new messages below" : "Jump to latest";
                tip: (root.pane.news ? "New below · " : "") + (ComposerKeys.latest == "" ? "Latest" : "Latest · " + ComposerKeys.latest);
                accessible-id: "jump-latest:" + root.pane.id;
                clicked => { transcript.scroll-to-latest(); }
            }
            // New content arrived below since the reader scrolled up.
            if root.pane.news: Rectangle {
                x: parent.width - self.width + 1px;
                y: -1px;
                width: 11px;
                height: 11px;
                border-radius: 5.5px;
                background: Palette.accent;
                border-width: 2px;
                border-color: Palette.raised;
                accessible-role: text;
                accessible-id: "jump-news:" + root.pane.id;
                accessible-label: "New messages below";
            }
          }
          if ChatMenu.open == root.pane.id: Rectangle {
            x: parent.width - self.width - 10px;
            y: 16px;
            width: 280px;
            height: menu-list.preferred-height;
            border-radius: 2px;
            border-width: 1px;
            border-color: Palette.border;
            background: Palette.window;
            // Clicks inside stay inside.
            TouchArea { }
            menu-list := VerticalLayout {
                padding: 3px;
                if ChatMenu.submenu == "" && ChatMenu.coordination-shown: ChatMenuItem {
                    id: "chat-menu-coordination";
                    text: "Messages between agents";
                    value: ChatMenu.coordination-label;
                    clicked => { ChatMenu.submenu = "coordination"; }
                }
                if ChatMenu.submenu == "" && ChatMenu.view-shown: ChatMenuItem {
                    id: "chat-menu-view";
                    text: "Chat view";
                    value: ChatMenu.view-label;
                    clicked => { ChatMenu.submenu = "view"; }
                }
                if ChatMenu.submenu == "" && ChatMenu.activity-shown: ChatMenuItem {
                    id: "chat-menu-activity";
                    text: "Tool activity";
                    value: ChatMenu.activity-label;
                    clicked => { ChatMenu.submenu = "activity"; }
                }
                if ChatMenu.submenu == "": ChatMenuItem {
                    id: "chat-menu-snooze";
                    text: "Snooze";
                    value: ChatMenu.snooze-label;
                    clicked => { ChatMenu.submenu = "snooze"; }
                }
                // The agent's artifacts, as its profile's Artifacts shows them.
                if ChatMenu.submenu == "": ChatMenuItem {
                    id: "chat-menu-artifacts";
                    text: "Artifacts";
                    icon: @image-url("icons/artifacts.svg");
                    clicked => { ChatMenu.artifacts(); }
                }
                if ChatMenu.submenu == "coordination": VerticalLayout {
                    for choice in ChatMenu.coordination-choices: ChatMenuItem {
                        id: "chat-menu-coordination:" + choice.value;
                        text: (choice.current ? "✓  " : "     ") + choice.label;
                        clicked => { ChatMenu.pick("coordination", choice.value); }
                    }
                }
                if ChatMenu.submenu == "view": VerticalLayout {
                    for choice in ChatMenu.view-choices: ChatMenuItem {
                        id: "chat-menu-view:" + choice.value;
                        text: (choice.current ? "✓  " : "     ") + choice.label;
                        clicked => { ChatMenu.pick("view", choice.value); }
                    }
                }
                if ChatMenu.submenu == "snooze": VerticalLayout {
                    for choice in ChatMenu.snooze-choices: ChatMenuItem {
                        id: "chat-menu-snooze:" + choice.value;
                        text: (choice.current ? "✓  " : "     ") + choice.label;
                        clicked => { ChatMenu.pick("snooze", choice.value); }
                    }
                }
                if ChatMenu.submenu == "activity": VerticalLayout {
                    for choice in ChatMenu.activity-choices: ChatMenuItem {
                        id: "chat-menu-activity:" + choice.value;
                        text: (choice.current ? "✓  " : "     ") + choice.label;
                        clicked => { ChatMenu.pick("activity", choice.value); }
                    }
                }
            }
          }
        }
        // Live items' one status line (docs/live-items.md §7.4): what runs
        // and for how long by the Host's clock, and the key that stops it
        // while the agent works. Off unless Settings turn it on: the
        // running row shimmers in the chat and the shortcut bar names Stop.
        // A stalled turn (#249): the working indicator says it seems stuck,
        // whether the user's words wait, and holds the same Stop as Ctrl+.
        // It stands in for the status line and the typing dots.
        if root.pane.stall != "": Rectangle {
            background: Palette.window;
            height: 26px;
            accessible-role: text;
            accessible-id: "stall:" + root.pane.id;
            accessible-label: root.pane.stall;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 10px;
                Text {
                    text: "! " + root.pane.stall;
                    color: Palette.warning;
                    font-size: 12 * Look.unit;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                if root.pane.active: KeyHint {
                    y: 3px;
                    key: root.pane.live-stop-key;
                    label: root.pane.stall-stop;
                    accessible-id: "stall-stop:" + root.pane.id;
                    clicked => { root.stop(); }
                }
            }
        }
        if root.pane.stall == "" && root.pane.live-status != "" && ChatLook.live-status-line: Rectangle {
            background: Palette.window;
            height: 26px;
            accessible-role: text;
            accessible-id: "live-status:" + root.pane.id;
            accessible-label: root.pane.live-status;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 10px;
                Text {
                    text: root.pane.live-status;
                    color: root.pane.live-busy ? Palette.chrome-text : root.pane.live-status == "■ Interrupted" ? Palette.warning : Palette.muted;
                    font-size: 12 * Look.unit;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                if root.pane.live-busy && root.pane.live-stop-key != "" && root.pane.active: KeyHint {
                    y: 3px;
                    key: root.pane.live-stop-key;
                    label: "Stop";
                    clicked => { root.stop(); }
                }
            }
        }
        // The transcript's footer (ConversationPane.qml).
        if root.pane.stall == "" && root.pane.working: Rectangle {
            background: Palette.window;
            HorizontalLayout {
                padding-left: 14px;
                padding-top: 7px;
                padding-bottom: 7px;
                alignment: start;
                TypingIndicator { reduced-motion: ProfileBridge.reduced-motion; }
            }
            // The composer folded away holds no Stop: the working row does,
            // floating at its right end (the row keeps its height).
            if composer-box.folded && root.pane.busy && root.pane.session != "": TipButton {
                x: parent.width - self.width - 8px;
                y: (parent.height - self.height) / 2;
                width: self.captioned-width;
                height: 24px;
                icon: @image-url("icons/stop.svg");
                caption: "Stop";
                label: "Stop";
                tip: ComposerKeys.stop == "" ? "Stop" : "Stop · " + ComposerKeys.stop;
                tint: Palette.danger;
                accessible-id: "working-stop:" + root.pane.id;
                clicked => { root.stop(); }
            }
        }
        // The messages waiting behind the turn: one line, "1 waiting · Steer now".
        if (root.pane.chip-count > 0 || root.pane.chip-reason != "" || root.pane.waiting-refused != "") && !root.pane.pair: QueueStrip {
            items: root.pane.waiting;
            count: root.pane.chip-count;
            busy: root.pane.busy;
            paused: root.pane.queue-paused;
            refused: root.pane.waiting-refused;
            pane-id: root.pane.id;
            chip-kind: root.pane.chip-kind;
            chip-target: root.pane.chip-target;
            chip-label: root.pane.chip-label;
            reason: root.pane.chip-reason;
            acting: root.pane.chip-acting;
            act(kind, target) => { AgentDialogs.waiting-act(root.pane.session, kind, target); }
            manage => { AgentDialogs.queue-open(root.pane.session); }
        }
        // Pair rooms are the Host's read-only projection: no composer.
        composer-box := Rectangle {
          visible: !root.pane.pair;
          min-width: 0px;
          accessible-role: groupbox;
          accessible-id: "composer-box:" + root.pane.id;
          // Folded to its "[i] Insert" line until it has the keyboard (or
          // holds a draft, which stays in view).
          property <bool> folded: !composer.editor-focused && composer.draft == "";
          property <length> natural: root.pane.pair ? 0px : self.folded ? 16px : composer.preferred-height + Frame.top + Frame.bottom;
          // After a send it shrinks from its height then, with a spring.
          height: root.boxing ? root.box-from + (self.natural - root.box-from) * root.box-t : self.natural;
          clip: true;
          composer := Composer {
            x: Frame.side;
            y: Frame.top;
            width: parent.width - 2 * Frame.side;
            height: parent.height - Frame.top - Frame.bottom;
            init => { self.draft = root.pane.draft; root.draft-set-seen = root.pane.draft-set; }
            attachments: root.pane.attachments;
            queued: root.pane.queued;
            queue-paused: root.pane.queue-paused;
            strip-shown: root.pane.waiting.length > 0;
            quota-notice: root.pane.quota-notice;
            stop-notice: root.pane.stop-notice;
            busy: root.pane.busy;
            can-send: root.pane.can-send;
            transcribing: root.pane.transcribing;
            recording: root.pane.recording;
            playing: root.pane.playing && root.pane.active;
            silence => { root.silence(); }
            cancel-transcription => { root.cancel-transcription(); }
            paste-image => { return root.paste-image(); }
            active: root.pane.session != "";
            agent-name: root.pane.name;
            pane-id: root.pane.id;
            mentions: root.pane.mentions;
            mention-current: root.pane.mention-current;
            route: root.pane.route;
            send(text, queue) => { root.sent(text, queue); }
            stop => { root.stop(); }
            edited(text) => { root.draft-edited(text); }
            attach => { root.attach(); }
            remove-attachment(id) => { root.remove-attachment(id); }
            escape => { transcript.focus(); }
            jump-to-latest => { transcript.scroll-to-latest(); }
            queue-requested => { AgentDialogs.queue-open(root.pane.session); }
          }
          PaneFrame {
            key: "i";
            label: "Insert";
            active: root.pane.active && Focus.mode == "composer";
            surface: root.background;
            // The context and quota meter, quiet on the frame's right end.
            info: root.pane.meter;
            info-color: root.pane.meter-warn ? Palette.warning : Palette.faint;
            info-id: "composer-meter:" + root.pane.id;
          }
          // Folded, the editor is out of reach under the line: a click on
          // the line gives it the keyboard in the same event, so what is
          // typed straight after the click lands in the draft.
          if composer-box.folded && root.pane.session != "": TouchArea {
            mouse-cursor: text;
            clicked => { composer.focus(); }
          }
        }
    }
    // The sent text in flight: from the editor to the bubble, taking on
    // the bubble's colour, corners, padding and text size on the way; at
    // the bubble it fades over the real one.
    if root.copy-shown: Rectangle {
        accessible-role: text;
        accessible-id: "send-flight";
        accessible-label: flown.text;
        x: root.fly-x;
        y: root.fly-y;
        width: root.fly-width;
        height: root.fly-height;
        opacity: root.copy-opacity;
        background: Palette.bubble.with-alpha(Math.min(1, root.flight-t));
        // From the composer field's corners to the bubble's own.
        border-radius: Math.max(0px, SendFlight.from-radius + (SendFlight.to-radius - SendFlight.from-radius) * root.flight-t);
        clip: true;
        // The bubble's own padding (transcript.slint) at the reading size.
        property <length> inset: 10px * ChatText.scale * root.flight-t;
        flown := Text {
            x: parent.inset;
            y: parent.inset;
            width: parent.width - 2 * parent.inset;
            text: root.flown-text;
            color: Palette.text;
            font-size: ChatText.body * (SendFlight.from-text-scale + (1 - SendFlight.from-text-scale) * root.flight-t);
            font-family: Palette.body-family;
            wrap: word-wrap;
            vertical-alignment: top;
        }
    }
}

// The split between two panes: drag to resize, double-click to balance.
component Handle inherits Rectangle {
    in property <SplitView> split;
    in property <length> area-width;
    in property <length> area-height;
    in property <length> top;
    in property <length> gap;
    callback resized(string, float);
    callback balance();
    property <length> sx: root.split.x * root.area-width;
    property <length> sy: root.top + root.split.y * root.area-height;
    property <length> sw: root.split.width * root.area-width;
    property <length> sh: root.split.height * root.area-height;
    property <float> live-ratio: root.split.ratio;
    x: root.split.vertical ? root.sx + root.sw * root.live-ratio - root.gap / 2 : root.sx;
    y: root.split.vertical ? root.sy : root.sy + root.sh * root.live-ratio - root.gap / 2;
    width: root.split.vertical ? root.gap : root.sw;
    height: root.split.vertical ? root.sh : root.gap;
    background: drag.pressed ? Palette.muted : drag.has-hover ? Palette.faint : Palette.window;
    drag := TouchArea {
        mouse-cursor: root.split.vertical ? col-resize : row-resize;
        moved => {
            if (self.pressed) {
                root.live-ratio = root.split.vertical
                    ? Math.clamp((root.x + self.mouse-x - root.sx) / root.sw, 0.15, 0.85)
                    : Math.clamp((root.y + self.mouse-y - root.sy) / root.sh, 0.15, 0.85);
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                root.resized(root.split.id, root.live-ratio);
            }
        }
        double-clicked => { root.balance(); }
    }
}

// Workspace.qml: the workspace tabs, then the panes where the tree puts them.
export component Workspace inherits Rectangle {
    // The panes' area may shrink to the window; the panes inside wrap.
    min-width: 0px;
    in property <[PaneView]> panes;
    in property <[SplitView]> splits;
    in property <[WorkspaceTab]> workspaces;
    in property <string> save-warning;
    in property <string> save-warning-dismiss-key;
    in property <string> save-warning-keep-key;
    in property <bool> bar-visible;
    callback activate(string);
    callback send(string, string, bool) -> string;
    callback stop(string);
    callback draft-edited(string, string);
    callback attach(string);
    callback remove-attachment(string, string);
    callback link-clicked(string);
    callback load-older(string);
    callback scroll-journal(string, string, length, length, float, float, length, length, bool, bool, int);
    callback toggle-activity(string, string, string);
    callback copy-message(string, string);
    callback select-message(string, string);
    callback silence();
    callback cancel-transcription(string);
    callback paste-image(string) -> bool;
    callback reported(string, bool, bool, length, bool, bool, int);
    callback switch-workspace(string);
    callback create-workspace();
    callback save-layout-instead();
    callback dismiss-save-warning();
    callback resize-split(string, float);
    callback balance();
    property <length> gap: Look.pane-gap;
    property <length> bar-height: root.bar-visible ? 36px : 0px;
    property <length> top: root.bar-height + (root.save-warning != "" ? 40px : 0px);
    property <length> area-height: root.height - root.top;
    background: Palette.window;

    if root.bar-visible: HorizontalLayout {
        y: 0;
        height: 36px;
        padding: 4px;
        spacing: 4px;
        alignment: start;
        for tab in root.workspaces: Rectangle {
            width: tab-label.preferred-width + 20px;
            border-radius: 3px;
            background: tab.active ? Palette.control : tab-touch.has-hover ? Palette.hover : transparent;
            border-width: tab.active ? 1px : 0px;
            border-color: Palette.border;
            tab-label := Text {
                text: tab.name;
                color: tab.active ? Palette.text : Palette.muted;
                font-size: 12 * Look.unit;
            }
            tab-touch := TouchArea { clicked => { root.switch-workspace(tab.id); } }
        }
        if root.workspaces.length < 8: Rectangle {
            width: 28px;
            border-radius: 3px;
            background: plus-touch.has-hover ? Palette.hover : transparent;
            accessible-role: button;
            accessible-label: "New workspace";
            Image {
                source: @image-url("icons/rail-plus.svg");
                width: 14px;
                height: 14px;
                colorize: Palette.muted;
            }
            plus-touch := TouchArea { clicked => { root.create-workspace(); } }
        }
    }
    if root.save-warning != "": HorizontalLayout {
        y: root.bar-height;
        height: 40px;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Text {
            font-size: ChromeText.body;
            text: root.save-warning;
            color: Palette.warning;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        // Key hints, as the shortcut bar spells keys; a click does the same.
        HorizontalLayout {
            spacing: 4px;
            Text { text: root.save-warning-keep-key; color: Palette.accent; font-size: 11 * Look.unit; font-weight: 700; vertical-alignment: center; }
            Text { text: "Keep this layout"; color: Palette.muted; font-size: 11 * Look.unit; vertical-alignment: center; }
            TouchArea { clicked => { root.save-layout-instead(); } }
        }
        HorizontalLayout {
            spacing: 4px;
            padding-left: 8px;
            Text { text: root.save-warning-dismiss-key; color: Palette.accent; font-size: 11 * Look.unit; font-weight: 700; vertical-alignment: center; }
            Text { text: "Dismiss"; color: Palette.muted; font-size: 11 * Look.unit; vertical-alignment: center; }
            TouchArea { clicked => { root.dismiss-save-warning(); } }
        }
    }
    for pane in root.panes: Pane {
        visible: pane.shown;
        x: Math.round(pane.x * root.width / 1px) * 1px + root.gap / 2;
        y: root.top + Math.round(pane.y * root.area-height / 1px) * 1px + root.gap / 2;
        width: Math.max(1px, Math.round(pane.width * root.width / 1px) * 1px - root.gap);
        height: Math.max(1px, Math.round(pane.height * root.area-height / 1px) * 1px - root.gap);
        pane: pane;
        activate => { root.activate(pane.id); }
        send(text, queue) => { return root.send(pane.id, text, queue); }
        stop => { root.stop(pane.id); }
        draft-edited(text) => { root.draft-edited(pane.id, text); }
        attach => { root.attach(pane.id); }
        remove-attachment(id) => { root.remove-attachment(pane.id, id); }
        link-clicked(url) => { root.link-clicked(url); }
        load-older => { root.load-older(pane.id); }
        scroll-journal(cause, old, new, old-place, new-place, content, viewport, at-end, follow, rows) => { root.scroll-journal(pane.id, cause, old, new, old-place, new-place, content, viewport, at-end, follow, rows); }
        toggle-activity(id, group) => { root.toggle-activity(pane.id, id, group); }
        copy-message(id) => { root.copy-message(pane.id, id); }
        select-message(id) => { root.select-message(pane.id, id); }
        silence => { root.silence(); }
        cancel-transcription => { root.cancel-transcription(pane.id); }
        paste-image => { return root.paste-image(pane.id); }
        reported(follows, at-end, offset, transcript, composer, top) => { root.reported(pane.id, follows, at-end, offset, transcript, composer, top); }
    }
    for split in root.splits: Handle {
        split: split;
        area-width: root.width;
        area-height: root.area-height;
        top: root.top;
        gap: root.gap;
        resized(id, ratio) => { root.resize-split(id, ratio); }
        balance => { root.balance(); }
    }
}
