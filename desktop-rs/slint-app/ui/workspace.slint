import { Palette, Focus, FocusRing, Frame, PaneFrame, ChatLook, Look, VimBridge, ChatText, SendFlight } from "theme.slint";
import { Composer, Attachment, MentionRow } from "composer.slint";
import { Transcript, MessageRow, MeasureRow } from "transcript.slint";
import { AgentDialogs } from "agent_dialogs.slint";
import { TypingIndicator } from "cells.slint";
import { ProfileBridge } from "profile.slint";
import { KeyHint } from "artifacts.slint";

// One pane of the workspace: where it sits (fractions of the workspace),
// the chat it shows, and that chat's composer state. The counters ask the
// pane to act (focus its composer or transcript, jump to the latest) when
// they change.
export struct PaneView {
    id: string,
    session: string,
    name: string,
    workspace-kind: string,
    workspace-label: string,
    model: string,
    effort: string,
    // The agent's status line and the effort its provider runs at unset.
    status: string,
    default-effort: string,
    busy: bool,
    // "Working…" under the transcript (Show when ready, agent working).
    working: bool,
    // Live items' status line ("" when idle), whether the agent works (the
    // interrupt key works) and that key.
    live-status: string,
    live-busy: bool,
    live-stop-key: string,
    pair: bool,
    x: float,
    y: float,
    width: float,
    height: float,
    shown: bool,
    active: bool,
    messages: [MessageRow],
    // The scroll book's: rows to measure, and where each row starts (px).
    measure: [MeasureRow],
    before: [float],
    draft: string,
    // Bumped when `draft` should replace what the composer holds (another
    // chat, a send, the same chat typed in another pane).
    draft-set: int,
    attachments: [Attachment],
    queued: int,
    quota-notice: string,
    can-send: bool,
    transcribing: int,
    recording: bool,
    playing: bool,
    focus-composer: int,
    focus-transcript: int,
    to-latest: int,
    // Bumped to scroll the transcript by `scroll-amount` px (J/K bringing
    // a card into view: an explicit keypress, never activity).
    scroll-request: int,
    scroll-amount: float,
    // Bumped to bring row `seek-index` into view by the rows' measured
    // heights (J/K to a card the list has not drawn; `seek-down`: going
    // down the chat).
    seek-request: int,
    seek-index: int,
    seek-down: bool,
    // Message search: the row drawn marked, and a request (bumped) to
    // bring the row at `reveal-index` into view.
    marked: string,
    reveal-request: int,
    reveal-index: int,
    // @-mentions: the agents matching the `@` being typed, the chosen one,
    // and the agent Enter sends to ("" for this chat).
    mentions: [MentionRow],
    mention-current: int,
    route: string,
    // One more than where the cursor goes when `draft-set` replaces the
    // draft (a completed mention); 0 leaves it.
    draft-cursor: int,
    // What the amount counts: px (""), "pages" of the view, or the "row"
    // to bring to the top (vim mode's jumps).
    scroll-kind: string,
}

export struct SplitView {
    id: string,
    vertical: bool,
    x: float,
    y: float,
    width: float,
    height: float,
    ratio: float,
}

export struct WorkspaceTab {
    id: string,
    name: string,
    active: bool,
}

// PaneLeaf.qml + ConversationPane.qml.
export component Pane inherits Rectangle {
    in property <PaneView> pane;
    callback activate();
    // Sends the draft; the id of the message's row in this chat, or "" (not
    // sent, or sent to another agent's chat).
    callback send(string, bool) -> string;
    callback stop();
    callback draft-edited(string);
    callback attach();
    callback remove-attachment(string);
    callback link-clicked(string);
    callback load-older();
    // The transcript's scroll journal (Transcript.journal).
    callback scroll-journal(string, length, length, float, float, length, length, bool, bool, int);
    callback toggle-activity(string, string);
    callback copy-message(string);
    callback silence();
    callback cancel-transcription();
    callback paste-image() -> bool;
    // The transcript and composer tell the window where the keyboard is and
    // whether the reader follows, for shortcuts and checks.
    callback reported(bool, bool, length, bool, bool, int);
    background: root.pane.active ? Palette.control : Palette.raised;
    border-width: 0px;
    border-radius: 3px;
    clip: true;
    opacity: root.pane.active ? 1 : 0.76;
    animate opacity { duration: 120ms; }

    function report() {
        root.reported(transcript.follow, transcript.at-end, transcript.offset, transcript.has-focus, composer.editor-focused, transcript.top-row);
    }
    // A pane made for a request (a split's focus) acts on it at once.
    // An old scroll request is not replayed into a pane made later.
    init => { root.scroll-request-seen = root.pane.scroll-request; root.seek-request-seen = root.pane.seek-request; root.reveal-request-seen = root.pane.reveal-request; root.apply-requests(); }
    changed pane => { root.apply-requests(); }
    function apply-requests() {
        if (root.draft-set-seen != root.pane.draft-set) {
            root.draft-set-seen = root.pane.draft-set;
            composer.draft = root.pane.draft;
            if (root.pane.draft-cursor > 0) {
                composer.set-cursor(root.pane.draft-cursor - 1);
            }
        }
        if (root.focus-composer-seen != root.pane.focus-composer) {
            root.focus-composer-seen = root.pane.focus-composer;
            root.pending-focus = "composer";
        }
        if (root.focus-transcript-seen != root.pane.focus-transcript) {
            root.focus-transcript-seen = root.pane.focus-transcript;
            root.pending-focus = "transcript";
        }
        if (root.to-latest-seen != root.pane.to-latest) {
            root.to-latest-seen = root.pane.to-latest;
            transcript.scroll-to-latest();
        }
        if (root.scroll-request-seen != root.pane.scroll-request) {
            root.scroll-request-seen = root.pane.scroll-request;
            if (root.pane.scroll-kind == "row") {
                transcript.go-to-row(Math.round(root.pane.scroll-amount));
            } else if (root.pane.scroll-kind == "pages") {
                transcript.scroll-pages(root.pane.scroll-amount);
            } else {
                transcript.scroll-by(root.pane.scroll-amount * 1px, "seek");
            }
        }
        if (root.seek-request-seen != root.pane.seek-request) {
            root.seek-request-seen = root.pane.seek-request;
            transcript.seek-row(root.pane.seek-index, root.pane.seek-down);
        }
        if (root.reveal-request-seen != root.pane.reveal-request) {
            root.reveal-request-seen = root.pane.reveal-request;
            transcript.reveal(root.pane.reveal-index);
        }
    }
    // Focus moves once the pane is live: a new pane's composer, or one just
    // enabled by its chat, cannot take the keyboard in the same update.
    property <string> pending-focus;
    Timer {
        interval: 1ms;
        running: root.pending-focus != "";
        triggered => {
            if (root.pending-focus == "composer") { composer.focus(); } else { transcript.focus(); }
            root.pending-focus = "";
        }
    }
    // The send animation (Telegram's): the composer's text lifts out of the
    // box and flies, growing into a bubble, to where the new message is
    // drawn at the chat's end, while the box shrinks to its empty height.
    // One overlay moves; the chat's rows stay as they are laid out (the new
    // one hidden until the overlay lands on it). Reduce Motion, and a send
    // that cannot fly (an attachment adds to its text, a draft longer than
    // the box shows), fade the bubble in instead. A reader scrolled up gets
    // the usual jump to the latest, with no flight.
    property <string> flight-id;
    property <bool> flying;
    property <duration> flight-start;
    // The clock starts on the first frame after the send (the send itself
    // and the frame that lays out the new row can take a while on a slow
    // machine): the first frame drawn shows the text still in the box.
    property <bool> flight-armed;
    property <float> flight-raw: root.flight-id == "" ? 1 : !root.flight-armed ? 0 : Math.clamp((animation-tick() - root.flight-start) / (root.flying ? SendFlight.flight : SendFlight.fade), 0, 1);
    // Ease out: quick off the composer, settling into place.
    property <float> flight-t: 1 - Math.pow(1 - root.flight-raw, 3);
    // Where it flies from (in the pane) and the box's height then.
    property <length> from-x;
    property <length> from-y;
    property <length> from-width;
    property <length> from-height;
    property <length> box-from;
    property <string> flown-text;
    property <string> sent-id;
    // Where the bubble is drawn, once the chat has drawn it (else where
    // the text started).
    property <bool> landing: transcript.flight-drawn-id == root.flight-id && root.flight-id != "";
    property <length> to-x: root.landing ? transcript.flight-x - root.absolute-position.x : root.from-x;
    property <length> to-y: root.landing ? transcript.flight-y - root.absolute-position.y : root.from-y;
    property <length> to-width: root.landing ? transcript.flight-width : root.from-width;
    property <length> to-height: root.landing ? transcript.flight-height : root.from-height;
    property <length> fly-x: root.from-x + (root.to-x - root.from-x) * root.flight-t;
    property <length> fly-y: root.from-y + (root.to-y - root.from-y) * root.flight-t;
    property <length> fly-width: root.from-width + (root.to-width - root.from-width) * root.flight-t;
    property <length> fly-height: root.from-height + (root.to-height - root.from-height) * root.flight-t;
    function sent(text: string, queue: bool) {
        let can-fly = composer.attachments.length == 0 && root.pane.route == "" && composer.editor-text-height <= composer.editor-height + 1px;
        let at-end = transcript.follow && transcript.at-end;
        root.from-x = composer.editor-x - root.absolute-position.x;
        root.from-y = composer.editor-y - root.absolute-position.y;
        root.from-width = composer.editor-width;
        root.from-height = Math.min(composer.editor-text-height, composer.editor-height);
        root.box-from = composer-box.height;
        root.flown-text = text;
        root.land();
        root.sent-id = root.send(text, queue);
        if (root.sent-id == "" || !ChatLook.send-animation || !at-end) {
            return;
        }
        root.flying = can-fly && !ChatLook.reduced-motion;
        root.flight-id = root.sent-id;
        root.flight-armed = false;
        SendFlight.id = root.sent-id;
        SendFlight.phase = root.flying ? "flight" : "fade";
        SendFlight.from-x = composer.editor-x;
        SendFlight.from-y = composer.editor-y;
        SendFlight.from-width = root.from-width;
        SendFlight.from-height = root.from-height;
        SendFlight.started += 1;
    }
    // The animation is over (or another send takes its place): the row
    // shows as it is.
    function land() {
        if (root.flight-id != "") {
            root.flight-id = "";
            root.flying = false;
            SendFlight.phase = "";
            SendFlight.landed += 1;
        }
    }
    Timer {
        interval: 16ms;
        running: root.flight-id != "";
        triggered => {
            if (!root.flight-armed) {
                root.flight-start = animation-tick();
                root.flight-armed = true;
            }
            SendFlight.progress = root.flight-t;
            SendFlight.x = root.absolute-position.x + root.fly-x;
            SendFlight.y = root.absolute-position.y + root.fly-y;
            SendFlight.width = root.fly-width;
            SendFlight.height = root.fly-height;
            SendFlight.composer-height = composer-box.height;
            if (root.flight-raw >= 1) { root.land(); }
        }
    }
    property <int> draft-set-seen;
    property <int> focus-composer-seen;
    property <int> focus-transcript-seen;
    property <int> to-latest-seen;
    property <int> scroll-request-seen;
    property <int> seek-request-seen;
    property <int> reveal-request-seen;
    property <bool> follows: transcript.follow;
    property <bool> at-end: transcript.at-end;
    property <length> offset: transcript.offset;
    property <bool> transcript-focused: transcript.has-focus;
    property <bool> composer-focused: composer.editor-focused;
    changed follows => { root.report(); }
    changed at-end => { root.report(); }
    changed offset => { root.report(); }
    property <int> top-row: transcript.top-row;
    changed top-row => { root.report(); }
    changed transcript-focused => { root.report(); if (self.transcript-focused) { root.activate(); } }
    changed composer-focused => { root.report(); if (self.composer-focused) { root.activate(); } }

    // A click anywhere but the composer makes the pane active.
    TouchArea {
        clicked => { root.activate(); }
    }
    VerticalLayout {
        padding: 2px;
        // [c] Chat and [i] Insert: the pane's two keyboard regions, framed
        // as sqlit frames its panes.
        Rectangle {
          vertical-stretch: 1;
          transcript := Transcript {
            // The pane's chat, found by link hints and the checks.
            accessible-role: list;
            accessible-id: "chat:" + root.pane.id;
            x: Frame.side;
            y: Frame.top;
            width: parent.width - 2 * Frame.side;
            height: parent.height - Frame.top - Frame.bottom;
            rows: root.pane.messages;
            pane-id: root.pane.id;
            measure: root.pane.measure;
            before: root.pane.before;
            marked: root.pane.marked;
            flight-id: root.flight-id;
            flight-reveal: root.flying ? 0 : root.flight-t;
            flight-pinning: root.flying;
            link-clicked(url) => { root.link-clicked(url); }
            toggle-activity(id, group) => { root.toggle-activity(id, group); }
            copy-message(id) => { root.copy-message(id); }
            reached-top => { root.load-older(); }
            journal(cause, old, new, old-place, new-place, content, viewport, at-end, follow, rows) => { root.scroll-journal(cause, old, new, old-place, new-place, content, viewport, at-end, follow, rows); }
          }
          // In the composer letters type: Ctrl+H is the way back to the chat.
          // The agent's name, folder and runtime sit on the right of the
          // frame's border (there is no separate header).
          PaneFrame {
            info-name: root.pane.session == "" ? "No agent selected" : root.pane.name;
            info: root.pane.session == "" || root.pane.pair ? root.pane.workspace-label
                : (root.pane.workspace-label != "" ? root.pane.workspace-label + "  ·  " : "")
                + (root.pane.status != "" ? root.pane.status + "  ·  " : "")
                + (root.pane.model != "" ? root.pane.model : "model not reported")
                + "  ·  " + (root.pane.effort != "" ? "effort " + root.pane.effort
                    : root.pane.default-effort != "" ? "effort " + root.pane.default-effort + " (default)" : "effort default")
                + (root.pane.busy ? "  ·  working" : "");
            info-clicked => { if (root.pane.session != "" && !root.pane.pair) { ProfileBridge.open-for-pane(root.pane.id); } }
            // In vim mode the title says the mode, as Vim's last line does.
            key: root.pane.active && Focus.mode == "composer" ? (VimBridge.mode != "" ? "esc" : "ctrl+h") : "h";
            label: VimBridge.mode != "" && root.pane.active && Focus.mode == "pane" ? "Chat  -- " + VimBridge.mode + " --" : "Chat";
            active: root.pane.active && Focus.mode == "pane"; surface: root.background; }
        }
        // Live items' one status line (docs/live-items.md §7.4): what runs
        // and for how long by the Host's clock, and the key that stops it
        // while the agent works. Off unless Settings turn it on: the
        // running row shimmers in the chat and the shortcut bar names Stop.
        if root.pane.live-status != "" && ChatLook.live-status-line: Rectangle {
            background: Palette.window;
            height: 26px;
            accessible-role: text;
            accessible-id: "live-status:" + root.pane.id;
            accessible-label: root.pane.live-status;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 10px;
                Text {
                    text: root.pane.live-status;
                    color: root.pane.live-busy ? Palette.chrome-text : root.pane.live-status == "■ Interrupted" ? Palette.warning : Palette.muted;
                    font-size: 12 * Look.unit;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                if root.pane.live-busy && root.pane.live-stop-key != "" && root.pane.active: KeyHint {
                    y: 3px;
                    key: root.pane.live-stop-key;
                    label: "Stop";
                    clicked => { root.stop(); }
                }
            }
        }
        // The transcript's footer (ConversationPane.qml).
        if root.pane.working: Rectangle {
            background: Palette.window;
            HorizontalLayout {
                padding-left: 14px;
                padding-top: 7px;
                padding-bottom: 7px;
                alignment: start;
                TypingIndicator { reduced-motion: ProfileBridge.reduced-motion; }
            }
        }
        // Pair rooms are the Host's read-only projection: no composer.
        composer-box := Rectangle {
          visible: !root.pane.pair;
          accessible-role: groupbox;
          accessible-id: "composer-box:" + root.pane.id;
          // Folded to its "[i] Insert" line until it has the keyboard (or
          // holds a draft, which stays in view).
          property <bool> folded: !composer.editor-focused && composer.draft == "";
          property <length> natural: root.pane.pair ? 0px : self.folded ? 16px : composer.preferred-height + Frame.top + Frame.bottom;
          // A flight shrinks it from its height at the send.
          height: root.flying ? root.box-from + (self.natural - root.box-from) * root.flight-t : self.natural;
          clip: true;
          composer := Composer {
            x: Frame.side;
            y: Frame.top;
            width: parent.width - 2 * Frame.side;
            height: parent.height - Frame.top - Frame.bottom;
            init => { self.draft = root.pane.draft; root.draft-set-seen = root.pane.draft-set; }
            attachments: root.pane.attachments;
            queued: root.pane.queued;
            quota-notice: root.pane.quota-notice;
            busy: root.pane.busy;
            can-send: root.pane.can-send;
            transcribing: root.pane.transcribing;
            recording: root.pane.recording;
            playing: root.pane.playing && root.pane.active;
            silence => { root.silence(); }
            cancel-transcription => { root.cancel-transcription(); }
            paste-image => { return root.paste-image(); }
            active: root.pane.session != "";
            agent-name: root.pane.name;
            pane-id: root.pane.id;
            mentions: root.pane.mentions;
            mention-current: root.pane.mention-current;
            route: root.pane.route;
            send(text, queue) => { root.sent(text, queue); }
            stop => { root.stop(); }
            edited(text) => { root.draft-edited(text); }
            attach => { root.attach(); }
            remove-attachment(id) => { root.remove-attachment(id); }
            escape => { transcript.focus(); }
            jump-to-latest => { transcript.scroll-to-latest(); }
            queue-requested => { AgentDialogs.queue-open(root.pane.session); }
          }
          PaneFrame {
            key: "i";
            label: VimBridge.mode == "INSERT" && root.pane.active && Focus.mode == "composer" ? "Insert  -- INSERT --" : "Insert";
            active: root.pane.active && Focus.mode == "composer";
            surface: root.background;
          }
        }
    }
    // The sent text in flight: from the editor to the bubble, taking on
    // the bubble's colour, padding and text size on the way.
    if root.flying: Rectangle {
        accessible-role: text;
        accessible-id: "send-flight";
        accessible-label: flown.text;
        x: root.fly-x;
        y: root.fly-y;
        width: root.fly-width;
        height: root.fly-height;
        background: Palette.bubble.with-alpha(root.flight-t);
        border-radius: Look.radius / 3;
        // The bubble's own padding (transcript.slint) at the reading size.
        property <length> inset: 10px * ChatText.scale * root.flight-t;
        flown := Text {
            x: parent.inset;
            y: parent.inset;
            width: parent.width - 2 * parent.inset;
            text: root.flown-text;
            color: Palette.text;
            font-size: Palette.body-size + (ChatText.body - Palette.body-size) * root.flight-t;
            font-family: Palette.body-family;
            wrap: word-wrap;
            vertical-alignment: top;
        }
    }
}

// The split between two panes: drag to resize, double-click to balance.
component Handle inherits Rectangle {
    in property <SplitView> split;
    in property <length> area-width;
    in property <length> area-height;
    in property <length> top;
    in property <length> gap;
    callback resized(string, float);
    callback balance();
    property <length> sx: root.split.x * root.area-width;
    property <length> sy: root.top + root.split.y * root.area-height;
    property <length> sw: root.split.width * root.area-width;
    property <length> sh: root.split.height * root.area-height;
    property <float> live-ratio: root.split.ratio;
    x: root.split.vertical ? root.sx + root.sw * root.live-ratio - root.gap / 2 : root.sx;
    y: root.split.vertical ? root.sy : root.sy + root.sh * root.live-ratio - root.gap / 2;
    width: root.split.vertical ? root.gap : root.sw;
    height: root.split.vertical ? root.sh : root.gap;
    background: drag.pressed ? Palette.muted : drag.has-hover ? Palette.faint : Palette.window;
    drag := TouchArea {
        mouse-cursor: root.split.vertical ? col-resize : row-resize;
        moved => {
            if (self.pressed) {
                root.live-ratio = root.split.vertical
                    ? Math.clamp((root.x + self.mouse-x - root.sx) / root.sw, 0.15, 0.85)
                    : Math.clamp((root.y + self.mouse-y - root.sy) / root.sh, 0.15, 0.85);
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                root.resized(root.split.id, root.live-ratio);
            }
        }
        double-clicked => { root.balance(); }
    }
}

// Workspace.qml: the workspace tabs, then the panes where the tree puts them.
export component Workspace inherits Rectangle {
    in property <[PaneView]> panes;
    in property <[SplitView]> splits;
    in property <[WorkspaceTab]> workspaces;
    in property <string> save-warning;
    in property <string> save-warning-dismiss-key;
    in property <string> save-warning-keep-key;
    in property <bool> bar-visible;
    callback activate(string);
    callback send(string, string, bool) -> string;
    callback stop(string);
    callback draft-edited(string, string);
    callback attach(string);
    callback remove-attachment(string, string);
    callback link-clicked(string);
    callback load-older(string);
    callback scroll-journal(string, string, length, length, float, float, length, length, bool, bool, int);
    callback toggle-activity(string, string, string);
    callback copy-message(string, string);
    callback silence();
    callback cancel-transcription(string);
    callback paste-image(string) -> bool;
    callback reported(string, bool, bool, length, bool, bool, int);
    callback switch-workspace(string);
    callback create-workspace();
    callback save-layout-instead();
    callback dismiss-save-warning();
    callback resize-split(string, float);
    callback balance();
    property <length> gap: Look.pane-gap;
    property <length> bar-height: root.bar-visible ? 36px : 0px;
    property <length> top: root.bar-height + (root.save-warning != "" ? 40px : 0px);
    property <length> area-height: root.height - root.top;
    background: Palette.window;

    if root.bar-visible: HorizontalLayout {
        y: 0;
        height: 36px;
        padding: 4px;
        spacing: 4px;
        alignment: start;
        for tab in root.workspaces: Rectangle {
            width: tab-label.preferred-width + 20px;
            border-radius: 3px;
            background: tab.active ? Palette.control : tab-touch.has-hover ? Palette.hover : transparent;
            border-width: tab.active ? 1px : 0px;
            border-color: Palette.border;
            tab-label := Text {
                text: tab.name;
                color: tab.active ? Palette.text : Palette.muted;
                font-size: 12 * Look.unit;
            }
            tab-touch := TouchArea { clicked => { root.switch-workspace(tab.id); } }
        }
        if root.workspaces.length < 8: Rectangle {
            width: 28px;
            border-radius: 3px;
            background: plus-touch.has-hover ? Palette.hover : transparent;
            accessible-role: button;
            accessible-label: "New workspace";
            Image {
                source: @image-url("icons/rail-plus.svg");
                width: 14px;
                height: 14px;
                colorize: Palette.muted;
            }
            plus-touch := TouchArea { clicked => { root.create-workspace(); } }
        }
    }
    if root.save-warning != "": HorizontalLayout {
        y: root.bar-height;
        height: 40px;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Text {
            text: root.save-warning;
            color: Palette.warning;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        // Key hints, as the shortcut bar spells keys; a click does the same.
        HorizontalLayout {
            spacing: 4px;
            Text { text: root.save-warning-keep-key; color: Palette.accent; font-size: 11 * Look.unit; font-weight: 700; vertical-alignment: center; }
            Text { text: "Keep this layout"; color: Palette.muted; font-size: 11 * Look.unit; vertical-alignment: center; }
            TouchArea { clicked => { root.save-layout-instead(); } }
        }
        HorizontalLayout {
            spacing: 4px;
            padding-left: 8px;
            Text { text: root.save-warning-dismiss-key; color: Palette.accent; font-size: 11 * Look.unit; font-weight: 700; vertical-alignment: center; }
            Text { text: "Dismiss"; color: Palette.muted; font-size: 11 * Look.unit; vertical-alignment: center; }
            TouchArea { clicked => { root.dismiss-save-warning(); } }
        }
    }
    for pane in root.panes: Pane {
        visible: pane.shown;
        x: Math.round(pane.x * root.width / 1px) * 1px + root.gap / 2;
        y: root.top + Math.round(pane.y * root.area-height / 1px) * 1px + root.gap / 2;
        width: Math.max(1px, Math.round(pane.width * root.width / 1px) * 1px - root.gap);
        height: Math.max(1px, Math.round(pane.height * root.area-height / 1px) * 1px - root.gap);
        pane: pane;
        activate => { root.activate(pane.id); }
        send(text, queue) => { return root.send(pane.id, text, queue); }
        stop => { root.stop(pane.id); }
        draft-edited(text) => { root.draft-edited(pane.id, text); }
        attach => { root.attach(pane.id); }
        remove-attachment(id) => { root.remove-attachment(pane.id, id); }
        link-clicked(url) => { root.link-clicked(url); }
        load-older => { root.load-older(pane.id); }
        scroll-journal(cause, old, new, old-place, new-place, content, viewport, at-end, follow, rows) => { root.scroll-journal(pane.id, cause, old, new, old-place, new-place, content, viewport, at-end, follow, rows); }
        toggle-activity(id, group) => { root.toggle-activity(pane.id, id, group); }
        copy-message(id) => { root.copy-message(pane.id, id); }
        silence => { root.silence(); }
        cancel-transcription => { root.cancel-transcription(pane.id); }
        paste-image => { return root.paste-image(pane.id); }
        reported(follows, at-end, offset, transcript, composer, top) => { root.reported(pane.id, follows, at-end, offset, transcript, composer, top); }
    }
    for split in root.splits: Handle {
        split: split;
        area-width: root.width;
        area-height: root.area-height;
        top: root.top;
        gap: root.gap;
        resized(id, ratio) => { root.resize-split(id, ratio); }
        balance => { root.balance(); }
    }
}
