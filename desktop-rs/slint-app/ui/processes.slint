import { Button } from "std-widgets.slint";
import { Palette, Look, ChatLook } from "theme.slint";

export struct ProcessJob {
    id: string,
    title: string,
    // kind · queued · detail
    detail: string,
    elapsed: string,
    heartbeat: string,
    sub-agent: bool,
    // Running and the Host lets it be cancelled.
    can-stop: bool,
    // How its latest stop went ("Stopping…", "Stopped", "Not stopped: …").
    outcome: string,
}

export struct ProcessHelper {
    session: string,
    name: string,
    detail: string,
}

// A running process: an indeterminate spinner, a ring of dots whose
// brightness sweeps round as a fading arc (the software renderer draws no
// paths). Only the dots' opacity changes, so nothing around it moves. It
// turns only while `running` (its holder is shown and on screen), the window
// shows and motion is not reduced; otherwise it is the same arc, still.
export component ProcessSpinner inherits Rectangle {
    in property <length> size: 14px;
    in property <color> tone: Palette.link;
    in property <bool> running: true;
    out property <bool> turning: root.running && !ChatLook.reduced-motion && ChatLook.window-shown;
    property <float> phase: root.turning ? Math.mod(animation-tick() / 900ms, 1.0) : 0.0;
    property <length> dot: Math.max(2px, root.size * 0.2);
    width: root.size;
    height: root.size;
    // What the checks find it by (no accessible node of its own: the
    // badge's label says what runs).
    if root.turning: turning := Rectangle { width: root.size; height: root.size; }
    if !root.turning: still := Rectangle { width: root.size; height: root.size; }
    for i in 10: Rectangle {
        property <angle> at: i * 36deg - 90deg;
        // How far the dot is behind the arc's head, as a share of a turn.
        property <float> behind: Math.mod(root.phase - i / 10 + 1.0, 1.0);
        x: (root.size - root.dot) / 2 * (1 + Math.cos(self.at));
        y: (root.size - root.dot) / 2 * (1 + Math.sin(self.at));
        width: root.dot;
        height: root.dot;
        border-radius: root.dot / 2;
        background: root.tone;
        opacity: self.behind < 0.75 ? 1.0 - self.behind / 0.75 * 0.8 : 0.12;
    }
}

// ProcessGlyph.qml: the spinner while an agent waits on a background job,
// the agent mark while a sub-agent or helper runs; both follow the theme.
export component ProcessGlyph inherits Rectangle {
    // "agent" or "process".
    in property <string> kind: "process";
    in property <length> glyph-size: 14px;
    // The holder is shown and on screen: the spinner may turn.
    in property <bool> running: true;
    width: root.glyph-size;
    height: root.glyph-size;
    if root.kind == "agent": Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("icons/agent.svg");
        colorize: Palette.link;
    }
    if root.kind != "agent": ProcessSpinner {
        size: root.glyph-size;
        running: root.running;
    }
}

// ProcessIndicator.qml: one glyph for an agent's background work, with a
// count once more than one process runs. Clicking asks for the list.
export component ProcessIndicator inherits Rectangle {
    in property <int> jobs;
    in property <int> sub-agents;
    in property <int> children;
    in property <length> glyph-size: 14px;
    // "jobs" or "agents" shows only that kind (the explorer gives each its
    // own icon); empty shows both as one glyph.
    in property <string> only;
    // Shown and on screen: its spinner may turn.
    in property <bool> running: true;
    callback clicked();
    property <int> plain: root.only == "agents" ? 0 : Math.max(0, root.jobs - root.sub-agents);
    property <int> agents: root.only == "jobs" ? 0 : Math.max(root.sub-agents, root.children, 0);
    out property <int> total: root.plain + root.agents;
    out property <string> summary: (root.plain > 0 ? root.plain + (root.plain == 1 ? " background job" : " background jobs") : "")
        + (root.plain > 0 && root.agents > 0 ? ", " : "")
        + (root.agents > 0 ? root.agents + (root.agents == 1 ? " sub-agent" : " sub-agents") : "");
    visible: root.total > 0;
    width: root.total > 0 ? root.glyph-size + (root.total > 1 ? 10px : 0px) + 2px : 0px;
    height: root.glyph-size + 2px;
    accessible-role: button;
    accessible-label: root.summary != "" ? root.summary + " running" : "Nothing running";
    accessible-action-default => { root.clicked(); }
    ProcessGlyph {
        x: 0;
        y: parent.height - self.height;
        glyph-size: root.glyph-size;
        kind: root.agents > 0 ? "agent" : "process";
        running: root.running;
    }
    if root.total > 1: Rectangle {
        x: root.glyph-size * 0.8;
        y: -3px;
        width: Math.max(11px, badge.preferred-width + 5px);
        height: 11px;
        border-radius: 5.5px;
        background: root.agents > 0 ? Palette.link : Palette.muted;
        border-width: 1px;
        border-color: Palette.window;
        badge := Text {
            text: root.total > 9 ? "9+" : root.total;
            color: Palette.window;
            font-size: 8 * Look.unit;
            font-weight: 700;
        }
    }
    TouchArea {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The compact explorer's mark for one kind of running work: its glyph (the
// agent mark for helpers, the spinner for processes) and how many run, as
// narrow as it can be. Clicking asks for the list, as ProcessIndicator does.
export component CompactWork inherits Rectangle {
    // "agent" or "process".
    in property <string> kind;
    in property <int> count;
    in property <bool> running: true;
    callback clicked();
    property <string> what: root.kind == "agent"
        ? (root.count == 1 ? " sub-agent" : " sub-agents")
        : (root.count == 1 ? " background process" : " background processes");
    width: layout.preferred-width;
    height: 14px;
    accessible-role: button;
    accessible-id: root.kind == "agent" ? "compact-helpers" : "compact-processes";
    accessible-label: root.count + root.what + " running";
    accessible-value: root.count;
    accessible-action-default => { root.clicked(); }
    layout := HorizontalLayout {
        spacing: 1px;
        ProcessGlyph { y: 1px; glyph-size: 12px; kind: root.kind; running: root.running; }
        Text {
            text: root.count > 9 ? "9+" : root.count;
            color: Palette.chrome-text;
            font-size: 10 * Look.unit;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
    TouchArea {
        x: -2px;
        y: -4px;
        width: parent.width + 4px;
        height: parent.height + 8px;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ProcessPopover.qml, with the iOS app's process detail: what an agent
// runs right now, one line per job and one per running helper, placed under
// the indicator that opened it (or centred when a key did). A job opens its
// output (the log's newest lines, read again while it shows); a helper opens
// its chat; either stops after a confirm. Escape and a click outside close it.
export component ProcessPopover inherits Rectangle {
    in property <string> name;
    in property <string> count;
    in property <[ProcessJob]> jobs;
    in property <[ProcessHelper]> helpers;
    in property <string> note;
    // Where the indicator's bottom right is, in window coordinates.
    in property <length> anchor-x;
    in property <length> anchor-y;
    // Opened by a key: in the middle, not under a row.
    in property <bool> centered;
    // "list" or "output".
    in property <string> mode: "list";
    // The row the keyboard is on: jobs first, then helpers.
    in property <int> cursor;
    // The stop being asked about ("" for none).
    in property <string> confirm;
    // The keys that work right now.
    in property <string> hint;
    in property <string> output-title;
    in property <string> output-status;
    in property <string> output-progress;
    in property <string> output-owner;
    in property <[string]> output-lines;
    // Lines scrolled back from the newest (0: following it).
    in property <int> output-back;
    in property <[string]> output-events;
    in property <string> output-note;
    in property <string> output-outcome;
    in property <bool> output-stoppable;
    callback helper-opened(string);
    callback job-opened(string);
    // "job" or "helper", and its id.
    callback stop-asked(string, string);
    callback answered(bool);
    callback dismissed();
    // Holds the keyboard while it shows (the window's map reads the keys).
    public function take-focus() { keys.focus(); }
    keys := FocusScope { }
    TouchArea { clicked => { root.dismissed(); } }
    card := Rectangle {
        width: root.mode == "output" ? Math.min(620px, root.width - 32px) : 360px;
        height: body.preferred-height;
        x: root.centered ? (root.width - self.width) / 2 : Math.max(8px, Math.min(root.anchor-x - self.width, root.width - self.width - 8px));
        y: root.centered ? Math.max(8px, (root.height - self.height) / 3) : Math.max(8px, Math.min(root.anchor-y + 4px, root.height - self.height - 8px));
        background: Palette.raised;
        border-width: 1px;
        border-color: Palette.border;
        border-radius: 3px;
        accessible-role: list;
        accessible-id: "processes-panel";
        accessible-label: root.mode == "output" ? root.output-title : root.name + " processes";
        // Clicks on the card stay on it.
        TouchArea { }
        body := VerticalLayout {
            HorizontalLayout {
                padding: 10px;
                padding-bottom: 6px;
                spacing: 8px;
                Text {
                    text: root.mode == "output" ? root.output-title : root.name;
                    color: Palette.text;
                    font-size: 12 * Look.unit;
                    font-weight: 600;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text { text: root.mode == "output" ? root.output-owner : root.count; color: Palette.muted; font-size: 11 * Look.unit; }
            }
            Rectangle { height: 1px; background: Palette.rule; }
            if root.mode == "list": VerticalLayout {
                for job[i] in root.jobs: Rectangle {
                    background: i == root.cursor ? Palette.control : job-touch.has-hover ? Palette.hover : transparent;
                    accessible-role: list-item;
                    accessible-id: "process-job:" + job.id;
                    accessible-label: job.title;
                    accessible-action-default => { root.job-opened(job.id); }
                    job-touch := TouchArea { mouse-cursor: pointer; clicked => { root.job-opened(job.id); } }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 6px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 8px;
                        ProcessGlyph { y: 1px; glyph-size: 13px; kind: job.sub-agent ? "agent" : "process"; running: root.visible && job.can-stop; }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 1px;
                            Text { text: job.title; color: Palette.text; font-size: 12 * Look.unit; overflow: elide; }
                            if job.detail != "": Text { text: job.detail; color: Palette.muted; font-size: 10 * Look.unit; overflow: elide; }
                            if job.outcome != "": Text { text: job.outcome; color: Palette.chrome-text; font-size: 10 * Look.unit; overflow: elide; }
                        }
                        VerticalLayout {
                            alignment: start;
                            spacing: 1px;
                            Text { text: job.elapsed; color: Palette.chrome-text; font-size: 11 * Look.unit; horizontal-alignment: right; }
                            if job.heartbeat != "": Text { text: "♥ " + job.heartbeat; color: Palette.faint; font-size: 10 * Look.unit; horizontal-alignment: right; }
                        }
                        if job.can-stop: Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 3px;
                            background: stop-touch.has-hover ? Palette.hover : transparent;
                            accessible-role: button;
                            accessible-label: "Stop " + job.title;
                            accessible-action-default => { root.stop-asked("job", job.id); }
                            Image { width: 12px; height: 12px; source: @image-url("icons/stop.svg"); colorize: Palette.muted; }
                            stop-touch := TouchArea { mouse-cursor: pointer; clicked => { root.stop-asked("job", job.id); } }
                        }
                    }
                }
                for helper[h] in root.helpers: Rectangle {
                    background: root.jobs.length + h == root.cursor ? Palette.control : helper-touch.has-hover ? Palette.hover : transparent;
                    accessible-role: button;
                    accessible-id: "process-helper:" + helper.session;
                    accessible-label: "Open " + helper.name;
                    helper-touch := TouchArea { mouse-cursor: pointer; clicked => { root.helper-opened(helper.session); } }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 6px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 8px;
                        ProcessGlyph { glyph-size: 13px; kind: "agent"; y: 1px; }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 1px;
                            Text { text: helper.name; color: Palette.text; font-size: 12 * Look.unit; overflow: elide; }
                            Text { text: helper.detail; color: Palette.muted; font-size: 10 * Look.unit; overflow: elide; }
                        }
                        Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 3px;
                            background: helper-stop.has-hover ? Palette.hover : transparent;
                            accessible-role: button;
                            accessible-label: "Stop " + helper.name;
                            accessible-action-default => { root.stop-asked("helper", helper.session); }
                            Image { width: 12px; height: 12px; source: @image-url("icons/stop.svg"); colorize: Palette.muted; }
                            helper-stop := TouchArea { mouse-cursor: pointer; clicked => { root.stop-asked("helper", helper.session); } }
                        }
                        Text { text: "›"; color: Palette.chrome-text; font-size: 14 * Look.unit; vertical-alignment: center; }
                    }
                }
                if root.note != "": HorizontalLayout {
                    padding: 10px;
                    Text { text: root.note; color: Palette.muted; font-size: 11 * Look.unit; wrap: word-wrap; }
                }
            }
            if root.mode == "output": VerticalLayout {
                padding: 10px;
                spacing: 6px;
                Text {
                    text: root.output-status;
                    color: Palette.chrome-text;
                    font-size: 11 * Look.unit;
                    accessible-role: text;
                    accessible-id: "process-output-status";
                }
                if root.output-progress != "": Text { text: root.output-progress; color: Palette.text; font-size: 11 * Look.unit; wrap: word-wrap; }
                for event in root.output-events: Text { text: event; color: Palette.muted; font-size: 10 * Look.unit; font-family: Palette.code-family; overflow: elide; }
                if root.output-outcome != "": Text { text: root.output-outcome; color: Palette.chrome-text; font-size: 11 * Look.unit; }
                Rectangle {
                    background: Palette.window;
                    border-radius: 3px;
                    min-height: 60px;
                    accessible-role: text;
                    accessible-id: "process-output-log";
                    accessible-label: "Log";
                    accessible-value: root.output-lines.length > 0 ? root.output-lines[root.output-lines.length - 1] : root.output-note;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 0px;
                        for line in root.output-lines: Text {
                            text: line;
                            color: Palette.text;
                            font-size: 11 * Look.unit;
                            font-family: Palette.code-family;
                            overflow: elide;
                        }
                        if root.output-note != "": Text { text: root.output-note; color: Palette.muted; font-size: 11 * Look.unit; wrap: word-wrap; }
                        if root.output-back > 0: Text { text: "↑ " + root.output-back + " lines back · End for the latest"; color: Palette.faint; font-size: 10 * Look.unit; }
                    }
                }
            }
            if root.confirm != "": Rectangle {
                background: Palette.control;
                accessible-role: groupbox;
                accessible-id: "process-confirm";
                accessible-label: root.confirm;
                HorizontalLayout {
                    padding: 10px;
                    spacing: 8px;
                    Text { text: root.confirm; color: Palette.text; font-size: 12 * Look.unit; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                    Button { text: "Keep running"; clicked => { root.answered(false); } }
                    Button { text: "Stop"; primary: true; clicked => { root.answered(true); } }
                }
            }
            Rectangle { height: 1px; background: Palette.rule; }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 5px;
                padding-bottom: 6px;
                Text {
                    text: root.hint;
                    color: Palette.faint;
                    font-size: 10 * Look.unit;
                    overflow: elide;
                    accessible-role: text;
                    accessible-id: "process-hint";
                }
            }
        }
    }
}
