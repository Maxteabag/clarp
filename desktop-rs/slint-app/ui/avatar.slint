import { Palette, Look } from "theme.slint";

// The avatar sizes (Settings: Agent picture size) and the soft rings
// drawn round avatars. Rust sets the sizes and makes each ring at the
// device size it is drawn at (`avatar_view.rs`): the software renderer
// draws a round border or clip with hard edges.
export global AvatarArt {
    in property <length> row: 44px;
    in property <length> compact: 32px;
    in property <length> card: 40px;
    // Bumped when the scale changes: the rings are made again.
    in property <int> revision;
    // A white ring `stroke` wide just inside a `size` square, antialiased,
    // to colour (`colorize`) with the theme.
    pure callback ring(/* size */ length, /* stroke */ length, /* revision */ int) -> image;
}

// AgentAvatar.qml: the agent's portrait (made round, with soft edges, at
// exactly the size it is drawn), else its symbol or initial in a soft
// outline; a status ring round it when asked for.
export component AgentAvatar inherits Rectangle {
    in property <image> portrait;
    in property <string> name;
    in property <string> symbol;
    in property <length> size: 40px;
    // The first letter, upper-cased (set from Rust: Slint has no slicing).
    in property <string> initial;
    // The initial's smallest size (a chat row's avatar follows its text).
    in property <length> min-letter: 9 * Look.unit;
    in property <color> initial-color: Palette.text;
    // A ring round the avatar in `ring-color` (working, needs attention).
    in property <bool> ringed;
    in property <color> ring-color: Palette.success;
    in property <float> ring-opacity: 1;
    width: root.size;
    height: root.size;
    property <bool> has-portrait: root.portrait.width > 0;
    accessible-role: image;
    accessible-label: root.name;
    if !root.has-portrait: Image {
        width: root.size;
        height: root.size;
        source: AvatarArt.ring(root.size, 1px, AvatarArt.revision);
        colorize: Palette.border;
    }
    if !root.has-portrait: Text {
        text: root.symbol != "" ? root.symbol : root.initial;
        color: root.initial-color;
        font-family: "JetBrains Mono";
        font-size: Math.max(root.min-letter, root.size * 0.38);
        font-weight: 600;
    }
    if root.has-portrait: Image {
        width: root.size;
        height: root.size;
        source: root.portrait;
        image-fit: fill;
    }
    // One clear pixel between the portrait and the ring.
    if root.ringed: Image {
        x: -3px;
        y: -3px;
        width: root.size + 6px;
        height: root.size + 6px;
        source: AvatarArt.ring(root.size + 6px, 2px, AvatarArt.revision);
        colorize: root.ring-color;
        opacity: root.ring-opacity;
    }
}

// AvatarActivity.qml: an avatar with a breathing ring while its agent works.
// Reduced motion keeps the ring still.
export component AvatarActivity inherits Rectangle {
    in property <image> portrait;
    in property <string> name;
    in property <string> initial;
    in property <string> symbol;
    in property <length> size: 40px;
    in property <bool> working;
    in property <bool> reduced-motion;
    // One breath every 1.6 s; only a working, moving avatar follows the clock.
    out property <float> phase: root.working && !root.reduced-motion ? Math.mod(animation-tick() / 1600ms, 1.0) : 0.0;
    width: root.size;
    height: root.size;
    AgentAvatar {
        portrait: root.portrait;
        name: root.name;
        initial: root.initial;
        symbol: root.symbol;
        size: root.size;
        ringed: root.working;
        ring-color: Palette.success;
        ring-opacity: root.reduced-motion ? 0.6 : 0.35 + 0.65 * (1 + Math.cos(root.phase * 360deg)) / 2;
    }
}

// ActivitySweep.qml: a pale band crossing a working agent's line of text.
export component ActivitySweep inherits Rectangle {
    in property <bool> working;
    in property <bool> reduced-motion;
    in property <float> phase;
    clip: true;
    if root.working && !root.reduced-motion: Rectangle {
        width: root.width * 0.3;
        height: root.height;
        x: -self.width + Math.max(0, (root.phase - 0.05) / 0.95) * (root.width + self.width);
        background: Palette.success.with-alpha(0.1);
    }
}

// StatusPill.qml: a state worth showing (working, waiting, offline).
export component StatusPill inherits HorizontalLayout {
    in property <string> status;
    property <string> label: root.status != "" ? root.status : "offline";
    property <bool> quiet: root.status == "live" || root.status == "done" || root.status == "idle";
    property <color> tone: root.status == "thinking" || root.status == "tool" || root.status == "compacting" ? Palette.success
        : root.status == "waiting" || root.status == "interrupted" ? Palette.danger
        : Palette.faint;
    visible: !root.quiet;
    spacing: 5px;
    alignment: center;
    if !root.quiet: Rectangle {
        width: 5px;
        height: 5px;
        y: (parent.height - self.height) / 2;
        border-radius: 2.5px;
        background: root.tone;
    }
    if !root.quiet: Text {
        text: root.label.to-uppercase();
        color: root.tone;
        font-family: "JetBrains Mono";
        font-size: 9 * Look.unit;
        font-weight: 600;
        vertical-alignment: center;
    }
}
