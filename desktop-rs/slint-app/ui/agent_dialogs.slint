import { Button, ComboBox, ListView } from "std-widgets.slint";
import { Field, Editor } from "fields.slint";
import { Palette, Look, ChromeText } from "theme.slint";
import { Modal } from "dialogs.slint";
import { IconButton } from "launch.slint";

// ---- launch dialogs: managing an agent --------------------------------------

// One turn waiting in a chat's queue.
export struct QueuedTurn {
    id: string,
    text: string,
    stamp: string,
}

// What the rename, assign and queue dialogs show; Rust
// (`agent_dialogs_view.rs`) owns the state.
export global AgentDialogs {
    in property <bool> connected;
    in property <string> error;
    in property <bool> submitting;
    // Bumped to give the keyboard to `focus-target` ("rename" or "assign").
    in property <int> focus-request;
    in property <string> focus-target;
    // RenameAgentDialog.qml
    in property <string> rename-session;
    in-out property <string> rename-name;
    callback rename-submit();
    // AssignAgentDialog.qml: "auto", "choose" or "create".
    in property <string> assign-mode: "auto";
    in property <[string]> assign-contacts;
    in-out property <int> assign-contact: -1;
    in-out property <string> assign-name;
    callback assign-mode-chosen(string);
    callback assign-step(int);
    callback assign-submit();
    // QueueDialog.qml
    in property <string> queue-title;
    in property <bool> queue-paused;
    in property <bool> queue-loading;
    in property <string> queue-error;
    in property <[QueuedTurn]> queue-items;
    // A composer's queue line asks for its chat's queue.
    callback queue-open(string);
    callback queue-refresh();
    callback queue-save(string, string);
    callback queue-send(string);
    // The queue strip's Steer now and take-over Send now (`queue_steer`).
    callback queue-steer(string);
    callback queue-take-over(string);
    // The waiting line's action (#920): its chat, "steer" or "stop", and the
    // message Steer now reads in.
    callback waiting-act(string, string, string);
    callback queue-delete(string);
    callback cancel();
}

// i18n-screen: rename contact
// Rename the chat's contact; its session id (and so history and pairings)
// stays. Enter renames.
export component RenameAgentDialog inherits Modal {
    card-width: 480px;
    card-height: 250px;
    dismissed => { AgentDialogs.cancel(); }
    VerticalLayout {
        padding: 20px;
        spacing: 14px;
        // i18n: Rename contact dialog, title at the top: the dialog renames the agent contact that runs this chat
        Text { text: @tr("Rename contact"); color: Palette.text; font-size: 17 * Look.unit; }
        field := Field {
            // i18n: Rename contact dialog, placeholder of the text field where the contact's new name is typed (noun)
            placeholder-text: @tr("Name");
            text <=> AgentDialogs.rename-name;
            enabled: !AgentDialogs.submitting;
            // i18n: Rename contact dialog, accessibility label of the field for the contact's new name (noun)
            accessible-label: @tr("Name");
            accepted => { AgentDialogs.rename-submit(); }
            property <int> request: AgentDialogs.focus-request;
            changed request => { if (AgentDialogs.focus-target == "rename") { self.focus(); self.select-all(); } }
        }
        if AgentDialogs.error != "" || !AgentDialogs.connected: Text {
            font-size: ChromeText.body;
            text: AgentDialogs.error != "" ? AgentDialogs.error
                // i18n: Rename contact dialog, warning line shown when the app has no connection to the Host, so renaming cannot be done
                : @tr("Not connected");
            color: Palette.warning;
            wrap: word-wrap;
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            IconButton {
                icon: @image-url("icons/rail-close.svg");
                // i18n: Rename contact dialog, label of the icon button that closes the dialog without renaming (verb)
                label: @tr("Cancel");
                clicked => { AgentDialogs.cancel(); }
            }
            Button {
                text: AgentDialogs.submitting
                    // i18n: Rename contact dialog, primary button text while the rename is being saved (in progress)
                    ? @tr("Renaming…")
                    // i18n: Rename contact dialog, primary button (verb: rename the contact); "Enter" is the keyboard key that does the same, keep it as the key's name
                    : @tr("Rename · Enter");
                primary: true;
                enabled: !AgentDialogs.submitting && AgentDialogs.connected && AgentDialogs.rename-name != "";
                clicked => { AgentDialogs.rename-submit(); }
            }
        }
    }
}

component Radio inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback clicked();
    height: 28px;
    accessible-role: radio-button;
    accessible-label: root.text;
    accessible-checked: root.checked;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 16px;
            height: 16px;
            y: 6px;
            border-radius: 8px;
            border-width: 1.5px;
            border-color: root.checked ? Palette.accent : Palette.border;
            Rectangle {
                visible: root.checked;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Palette.accent;
            }
        }
        Text {
            font-size: ChromeText.body;
            text: root.text;
            color: root.enabled ? Palette.text : Palette.faint;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

// i18n-screen: assign contact
// Assign a contact to a chat: automatically, a chosen idle contact, or a
// new one by name. Up/Down change the choice, Enter assigns.
export component AssignAgentDialog inherits Modal {
    card-width: 580px;
    card-height: 330px;
    dismissed => { AgentDialogs.cancel(); }
    keys := FocusScope {
        property <int> request: AgentDialogs.focus-request;
        changed request => { if (AgentDialogs.focus-target == "assign" && AgentDialogs.assign-mode != "create") { self.focus(); } }
        capture-key-pressed(event) => {
            if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                AgentDialogs.assign-step(event.text == Key.DownArrow ? 1 : -1);
                return accept;
            }
            if (event.text == Key.Return) {
                AgentDialogs.assign-submit();
                return accept;
            }
            reject
        }
        VerticalLayout {
            padding: 20px;
            spacing: 10px;
            // i18n: Assign contact dialog, title at the top: the dialog picks which agent contact runs this chat (verb phrase)
            Text { text: @tr("Assign contact"); color: Palette.text; font-size: 18 * Look.unit; }
            Radio {
                // i18n: Assign contact dialog, radio option: Clarp picks a contact by itself
                text: @tr("Automatic");
                checked: AgentDialogs.assign-mode == "auto";
                enabled: !AgentDialogs.submitting;
                clicked => { AgentDialogs.assign-mode-chosen("auto"); }
            }
            Radio {
                // i18n: Assign contact dialog, radio option: the user picks an existing contact from a list (verb phrase)
                text: @tr("Choose contact");
                checked: AgentDialogs.assign-mode == "choose";
                enabled: !AgentDialogs.submitting;
                clicked => { AgentDialogs.assign-mode-chosen("choose"); }
            }
            if AgentDialogs.assign-mode == "choose" && AgentDialogs.assign-contacts.length > 0: ComboBox {
                model: AgentDialogs.assign-contacts;
                current-index <=> AgentDialogs.assign-contact;
                enabled: !AgentDialogs.submitting;
                // i18n: Assign contact dialog, accessibility label of the drop-down list of contacts to choose from (noun)
                accessible-label: @tr("Contact");
            }
            if AgentDialogs.assign-mode == "choose" && AgentDialogs.assign-contacts.length == 0: Text {
                font-size: ChromeText.body;
                // i18n: Assign contact dialog, note under "Choose contact" when there is no contact to choose
                text: @tr("No contacts available");
                color: Palette.muted;
                wrap: word-wrap;
            }
            Radio {
                // i18n: Assign contact dialog, radio option: create a new contact with a typed name (noun phrase)
                text: @tr("New contact");
                checked: AgentDialogs.assign-mode == "create";
                enabled: !AgentDialogs.submitting;
                clicked => { AgentDialogs.assign-mode-chosen("create"); }
            }
            if AgentDialogs.assign-mode == "create": Field {
                // i18n: Assign contact dialog, placeholder of the text field for the new contact's name (noun)
                placeholder-text: @tr("Name");
                text <=> AgentDialogs.assign-name;
                enabled: !AgentDialogs.submitting;
                // i18n: Assign contact dialog, accessibility label of the field for the new contact's name
                accessible-label: @tr("New contact name");
                init => { if (AgentDialogs.focus-target == "assign") { self.focus(); } }
            }
            if AgentDialogs.error != "" || !AgentDialogs.connected: Text {
                font-size: ChromeText.body;
                text: AgentDialogs.error != "" ? AgentDialogs.error
                    // i18n: Assign contact dialog, warning line shown when the app has no connection to the Host, so assigning cannot be done
                    : @tr("Not connected");
                color: Palette.warning;
                wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                IconButton {
                    icon: @image-url("icons/rail-close.svg");
                    // i18n: Assign contact dialog, label of the icon button that closes the dialog without assigning (verb)
                    label: @tr("Cancel");
                    enabled: !AgentDialogs.submitting;
                    clicked => { AgentDialogs.cancel(); }
                }
                Button {
                    text: AgentDialogs.submitting
                        // i18n: Assign contact dialog, primary button text while the contact is being assigned (in progress)
                        ? @tr("Assigning…")
                        // i18n: Assign contact dialog, primary button (verb: assign the chosen contact to this chat)
                        : @tr("Assign");
                    primary: true;
                    enabled: !AgentDialogs.submitting && AgentDialogs.connected
                        && (AgentDialogs.assign-mode == "auto"
                            || (AgentDialogs.assign-mode == "create" ? AgentDialogs.assign-name != "" : AgentDialogs.assign-contact >= 0));
                    clicked => { AgentDialogs.assign-submit(); }
                }
            }
        }
    }
}

// i18n-screen: queued messages
component QueueRow inherits Rectangle {
    in property <QueuedTurn> item;
    in property <bool> loading;
    border-radius: 3px;
    background: Palette.control;
    border-width: 1px;
    border-color: Palette.border;
    height: body.preferred-height;
    body := VerticalLayout {
        padding: 9px;
        spacing: 7px;
        editor := Editor {
            text: root.item.text;
            wrap: word-wrap;
            font-size: 12 * Look.unit;
            min-height: 54px;
            // i18n: Queued messages dialog, accessibility label of the editable text box holding one message waiting to be sent (noun)
            accessible-label: @tr("Queued message");
        }
        HorizontalLayout {
            spacing: 4px;
            Text {
                text: root.item.stamp;
                color: Palette.faint;
                font-size: 9 * Look.unit;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            IconButton {
                icon: @image-url("icons/check.svg");
                // i18n: Queued messages dialog, one message's icon button: saves the edited text of the queued message (verb)
                label: @tr("Save");
                enabled: !root.loading && editor.text != "" && editor.text != root.item.text;
                clicked => { AgentDialogs.queue-save(root.item.id, editor.text); }
            }
            IconButton {
                icon: @image-url("icons/send.svg");
                // i18n: Queued messages dialog, one message's icon button: sends this queued message at once instead of waiting (verb)
                label: @tr("Send now");
                tint: Palette.accent;
                enabled: !root.loading;
                clicked => { AgentDialogs.queue-send(root.item.id); }
            }
            IconButton {
                icon: @image-url("icons/trash.svg");
                // i18n: Queued messages dialog, one message's icon button: deletes this message from the queue (verb)
                label: @tr("Remove queued message");
                tint: Palette.danger;
                enabled: !root.loading;
                clicked => { AgentDialogs.queue-delete(root.item.id); }
            }
        }
    }
}

// The turns waiting behind the running one: edit, send now or delete each.
export component QueueDialog inherits Modal {
    card-width: 660px;
    card-height: 620px;
    dismissed => { AgentDialogs.cancel(); }
    // Holds the keyboard while open, so typing never reaches the composer behind.
    FocusScope {
        property <int> request: AgentDialogs.focus-request;
        changed request => { if (AgentDialogs.focus-target == "queue") { self.focus(); } }
    }
    VerticalLayout {
        padding: 14px;
        spacing: 9px;
        HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    // i18n: Queued messages dialog, title at the top, written in capitals (noun: the messages waiting to be sent to the agent)
                    text: @tr("QUEUED MESSAGES");
                    color: Palette.text;
                    font-size: 14 * Look.unit;
                    font-weight: 600;
                    letter-spacing: 1.2px;
                }
                Text {
                    text: AgentDialogs.queue-paused
                        // i18n: Queued messages dialog, subtitle under the title when the queue is paused; {} is the chat's name
                        ? @tr("{} · paused", AgentDialogs.queue-title)
                        : AgentDialogs.queue-title;
                    color: AgentDialogs.queue-paused ? Palette.warning : Palette.muted;
                    font-size: 10 * Look.unit;
                }
            }
            if AgentDialogs.queue-loading: Text { font-size: ChromeText.body; text: "…"; color: Palette.muted; vertical-alignment: center; }
            IconButton {
                icon: @image-url("icons/refresh.svg");
                // i18n: Queued messages dialog, icon button that loads the queue again from the Host (verb)
                label: @tr("Reload");
                clicked => { AgentDialogs.queue-refresh(); }
            }
            IconButton {
                icon: @image-url("icons/rail-close.svg");
                // i18n: Queued messages dialog, icon button that closes the dialog (verb)
                label: @tr("Close");
                clicked => { AgentDialogs.cancel(); }
            }
        }
        if AgentDialogs.queue-error != "": Text {
            text: AgentDialogs.queue-error;
            color: Palette.danger;
            font-size: 11 * Look.unit;
            wrap: word-wrap;
        }
        Rectangle {
            vertical-stretch: 1;
            ListView {
                for item in AgentDialogs.queue-items: VerticalLayout {
                    padding-bottom: 7px;
                    QueueRow { item: item; loading: AgentDialogs.queue-loading; }
                }
            }
            if AgentDialogs.queue-items.length == 0 && !AgentDialogs.queue-loading: Text {
                // i18n: Queued messages dialog, empty state when no message is waiting
                text: @tr("No queued messages");
                color: Palette.faint;
                font-size: 11 * Look.unit;
            }
        }
    }
}
