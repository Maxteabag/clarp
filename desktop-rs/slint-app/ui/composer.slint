import { Field, Editor, PlainEditor } from "fields.slint";
import { Palette, Look, RevealText } from "theme.slint";

export struct Attachment {
    id: string,
    name: string,
    status: string,
    thumbnail: image,
}

// An agent the `@` being typed may name (mention_view.rs).
export struct MentionRow {
    session: string,
    name: string,
    detail: string,
}

// The composer's @-mentions: the draft and cursor go to the app as they
// change; the app lists the agents that match what follows the `@`, and
// the list's keys choose one (the pane's id first in each).
export global MentionBridge {
    callback scan(string, string, int);
    callback select(string, int);
    callback accept(string, int);
    callback dismiss(string);
}

// A message waiting behind the running turn (the queue strip): the
// Host's item id, its first line, and whether a turn already reads it.
export struct WaitingTurn {
    id: string,
    text: string,
    reading: bool,
    // On a Host with `queue_steer`, while a turn runs: Steer now reads it
    // into the turn (`steer`), and Send now stops the turn and runs it
    // (`take-over`). Otherwise Send now sends it after the turn's tools
    // allow (`/send`).
    steer: bool,
    take-over: bool,
}

// The keys the composer's buttons name in their tips, as the user bound
// them (commands.rs refresh_keys).
export global ComposerKeys {
    in property <string> stop: "Ctrl+.";
    in property <string> send: "Enter";
    in property <string> latest: "Ctrl+End";
    in property <string> send-now: "Ctrl+Shift+Enter";
}

export component TipButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <color> tint: Palette.muted;
    // Shown above the button while it is hovered ("Stop · Ctrl+.").
    in property <string> tip;
    // A word drawn after the icon ("Stop"), for a button whose icon alone
    // does not say what it does; `captioned-width` is the room both take.
    in property <string> caption;
    out property <length> captioned-width: root.caption == "" ? 32px : 6px + 14px + 4px + word.preferred-width + 7px;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 3px;
    background: touch.has-hover && root.enabled ? Palette.hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    Image {
        source: root.icon;
        x: root.caption == "" ? (root.width - self.width) / 2 : 6px;
        y: (root.height - self.height) / 2;
        width: root.caption == "" ? 18px : 14px;
        height: root.caption == "" ? 18px : 14px;
        colorize: root.enabled ? root.tint : Palette.faint;
    }
    word := Text {
        visible: root.caption != "";
        x: 6px + 14px + 4px;
        height: root.height;
        text: root.caption;
        color: root.enabled ? root.tint : Palette.faint;
        font-size: 12 * Look.unit;
        font-weight: 600;
        vertical-alignment: center;
        accessible-role: none;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if touch.has-hover && root.tip != "": Rectangle {
        width: tip-text.preferred-width + 12px;
        height: 22px;
        x: root.width - self.width;
        y: -self.height - 4px;
        border-radius: 3px;
        background: Palette.raised;
        border-width: 1px;
        border-color: Palette.border;
        tip-text := Text { text: root.tip; color: Palette.text; font-size: 11 * Look.unit; }
    }
}

component Chip inherits Rectangle {
    in property <Attachment> item;
    callback remove();
    height: 24px;
    border-radius: 3px;
    background: Palette.control;
    border-width: 1px;
    border-color: Palette.border;
    HorizontalLayout {
        padding-left: 7px;
        spacing: 4px;
        if root.item.thumbnail.width > 0: Image {
            source: root.item.thumbnail;
            width: 18px;
            height: 18px;
            y: 3px;
            image-fit: cover;
        }
        Text {
            text: root.item.name + (root.item.status == "ready" ? "" : " · " + root.item.status);
            color: root.item.status == "failed" ? Palette.danger : Palette.text;
            font-size: 12 * Look.unit;
            vertical-alignment: center;
            overflow: elide;
            max-width: 180px;
        }
        TipButton {
            width: 22px;
            height: 22px;
            y: 1px;
            icon: @image-url("icons/rail-close.svg");
            label: "Remove " + root.item.name;
            clicked => { root.remove(); }
        }
    }
}

// The composer (Composer.qml): notices above the editor, attachment chips,
// then the editor. Enter sends, Shift+Enter is a new line, Ctrl+Enter
// queues behind a running turn, Ctrl+End jumps to the latest, Escape hands
// the keyboard to the transcript, Ctrl+Shift+O attaches a file.
export component Composer inherits FocusScope {
    forward-focus: editor;
    capture-key-pressed(event) => {
        if (!editor.has-focus) { return reject; }
        // The mention list takes the arrows, Tab and Enter while it shows.
        if (root.mentions.length > 0 && !event.modifiers.control && !event.modifiers.alt) {
            if (event.text == Key.DownArrow) {
                MentionBridge.select(root.pane-id, Math.min(root.mention-current + 1, root.mentions.length - 1));
                return accept;
            }
            if (event.text == Key.UpArrow) {
                MentionBridge.select(root.pane-id, Math.max(root.mention-current - 1, 0));
                return accept;
            }
            if (event.text == Key.Tab || (event.text == Key.Return && !event.modifiers.shift)) {
                MentionBridge.accept(root.pane-id, root.mention-current);
                return accept;
            }
            if (event.text == Key.Escape) {
                MentionBridge.dismiss(root.pane-id);
                return accept;
            }
        }
        if (event.text == Key.Escape) {
            root.escape();
            return accept;
        }
        if (event.text == Key.Return && !event.modifiers.shift) {
            root.submit(event.modifiers.control);
            return accept;
        }
        if (event.text == Key.End && event.modifiers.control) {
            root.jump-to-latest();
            return accept;
        }
        if ((event.text == "v" || event.text == "V") && event.modifiers.control && !event.modifiers.shift) {
            if (root.paste-image()) { return accept; }
            return reject;
        }
        if ((event.text == "o" || event.text == "O") && event.modifiers.control && event.modifiers.shift) {
            root.attach();
            return accept;
        }
        reject
    }

    in-out property <string> draft;
    in property <[Attachment]> attachments;
    in property <int> queued;
    in property <bool> queue-paused;
    // The queue strip above the composer lists the waiting messages: the
    // count line then stays away.
    in property <bool> strip-shown;
    in property <string> quota-notice;
    in property <string> stop-notice;
    in property <string> starting;
    in property <int> transcribing;
    // Speech is playing (or paused): the Silence button shows.
    in property <bool> playing;
    // This chat's dictation is recording.
    in property <bool> recording;
    callback silence();
    // Ctrl+V: true when the clipboard held an image and it was attached.
    callback paste-image() -> bool;
    in property <bool> busy;
    in property <bool> can-send: true;
    in property <bool> active: true;
    in property <string> agent-name;
    // @-mentions: the pane, the agents matching the `@` being typed, the
    // chosen one, and the agent a send goes to ("" for this chat).
    in property <string> pane-id;
    in property <[MentionRow]> mentions;
    in property <int> mention-current;
    in property <string> route;
    // Puts the editor's cursor at `at` (bytes): after a completed mention.
    public function set-cursor(at: int) { editor.set-cursor(at); }
    callback send(string, bool);
    callback stop();
    callback edited(string);
    callback attach();
    callback remove-attachment(string);
    callback cancel-transcription();
    callback escape();
    callback jump-to-latest();
    callback queue-requested();

    out property <bool> editor-focused: editor.has-focus;
    // Where the editor is drawn (in the window) and how tall its text is:
    // the send animation lifts the text out of it.
    out property <length> editor-x: editor.absolute-position.x;
    out property <length> editor-y: editor.absolute-position.y;
    out property <length> editor-width: editor.width;
    out property <length> editor-height: editor.height;
    out property <length> editor-text-height: editor.text-height;
    property <bool> sendable: root.can-send && (root.draft != "" || root.attachments.length > 0);
    function submit(queue: bool) {
        if (root.sendable) {
            root.send(root.draft, queue);
        }
    }
    // The [i] Insert frame is the box: the editor sits on the pane itself,
    // and its actions are keys (the shortcut bar lists them).
    VerticalLayout {
        padding-left: 4px;
        padding-right: 4px;
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 6px;
        if root.starting != "": Text {
            text: "Starting " + root.starting + "…";
            color: Palette.muted;
            font-size: 12 * Look.unit;
        }
        if root.recording: Text {
            text: "● Recording · Ctrl+Shift+Space sends";
            color: Palette.danger;
            font-size: 12 * Look.unit;
        }
        if root.transcribing > 0: HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.transcribing == 1 ? "Transcribing voice in background…" : root.transcribing + " voice notes transcribing…";
                color: Palette.muted;
                font-size: 12 * Look.unit;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: "Cancel";
                color: Palette.link;
                font-size: 12 * Look.unit;
                TouchArea { clicked => { root.cancel-transcription(); } }
            }
        }
        if root.quota-notice != "": Text {
            text: "! " + root.quota-notice;
            color: Palette.warning;
            font-size: 12 * Look.unit;
            overflow: elide;
            accessible-label: root.quota-notice;
        }
        // What Stop did: never what happens next (Stop does not resume).
        if root.stop-notice != "": Text {
            text: "■ " + root.stop-notice;
            color: Palette.muted;
            font-size: 12 * Look.unit;
            overflow: elide;
            accessible-label: root.stop-notice;
        }
        // The count waits the grace period after a rise (view.rs
        // queued_shown) and fades in. A paused queue's messages wait until
        // sent: its dialog sends one now (the queue stays paused until empty).
        if root.queued > 0 && !root.strip-shown: RevealText {
            text: root.queued + (root.queued == 1 ? " message queued" : " messages queued")
                + (root.queue-paused ? "  ·  paused  ·  click to send one now" : "  ·  Ctrl+Enter queues next");
            color: Palette.muted;
            font-size: 12 * Look.unit;
            overflow: elide;
            accessible-role: button;
            // Opens the queue dialog (launch dialogs).
            TouchArea { mouse-cursor: pointer; clicked => { root.queue-requested(); } }
        }
        if root.mentions.length > 0: Rectangle {
          accessible-role: list;
          accessible-label: "Agents to mention";
          VerticalLayout {
            for row[index] in root.mentions: Rectangle {
                height: 26px;
                border-radius: 3px;
                background: index == root.mention-current ? Palette.control : touch.has-hover ? Palette.hover : transparent;
                accessible-role: list-item;
                accessible-id: "mention:" + row.session;
                accessible-label: row.name;
                touch := TouchArea { clicked => { MentionBridge.accept(root.pane-id, index); } }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    Text { text: "@" + row.name; color: Palette.text; font-size: 13 * Look.unit; vertical-alignment: center; }
                    Text { text: row.detail; color: Palette.muted; font-size: 11 * Look.unit; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    if index == root.mention-current: Text { text: "Tab"; color: Palette.accent; font-size: 11 * Look.unit; vertical-alignment: center; }
                }
            }
          }
        }
        // Where Enter sends: another agent's chat, named in the draft.
        if root.route != "": HorizontalLayout {
            alignment: start;
            Rectangle {
                height: 22px;
                border-radius: 11px;
                background: Palette.accent.with-alpha(0.18);
                accessible-role: text;
                accessible-id: "route-chip";
                accessible-label: "Sends to " + root.route;
                HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 9px;
                    Text { text: "→ " + root.route + "  ·  Enter sends to " + root.route + "'s chat"; color: Palette.text; font-size: 12 * Look.unit; vertical-alignment: center; }
                }
            }
        }
        if root.attachments.length > 0: HorizontalLayout {
            spacing: 5px;
            alignment: start;
            for item in root.attachments: Chip {
                item: item;
                remove => { root.remove-attachment(item.id); }
            }
        }
        HorizontalLayout {
        spacing: 4px;
        editor := PlainEditor {
            horizontal-stretch: 1;
            text <=> root.draft;
            // The editor wraps to the pane: it never sets the pane's width.
            min-width: 0px;
            enabled: root.active;
            wrap: word-wrap;
            font-size: Palette.body-size;
            font-family: Palette.body-family;
            // One line to start; grows with the text up to 240px, then
            // scrolls.
            height: clamp(self.text-height, Palette.body-size * 1.6, 240px);
            accessible-label: "Message to " + root.agent-name;
            accessible-id: "composer-editor";
            edited(text) => {
                root.edited(text);
                MentionBridge.scan(root.pane-id, text, self.cursor);
            }
            cursor-moved(at) => { MentionBridge.scan(root.pane-id, self.text, at); }
        }
        // While the agent works: Stop, as its key does.
        if root.busy && root.active: VerticalLayout {
            alignment: end;
            // No taller than the editor's one line: a button never makes the
            // composer taller.
            TipButton {
                width: self.captioned-width;
                height: Palette.body-size * 1.6;
                icon: @image-url("icons/stop.svg");
                caption: "Stop";
                label: "Stop";
                tip: ComposerKeys.stop == "" ? "Stop" : "Stop · " + ComposerKeys.stop;
                tint: Palette.danger;
                accessible-id: "composer-stop";
                clicked => { root.stop(); }
            }
        }
        // With something to send: Send, as Enter does.
        if root.sendable && root.active: VerticalLayout {
            alignment: end;
            // No taller than the editor's one line: a button never makes the
            // composer taller.
            TipButton {
                width: Palette.body-size * 1.6;
                height: Palette.body-size * 1.6;
                icon: @image-url("icons/send.svg");
                label: "Send";
                tip: "Send · " + ComposerKeys.send;
                tint: Palette.accent;
                accessible-id: "composer-send";
                clicked => { root.submit(false); }
            }
        }
        }
    }
}

// The waiting line's action: a filled pill with an icon and its word
// ("Steer now").
component ChipAction inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <string> tip;
    callback clicked();
    width: action-row.preferred-width;
    height: 20px;
    border-radius: 10px;
    background: touch.has-hover ? Palette.accent.brighter(10%) : Palette.accent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.tip;
    accessible-action-default => { root.clicked(); }
    action-row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 5px;
        Image {
            source: root.icon;
            width: 12px;
            height: 12px;
            y: (parent.height - self.height) / 2;
            colorize: Palette.accent-text;
        }
        Text {
            text: root.text;
            color: Palette.accent-text;
            font-size: 11 * Look.unit;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// The messages waiting behind the running turn, above the composer, as one
// line: "1 waiting · Steer now". Its action reads them into the running
// turn, or stops it for them where it cannot take them, or after a Stop
// sends them (Ctrl+Shift+Enter does the same); Manage lists and edits them.
// What could not be sent says so under it; the message waits on. Shown
// while messages wait and Show queue is on, folded composer or not.
export component QueueStrip inherits Rectangle {
    in property <[WaitingTurn]> items;
    // The Host's count of waiting messages.
    in property <int> count;
    in property <bool> busy;
    in property <bool> paused;
    in property <string> refused;
    in property <string> pane-id;
    // The line's action ("steer", "take-over", "send"; "" for none), the
    // message it acts on, and its word.
    in property <string> chip-kind;
    in property <string> chip-target;
    in property <string> chip-label;
    callback send-now(string);
    callback steer-now(string);
    callback take-over(string);
    callback manage();
    background: Palette.window;
    accessible-role: list;
    accessible-id: "queue-strip:" + root.pane-id;
    accessible-label: root.count == 1 ? "1 message waiting" : root.count + " messages waiting";
    VerticalLayout {
        padding-left: 14px;
        padding-right: 10px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 2px;
        HorizontalLayout {
            height: 24px;
            spacing: 8px;
            if root.count > 0: Rectangle {
                width: chip-row.preferred-width;
                border-radius: 12px;
                background: Palette.raised;
                border-width: 1px;
                border-color: Palette.border;
                accessible-role: groupbox;
                accessible-id: "steer-chip:" + root.pane-id;
                accessible-label: (root.count == 1 ? "1 waiting" : root.count + " waiting") + (root.chip-label != "" ? " · " + root.chip-label : "");
                chip-row := HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 2px;
                    spacing: 5px;
                    Image {
                        source: @image-url("icons/clock.svg");
                        width: 12px;
                        height: 12px;
                        y: (parent.height - self.height) / 2;
                        colorize: Palette.muted;
                    }
                    Text {
                        text: root.count + " waiting";
                        color: Palette.muted;
                        font-size: 11 * Look.unit;
                        vertical-alignment: center;
                    }
                    if root.chip-kind != "": Text {
                        text: "·";
                        color: Palette.faint;
                        font-size: 11 * Look.unit;
                        vertical-alignment: center;
                    }
                    if root.chip-kind != "": ChipAction {
                        y: 1px;
                        icon: root.chip-kind == "steer" ? @image-url("icons/steer.svg") : root.chip-kind == "take-over" ? @image-url("icons/stop.svg") : @image-url("icons/send.svg");
                        text: root.chip-label;
                        tip: root.chip-kind == "steer" ? "Read into this turn" : root.chip-kind == "take-over" ? "Stop this turn and send" : "Send now";
                        accessible-id: "steer-chip-action:" + root.pane-id;
                        clicked => {
                            if (root.chip-kind == "steer") { root.steer-now(root.chip-target); }
                            else if (root.chip-kind == "take-over") { root.take-over(root.chip-target); }
                            else { root.send-now(root.chip-target); }
                        }
                    }
                }
            }
            if root.count > 0 && root.paused && !root.busy: Text {
                text: "queue paused";
                color: Palette.muted;
                font-size: 11 * Look.unit;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            if root.count > 0: Rectangle {
                width: manage-text.preferred-width;
                accessible-role: button;
                accessible-id: "queue-manage:" + root.pane-id;
                accessible-label: "Manage waiting messages";
                accessible-action-default => { root.manage(); }
                manage-text := Text {
                    text: "Manage";
                    color: manage-touch.has-hover ? Palette.accent : Palette.link;
                    font-size: 11 * Look.unit;
                    vertical-alignment: center;
                }
                manage-touch := TouchArea { mouse-cursor: pointer; clicked => { root.manage(); } }
            }
        }
        if root.refused != "": Text {
            text: root.refused;
            color: Palette.warning;
            font-size: 11 * Look.unit;
            wrap: word-wrap;
            accessible-role: text;
            accessible-id: "queue-refused:" + root.pane-id;
            accessible-label: root.refused;
        }
    }
}
