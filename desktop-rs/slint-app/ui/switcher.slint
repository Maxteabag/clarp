import { ListView } from "std-widgets.slint";
import { Field, Editor } from "fields.slint";
import { Palette, Focus, FocusRing, Look } from "theme.slint";

export struct SwitcherRow {
    kind: string,
    label: string,
    detail: string,
    key: string,
    group: string,
    // A setting's current value ("On", "Paper"); "Current" in a picker.
    value: string,
    // A message search result: the words around the match, matches bold.
    snippet: styled-text,
    // A setting that steps: + and - change it in place.
    adjustable: bool,
}

// The quick switcher (QuickSwitcher.qml): type to find an agent, command or
// setting; Up/Down move, Enter chooses, Escape or a click outside closes.
// Each row says what it does under its name; a setting shows its value,
// and Enter on a setting with choices lists them here.
export component Switcher inherits Rectangle {
    in property <[SwitcherRow]> rows;
    in-out property <int> current;
    in property <string> placeholder: "Agent, contact, setting or command";
    in property <string> empty-text: "No matching agent or contact";
    // What the keys do, under the list.
    in property <string> hint: "↑↓ move · Enter run or switch · Esc close";
    // Under the results: what message search searched.
    in property <string> note;
    out property <string> query: search.text;
    property <length> row-height: 46px;
    callback edited(string);
    callback chosen(int);
    callback moved(int);
    callback dismissed();
    // + or - on a setting that steps (the row, and -1 or 1).
    callback adjusted(int, int);
    public function open() {
        search.text = "";
        search.focus();
    }
    background: #00000080;
    // A click outside the panel closes it.
    TouchArea { clicked => { root.dismissed(); } }
    panel := Rectangle {
        width: Math.min(560px, root.width - 32px);
        height: Math.min(500px, root.height - 80px);
        x: (root.width - self.width) / 2;
        y: Math.min(145px, root.height * 0.15);
        border-radius: 3px;
        background: Palette.window;
        border-width: 1px;
        border-color: Palette.border;
        TouchArea { }
        keys := FocusScope {
            capture-key-pressed(event) => {
                if (event.text == Key.DownArrow) {
                    root.moved(Math.min(root.current + 1, root.rows.length - 1));
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    root.moved(Math.max(root.current - 1, 0));
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.chosen(root.current);
                    return accept;
                }
                // A setting steps in place: the switcher stays open on it.
                if ((event.text == "+" || event.text == "=" || event.text == "-") && root.current >= 0 && root.current < root.rows.length && root.rows[root.current].adjustable) {
                    root.adjusted(root.current, event.text == "-" ? -1 : 1);
                    return accept;
                }
                reject
            }
            VerticalLayout {
                padding: 5px;
                spacing: 4px;
                search := Field {
                    height: 43px;
                    accessible-label: root.placeholder;
                    font-size: 14 * Look.unit;
                    placeholder-text: root.placeholder;
                    edited(text) => { root.edited(text); }
                }
                if root.rows.length == 0: Text {
                    text: root.empty-text;
                    color: Palette.faint;
                    font-size: 12 * Look.unit;
                    horizontal-alignment: center;
                }
                list := ListView {
                    vertical-stretch: 1;
                    for row[index] in root.rows: Rectangle {
                        height: root.row-height;
                        border-radius: 3px;
                        background: index == root.current ? Palette.control : touch.has-hover ? Palette.hover : transparent;
                        touch := TouchArea { clicked => { root.chosen(index); } }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            Text {
                                text: row.kind == "agent" ? "●" : row.kind == "contact" ? "+" : row.kind == "message" ? "❞" : "›";
                                color: row.kind == "agent" ? Palette.success : Palette.faint;
                                vertical-alignment: center;
                                width: 12px;
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                if row.kind != "message": Text { text: row.label; color: Palette.text; overflow: elide; }
                                if row.kind == "message": Text { text: row.label; color: Palette.muted; font-size: 11px; overflow: elide; }
                                if row.kind == "message": Rectangle {
                                    height: 16px;
                                    clip: true;
                                    StyledText {
                                        x: 0;
                                        y: 0;
                                        width: parent.width;
                                        text: row.snippet;
                                        default-color: Palette.text;
                                        default-font-size: 12px;
                                    }
                                }
                                if row.detail != "" && row.kind != "message": Text { text: row.detail; color: Palette.muted; font-size: 11px; overflow: elide; }
                            }
                            if row.value != "": Rectangle {
                                y: (parent.height - self.height) / 2;
                                height: 20px;
                                width: value-text.preferred-width + 14px;
                                border-radius: 10px;
                                background: row.value == "On" || row.value == "Current" ? Palette.accent : Palette.sunken;
                                value-text := Text {
                                    text: row.value;
                                    color: row.value == "On" || row.value == "Current" ? Palette.accent-text : Palette.text;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            if row.adjustable && index == root.current: Text {
                                text: "−  +";
                                color: Palette.accent;
                                font-size: 13 * Look.unit;
                                font-weight: 700;
                                vertical-alignment: center;
                                accessible-label: "Minus or plus steps it";
                            }
                            if row.key != "": Text {
                                text: row.key;
                                color: Palette.accent;
                                font-size: 11 * Look.unit;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                if root.note != "": Text {
                    text: root.note;
                    color: Palette.faint;
                    font-size: 11px;
                    wrap: word-wrap;
                    accessible-role: text;
                    accessible-id: "switcher-note";
                    accessible-label: root.note;
                }
                if root.hint != "": Text {
                    text: root.hint;
                    color: Palette.faint;
                    font-size: 11px;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
        }
        FocusRing { shown: Focus.mode == "modal"; }
    }
    // Keep the chosen row in view as Up/Down move it.
    changed current => {
        if (root.current >= 0) {
            list.content-y = Math.min(Math.max(list.content-y, -root.current * root.row-height), list.visible-height - (root.current + 1) * root.row-height);
        }
    }
}
