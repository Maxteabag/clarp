import { Palette, Look, ChromeText, RevealText } from "theme.slint";
import { ListView, ScrollView } from "std-widgets.slint";
import { Modal } from "dialogs.slint";
import { AvatarActivity, ActivitySweep, StatusPill, AvatarArt } from "avatar.slint";
import { IconButton, TextButton } from "agent_controls.slint";

export struct OverviewSchedule {
    id: string,
    title: string,
    prompt: string,
    on: bool,
}

export struct OverviewCard {
    session: string,
    name: string,
    initial: string,
    symbol: string,
    portrait: image,
    preview: string,
    state: string,
    backend: string,
    model: string,
    folder: string,
    queued: int,
    queue-paused: bool,
    // Context used, 0–1; below 0 when the window is unknown.
    context: float,
    busy: bool,
    muted: bool,
    heartbeat: bool,
    dreaming: bool,
    selected: bool,
    schedules: [OverviewSchedule],
}

export struct OverviewArchived {
    session: string,
    name: string,
    preview: string,
}

export struct OverviewContact {
    name: string,
    initial: string,
    detail: string,
    starting: bool,
}

// The overview's state and commands (Rust sets and handles them).
export global OverviewBridge {
    in property <[OverviewCard]> cards;
    in property <[OverviewArchived]> archived;
    in property <[OverviewContact]> contacts;
    in property <bool> starting;
    in property <bool> reduced-motion;
    // The card whose actions menu is open, and one whose release awaits a
    // second click.
    in-out property <string> menu;
    in-out property <string> confirm-release;
    callback close();
    callback new-agent();
    callback orchestrator();
    callback open(string);
    callback relaunch(string);
    callback voice(string);
    callback heartbeat(string);
    callback dreaming(string);
    callback push-alerts(string);
    callback archive(string);
    callback release(string);
    callback restore(string);
    callback start(string);
    callback schedule(string, bool);
}

component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    callback clicked();
    height: 26px;
    background: touch.has-hover ? Palette.hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    Text { x: 10 * Look.unit; text: root.text; color: root.danger ? Palette.danger : Palette.text; font-size: 12 * Look.unit; }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component Card inherits Rectangle {
    in property <OverviewCard> card;
    border-radius: 2px;
    background: root.card.selected ? Palette.control : Palette.raised;
    VerticalLayout {
        padding: 9px;
        spacing: 7px;
        HorizontalLayout {
            spacing: 9px;
            avatar := AvatarActivity {
                y: (parent.height - self.height) / 2;
                portrait: root.card.portrait;
                name: root.card.name;
                initial: root.card.initial;
                symbol: root.card.symbol;
                size: AvatarArt.card;
                working: root.card.busy;
                reduced-motion: OverviewBridge.reduced-motion;
            }
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                alignment: center;
                Text { text: root.card.name; color: Palette.text; font-family: "JetBrains Mono"; font-size: 13 * Look.unit; font-weight: 600; }
                Rectangle {
                    height: preview.preferred-height;
                    ActivitySweep {
                        width: parent.width;
                        height: parent.height;
                        working: root.card.busy;
                        reduced-motion: OverviewBridge.reduced-motion;
                        phase: avatar.phase;
                    }
                    preview := Text {
                        width: parent.width;
                        text: root.card.preview;
                        color: Palette.muted;
                        font-size: 12 * Look.unit;
                        overflow: elide;
                    }
                }
            }
            StatusPill { status: root.card.state; }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { text: root.card.backend; color: Palette.chrome-text; font-family: "JetBrains Mono"; font-size: 11 * Look.unit; }
            // i18n: All agents overview, agent card, shown in place of the model name when the agent uses its backend's default model (adjective/noun)
            Text { text: root.card.model != "" ? root.card.model : @tr("default"); color: Palette.faint; font-family: "JetBrains Mono"; font-size: 11 * Look.unit; }
            Text { text: root.card.folder; color: Palette.faint; font-family: "JetBrains Mono"; font-size: 11 * Look.unit; overflow: elide; horizontal-stretch: 1; }
            if root.card.queued > 0: RevealText {
                text: root.card.queue-paused
                    // i18n: All agents overview, agent card, tag: {n} messages wait in the agent's queue, and the queue is paused
                    ? @tr("{n} queued · paused" | "{n} queued · paused" % root.card.queued)
                    // i18n: All agents overview, agent card, tag: {n} messages wait in the agent's queue
                    : @tr("{n} queued" | "{n} queued" % root.card.queued); color: Palette.chrome-text; font-family: "JetBrains Mono"; font-size: 11 * Look.unit; }
        }
        if root.card.context >= 0: Rectangle {
            height: 3px;
            border-radius: 1.5px;
            background: Palette.border;
            Rectangle { x: 0; width: parent.width * Math.clamp(root.card.context, 0, 1); border-radius: 1.5px; background: Palette.muted; }
        }
        if root.card.schedules.length > 0: VerticalLayout {
            spacing: 5px;
            // i18n: All agents overview, agent card, heading over the agent's scheduled tasks (noun, written in capitals where the script has them)
            Text { text: @tr("SCHEDULED TASKS"); color: Palette.muted; font-size: 11 * Look.unit; font-weight: 600; letter-spacing: 1 * Look.unit; }
            for schedule in root.card.schedules: Rectangle {
                height: 48px;
                border-radius: 2px;
                background: Palette.window;
                border-width: 1px;
                border-color: Palette.control;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 8px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        horizontal-stretch: 1;
                        Text { text: schedule.title; color: Palette.text; font-size: 12 * Look.unit; overflow: elide; }
                        Text { text: schedule.prompt; color: Palette.muted; font-size: 11 * Look.unit; overflow: elide; }
                    }
                    TextButton {
                        y: (parent.height - self.height) / 2;
                        text: schedule.on
                            // i18n: All agents overview, scheduled task row, toggle button while the task is on (a state of the task, feminine where "task" is; clicking turns it off)
                            ? @tr("scheduled task" => "On")
                            // i18n: All agents overview, scheduled task row, toggle button while the task is off (a state of the task, feminine where "task" is; clicking turns it on)
                            : @tr("scheduled task" => "Off");
                        primary: schedule.on;
                        clicked => { OverviewBridge.schedule(schedule.id, !schedule.on); }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 5px;
            // i18n: All agents overview, agent card, button (verb): open the agent's chat
            TextButton { text: @tr("Open"); clicked => { OverviewBridge.open(root.card.session); } }
            Rectangle { horizontal-stretch: 1; }
            IconButton {
                icon: @image-url("icons/more.svg");
                // i18n: All agents overview, agent card, tooltip of the ··· menu button (noun phrase: actions for this agent)
                tip: @tr("Agent actions");
                clicked => {
                    OverviewBridge.menu = OverviewBridge.menu == root.card.session ? "" : root.card.session;
                }
            }
        }
        // The card's "···" menu, opened in place.
        if OverviewBridge.menu == root.card.session: Rectangle {
            border-radius: 2px;
            border-width: 1px;
            border-color: Palette.border;
            background: Palette.window;
            VerticalLayout {
                padding: 3px;
                // i18n: All agents overview, agent card menu item (verb): restart the agent
                MenuItem { text: @tr("Relaunch"); clicked => { OverviewBridge.relaunch(root.card.session); } }
                // i18n: All agents overview, agent card menu item (noun): pick the voice the agent speaks with
                MenuItem { text: @tr("Voice"); clicked => { OverviewBridge.voice(root.card.session); } }
                Rectangle { height: 1px; background: Palette.rule; }
                MenuItem {
                    text: root.card.heartbeat
                        // i18n: All agents overview, agent card menu item (verb phrase): turn off the agent's heartbeat (a regular check-in prompt)
                        ? @tr("Disable heartbeat")
                        // i18n: All agents overview, agent card menu item (verb phrase): turn on the agent's heartbeat (a regular check-in prompt)
                        : @tr("Enable heartbeat"); clicked => { OverviewBridge.heartbeat(root.card.session); } }
                MenuItem {
                    text: root.card.dreaming
                        // i18n: All agents overview, agent card menu item (verb phrase): turn off dreaming (the agent reflects on its work while idle)
                        ? @tr("Disable dreaming")
                        // i18n: All agents overview, agent card menu item (verb phrase): turn on dreaming (the agent reflects on its work while idle)
                        : @tr("Enable dreaming"); clicked => { OverviewBridge.dreaming(root.card.session); } }
                MenuItem {
                    text: root.card.muted
                        // i18n: All agents overview, agent card menu item (verb phrase): turn the agent's phone push notifications back on
                        ? @tr("Enable push alerts")
                        // i18n: All agents overview, agent card menu item (verb phrase): silence the agent's phone push notifications
                        : @tr("Mute push alerts"); clicked => { OverviewBridge.push-alerts(root.card.session); } }
                Rectangle { height: 1px; background: Palette.rule; }
                // i18n: All agents overview, agent card menu item (verb): archive the agent
                MenuItem { text: @tr("Archive"); clicked => { OverviewBridge.archive(root.card.session); } }
                MenuItem {
                    text: OverviewBridge.confirm-release == root.card.session
                        // i18n: All agents overview, agent card menu item after one click on Release: click again to confirm (verb phrase)
                        ? @tr("Confirm release")
                        // i18n: All agents overview, agent card menu item (verb): release the agent, ending it for good (asks to confirm)
                        : @tr("Release…");
                    danger: true;
                    clicked => { OverviewBridge.release(root.card.session); }
                }
            }
        }
    }
}

// AgentOverview.qml: every agent as a card with its actions, the archived
// agents to restore, and contacts ready to start.
export component AgentOverview inherits Modal {
    card-width: 100000px;
    card-height: 100000px;
    dismissed => { OverviewBridge.close(); }
    // The panel's own surface (Theme.raised), under the card's contents.
    Rectangle {
        x: 1px;
        y: 1px;
        width: Math.min(root.card-width, root.width - 40px) - 2px;
        height: Math.min(root.card-height, root.height - 40px) - 2px;
        border-radius: 3px;
        background: Palette.raised;
    }
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                // i18n: All agents overview, title at the top (noun, plural; written in capitals where the script has them)
                Text { text: @tr("AGENTS"); color: Palette.text; font-family: "JetBrains Mono"; font-size: 17 * Look.unit; font-weight: 600; letter-spacing: 1.5 * Look.unit; }
                // i18n: All agents overview, line beside the title; {n} is how many agents are running (adjective)
                Text { text: @tr("{n} active" | "{n} active" % OverviewBridge.cards.length); color: Palette.muted; font-family: "JetBrains Mono"; font-size: 11 * Look.unit; }
            }
            // i18n: All agents overview, tooltip of the + button: create a new agent
            IconButton { y: (parent.height - self.height) / 2; icon: @image-url("icons/plus.svg"); tip: @tr("New agent"); clicked => { OverviewBridge.new-agent(); } }
            // i18n: All agents overview, tooltip of the button that opens the Orchestrator dialog (noun, translated: the model that routes messages to agents)
            IconButton { y: (parent.height - self.height) / 2; icon: @image-url("icons/route.svg"); tip: @tr("Orchestrator"); clicked => { OverviewBridge.orchestrator(); } }
            // i18n: All agents overview, tooltip of the close button (verb)
            IconButton { y: (parent.height - self.height) / 2; icon: @image-url("icons/close.svg"); tip: @tr("Close"); clicked => { OverviewBridge.close(); } }
        }
        ListView {
            vertical-stretch: 1;
            for card in OverviewBridge.cards: VerticalLayout {
                padding-bottom: 6px;
                Card { card: card; }
            }
        }
        if OverviewBridge.archived.length > 0: VerticalLayout {
            height: 88px;
            spacing: 6px;
            // i18n: All agents overview, heading over archived agents (adjective used as a noun; written in capitals where the script has them)
            Text { text: @tr("ARCHIVED"); color: Palette.muted; font-size: 12 * Look.unit; font-weight: 600; letter-spacing: 1.2 * Look.unit; }
            ScrollView {
                vertical-stretch: 1;
                content-width: archived-row.preferred-width;
                content-height: self.visible-height;
                archived-row := HorizontalLayout {
                    height: parent.height;
                    spacing: 8px;
                    for item in OverviewBridge.archived: Rectangle {
                        width: 250px;
                        border-radius: 2px;
                        background: Palette.raised;
                        border-width: 1px;
                        border-color: Palette.border;
                        HorizontalLayout {
                            padding: 9px;
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 1px;
                                Text { text: item.name; color: Palette.text; font-size: 13 * Look.unit; font-weight: 500; }
                                Text { text: item.preview; color: Palette.muted; font-size: 11 * Look.unit; overflow: elide; }
                            }
                            // i18n: All agents overview, archived agent row, tooltip (verb): bring the agent back from the archive
                            IconButton { y: (parent.height - self.height) / 2; icon: @image-url("icons/restore.svg"); tip: @tr("Restore"); clicked => { OverviewBridge.restore(item.session); } }
                        }
                    }
                }
            }
        }
        if OverviewBridge.contacts.length > 0: VerticalLayout {
            height: 126px;
            spacing: 7px;
            // i18n: All agents overview, heading over contacts that can be started as agents (written in capitals where the script has them)
            Text { text: @tr("READY CONTACTS"); color: Palette.muted; font-size: 12 * Look.unit; font-weight: 600; letter-spacing: 1.2 * Look.unit; }
            ScrollView {
                vertical-stretch: 1;
                content-width: contact-row.preferred-width;
                content-height: self.visible-height;
                contact-row := HorizontalLayout {
                    height: parent.height;
                    spacing: 8px;
                    for contact in OverviewBridge.contacts: Rectangle {
                        width: 280px;
                        border-radius: 2px;
                        background: Palette.raised;
                        border-width: 1px;
                        border-color: Palette.border;
                        HorizontalLayout {
                            padding: 10px;
                            spacing: 9px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 36px;
                                    height: 36px;
                                    border-radius: 2px;
                                    background: Palette.border;
                                    Text { font-size: ChromeText.body; text: contact.initial; color: Palette.text; font-weight: 600; }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 1px;
                                Text { text: contact.name; color: Palette.text; font-size: 14 * Look.unit; font-weight: 500; }
                                Text { text: contact.detail; color: Palette.muted; font-size: 11 * Look.unit; overflow: elide; }
                            }
                            VerticalLayout {
                                alignment: center;
                                TextButton {
                                    text: contact.starting
                                        // i18n: All agents overview, ready contact, button while the contact is being started as an agent (a state)
                                        ? @tr("Starting…")
                                        // i18n: All agents overview, ready contact, button (verb): start this contact as an agent
                                        : @tr("Start");
                                    enabled: !OverviewBridge.starting;
                                    clicked => { OverviewBridge.start(contact.name); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
