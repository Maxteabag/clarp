import { Palette, Focus, Look, ChatText } from "theme.slint";
import { Modal } from "dialogs.slint";

// One answer a decision or question offers.
export struct ArtifactOption {
    id: string,
    label: string,
    detail: string,
    recommended: bool,
}

// One of a card's key hints: the key, what it does, the action a click on
// it runs (as the key would), and whether it is the answer chosen.
export struct CardHint {
    key: string,
    label: string,
    action: string,
    chosen: bool,
}

// A clarp.form v2 chart as the card draws it (form_chart.rs): each mark is
// SVG path data in a fixed view box (a plot's 1000 by 200, a pie's 200
// square) stretched to the plot; ticks, dots and legend colours are
// fractions of it and palette indices.
export struct FormChartMark {
    commands: string,
    color: int,
    fill: bool,
}
export struct FormChartTick {
    at: float,
    text: string,
}
export struct FormChartDot {
    x: float,
    y: float,
    color: int,
}
export struct FormChartKey {
    label: string,
    color: int,
}
export struct FormChart {
    kind: string,
    title: string,
    marks: [FormChartMark],
    dots: [FormChartDot],
    x-ticks: [FormChartTick],
    y-ticks: [FormChartTick],
    keys: [FormChartKey],
    x-label: string,
    y-label: string,
    summary: string,
}

// A clarp.form v2 table: columns (label, end-aligned, width in characters)
// and rows of cells (flag: -1 none, 0 a dash for false, 1 a check for true).
export struct FormTableColumn {
    label: string,
    end: bool,
    chars: int,
}
export struct FormTableCell {
    text: string,
    flag: int,
}
export struct FormTableRow {
    cells: [FormTableCell],
    // What a screen reader says for the row.
    words: string,
}
export struct FormTable {
    title: string,
    columns: [FormTableColumn],
    rows: [FormTableRow],
    // Every column's width in characters, added up.
    chars: int,
}

// One element of a native form (render_spec, catalog clarp.form v1 and v2)
// as the card draws it. `kind` is the element's type as drawn: heading,
// text, field, toggle, choice, divider, card (a card's title row), chart,
// table or button. A type a later catalog adds is one more kind here and
// one more arm in FormLeafView; until then its form reads as needing a newer
// app and the card stays plain.
export struct FormLeaf {
    id: string,
    kind: string,
    // A heading's or text's words, a control's label, a card's title.
    text: string,
    level: int,
    placeholder: string,
    multiline: bool,
    // The answer key a control writes.
    key: string,
    // A text field's text (or the answer read-only), a toggle's state.
    value: string,
    on: bool,
    // A choice's options (id: the value) and the one chosen (-1: none).
    options: [ArtifactOption],
    chosen: int,
    required: bool,
    // Why a text cannot be sent yet ("At least 10 characters.").
    note: string,
    chart: FormChart,
    table: FormTable,
    // A button: its style (primary, secondary or destructive), its question
    // before sending ("" for none), whether it can be pressed now, and
    // whether its answer is being sent. `key` is its action; `on` marks the
    // button the answer chose.
    style: string,
    confirm: string,
    enabled: bool,
    busy: bool,
}

// One row of a form: an element, or a horizontal stack's elements side by
// side (cells), and whether it sits in a card (first and last row rounded).
export struct FormRow {
    leaf: FormLeaf,
    cells: [FormLeaf],
    in-card: bool,
    card-top: bool,
    card-bottom: bool,
}

// One artifact card in the chat (iOS ArtifactCard): what every type shows
// inline, and the state its controls are in.
export struct ArtifactItem {
    id: string,
    // The Host's type (countdown, document, ...), and as shown.
    kind: string,
    label: string,
    outcome: string,
    failed: bool,
    // The status worth a badge: draft, failed, cancelled, expired ("" for none).
    badge: string,
    title: string,
    summary: string,
    progress: string,
    form: bool,
    // countdown: the target in seconds on ArtifactBridge.now's clock, when
    // it parses; the target's date and zone; why there is no clock.
    countdown-at: int,
    countdown-set: bool,
    countdown-line: string,
    countdown-note: string,
    // The artifact's Markdown body where the card shows it, and drawn.
    note: string,
    note-styled: styled-text,
    // What Enter or a click does ("" for nothing), and how it went.
    action: string,
    // An HTML report O shows as Clarp's preview: B opens the whole page in
    // the browser.
    browser: bool,
    status-text: string,
    // The keyboard's card in the chat (J/K).
    selected: bool,
    // decision / question: what is asked, why, how urgent; while pending
    // its answers (an approval's are Yes and No) and the one the keyboard
    // chose (-1 for none); once answered, how, with what, delivered yet.
    question: string,
    context: string,
    meta: string,
    pending: bool,
    approval: bool,
    options: [ArtifactOption],
    chosen: int,
    resolved: string,
    resolved-ok: bool,
    answer: string,
    delivery: string,
    // A question that takes an answer of one's own: its text, and whether
    // the keyboard is writing it (its option is the last number).
    allow-custom: bool,
    draft: string,
    editing: bool,
    // plan / workflow_run: how far along (0-1, -1 for unknown, -2 for
    // under way without a count), "done/total", and the step under way.
    progress-value: float,
    progress-count: string,
    current: string,
    // The step shown is blocked, not under way.
    current-blocked: bool,
    // document / research: the body's first lines as plain text.
    preview: string,
    // research: how many sources it cites that can be opened.
    sources: string,
    // data: the header and the first row (iOS shows one), the row count,
    // or why there is no table.
    head: [string],
    first-row: [string],
    rows-count: string,
    data-note: string,
    // audio / video: idle, preparing, playing, paused or failed; what to
    // say; the length; for the position, seconds played before and the
    // bridge clock's second playback (re)started (-1 when not playing).
    media-state: string,
    media-text: string,
    media-length: string,
    media-played: int,
    media-started: int,
    media-seconds: int,
    // video: its poster once fetched (has-poster), else a placeholder.
    poster: image,
    has-poster: bool,
    // file: its kind and size ("PDF · 1.2 MB").
    file-info: string,
    // release: the version (or commit), and how it went (ready, failed,
    // active or other).
    revision: string,
    release-state: string,
    // code_change: where (repository and branch) and how much.
    repo: string,
    files: string,
    additions: string,
    deletions: string,
    // Keeps the why/delivery line: the card is or was pending in this
    // window, or has something to say there.
    keep-line: bool,
    // Its keys, shown as hints (the selected card's emphasised).
    hints: [CardHint],
    // render_spec: loading, form, newer, unreadable or failed ("" for
    // another kind); the form's rows; Send's label ("" for a form whose
    // buttons send it), whether it may be sent now and is being sent;
    // read-only once answered; the line above Send.
    spec-state: string,
    spec-rows: [FormRow],
    spec-send: string,
    spec-can-send: bool,
    spec-sending: bool,
    spec-read-only: bool,
    spec-footnote: string,
}

// What the cards share: the clock countdowns read, and their actions.
export global ArtifactBridge {
    // The keyboard's place in the chat (a card, or an image block) and,
    // in a gallery, its tile.
    in property <string> cursor;
    in property <int> tile;
    // Seconds since the window started, ticking once a second.
    in property <int> now;
    // "Remaining", "Target reached" or "Since target", and the clock.
    pure callback countdown-phase(int, int) -> string;
    pure callback countdown-clock(int, int) -> string;
    // A playing card's position, "m:ss", from its played and started.
    pure callback media-position(int, int, int) -> string;
    // A click (or Enter on the selected card) on the card's action.
    callback open(string);
    callback link-clicked(string);
    // A decision's or question's answer: choose one (keyboard 1-9), send
    // the chosen one (Enter, or an approval's button), or discard it.
    callback choose(string, int);
    callback send(string);
    callback discard(string);
    // The answer of one's own as typed, and whether a card's field has the
    // keyboard (letters then type, they are not shortcuts).
    callback draft-edited(string, string);
    in-out property <bool> editing;
    callback editing-changed(string, bool);
    // Where a card is (its left, top, width and height) and the chat's
    // visible band.
    callback card-shown(string, length, length, length, length, length, length);
    // The reader scrolled the chat themselves: J/K stop bringing a card
    // into view.
    callback reader-moved();
    // A click on a card's hint: what its key does.
    callback hint(string, string);
    // A click on an image in a message (its block, its tile): enlarge it.
    callback image-clicked(string, int);
    // A native form's controls: (card, answer key, value), Send and the
    // Retry of a form that could not be read.
    callback form-text(string, string, string);
    callback form-toggle(string, string, bool);
    callback form-choose(string, string, string);
    callback form-send(string);
    callback form-retry(string);
    // A form's button pressed: (card, action). One with a question asks it
    // first (the window's form-confirm dialog, OK or Cancel; Escape and a
    // click outside cancel): its words, OK's label and whether OK is
    // destructive, and the answer.
    callback form-press(string, string);
    in property <string> confirm-text;
    in property <string> confirm-ok;
    in property <bool> confirm-destructive;
    callback form-confirm-answer(bool);
    // A form card's rows by its id: one model for the card's life, read
    // through here so the rows' repeater depends on the id alone (a row
    // changed while the card's item is being replaced is still applied).
    pure callback form-rows(string) -> [FormRow];
}

// The type's tint (iOS ArtifactCard's palette, from the reading theme).
export global ArtifactLook {
    // A chart's colours in series order (a pie's in point order), as the
    // iOS app's: blue, green, orange, purple, red, teal, yellow, pink,
    // indigo, brown, mint, cyan.
    public pure function chart-color(index: int) -> color {
        if (index == 0) { return #0a84ff; }
        if (index == 1) { return #30d158; }
        if (index == 2) { return #ff9f0a; }
        if (index == 3) { return #bf5af2; }
        if (index == 4) { return #ff453a; }
        if (index == 5) { return #40c8e0; }
        if (index == 6) { return #ffd60a; }
        if (index == 7) { return #ff375f; }
        if (index == 8) { return #5e5ce6; }
        if (index == 9) { return #ac8e68; }
        if (index == 10) { return #66d4cf; }
        return #64d2ff;
    }
    public pure function tint(kind: string, failed: bool) -> color {
        if (failed) { return Palette.danger; }
        if (kind == "countdown" || kind == "plan" || kind == "release") { return Palette.success; }
        if (kind == "decision" || kind == "question" || kind == "html_form" || kind == "render_spec") { return Palette.warning; }
        if (kind == "workflow_run" || kind == "code_change") { return Palette.accent; }
        return Palette.link;
    }
    public pure function glyph(kind: string) -> string {
        if (kind == "countdown") { return "◷"; }
        if (kind == "plan") { return "☰"; }
        if (kind == "decision" || kind == "question") { return "?"; }
        if (kind == "html_form" || kind == "render_spec") { return "▤"; }
        if (kind == "code_change") { return "±"; }
        if (kind == "data") { return "▦"; }
        if (kind == "audio") { return "♪"; }
        if (kind == "video") { return "▶"; }
        if (kind == "release") { return "⬢"; }
        if (kind == "directory") { return "▭"; }
        if (kind == "file") { return "▣"; }
        if (kind == "workflow_run") { return "⟳"; }
        return "¶";
    }
}

// A key and what it does, in the shortcut bar's style (the key in accent
// bold, the label muted); brighter on the card the keyboard is on. A click
// does what the key does.
export component KeyHint inherits Rectangle {
    in property <string> key;
    in property <string> label;
    in property <bool> emphasised;
    in property <bool> chosen;
    // In a chat row: sized with the row's text (ChatText), not the chrome.
    in property <bool> chat;
    property <float> scale: root.chat ? ChatText.scale : 1;
    callback clicked();
    height: 20px * root.scale;
    min-width: key-text.preferred-width + 12px * root.scale;
    preferred-width: row.preferred-width;
    border-radius: 4px;
    background: area.has-hover ? Palette.hover : root.chosen ? Palette.accent.with-alpha(0.16) : transparent;
    accessible-role: button;
    accessible-id: "key-hint";
    accessible-label: root.key + " " + root.label;
    accessible-action-default => { root.clicked(); }
    row := HorizontalLayout {
        padding-left: 4px * root.scale;
        padding-right: 4px * root.scale;
        spacing: 5px * root.scale;
        key-text := Text {
            text: root.key;
            color: root.emphasised || root.chosen ? Palette.accent : Palette.accent.with-alpha(0.6);
            font-size: root.chat ? ChatText.note : 11 * Look.unit;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: root.emphasised || root.chosen ? Palette.text : Palette.muted;
            font-size: root.chat ? ChatText.note : 11 * Look.unit;
            font-weight: root.chosen ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            min-width: 0px;
        }
    }
    area := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A card's hints, left to right; a narrow card elides their labels. Keys
// show only where they work: on the selected card while the chat has the
// keyboard. Another card draws nothing in their place (its height stays),
// except a decision, whose answers stay as buttons without their keys.
component HintRow inherits Rectangle {
    in property <ArtifactItem> artifact;
    property <bool> live: root.artifact.selected && Focus.mode == "pane";
    property <bool> decision: root.artifact.kind == "decision" || root.artifact.kind == "question";
    property <[CardHint]> none;
    min-width: 0px;
    clip: true;
    height: 20px * ChatText.scale;
    HorizontalLayout {
        alignment: start;
        spacing: 8px;
        for hint in root.live || root.decision ? root.artifact.hints : root.none: KeyHint {
            chat: true;
            key: root.live ? hint.key : "";
            label: hint.label;
            chosen: hint.chosen;
            emphasised: root.artifact.selected;
            clicked => { ArtifactBridge.hint(root.artifact.id, hint.action); }
        }
    }
}

// A countdown's body (iOS CountdownArtifactView): the phase, the clock in
// large figures, the target's date and zone; it ticks on the bridge's
// clock, so its height never changes.
component CountdownBody inherits VerticalLayout {
    in property <ArtifactItem> artifact;
    spacing: 3px;
    if !root.artifact.countdown-set: Text {
        text: root.artifact.countdown-note;
        color: root.artifact.countdown-note == "Cancelled" ? Palette.muted : Palette.warning;
        font-size: ChatText.label;
    }
    if root.artifact.countdown-set: Text {
        text: ArtifactBridge.countdown-phase(root.artifact.countdown-at, ArtifactBridge.now);
        color: Palette.muted;
        font-size: ChatText.note;
    }
    if root.artifact.countdown-set: Text {
        height: 30px * ChatText.scale;
        text: ArtifactBridge.countdown-clock(root.artifact.countdown-at, ArtifactBridge.now);
        color: Palette.text;
        font-family: "JetBrains Mono";
        font-size: 24px * ChatText.scale;
        font-weight: 600;
        vertical-alignment: center;
        accessible-role: text;
    }
    if root.artifact.countdown-set: Text {
        text: root.artifact.countdown-line;
        color: Palette.muted;
        font-size: ChatText.detail;
        overflow: elide;
    }
}

// One of a question's answers (iOS's radio rows): a fixed height, so
// choosing never moves the chat.
component OptionRow inherits Rectangle {
    in property <int> number;
    in property <string> label;
    in property <string> detail;
    in property <bool> recommended;
    in property <bool> chosen;
    in property <bool> enabled;
    in property <bool> show-number;
    in property <bool> emphasised;
    callback clicked();
    height: root.detail != "" ? 38px : 26px;
    border-radius: 6px;
    background: root.chosen ? Palette.accent.with-alpha(0.14) : area.has-hover && root.enabled ? Palette.hover : transparent;
    accessible-role: radio-button;
    accessible-checked: root.chosen;
    accessible-label: root.label;
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 8px;
        Text {
            width: 14px * ChatText.scale;
            text: root.chosen ? (root.enabled ? "●" : "✓") : "○";
            color: root.chosen ? Palette.accent : Palette.faint;
            font-size: ChatText.detail;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                // Its key, only while it works.
                if root.show-number: Text { text: root.number; color: root.emphasised ? Palette.accent : Palette.accent.with-alpha(0.6); font-size: ChatText.note; font-weight: 700; vertical-alignment: center; }
                Text { text: root.label; color: root.enabled || root.chosen ? Palette.text : Palette.muted; font-size: ChatText.detail; font-weight: root.chosen ? 600 : 400; overflow: elide; }
                // i18n: decision card in the chat, small tag after the answer option the agent recommends (adjective)
                if root.recommended: Text { text: @tr("Recommended"); color: Palette.success; font-size: ChatText.caption; vertical-alignment: center; }
            }
            if root.detail != "": Text { text: root.detail; color: Palette.muted; font-size: ChatText.note; overflow: elide; }
        }
    }
}

// "Write my own answer": the last numbered answer, its field typing like
// the composer (Enter sends, Escape goes back to the chat).
component OwnAnswer inherits HorizontalLayout {
    in property <ArtifactItem> artifact;
    // A copy measured off screen never takes the keyboard.
    in property <bool> measuring;
    in property <int> number;
    property <bool> chosen: root.artifact.chosen == root.artifact.options.length;
    height: 30px * ChatText.scale;
    padding-left: 6px;
    spacing: 8px;
    Text {
        width: 14px * ChatText.scale;
        text: root.chosen ? (root.artifact.pending ? "●" : "✓") : "○";
        color: root.chosen ? Palette.accent : Palette.faint;
        font-size: ChatText.detail;
        vertical-alignment: center;
    }
    // Its key, only while it works.
    if root.artifact.pending && root.artifact.selected && Focus.mode == "pane": Text { text: root.number; color: Palette.accent; font-size: ChatText.note; font-weight: 700; vertical-alignment: center; }
    // Asked once, after the row is in the window (focus during its
    // creation is ignored); Escape gives the keyboard back for good.
    property <bool> asked;
    if root.artifact.pending: HorizontalLayout {
        horizontal-stretch: 1;
        Rectangle {
            horizontal-stretch: 1;
            height: 26px * ChatText.scale;
            border-radius: 4px;
            border-width: 1px;
            border-color: field.has-focus ? Palette.accent : Palette.border;
            background: Palette.sunken;
            if field.text == "": Text {
                x: 8px;
                height: parent.height;
                // i18n: decision card in the chat, placeholder of the last option's text field, where the user types an answer of their own instead of picking one
                text: @tr("Write my own answer");
                color: Palette.faint;
                font-size: ChatText.detail;
                vertical-alignment: center;
            }
            field := TextInput {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: root.artifact.draft;
                color: Palette.text;
                font-size: ChatText.detail;
                single-line: true;
                vertical-alignment: center;
                // i18n: decision card in the chat, accessibility label of the text field for an answer of the user's own
                accessible-label: @tr("Write my own answer");
                edited => {
                    ArtifactBridge.draft-edited(root.artifact.id, self.text);
                    if (!root.chosen) {
                        ArtifactBridge.choose(root.artifact.id, root.artifact.options.length);
                    }
                }
                // The keyboard leaves the field before sending: the answered
                // card has no field, and a focused one must not be destroyed.
                accepted => {
                    self.clear-focus();
                    ArtifactBridge.send(root.artifact.id);
                }
                changed has-focus => {
                    ArtifactBridge.editing = self.has-focus;
                    ArtifactBridge.editing-changed(root.artifact.id, self.has-focus);
                }
            }
        }
        Timer {
            interval: 30ms;
            running: root.artifact.editing && !root.asked && !root.measuring;
            triggered => {
                root.asked = true;
                field.focus();
            }
        }
    }
    if !root.artifact.pending: Text {
        text: root.chosen ? root.artifact.draft
            // i18n: answered decision card in the chat, the last option (not chosen): an answer of the user's own
            : @tr("Write my own answer");
        color: root.chosen ? Palette.text : Palette.faint;
        font-size: ChatText.detail;
        overflow: elide;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
}

// A decision's or question's body (iOS DecisionResponseView). Its height
// is the same pending and answered, so a decision answered above a reader
// who scrolled up does not move what they read: one line for why and how
// urgent (then whether it was delivered), one row for the buttons (then
// how it was answered), with the send's status beside them.
component DecisionBody inherits VerticalLayout {
    in property <ArtifactItem> artifact;
    in property <bool> measuring;
    property <bool> question: !root.artifact.approval;
    // Its digits work while it is selected and the chat has the keyboard.
    property <bool> live: root.artifact.selected && Focus.mode == "pane";
    spacing: 5px;
    if root.artifact.question != "": Text { text: root.artifact.question; color: Palette.text; font-size: ChatText.label; font-weight: 600; wrap: word-wrap; }
    if root.artifact.context != "": Text { text: root.artifact.context; color: Palette.muted; font-size: ChatText.detail; wrap: word-wrap; }
    // Settled with nothing to say, a decision has no line to keep.
    if root.artifact.keep-line: Text {
        height: 15px * ChatText.scale;
        text: root.artifact.pending ? root.artifact.meta : root.artifact.delivery;
        color: root.artifact.pending ? Palette.warning : Palette.muted;
        font-size: ChatText.note;
        overflow: elide;
    }
    // A question's options, pending and answered alike (the answer marked).
    if root.question: VerticalLayout {
        spacing: 2px;
        for option[index] in root.artifact.options: OptionRow {
            number: index + 1;
            label: option.label;
            detail: option.detail;
            recommended: option.recommended;
            chosen: root.artifact.chosen == index;
            enabled: root.artifact.pending;
            show-number: root.artifact.pending && root.live;
            emphasised: root.artifact.selected;
            clicked => { ArtifactBridge.choose(root.artifact.id, index); }
        }
        if root.artifact.allow-custom: OwnAnswer {
            artifact: root.artifact;
            number: root.artifact.options.length + 1;
            measuring: root.measuring;
        }
    }
    if root.artifact.question != "" || root.artifact.resolved != "": HorizontalLayout {
        height: 28px * ChatText.scale;
        alignment: start;
        spacing: 8px;
        // Its keys: an approval's answers, send and discard.
        if root.artifact.pending: HintRow { artifact: root.artifact; }
        if !root.artifact.pending && root.artifact.resolved != "": HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.artifact.resolved-ok ? "✓" : "–";
                color: root.artifact.resolved-ok ? Palette.success : Palette.muted;
                font-size: ChatText.label;
                vertical-alignment: center;
            }
            Text { text: root.artifact.resolved; color: root.artifact.resolved-ok ? Palette.success : Palette.muted; font-size: ChatText.detail; font-weight: 600; vertical-alignment: center; }
            if root.artifact.answer != "": Text { text: "· " + root.artifact.answer; color: Palette.text; font-size: ChatText.detail; overflow: elide; vertical-alignment: center; }
        }
        if root.artifact.status-text != "": Text {
            text: root.artifact.status-text;
            color: root.artifact.status-text.starts-with("Not ") || root.artifact.status-text.starts-with("Choose") ? Palette.danger : Palette.muted;
            font-size: ChatText.detail;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

// A video's poster (iOS plays it inline; the desktop opens it in the
// system's player): 180 px tall before and after the poster lands.
component VideoBody inherits VerticalLayout {
    in property <ArtifactItem> artifact;
    in property <color> tint;
    spacing: 4px;
    Rectangle {
        height: 180px;
        border-radius: 6px;
        clip: true;
        background: Palette.sunken;
        if root.artifact.has-poster: Image {
            width: parent.width;
            height: parent.height;
            source: root.artifact.poster;
            image-fit: contain;
        }
        if root.artifact.action != "": Rectangle {
            width: 44px * ChatText.scale;
            height: 44px * ChatText.scale;
            border-radius: self.width / 2;
            background: Palette.window.with-alpha(0.7);
            Text { width: parent.width; height: parent.height; text: "▶"; color: root.tint; font-size: 18px * ChatText.scale; horizontal-alignment: center; vertical-alignment: center; }
        }
        if root.artifact.media-length != "": Text {
            x: parent.width - self.width - 8px;
            y: parent.height - self.height - 6px;
            text: root.artifact.media-length;
            color: Palette.text;
            font-family: "JetBrains Mono";
            font-size: ChatText.note;
        }
    }
    if root.artifact.media-text != "": Text { text: root.artifact.media-text; color: Palette.warning; font-size: ChatText.note; }
}

// An audio card's player (iOS: play/pause, progress, m:ss / m:ss and a
// status line), one row and one line, whatever its state.
component MediaBody inherits VerticalLayout {
    in property <ArtifactItem> artifact;
    in property <color> tint;
    property <int> played: root.artifact.media-played + (root.artifact.media-started >= 0 ? Math.max(0, ArtifactBridge.now - root.artifact.media-started) : 0);
    property <string> position: ArtifactBridge.media-position(root.artifact.media-played, root.artifact.media-started, ArtifactBridge.now);
    spacing: 4px;
    // Played from the keyboard (its hints): the bar and the clock.
    if root.artifact.action != "": HorizontalLayout {
        spacing: 10px;
        height: 20px * ChatText.scale;
        Rectangle {
            y: (parent.height - self.height) / 2;
            height: 4px;
            horizontal-stretch: 1;
            border-radius: 2px;
            background: Palette.control;
            Rectangle {
                x: 0;
                height: parent.height;
                border-radius: 2px;
                background: root.tint;
                width: root.artifact.media-seconds <= 0 ? 0 : parent.width * Math.min(1, root.played / root.artifact.media-seconds);
            }
        }
        Text {
            text: root.position + (root.artifact.media-length != "" ? " / " + root.artifact.media-length : "");
            color: Palette.muted;
            font-family: "JetBrains Mono";
            font-size: ChatText.note;
            vertical-alignment: center;
        }
    }
    Text {
        height: 15px * ChatText.scale;
        text: root.artifact.media-text;
        color: root.artifact.media-state == "failed" || root.artifact.action == "" ? Palette.warning : Palette.muted;
        font-size: ChatText.note;
        overflow: elide;
    }
}

// A plan's or run's progress (iOS's ProgressView and caption) and the
// step under way, in two lines whatever its length.
component ProgressBody inherits VerticalLayout {
    in property <ArtifactItem> artifact;
    in property <color> tint;
    spacing: 4px;
    if root.artifact.progress-value >= 0 || root.artifact.progress-value < -1.5: HorizontalLayout {
        spacing: 8px;
        Rectangle {
            y: (parent.height - self.height) / 2;
            height: 6px;
            horizontal-stretch: 1;
            border-radius: 3px;
            background: Palette.control;
            Rectangle {
                x: 0;
                height: parent.height;
                // Under way without a count: a third, at rest.
                width: parent.width * (root.artifact.progress-value < 0 ? 0.33 : Math.min(1, root.artifact.progress-value));
                border-radius: 3px;
                background: root.tint;
            }
        }
        if root.artifact.progress-count != "": Text { text: root.artifact.progress-count; color: Palette.muted; font-family: "JetBrains Mono"; font-size: ChatText.note; vertical-alignment: center; }
    }
    // One line, there whenever the plan is known: a step finishing, the
    // next beginning or the plan completing never changes the height.
    if root.artifact.current != "" || root.artifact.progress-value >= 0: HorizontalLayout {
        spacing: 6px;
        if root.artifact.current != "" && root.artifact.progress-value >= 0: Text {
            text: root.artifact.current-blocked ? "■" : "▶";
            color: root.artifact.current-blocked ? Palette.danger : root.tint;
            font-size: ChatText.caption;
            vertical-alignment: center;
        }
        Text {
            text: root.artifact.current != "" ? root.artifact.current
                : root.artifact.progress-value >= 0.999
                // i18n: plan or workflow card in the chat, line under the progress bar when every step is finished
                ? @tr("All steps done")
                // i18n: plan or workflow card in the chat, line under the progress bar when no step is running right now
                : @tr("Nothing under way");
            color: root.artifact.current == "" ? Palette.muted : root.artifact.progress-value >= 0 ? Palette.text : Palette.warning;
            font-size: ChatText.detail;
            overflow: elide;
            height: 16px * ChatText.scale;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

// A clarp.form v2 chart (iOS RenderSpecChartView): its title, the plot
// about 200px high with the y axis's labels beside it and x's under it,
// and a legend for more than one series (a pie's names its points).
component FormChartView inherits Rectangle {
    in property <FormChart> chart;
    property <length> axis: 52px * ChatText.scale;
    property <length> plot-height: 200px;
    accessible-role: image;
    accessible-label: root.chart.summary;
    VerticalLayout {
        spacing: 6px;
        if root.chart.title != "": Text {
            text: root.chart.title;
            color: Palette.text;
            font-size: ChatText.label;
            font-weight: 600;
            wrap: word-wrap;
        }
        if root.chart.y-label != "" && root.chart.kind != "pie": Text { text: root.chart.y-label; color: Palette.muted; font-size: ChatText.note; }
        if root.chart.kind != "pie": HorizontalLayout {
            spacing: 4px;
            Rectangle {
                width: root.axis;
                height: root.plot-height;
                for tick in root.chart.y-ticks: Text {
                    x: 0px;
                    width: parent.width;
                    y: tick.at * parent.height - self.height / 2;
                    text: tick.text;
                    color: Palette.muted;
                    font-size: ChatText.caption;
                    horizontal-alignment: right;
                    overflow: elide;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                height: root.plot-height;
                for tick in root.chart.y-ticks: Rectangle {
                    x: 0px;
                    y: Math.min(tick.at * parent.height, parent.height - 1px);
                    width: parent.width;
                    height: 1px;
                    background: Palette.rule;
                }
                for mark in root.chart.marks: Path {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 1000;
                    viewbox-height: 200;
                    fit: fill;
                    commands: mark.commands;
                    fill: mark.fill ? ArtifactLook.chart-color(mark.color) : transparent;
                    stroke: mark.fill ? transparent : ArtifactLook.chart-color(mark.color);
                    stroke-width: mark.fill ? 0px : 2px;
                }
                for dot in root.chart.dots: Rectangle {
                    x: dot.x * parent.width - 3px;
                    y: dot.y * parent.height - 3px;
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: ArtifactLook.chart-color(dot.color);
                }
            }
        }
        if root.chart.kind != "pie": Rectangle {
            height: 16px * ChatText.scale;
            for tick in root.chart.x-ticks: Text {
                property <length> plot: parent.width - root.axis - 4px;
                x: Math.max(0px, Math.min(parent.width - self.width, root.axis + 4px + tick.at * self.plot - self.width / 2));
                y: 0px;
                text: tick.text;
                color: Palette.muted;
                font-size: ChatText.caption;
            }
        }
        if root.chart.x-label != "" && root.chart.kind != "pie": Text {
            text: root.chart.x-label;
            color: Palette.muted;
            font-size: ChatText.note;
            horizontal-alignment: center;
        }
        if root.chart.kind == "pie": HorizontalLayout {
            spacing: 16px;
            alignment: start;
            Rectangle {
                width: root.plot-height;
                height: root.plot-height;
                for mark in root.chart.marks: Path {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 200;
                    viewbox-height: 200;
                    fit: fill;
                    commands: mark.commands;
                    fill: ArtifactLook.chart-color(mark.color);
                    stroke: Palette.window;
                    stroke-width: 1px;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                for key in root.chart.keys: HorizontalLayout {
                    spacing: 6px;
                    Rectangle { width: 10px; height: 10px; y: (parent.height - self.height) / 2; border-radius: 2px; background: ArtifactLook.chart-color(key.color); }
                    Text { text: key.label; color: Palette.text; font-size: ChatText.note; overflow: elide; }
                }
            }
        }
        if root.chart.kind != "pie" && root.chart.keys.length > 0: HorizontalLayout {
            spacing: 14px;
            alignment: start;
            for key in root.chart.keys: HorizontalLayout {
                spacing: 6px;
                Rectangle { width: 10px; height: 10px; y: (parent.height - self.height) / 2; border-radius: 2px; background: ArtifactLook.chart-color(key.color); }
                Text { text: key.label; color: Palette.text; font-size: ChatText.note; overflow: elide; min-width: 0px; }
            }
        }
    }
}

// A clarp.form v2 table: a header and one line per row, each column as wide
// as its words (up to a limit) and sharing what is left over; a table wider
// than the card scrolls sideways inside it.
component FormTableView inherits VerticalLayout {
    in property <FormTable> table;
    property <length> char: 7px * ChatText.scale;
    property <length> line: 22px * ChatText.scale;
    property <length> gap: 12px;
    property <length> wide: root.table.chars * root.char + (root.table.columns.length - 1) * root.gap;
    spacing: 4px;
    if root.table.title != "": Text {
        text: root.table.title;
        color: Palette.text;
        font-size: ChatText.label;
        font-weight: 600;
        wrap: word-wrap;
    }
    flick := Flickable {
        height: (root.table.rows.length + 1) * root.line;
        content-width: Math.max(self.width, root.wide);
        content-height: self.height;
        accessible-role: AccessibleRole.table;
        accessible-label: root.table.title;
        VerticalLayout {
            width: flick.content-width;
            spacing: 0px;
            HorizontalLayout {
                height: root.line;
                spacing: root.gap;
                for column in root.table.columns: Text {
                    min-width: column.chars * root.char;
                    horizontal-stretch: column.chars;
                    text: column.label;
                    color: Palette.chrome-text;
                    font-size: ChatText.note;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-alignment: column.end ? right : left;
                }
            }
            for row[index] in root.table.rows: Rectangle {
                height: root.line;
                background: Math.mod(index, 2) == 0 ? Palette.rule.with-alpha(0.35) : transparent;
                accessible-role: list-item;
                accessible-label: row.words;
                HorizontalLayout {
                    spacing: root.gap;
                    for cell[column] in row.cells: Text {
                        min-width: root.table.columns[column].chars * root.char;
                        horizontal-stretch: root.table.columns[column].chars;
                        text: cell.text;
                        color: cell.flag == 1 ? Palette.success : cell.flag == 0 ? Palette.faint : Palette.text;
                        font-size: ChatText.note;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-alignment: root.table.columns[column].end ? right : left;
                    }
                }
            }
        }
    }
}

// A clarp.form v2 button: pressed only by a click (never by Enter). It
// waits for the required values; after one answer every button is off and
// the chosen one keeps its colour with a check.
component FormButtonView inherits Rectangle {
    in property <string> card;
    in property <FormLeaf> leaf;
    property <bool> live: root.leaf.enabled && !root.leaf.on && !root.leaf.busy;
    property <color> tone: root.leaf.style == "primary" ? Palette.accent : root.leaf.style == "destructive" ? Palette.danger : Palette.control;
    property <bool> lit: root.leaf.enabled || root.leaf.on;
    height: 28px * ChatText.scale;
    min-width: label.preferred-width + 28px;
    preferred-width: label.preferred-width + 28px;
    border-radius: 6px;
    background: !root.lit ? Palette.control.with-alpha(0.5)
        : root.leaf.style == "secondary" ? (area.has-hover && root.live ? Palette.control.brighter(0.15) : Palette.control)
        : (area.has-hover && root.live ? root.tone.brighter(0.15) : root.tone);
    border-width: root.leaf.on ? 2px : 0px;
    border-color: Palette.text;
    accessible-role: button;
    accessible-label: root.leaf.text;
    accessible-description: root.leaf.on
        // i18n: form card in the chat, accessibility description of the button the user pressed as their answer (past participle: this one was chosen)
        ? @tr("Chosen")
        : "";
    accessible-enabled: root.live;
    accessible-action-default => { if (root.live) { ArtifactBridge.form-press(root.card, root.leaf.key); } }
    label := Text {
        width: parent.width;
        height: parent.height;
        text: (root.leaf.on ? "✓ " : "") + (root.leaf.busy
            // i18n: form card in the chat, text of a pressed button while its answer is being sent to the agent (in progress)
            ? @tr("Sending…")
            : root.leaf.text);
        color: !root.lit ? Palette.faint : root.leaf.style == "secondary" ? Palette.text : Palette.window;
        font-size: ChatText.detail;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    area := TouchArea {
        enabled: root.live;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { ArtifactBridge.form-press(root.card, root.leaf.key); }
    }
}

// One element of a native form (iOS RenderSpecFormController's views), by
// its kind.
component FormLeafView inherits VerticalLayout {
    in property <string> card;
    in property <FormLeaf> leaf;
    in property <bool> read-only;
    in property <bool> measuring;
    // One of a row's cells (a horizontal stack's elements side by side).
    in property <bool> side-by-side;
    spacing: 4px;
    if root.leaf.kind == "heading": Text {
        text: root.leaf.text;
        color: Palette.text;
        font-size: root.leaf.level == 1 ? ChatText.body * 1.2 : root.leaf.level == 2 ? ChatText.lead : ChatText.label;
        font-weight: root.leaf.level < 3 ? 700 : 600;
        wrap: word-wrap;
        accessible-role: text;
    }
    if root.leaf.kind == "card": Text {
        text: root.leaf.text;
        color: Palette.text;
        font-size: ChatText.label;
        font-weight: 600;
        wrap: word-wrap;
    }
    if root.leaf.kind == "text": Text {
        text: root.leaf.text;
        color: Palette.text;
        font-size: ChatText.detail;
        wrap: word-wrap;
    }
    if root.leaf.kind == "divider": Rectangle { height: 1px; background: Palette.rule; }
    // A caption, with 'Required' after it while the answer is owed.
    if root.leaf.kind == "field" || root.leaf.kind == "choice": HorizontalLayout {
        alignment: start;
        spacing: 8px;
        Text { text: root.leaf.text; color: Palette.muted; font-size: ChatText.detail; wrap: word-wrap; }
        // i18n: form card in the chat, small note after a field's caption: the field must be filled in before sending (adjective)
        if root.leaf.required && !root.read-only: Text { text: @tr("Required"); color: Palette.faint; font-size: ChatText.note; vertical-alignment: center; }
    }
    if root.leaf.kind == "field" && root.read-only: Text {
        text: root.leaf.value != "" ? root.leaf.value : "—";
        color: root.leaf.value != "" ? Palette.text : Palette.faint;
        font-size: ChatText.detail;
        wrap: word-wrap;
    }
    if root.leaf.kind == "field" && !root.read-only: Rectangle {
        height: (root.leaf.multiline ? 72px : 26px) * ChatText.scale;
        border-radius: 4px;
        border-width: 1px;
        border-color: input.has-focus ? Palette.accent : Palette.border;
        background: Palette.sunken;
        accessible-role: text-input;
        accessible-label: root.leaf.text;
        if input.text == "": Text {
            x: 8px;
            y: root.leaf.multiline ? 5px : 0px;
            height: root.leaf.multiline ? self.preferred-height : parent.height;
            text: root.leaf.placeholder;
            color: Palette.faint;
            font-size: ChatText.detail;
            vertical-alignment: center;
        }
        input := TextInput {
            x: 8px;
            y: root.leaf.multiline ? 5px : 0px;
            width: parent.width - 16px;
            height: root.leaf.multiline ? parent.height - 10px : parent.height;
            text: root.leaf.value;
            color: Palette.text;
            font-size: ChatText.detail;
            single-line: !root.leaf.multiline;
            wrap: root.leaf.multiline ? word-wrap : no-wrap;
            vertical-alignment: root.leaf.multiline ? top : center;
            edited => { ArtifactBridge.form-text(root.card, root.leaf.key, self.text); }
            // Letters type here; they are not the chat's shortcuts.
            changed has-focus => {
                if (!root.measuring) {
                    ArtifactBridge.editing = self.has-focus;
                }
            }
        }
    }
    if root.leaf.kind == "field" && root.leaf.note != "" && !root.read-only: Text {
        text: root.leaf.note;
        color: Palette.warning;
        font-size: ChatText.note;
    }
    if root.leaf.kind == "toggle": HorizontalLayout {
        spacing: 12px;
        Text { text: root.leaf.text; color: Palette.text; font-size: ChatText.detail; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
        Rectangle {
            width: 34px * ChatText.scale;
            height: 18px * ChatText.scale;
            border-radius: self.height / 2;
            background: root.leaf.on ? (root.read-only ? Palette.accent.with-alpha(0.5) : Palette.accent) : Palette.control;
            accessible-role: checkbox;
            accessible-checked: root.leaf.on;
            accessible-label: root.leaf.text;
            accessible-action-default => { if (!root.read-only) { ArtifactBridge.form-toggle(root.card, root.leaf.key, !root.leaf.on); } }
            Rectangle {
                x: root.leaf.on ? parent.width - self.width - 2px : 2px;
                y: 2px;
                width: parent.height - 4px;
                height: parent.height - 4px;
                border-radius: self.height / 2;
                background: Palette.text;
            }
            TouchArea {
                enabled: !root.read-only;
                mouse-cursor: self.enabled ? pointer : default;
                clicked => { ArtifactBridge.form-toggle(root.card, root.leaf.key, !root.leaf.on); }
            }
        }
    }
    if root.leaf.kind == "choice": Rectangle {
        border-radius: 6px;
        background: Palette.sunken;
        VerticalLayout {
            padding: 2px;
            spacing: 0px;
            for option[index] in root.leaf.options: OptionRow {
                number: index + 1;
                label: option.label;
                chosen: root.leaf.chosen == index;
                enabled: !root.read-only;
                clicked => { ArtifactBridge.form-choose(root.card, root.leaf.key, option.id); }
            }
        }
    }
    if root.leaf.kind == "chart": FormChartView { chart: root.leaf.chart; }
    if root.leaf.kind == "table": FormTableView { table: root.leaf.table; }
    // On its own a button is as wide as its label; side by side (cells)
    // the buttons share the row.
    if root.leaf.kind == "button" && !root.side-by-side: HorizontalLayout {
        alignment: start;
        FormButtonView { card: root.card; leaf: root.leaf; }
    }
    if root.leaf.kind == "button" && root.side-by-side: FormButtonView { card: root.card; leaf: root.leaf; }
}

// i18n-screen: form confirmation
// A button's question before its answer is sent (OK or Cancel). Escape and
// a click outside cancel; Enter does nothing, as a button is pressed only by
// a click.
export component FormConfirmDialog inherits Modal {
    card-width: 420px;
    card-height: 150px;
    dismissed => { ArtifactBridge.form-confirm-answer(false); }
    VerticalLayout {
        padding: 18px;
        spacing: 10px;
        Text { text: ArtifactBridge.confirm-text; color: Palette.text; font-size: 14px; wrap: word-wrap; vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Rectangle {
                height: 28px;
                width: cancel-label.preferred-width + 28px;
                border-radius: 6px;
                background: cancel-area.has-hover ? Palette.control.brighter(0.15) : Palette.sunken;
                accessible-role: button;
                // i18n: form confirmation dialog, accessibility label of the button that closes the question without sending the answer (verb)
                accessible-label: @tr("Cancel");
                accessible-action-default => { ArtifactBridge.form-confirm-answer(false); }
                // i18n: form confirmation dialog, button that closes the question without sending the answer (verb)
                cancel-label := Text { text: @tr("Cancel"); color: Palette.text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                cancel-area := TouchArea { mouse-cursor: pointer; clicked => { ArtifactBridge.form-confirm-answer(false); } }
            }
            Rectangle {
                height: 28px;
                width: ok-label.preferred-width + 28px;
                border-radius: 6px;
                property <color> tone: ArtifactBridge.confirm-destructive ? Palette.danger : Palette.accent;
                background: ok-area.has-hover ? self.tone.brighter(0.15) : self.tone;
                accessible-role: button;
                accessible-label: ArtifactBridge.confirm-ok;
                accessible-action-default => { ArtifactBridge.form-confirm-answer(true); }
                ok-label := Text { text: ArtifactBridge.confirm-ok; color: Palette.window; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                ok-area := TouchArea { mouse-cursor: pointer; clicked => { ArtifactBridge.form-confirm-answer(true); } }
            }
        }
    }
}

// i18n-screen: artifacts
// A native form in its card (iOS RenderSpecFormController): its rows, then
// the line saying what holds Send back (or how the answer went) and Send.
component FormBody inherits VerticalLayout {
    in property <ArtifactItem> artifact;
    in property <bool> measuring;
    // The card's id, assigned once (no binding): the rows' repeater must
    // depend on nothing that changes with the card's item, or a row changed
    // while the item is replaced is dropped (Slint ignores a row change
    // while the repeater's model binding is dirty and the model is the same).
    property <string> card;
    init => { self.card = root.artifact.id; }
    spacing: 6px;
    // i18n: form card in the chat, shown while the form's content loads
    if root.artifact.spec-state == "loading": Text { text: @tr("Loading the form…"); color: Palette.muted; font-size: ChatText.detail; }
    // i18n: form card in the chat, shown when the form uses features this app version does not know; "Clarp" stays as is
    if root.artifact.spec-state == "newer": Text { text: @tr("This form needs a newer version of Clarp."); color: Palette.warning; font-size: ChatText.detail; wrap: word-wrap; }
    // i18n: form card in the chat, shown when the form's content is broken; tells the user to ask the agent to publish the form again
    if root.artifact.spec-state == "unreadable": Text { text: @tr("This form can't be shown. Ask the agent to publish it again."); color: Palette.warning; font-size: ChatText.detail; wrap: word-wrap; }
    if root.artifact.spec-state == "failed": HorizontalLayout {
        alignment: start;
        spacing: 10px;
        // i18n: form card in the chat, shown when loading the form failed (a Try again button follows)
        Text { text: @tr("The form could not be loaded."); color: Palette.warning; font-size: ChatText.detail; vertical-alignment: center; }
        // i18n: form card in the chat, button after "The form could not be loaded.": loads the form again (verb)
        KeyHint { chat: true; label: @tr("Try again"); emphasised: true; clicked => { ArtifactBridge.form-retry(root.artifact.id); } }
    }
    if root.artifact.spec-state == "form": VerticalLayout {
        spacing: 0px;
        for row in ArtifactBridge.form-rows(root.card): Rectangle {
            background: row.in-card ? Palette.raised : transparent;
            border-top-left-radius: row.card-top ? 8px : 0px;
            border-top-right-radius: row.card-top ? 8px : 0px;
            border-bottom-left-radius: row.card-bottom ? 8px : 0px;
            border-bottom-right-radius: row.card-bottom ? 8px : 0px;
            HorizontalLayout {
                padding-left: row.in-card ? 12px : 0px;
                padding-right: row.in-card ? 12px : 0px;
                padding-top: row.card-top ? 10px : 5px;
                padding-bottom: row.card-bottom ? 10px : 5px;
                spacing: 12px;
                if row.cells.length == 0: FormLeafView {
                    card: root.artifact.id;
                    leaf: row.leaf;
                    read-only: root.artifact.spec-read-only;
                    measuring: root.measuring;
                }
                for cell in row.cells: FormLeafView {
                    horizontal-stretch: 1;
                    side-by-side: true;
                    card: root.artifact.id;
                    leaf: cell;
                    read-only: root.artifact.spec-read-only;
                    measuring: root.measuring;
                }
            }
        }
    }
    if root.artifact.spec-state == "form": HorizontalLayout {
        spacing: 10px;
        Text {
            horizontal-stretch: 1;
            text: root.artifact.spec-footnote;
            color: root.artifact.spec-read-only ? Palette.success : Palette.muted;
            font-size: ChatText.note;
            wrap: word-wrap;
            vertical-alignment: center;
        }
        // A form with buttons has no footer submit: each button sends it.
        if !root.artifact.spec-read-only && root.artifact.spec-send != "": Rectangle {
            height: 28px * ChatText.scale;
            width: send-label.preferred-width + 28px;
            border-radius: 6px;
            background: root.artifact.spec-can-send && !root.artifact.spec-sending
                ? (send-area.has-hover ? Palette.accent.brighter(0.15) : Palette.accent) : Palette.control;
            accessible-role: button;
            accessible-label: root.artifact.spec-send;
            accessible-action-default => { ArtifactBridge.form-send(root.artifact.id); }
            send-label := Text {
                text: root.artifact.spec-sending
                    // i18n: form card in the chat, text of the form's send button while the answers are being sent to the agent (in progress)
                    ? @tr("Sending…")
                    : root.artifact.spec-send;
                color: root.artifact.spec-can-send && !root.artifact.spec-sending ? Palette.window : Palette.faint;
                font-size: ChatText.detail;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            send-area := TouchArea {
                enabled: root.artifact.spec-can-send && !root.artifact.spec-sending;
                mouse-cursor: self.enabled ? pointer : default;
                clicked => { ArtifactBridge.form-send(root.artifact.id); }
            }
        }
    }
}

export component ArtifactCard inherits Rectangle {
    in property <ArtifactItem> artifact;
    // A copy measured off screen (the transcript's): it reports nothing and
    // takes no keyboard.
    in property <bool> measuring;
    // The chat's visible band, in window coordinates: the keyboard only
    // reaches cards in it. The card reports where it is a few times a
    // second (read fresh: its absolute position is not tracked through the
    // list); nothing in its size or layout reads these.
    in property <length> view-top;
    in property <length> view-bottom;
    Timer {
        interval: 150ms;
        running: !root.measuring;
        triggered => { ArtifactBridge.card-shown(root.artifact.id, root.absolute-position.x, root.absolute-position.y, root.width, root.height, root.view-top, root.view-bottom); }
    }
    property <color> tint: ArtifactLook.tint(root.artifact.kind, root.artifact.failed);
    background: touch.has-hover && root.artifact.action != "" ? root.tint.with-alpha(0.1) : root.tint.with-alpha(0.065);
    border-width: root.artifact.selected ? 2px : 1px;
    border-color: root.artifact.selected ? Palette.accent : root.tint.with-alpha(0.3);
    border-radius: 8px;
    accessible-role: groupbox;
    accessible-label: root.artifact.label + " " + root.artifact.title;
    accessible-description: root.artifact.action;
    touch := TouchArea {
        enabled: root.artifact.action != "";
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { ArtifactBridge.open(root.artifact.id); }
    }
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 24px * ChatText.scale;
                height: 24px * ChatText.scale;
                border-radius: 6px;
                background: root.tint.with-alpha(0.14);
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: ArtifactLook.glyph(root.artifact.kind);
                    color: root.tint;
                    font-size: ChatText.lead;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                Text { text: root.artifact.label; color: Palette.faint; font-size: ChatText.tiny; font-weight: 600; letter-spacing: 0.8px * ChatText.scale; }
                Text { text: root.artifact.title; color: Palette.text; font-size: ChatText.lead; font-weight: 600; wrap: word-wrap; }
            }
            if root.artifact.badge != "": Rectangle {
                y: 2px;
                height: 18px * ChatText.scale;
                width: badge-text.preferred-width + 12px;
                border-radius: self.height / 2;
                background: (root.artifact.badge == "Failed" ? Palette.danger : Palette.muted).with-alpha(0.16);
                badge-text := Text {
                    text: root.artifact.badge;
                    color: root.artifact.badge == "Failed" ? Palette.danger : Palette.muted;
                    font-size: ChatText.note;
                }
            }
        }
        if root.artifact.kind == "countdown": CountdownBody { artifact: root.artifact; }
        if root.artifact.kind == "decision" || root.artifact.kind == "question": DecisionBody { artifact: root.artifact; measuring: root.measuring; }
        if root.artifact.spec-state != "": FormBody { artifact: root.artifact; measuring: root.measuring; }
        // The body's first lines (iOS shows four), always four lines tall.
        // The body's first lines (iOS: four for a document, five for
        // research), as tall as they are up to that.
        if root.artifact.preview != "": Text {
            text: root.artifact.preview;
            color: Palette.muted;
            font-size: ChatText.detail;
            wrap: word-wrap;
            overflow: elide;
            max-height: (root.artifact.kind == "research" ? 5 : 4) * 16px;
            vertical-alignment: top;
        }
        // A table's header and first row, equal columns, one line each.
        if root.artifact.head.length > 0: VerticalLayout {
            spacing: 1px;
            HorizontalLayout {
                spacing: 6px;
                for cell in root.artifact.head: Text { text: cell; color: Palette.chrome-text; font-size: ChatText.note; font-weight: 600; overflow: elide; horizontal-stretch: 1; min-width: 0; preferred-width: 0; }
            }
            if root.artifact.first-row.length > 0: HorizontalLayout {
                spacing: 6px;
                for cell in root.artifact.first-row: Text { text: cell; color: Palette.text; font-family: "JetBrains Mono"; font-size: ChatText.note; overflow: elide; horizontal-stretch: 1; min-width: 0; preferred-width: 0; }
            }
            Text { text: root.artifact.rows-count; color: Palette.faint; font-size: ChatText.note; }
        }
        if root.artifact.data-note != "": Text { text: root.artifact.data-note; color: Palette.warning; font-size: ChatText.detail; }
        // A change's where and how much, one line each (iOS's monospaced row).
        if root.artifact.kind == "code_change" || root.artifact.kind == "directory" || root.artifact.kind == "workflow_run": Text { text: root.artifact.repo; color: Palette.text; font-family: "JetBrains Mono"; font-size: ChatText.detail; overflow: elide; }
        if root.artifact.files != "" || root.artifact.additions != "" || root.artifact.deletions != "": HorizontalLayout {
            alignment: start;
            spacing: 10px;
            if root.artifact.files != "": Text { text: root.artifact.files; color: Palette.muted; font-family: "JetBrains Mono"; font-size: ChatText.detail; }
            if root.artifact.additions != "": Text { text: root.artifact.additions; color: Palette.success; font-family: "JetBrains Mono"; font-size: ChatText.detail; }
            if root.artifact.deletions != "": Text { text: root.artifact.deletions; color: Palette.danger; font-family: "JetBrains Mono"; font-size: ChatText.detail; }
        }
        // iOS's release row: the revision large, its state marked.
        if root.artifact.kind == "release": HorizontalLayout {
            spacing: 8px;
            Text { text: root.artifact.revision; color: Palette.text; font-family: "JetBrains Mono"; font-size: ChatText.body; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
            Text {
                text: root.artifact.release-state == "ready"
                    // i18n: release card in the chat, state after the revision: the release is out (past participle)
                    ? "✓ " + @tr("Released")
                    : root.artifact.release-state == "failed"
                    // i18n: release card in the chat, state after the revision: the release failed (past tense)
                    ? "✕ " + @tr("Failed")
                    : root.artifact.release-state == "active"
                    // i18n: release card in the chat, state after the revision: the release is being installed now (in progress)
                    ? "● " + @tr("Rolling out")
                    // i18n: release card in the chat, state after the revision before it has started: names the card as a release (noun, not the verb)
                    : "○ " + @tr("noun" => "Release");
                color: root.artifact.release-state == "ready" ? Palette.success : root.artifact.release-state == "failed" ? Palette.danger : root.artifact.release-state == "active" ? Palette.warning : Palette.muted;
                font-size: ChatText.detail;
                vertical-alignment: center;
            }
        }
        if root.artifact.file-info != "": Text {
            text: root.artifact.file-info;
            color: root.artifact.action == "" ? Palette.warning : Palette.muted;
            font-family: "JetBrains Mono";
            font-size: ChatText.note;
            overflow: elide;
        }
        if root.artifact.sources != "": Text { text: root.artifact.sources; color: Palette.faint; font-size: ChatText.note; }
        if root.artifact.kind == "audio": MediaBody { artifact: root.artifact; tint: root.tint; }
        if root.artifact.kind == "video": VideoBody { artifact: root.artifact; tint: root.tint; }
        if root.artifact.kind == "plan" || root.artifact.kind == "workflow_run": ProgressBody { artifact: root.artifact; tint: root.tint; }
        // Two lines, whatever the summary's length: a summary that grows
        // does not change the card's height.
        // A body's preview stands in for the summary (iOS shows one).
        if root.artifact.summary != "" && root.artifact.preview == "": Text {
            text: root.artifact.summary;
            color: Palette.text;
            font-size: ChatText.detail;
            wrap: word-wrap;
            overflow: elide;
            height: 32px * ChatText.scale;
            vertical-alignment: top;
        }
        if root.artifact.note != "": StyledText {
            text: root.artifact.note-styled;
            default-color: Palette.text;
            default-font-size: ChatText.label;
            default-font-family: Palette.body-family;
            link-color: Palette.link;
            link-clicked(url) => { ArtifactBridge.link-clicked(url); }
        }
        // The bar's count says it already.
        if root.artifact.progress != "" && root.artifact.progress-count == "": Text { text: root.artifact.progress; color: Palette.text; font-size: ChatText.detail; }
        // i18n: card in the chat for an interactive HTML form, shown when this app cannot show the form
        if root.artifact.form: Text { text: @tr("Interactive form unavailable"); color: Palette.warning; font-size: ChatText.detail; wrap: word-wrap; }
        // Its keys as hints (a decision shows them, and its send's status,
        // in its own row), and how its action went.
        if root.artifact.kind != "decision" && root.artifact.kind != "question" && (root.artifact.hints.length > 0 || root.artifact.status-text != ""): HorizontalLayout {
            spacing: 10px;
            if root.artifact.hints.length > 0: HintRow { artifact: root.artifact; }
            if root.artifact.status-text != "": Text {
                text: root.artifact.status-text;
                color: root.artifact.status-text.starts-with("Not ") ? Palette.danger : root.artifact.status-text == "Answers accepted" ? Palette.success : Palette.muted;
                font-size: ChatText.detail;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
    }
}
