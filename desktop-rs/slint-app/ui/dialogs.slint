import { Button } from "std-widgets.slint";
import { Field, Editor } from "fields.slint";
import { Palette, Focus, FocusRing, Look } from "theme.slint";

// A dialog over the window: a dimmed backdrop that closes it when clicked,
// and a card in the middle. Escape closes it through the keyboard map.
export component Modal inherits Rectangle {
    in property <length> card-width: 560px;
    in property <length> card-height: 420px;
    callback dismissed();
    background: #00000080;
    TouchArea { clicked => { root.dismissed(); } }
    card := Rectangle {
        width: Math.min(root.card-width, root.width - 40px);
        height: Math.min(root.card-height, root.height - 40px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: 3px;
        background: Palette.control;
        border-width: 1px;
        border-color: Palette.faint;
        // Clicks on the card stay on it.
        TouchArea { }
        @children
        FocusRing { shown: Focus.mode == "modal" || Focus.mode == "launch" || Focus.mode == "keymap"; }
    }
}

// One action in the key bindings editor: its keys in the chosen context.
export struct KeymapRow {
    action: string,
    label: string,
    keys: string,
    // The user changed it in this context.
    custom: bool,
    current: bool,
}

// The key bindings: every action's keys in one context at a time, from
// the keyboard (the window hands the editor its keys; the shortcut bar
// says which work now), or the whole profile as JSON.
export component KeymapEditor inherits Modal {
    in property <[KeymapRow]> rows;
    in property <string> context;
    in property <string> count;
    in property <string> filter;
    in property <string> status;
    in property <string> error;
    in-out property <string> profile;
    out property <bool> json-focused: json.has-focus;
    callback clicked(string);
    callback import-profile(string);
    callback export-profile();
    callback reset();
    callback done();
    public function open() { list.focus(); }
    public function focus-list() { list.focus(); }
    public function focus-json() { json.focus(); }
    card-width: 760px;
    card-height: 640px;
    dismissed => { root.done(); }
    // Holds the keyboard while no field has it (the window reads the keys).
    list := FocusScope { width: 0; height: 0; }
    VerticalLayout {
        padding: 22px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            Text { text: "Key bindings"; color: Palette.text; font-size: 20 * Look.unit; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: "‹ " + root.context + " ›"; color: Palette.accent; font-size: 14 * Look.unit; font-weight: 700; vertical-alignment: center; accessible-label: "Context " + root.context; }
        }
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "A binding here reaches the contexts inside this one. Typing keys bound further out never reach a text field.";
                color: Palette.muted;
                font-size: 11 * Look.unit;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
            Text { text: root.filter != "" ? root.filter + "  " + root.count : root.count; color: Palette.muted; font-size: 11 * Look.unit; vertical-alignment: center; }
        }
        Rectangle {
            vertical-stretch: 1;
            min-height: 200px;
            border-width: 1px;
            border-color: Palette.faint;
            border-radius: 3px;
            clip: true;
            VerticalLayout {
                padding: 4px;
                alignment: start;
                for row in root.rows: Rectangle {
                    height: 30px;
                    border-radius: 3px;
                    background: row.current ? Palette.accent.with-alpha(0.16) : area.has-hover ? Palette.hover : transparent;
                    accessible-role: list-item;
                    accessible-label: row.label + ": " + row.keys;
                    area := TouchArea { clicked => { root.clicked(row.action); } }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 12px;
                        Text {
                            text: row.label;
                            color: row.current ? Palette.text : Palette.muted;
                            font-weight: row.current ? 600 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: row.keys;
                            color: row.custom ? Palette.accent : Palette.text;
                            font-family: "JetBrains Mono";
                            font-size: 12 * Look.unit;
                            font-weight: row.custom ? 700 : 400;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
        if root.status != "": Text { text: root.status; color: Palette.text; wrap: word-wrap; }
        if root.error != "": Text { text: root.error; color: Palette.danger; wrap: word-wrap; }
        Text { text: "Profile JSON"; color: Palette.muted; font-size: 11 * Look.unit; }
        json := Editor {
            height: 110px;
            text <=> root.profile;
            font-family: "JetBrains Mono";
            accessible-label: "Keymap JSON";
        }
        HorizontalLayout {
            spacing: 8px;
            Button { text: "Import"; clicked => { root.import-profile(root.profile); } }
            Button { text: "Export"; clicked => { root.export-profile(); } }
            Button { text: "Reset defaults"; clicked => { root.reset(); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Done"; primary: true; clicked => { root.done(); } }
        }
    }
}

// ConnectionPage.qml: the Host's address and a token, or a one-time pairing
// code; the device token then stays in the keyring.
export component ConnectionPage inherits Modal {
    in property <string> base-url;
    in property <string> state;
    in property <string> error;
    in property <bool> connecting;
    in property <bool> can-cancel;
    in property <bool> stored;
    callback connect(string, string);
    callback pair(string, string);
    callback forget();
    callback cancel();
    public function open() {
        server.text = root.base-url;
        token.text = "";
        code.text = "";
        server.focus();
    }
    card-width: 520px;
    card-height: 470px;
    dismissed => { if (root.can-cancel) { root.cancel(); } }
    VerticalLayout {
        padding: 28px;
        spacing: 14px;
        Text { text: "Connect to Clarp"; color: Palette.text; font-size: 17 * Look.unit; font-weight: 600; }
        Text {
            text: "The native client connects directly to the Clarp server. Credentials remain outside the UI after this session.";
            color: Palette.muted;
            font-size: 12 * Look.unit;
            wrap: word-wrap;
        }
        server := Field { placeholder-text: "http://127.0.0.1:7682"; accessible-label: "Server"; }
        token := Field {
            placeholder-text: "Device or administrator token";
            input-type: password;
            accessible-label: "Token";
            accepted => { root.connect(server.text, token.text); }
        }
        Rectangle { height: 1px; background: Palette.border; }
        Text { text: "Or pair with a one-time code from clarp-admin pair create"; color: Palette.muted; font-size: 11 * Look.unit; }
        HorizontalLayout {
            spacing: 8px;
            code := Field {
                placeholder-text: "clp_…";
                input-type: password;
                accessible-label: "Pairing code";
                accepted => { root.pair(server.text, code.text); }
            }
            Button {
                text: "Pair";
                enabled: code.text != "" && !root.connecting;
                clicked => { root.pair(server.text, code.text); }
            }
        }
        if root.error != "": Text { text: root.error; color: Palette.danger; font-size: 11 * Look.unit; wrap: word-wrap; }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: pill.preferred-width + 16px;
                height: 24px;
                y: 4px;
                border-radius: 12px;
                background: root.state == "live" ? Palette.success.with-alpha(0.2) : Palette.warning.with-alpha(0.2);
                pill := Text { text: root.state; color: root.state == "live" ? Palette.success : Palette.warning; font-size: 11 * Look.unit; }
            }
            Rectangle { horizontal-stretch: 1; }
            if root.can-cancel: Button { text: "Cancel"; clicked => { root.cancel(); } }
            if root.stored: Button {
                text: "Forget device token";
                enabled: !root.connecting;
                clicked => { token.text = ""; code.text = ""; root.forget(); }
            }
            Button {
                text: root.connecting ? "Connecting…" : "Connect";
                primary: true;
                enabled: !root.connecting;
                clicked => { root.connect(server.text, token.text); }
            }
        }
    }
}
