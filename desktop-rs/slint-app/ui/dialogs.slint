import { Button, TextEdit } from "std-widgets.slint";
import { Field, Editor } from "fields.slint";
import { Palette, Focus, FocusRing, Look, ChromeText } from "theme.slint";

// A dialog over the window: a dimmed backdrop that closes it when clicked,
// and a card in the middle. Escape closes it through the keyboard map.
export component Modal inherits Rectangle {
    in property <length> card-width: 560px;
    in property <length> card-height: 420px;
    callback dismissed();
    background: #00000080;
    TouchArea { clicked => { root.dismissed(); } }
    card := Rectangle {
        width: Math.min(root.card-width, root.width - 40px);
        height: Math.min(root.card-height, root.height - 40px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: 3px;
        background: Palette.control;
        border-width: 1px;
        border-color: Palette.faint;
        // Clicks on the card stay on it.
        TouchArea { }
        @children
        FocusRing { shown: Focus.mode == "modal" || Focus.mode == "launch" || Focus.mode == "keymap"; }
    }
}

// One action in the key bindings editor: its keys in the chosen context.
export struct KeymapRow {
    action: string,
    label: string,
    keys: string,
    // The user changed it in this context.
    custom: bool,
    current: bool,
}

// The key bindings: every action's keys in one context at a time, from
// the keyboard (the window hands the editor its keys; the shortcut bar
// says which work now), or the whole profile as JSON.
// i18n-screen: keys
export component KeymapEditor inherits Modal {
    in property <[KeymapRow]> rows;
    in property <string> context;
    in property <string> count;
    in property <string> filter;
    in property <string> status;
    in property <string> error;
    in-out property <string> profile;
    out property <bool> json-focused: json.has-focus;
    callback clicked(string);
    callback import-profile(string);
    callback export-profile();
    callback reset();
    callback done();
    public function open() { list.focus(); }
    public function focus-list() { list.focus(); }
    public function focus-json() { json.focus(); }
    card-width: 760px;
    card-height: 640px;
    dismissed => { root.done(); }
    // Holds the keyboard while no field has it (the window reads the keys).
    list := FocusScope { width: 0; height: 0; }
    VerticalLayout {
        padding: 22px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            // i18n: Key bindings editor, title (noun, plural: which keys do what)
            Text { text: @tr("Key bindings"); color: Palette.text; font-size: 20 * Look.unit; }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: "‹ " + root.context + " ›";
                color: Palette.accent;
                font-size: 14 * Look.unit;
                font-weight: 700;
                vertical-alignment: center;
                // i18n: Key bindings editor, accessibility label of the switcher at the top right; {} is the place the shown keys work in (chat, list, settings …)
                accessible-label: @tr("Context {}", root.context);
            }
        }
        if root.filter != "" || root.count != "": HorizontalLayout {
            spacing: 12px;
            Rectangle { horizontal-stretch: 1; }
            Text { text: root.filter != "" ? root.filter + "  " + root.count : root.count; color: Palette.muted; font-size: 11 * Look.unit; vertical-alignment: center; }
        }
        Rectangle {
            vertical-stretch: 1;
            min-height: 200px;
            border-width: 1px;
            border-color: Palette.faint;
            border-radius: 3px;
            clip: true;
            VerticalLayout {
                padding: 4px;
                alignment: start;
                for row in root.rows: Rectangle {
                    height: 30px;
                    border-radius: 3px;
                    background: row.current ? Palette.accent.with-alpha(0.16) : area.has-hover ? Palette.hover : transparent;
                    accessible-role: list-item;
                    // i18n: Key bindings editor, accessibility label of a row; {0} is the action, {1} its keys (only the colon is text)
                    accessible-label: @tr("{0}: {1}", row.label, row.keys);
                    area := TouchArea { clicked => { root.clicked(row.action); } }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 12px;
                        Text {
                            font-size: ChromeText.body;
                            text: row.label;
                            color: row.current ? Palette.text : Palette.muted;
                            font-weight: row.current ? 600 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: row.keys;
                            color: row.custom ? Palette.accent : Palette.text;
                            font-family: "JetBrains Mono";
                            font-size: 12 * Look.unit;
                            font-weight: row.custom ? 700 : 400;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
        if root.status != "": Text { font-size: ChromeText.body; text: root.status; color: Palette.text; wrap: word-wrap; }
        if root.error != "": Text { font-size: ChromeText.body; text: root.error; color: Palette.danger; wrap: word-wrap; }
        // i18n: Key bindings editor, label over the text box holding the key profile as JSON (JSON left as is)
        Text { text: @tr("Profile JSON"); color: Palette.muted; font-size: 11 * Look.unit; }
        json := Editor {
            height: 110px;
            text <=> root.profile;
            font-family: "JetBrains Mono";
            // i18n: Key bindings editor, accessibility label of the text box holding the key profile as JSON (JSON left as is)
            accessible-label: @tr("Keymap JSON");
        }
        HorizontalLayout {
            spacing: 8px;
            // i18n: Key bindings editor, button (verb): use the JSON in the box as the key profile
            Button { text: @tr("Import"); clicked => { root.import-profile(root.profile); } }
            // i18n: Key bindings editor, button (verb): put the current key profile into the box as JSON
            Button { text: @tr("Export"); clicked => { root.export-profile(); } }
            // i18n: Key bindings editor, button (verb phrase): put every key back to its default
            Button { text: @tr("Reset defaults"); clicked => { root.reset(); } }
            Rectangle { horizontal-stretch: 1; }
            // i18n: Key bindings editor, main button (finish and close; OS-standard "Done")
            Button { text: @tr("Done"); primary: true; clicked => { root.done(); } }
        }
    }
}

// A Host this desktop has connected to: what its row shows and where it is.
export struct SavedHostRow {
    url: string,
    name: string,
    current: bool,
}

// ConnectionPage.qml: the Host's address and a token, or a one-time pairing
// code; the device token then stays in the keyring. The Hosts connected to
// before are listed above, each one click from being the Host again.
// i18n-screen: connection
export component ConnectionPage inherits Modal {
    in property <string> base-url;
    in property <string> state;
    in property <string> error;
    in property <bool> connecting;
    in property <bool> can-cancel;
    in property <bool> stored;
    in property <[SavedHostRow]> hosts;
    callback connect(string, string);
    callback pair(string, string);
    callback forget();
    callback cancel();
    // Leaves a saved Host out of the list.
    callback remove(string);
    out property <string> repair-target;
    out property <bool> choosing-host: root.switch-from != "";
    callback repair(string, string, string, bool);
    callback switch-content(string);
    private property <string> switch-from;
    function submit(pairing: bool) {
        if (root.repair-target != "") {
            root.repair(root.repair-target, server.text, pairing ? code.text : token.text, pairing);
        } else if (pairing) { root.pair(server.text, code.text); }
        else { root.connect(server.text, token.text); }
    }
    public function open-for(url: string, action: string) {
        root.repair-target = (action == "pair" || action == "address") && url != root.base-url ? url : "";
        root.switch-from = action == "switch" ? url : "";
        server.text = url;
        token.text = "";
        code.text = "";
        if (action == "pair") { code.focus(); } else { server.focus(); }
    }
    card-width: 520px;
    card-height: 470px + (root.hosts.length > 0 ? 28px + root.hosts.length * 48px : 0px);
    dismissed => { if (root.can-cancel) { root.cancel(); } }
    VerticalLayout {
        padding: 28px;
        spacing: 14px;
        // i18n: Connection page, title (verb phrase); Clarp is the product name
        Text { text: @tr("Connect to Clarp"); color: Palette.text; font-size: 17 * Look.unit; font-weight: 600; }
        // i18n: Connection page, heading over the Hosts this app has connected to before (Host is the product noun, keep capitalised)
        if root.hosts.length > 0: Text { text: @tr("Saved Hosts"); color: Palette.muted; font-size: 11 * Look.unit; }
        // At most six (the app sends no more); Ctrl+K finds every saved Host.
        for host in root.hosts: HorizontalLayout {
            visible: root.repair-target == "" && host.url != root.switch-from;
            height: self.visible ? 40px : 0px;
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: (host.current ? "● " : "") + host.name;
                    color: host.current ? Palette.success : Palette.text;
                    font-size: 12 * Look.unit;
                    overflow: elide;
                    // i18n: Connection page, accessibility label of the Host this app is connected to now; {} is its name
                    accessible-label: host.current ? @tr("Connected Host {}", host.name)
                        // i18n: Connection page, accessibility label of a saved Host this app is not connected to now; {} is its name
                        : @tr("Saved Host {}", host.name);
                }
                Text { text: host.url; color: Palette.muted; font-size: 10 * Look.unit; overflow: elide; }
            }
            if !host.current || root.switch-from != "": Button {
                // i18n: Connection page, saved Host row, button (verb): connect to this Host
                text: @tr("Connect");
                enabled: !root.connecting;
                clicked => { if (root.switch-from != "") { root.switch-content(host.url); } else { root.connect(host.url, ""); } }
            }
            Button {
                // i18n: Connection page, saved Host row, button (verb): forget this saved Host
                text: @tr("Remove");
                enabled: !host.current;
                clicked => { root.remove(host.url); }
            }
        }
        server := Field {
            placeholder-text: "http://127.0.0.1:7682";
            // i18n: Connection page, accessibility label of the field for the Host's address (noun)
            accessible-label: @tr("Server");
        }
        token := Field {
            // i18n: Connection page, placeholder of the field for the Host's access token (noun: a secret key)
            placeholder-text: @tr("Token");
            input-type: password;
            // i18n: Connection page, accessibility label of the access token field (noun: a secret key)
            accessible-label: @tr("Token");
            accepted => { root.submit(false); }
        }
        Rectangle { height: 1px; background: Palette.border; }
        // i18n: Connection page, line over the pairing code field: instead of a token, pair with a code shown on the Host
        Text { text: @tr("Or pair with a one-time code"); color: Palette.muted; font-size: 11 * Look.unit; }
        HorizontalLayout {
            spacing: 8px;
            code := Field {
                placeholder-text: "clp_…";
                input-type: password;
                // i18n: Connection page, accessibility label of the one-time pairing code field (noun)
                accessible-label: @tr("Pairing code");
                accepted => { root.submit(true); }
            }
            Button {
                // i18n: Connection page, button (verb): pair with the Host using the one-time code
                text: @tr("Pair");
                enabled: code.text != "" && !root.connecting;
                clicked => { root.submit(true); }
            }
        }
        if root.error != "": Text { text: root.error; color: Palette.danger; font-size: 11 * Look.unit; wrap: word-wrap; }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: pill.preferred-width + 16px;
                height: 24px;
                y: 4px;
                border-radius: 12px;
                background: root.state == "live" ? Palette.success.with-alpha(0.2) : Palette.warning.with-alpha(0.2);
                // The connection state in the reader's language; an unknown
                // state is shown as the engine names it.
                pill := Text {
                    text:
                        // i18n: Connection page, state pill: connected and up to date (adjective)
                        root.state == "live" ? @tr("live")
                        // i18n: Connection page, state pill: connecting to the Host now (a state)
                        : root.state == "connecting" ? @tr("connecting")
                        // i18n: Connection page, state pill: the connection dropped and is being made again (a state)
                        : root.state == "reconnecting" ? @tr("reconnecting")
                        // i18n: Connection page, state pill: the Host cannot be reached (adjective)
                        : root.state == "offline" ? @tr("offline")
                        // i18n: Connection page, state pill: the Host refused the token or code (adjective)
                        : root.state == "unauthorized" ? @tr("unauthorized")
                        : root.state;
                    color: root.state == "live" ? Palette.success : Palette.warning;
                    font-size: 11 * Look.unit;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            // i18n: Connection page, button (verb): close the page without connecting
            if root.can-cancel: Button { text: @tr("Cancel"); clicked => { root.cancel(); } }
            if root.repair-target == "" && root.switch-from == "" && root.stored && server.text == root.base-url: Button {
                // i18n: Connection page, button (verb phrase): delete the access token this computer has saved
                text: @tr("Forget device token");
                enabled: !root.connecting;
                clicked => { token.text = ""; code.text = ""; root.forget(); }
            }
            Button {
                // i18n: Connection page, main button while connecting (a state)
                text: root.connecting ? @tr("Connecting…")
                    // i18n: Connection page, main button (verb): connect to the Host with the address and token above
                    : @tr("Connect");
                primary: true;
                enabled: !root.connecting;
                clicked => { root.submit(false); }
            }
        }
    }
}

// A message (or the whole chat) as plain text to select from: Slint's rich
// text cannot be selected, so this shows the same words without styling.
// Drag or Shift+arrows select, Ctrl+A selects all, Ctrl+C copies the
// selection; Escape or a click outside closes it.
// i18n-screen: select text
export component SelectTextPage inherits Modal {
    in property <string> title;
    in property <string> body;
    // What starts selected, its start in view.
    in property <int> from;
    in property <int> to;
    callback copy-all();
    callback close();
    public function open() {
        view.focus();
        root.placing = true;
    }
    // Once the page is laid out (it has just become visible): the anchor at
    // the end, so the caret, which the view keeps in sight, is the start.
    property <bool> placing;
    Timer {
        interval: 16ms;
        running: root.placing;
        triggered => {
            root.placing = false;
            view.set-selection-offsets(root.to, root.from);
        }
    }
    card-width: 860px;
    card-height: 2000px;
    dismissed => { root.close(); }
    VerticalLayout {
        padding: 20px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.title;
                color: Palette.text;
                font-size: 15 * Look.unit;
                font-weight: 600;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            copy-button := Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 4px;
                background: copy-touch.has-hover ? Palette.hover : transparent;
                accessible-role: button;
                // i18n: Select text page (a message as plain text to select from), accessibility label of the copy button (verb phrase: copy the whole text)
                accessible-label: @tr("Copy all");
                Image { source: @image-url("icons/copy.svg"); width: 16px; height: 16px; colorize: Palette.muted; }
                copy-touch := TouchArea { clicked => { root.copy-all(); } }
            }
            close-button := Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 4px;
                background: close-touch.has-hover ? Palette.hover : transparent;
                accessible-role: button;
                // i18n: Select text page, accessibility label of the close button (verb)
                accessible-label: @tr("Close");
                Image { source: @image-url("icons/close.svg"); width: 16px; height: 16px; colorize: Palette.muted; }
                close-touch := TouchArea { clicked => { root.close(); } }
            }
        }
        Text {
            // i18n: Select text page, key help under the title; Ctrl+A, Ctrl+C and Esc are key names left as is; "all" = select all, copy and close are verbs
            text: @tr("Ctrl+A all · Ctrl+C copy · Esc close");
            color: Palette.muted;
            font-size: 11 * Look.unit;
        }
        view := TextEdit {
            text: root.body;
            read-only: true;
            wrap: word-wrap;
            vertical-stretch: 1;
            // i18n: Select text page, accessibility label of the text box the user selects from
            accessible-label: @tr("Selectable text");
        }
    }
}
