#. Settings > Language picker, line under the System option: the app follows the computer's language; {} is that language's own name, e.g. "Norsk bokmål"
msgid "Follows this computer: {}"
msgstr "Sigue a este ordenador: {}"

#. relative time for something under a minute ago, shown alone as a timestamp
msgid "Just now"
msgstr "Ahora mismo"

#. Settings > Appearance, row label (noun): the setting that picks the app's language
msgid "Language"
msgstr "Idioma"

#. Settings page, title at the top (noun), written in capitals where the script has them
msgid "SETTINGS"
msgstr "AJUSTES"

#. Settings > Language picker, first option (noun): use the language the computer is set to
msgid "System"
msgstr "Sistema"

#. Settings > Appearance, the Language row's current value when it follows the computer; {} is that language's own name
msgid "System ({})"
msgstr "Sistema ({})"

#. Settings > Appearance, description line under the Language row; "System" is the picker's first option
msgid "The language of the app. System follows this computer's languages."
msgstr "El idioma de la aplicación. Sistema sigue los idiomas de este ordenador."

#. day heading in the transcript and chat-list stamp for a message sent today (adverb, capitalised as a heading)
msgid "Today"
msgstr "Hoy"

#. day heading for something due tomorrow
msgid "Tomorrow"
msgstr "Mañana"

#. day heading in the transcript and chat-list stamp for a message sent yesterday
msgid "Yesterday"
msgstr "Ayer"

#. relative timestamp for something due in the future; {n} is the number
msgid "in {n} day"
msgid_plural "in {n} days"
msgstr[0] "dentro de {n} día"
msgstr[1] "dentro de {n} días"

#. relative timestamp for something due in the future; {n} is the number
msgid "in {n} hour"
msgid_plural "in {n} hours"
msgstr[0] "dentro de {n} hora"
msgstr[1] "dentro de {n} horas"

#. relative timestamp for something due in the future; {n} is the number
msgid "in {n} minute"
msgid_plural "in {n} minutes"
msgstr[0] "dentro de {n} minuto"
msgstr[1] "dentro de {n} minutos"

#. relative timestamp for something due in the future; {n} is the number
msgid "in {n} month"
msgid_plural "in {n} months"
msgstr[0] "dentro de {n} mes"
msgstr[1] "dentro de {n} meses"

#. relative timestamp for something due in the future; {n} is the number
msgid "in {n} week"
msgid_plural "in {n} weeks"
