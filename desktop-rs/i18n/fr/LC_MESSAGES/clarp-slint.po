#. context: error.invalid_request
msgctxt "error.invalid_request"
msgid ""
"{backend} rejected the conversation history. Start a fresh session with the same conversation and try again."
msgstr ""
"{backend} a refusé l’historique de la conversation. Démarrez une nouvelle session avec la même conversation, puis réessayez."

