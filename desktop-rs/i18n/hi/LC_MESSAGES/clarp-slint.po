# Clarp desktop: hi. Edit with tools/i18n-import; see docs/i18n.md.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: hi\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

#. Settings file problems and :set errors, shown on the settings page; added after the allowed range when 0 also works; {} is what 0 means (e.g. Full width)
msgid " (or 0: {})"
msgstr " (या 0: {})"

#. settings value editor for a colour: the format and the theme's own colour; {} is that colour (#rrggbb stays)
msgid "#rrggbb · the theme's {}"
msgstr "#rrggbb · थीम का {}"

#. Teams page, small button after the member chips: adds an agent to the team; keep it short, the + means add
msgid "+ member"
msgstr "+ सदस्य"

#. chat, opened tool output: how many earlier lines are not shown; {n} is the count
msgid "+{n} earlier line"
msgid_plural "+{n} earlier lines"
msgstr[0] "+{n} पहले की लाइन"
msgstr[1] "+{n} पहले की लाइनें"

#. chat, folded tool output: how many more lines there are; {n} is the count
msgid "+{n} line"
msgid_plural "+{n} lines"
msgstr[0] "+{n} लाइन"
msgstr[1] "+{n} लाइनें"

#. chat, activity cell, last line when lines are hidden; {n} is how many more lines there are
msgid "+{n} more"
msgid_plural "+{n} more"
msgstr[0] "+{n} और"
msgstr[1] "+{n} और"

#. chat, quiet line where hidden messages between agents were: more than 100 of them
msgid "100+ messages between agents"
msgstr "एजेंटों के बीच 100+ मैसेज"

#. Settings page and Ctrl+K, the line under the preference “Time format” saying what it does.
msgid "12- or 24-hour clock for message and chat-list times"
msgstr "मैसेज और चैट सूची के समय के लिए 12- या 24-घंटे की घड़ी"

#. Settings > Time format, an option: how times are written; keep the example time as it is
msgid "12-hour (6:10 PM)"
msgstr "12-घंटे (6:10 PM)"

#. Settings > Time format, an option: how times are written; keep the example time as it is
msgid "24-hour (18:10)"
msgstr "24-घंटे (18:10)"

#. Key-binding editor and keymap import, error: a double press must be the same key twice (e.g. Right Right); {} is what was typed
msgid "A double press is one key twice: {}"
msgstr "डबल प्रेस का मतलब एक ही की दो बार: {}"

#. agent profile, error moving an agent: another move runs
msgid "A move is already running"
msgstr "एक ट्रांसफ़र पहले से चल रहा है"

#. Keys help (?), in the chat: what a key does, beside the key "PgUp / PgDn"
msgid "A page"
msgstr "एक पेज"

#. Settings page and Ctrl+K, the line under the preference “Send animation” saying what it does.
msgid "A sent message flies from the composer to its place in the chat"
msgstr "भेजा गया मैसेज मैसेज बॉक्स से उड़कर चैट में अपनी जगह पर पहुंचता है"

#. Settings > Appearance, description of the "Night" reading theme (font and product names stay as they are)
msgid ""
"A serif in warm parchment tones on brown-black, with little blue. For reading in the dark."
msgstr ""
"भूरे-काले पर गर्म चर्मपत्र रंगों में सेरिफ़ फ़ॉन्ट, नीला बहुत कम। अंधेरे में पढ़ने के लिए।"

#. settings, value editor description for importing a settings file
msgid ""
"A settings file exported from Clarp (or written by hand): its valid settings are applied, the rest is reported."
msgstr ""
"Clarp से एक्सपोर्ट की गई (या हाथ से लिखी गई) सेटिंग्स फ़ाइल: इसकी सही सेटिंग्स लागू की जाती हैं, बाकी के बारे में बताया जाता है।"

#. form card footnote, in place of a text field's label when it has none
msgid "A text"
msgstr "टेक्स्ट"

#. Settings page, section heading in capitals: the app's and the Host's versions
msgid "ABOUT"
msgstr "इसके बारे में"

#. Settings page, section heading in capitals: whether new agents get a contact's name and persona
msgid "AGENT IDENTITY"
msgstr "एजेंट की पहचान"

#. All agents overview, title at the top (noun, plural; written in capitals where the script has them)
msgid "AGENTS"
msgstr "एजेंट"

#. Orchestrator dialog, accessibility label of the switch that turns AI routing on (noun: an AI model picks which agent gets a request)
#. Orchestrator dialog, label beside the switch that turns AI routing on (noun)
msgid "AI routing"
msgstr "AI रूटिंग"

#. Settings page, section heading in capitals: the settings file and actions on every setting
msgid "ALL SETTINGS"
msgstr "सभी सेटिंग्स"

#. Settings page, section heading in capitals: how the app looks (noun)
msgid "APPEARANCE"
msgstr "दिखावट"

#. All agents overview, heading over archived agents (adjective used as a noun; written in capitals where the script has them)
msgid "ARCHIVED"
msgstr "संग्रहित"

#. artifacts gallery, tiny badge on a decision or question tile (a question to the user, max 4 letters)
msgid "ASK"
msgstr "सवाल"

#. artifacts gallery, tiny badge on an audio tile (abbreviation, max 4 letters)
msgid "AUD"
msgstr "ऑडियो"

#. artifact card kind label, small capitals: an audio recording
msgid "AUDIO"
msgstr "ऑडियो"

#. agent profile, section title in capitals: what the agent does by itself and when it notifies the user
msgid "AUTONOMY & NOTIFICATIONS"
msgstr "स्वायत्तता और सूचनाएं"

#. decision card, how long answering takes
msgid "About a minute"
msgstr "लगभग एक मिनट"

#. Settings > Colours, a colour setting's name, the row label (noun). What it colours: Colour of highlights, the cursor, switches and section titles
msgid "Accent"
msgstr "ऐक्सेंट"

#. form card, chart's spoken summary (accessibility): what the horizontal axis shows; {} is its label
msgid "Across: {}"
msgstr "क्षैतिज: {}"

#. key-binding editor, shortcut bar: the arrows move between actions (noun)
msgid "Action"
msgstr "कार्रवाई"

#. Settings > Experiments, the line describing the Tool detail level "Technical"
#. Settings > Experiments, tool explanations at the Technical level: what it shows
msgid "Actions with commands and paths."
msgstr "कमांड और पाथ के साथ कार्रवाइयां।"

#. Settings > Experiments, the line describing the Tool detail level "Balanced"
#. Settings > Experiments, tool explanations at the Balanced level: what it shows
msgid "Actions with key technical details."
msgstr "मुख्य तकनीकी जानकारी के साथ कार्रवाइयां।"

#. chat, title of an activity cell that has none (noun)
msgid "Activity"
msgstr "गतिविधि"

#. Settings page and Ctrl+K, a setting's name, the row label (a switch). What it does: The icon strip on the far left: Chats, Updates, Teams and Settings.
#. Settings page and Ctrl+K, a preference's name, the row label. What it does: The icon rail on the far left (Chats, Updates, Teams, Settings)
msgid "Activity bar"
msgstr "ऐक्टिविटी बार"

#. Add team member dialog, check icon button tooltip (verb): adds the chosen agent to the team
msgid "Add"
msgstr "जोड़ें"

#. key-binding editor, shortcut bar: Enter adds a key to the action (verb phrase)
msgid "Add key"
msgstr "की जोड़ें"

#. Teams page, accessibility label of the "+ member" button after the member chips (an action: add an agent to the team)
#. Add team member dialog, title
msgid "Add team member"
msgstr "टीम में सदस्य जोड़ें"

#. Settings > Chats > Send while working, and Send's menu during a turn: choice that sends the message once the turn has ended
msgid "After the turn"
msgstr "टर्न के बाद"

#. Add team member dialog, label above the picker of agents (noun)
#. Add team member dialog, accessibility label of the agent picker (noun)
#. agent profile, the agent's name when it has none (noun)
msgid "Agent"
msgstr "एजेंट"

#. All agents overview, agent card, tooltip of the ··· menu button (noun phrase: actions for this agent)
msgid "Agent actions"
msgstr "एजेंट की कार्रवाइयां"

#. chat title of a conversation between agents that has no title of its own
msgid "Agent conversation"
msgstr "एजेंटों की बातचीत"

#. chat list, row that opens the list of conversations between agents (agent-to-agent rooms) (noun)
#. Keys (key context “Everywhere”): the name of a key's action, in the shortcut bar, Keys help (?) and the key-binding editor. It shows the rooms where agents talk to each other.
msgid "Agent conversations"
msgstr "एजेंटों की बातचीत"

#. Ctrl+K command palette, a command's name (an action; a verb phrase is a command, a noun phrase names what it opens). What it does: Shows the rooms where agents talk to each other.
msgid "Agent conversations (agent to agent)"
msgstr "एजेंटों की बातचीत (एजेंट से एजेंट)"

#. chat list, accessibility label of the row that opens the agent-to-agent conversations, when there are none yet
msgid "Agent conversations, none yet"
msgstr "एजेंटों की बातचीत, अभी कोई नहीं"

#. chat list, accessibility label of the row that opens the agent-to-agent conversations; {} is how many there are
msgid "Agent conversations, {}"
msgstr "एजेंटों की बातचीत, {}"

#. chat, accessibility label of the "Working…" indicator under the last message while the agent works
msgid "Agent is working"
msgstr "एजेंट काम कर रहा है"

#. chat list, quiet note: the agent list is old and being read again; {} is the time it was last read ("14:02")
msgid "Agent list from {} · retrying"
msgstr "{} की एजेंट सूची · फिर से कोशिश हो रही है"

#. chat list, quiet note: the agent list has not loaded and is being read again
msgid "Agent list not loaded yet · retrying"
msgstr "एजेंट सूची अभी लोड नहीं हुई · फिर से कोशिश हो रही है"

#. Ctrl+K command palette, a command's name (an action; a verb phrase is a command, a noun phrase names what it opens). What it does: Shows every agent and what it is doing.
msgid "Agent overview"
msgstr "एजेंट ओवरव्यू"

#. Settings page and Ctrl+K, a setting's name, the row label (a choice that opens a list). What it does: How large agents' portraits are in the explorer; opens a list of sizes.
#. Settings page and Ctrl+K, a preference's name, the row label. What it does: Size of the agents' portraits in the explorer, compact rows and cards
msgid "Agent picture size"
msgstr "एजेंट की तस्वीर का साइज़"

#. chat pane border, accessibility label of the agent's name in the top right corner (a button that opens the agent's profile)
#. chat header, accessibility label of the agent's name, which opens the agent's profile (noun)
#. Ctrl+K command palette, a command's name (an action; a verb phrase is a command, a noun phrase names what it opens). What it does: Opens the open agent's profile: its artifacts and images, files, terminal, voice, plan, prompt history, model and backend.
#. Keys (key context “Everywhere”): the name of a key's action, in the shortcut bar, Keys help (?) and the key-binding editor. It opens the open agent's profile: its artifacts and images, files, terminal, voice, plan, prompt history, model and backend.
#. Key-binding editor and Keys help, the name of a key context (where a key works): an agent's profile
#. Vim mode, the which-key panel: what the keys "<Space> p" do in the chat and the explorer
msgid "Agent profile"
msgstr "एजेंट प्रोफ़ाइल"

#. quick switcher (Ctrl+K), placeholder of the search field: what can be found by typing
#. Ctrl+K command palette, placeholder of the search field: what it finds
msgid "Agent, contact, setting or command"
msgstr "एजेंट, संपर्क, सेटिंग या कमांड"

#. composer, accessibility label of the list of agents that pop up while typing @ (to mention one)
msgid "Agents to mention"
msgstr "मेंशन करने के लिए एजेंट"

#. Ctrl+K command palette, a command's name (an action; a verb phrase is a command, a noun phrase names what it opens). What it does: Shows every chat in the explorer.
#. Keys (key context “Everywhere”): the name of a key's action, in the shortcut bar, Keys help (?) and the key-binding editor. It shows every chat in the explorer.
msgid "Agents: all chats"
msgstr "एजेंट: सभी चैट"

#. Ctrl+K command palette, a command's name (an action; a verb phrase is a command, a noun phrase names what it opens). What it does: Shows only the chats that are idle and read in the explorer.
#. Keys (key context “Everywhere”): the name of a key's action, in the shortcut bar, Keys help (?) and the key-binding editor. It shows only the chats that are idle and read in the explorer.
msgid "Agents: done"
msgstr "एजेंट: पूरे हुए"

#. Ctrl+K command palette, a command's name (an action; a verb phrase is a command, a noun phrase names what it opens). What it does: Shows only the chats waiting for you: unread, asking a question or holding a decision. Snoozed chats stay out.
#. Keys (key context “Everywhere”): the name of a key's action, in the shortcut bar, Keys help (?) and the key-binding editor. It shows only the chats waiting for you: unread, asking a question or holding a decision. Snoozed chats stay out.
msgid "Agents: needs you"
msgstr "एजेंट: आपके लिए"

#. Ctrl+K command palette, a command's name (an action; a verb phrase is a command, a noun phrase names what it opens). What it does: Shows the chats you snoozed, with when each comes back.
#. Keys (key context “Everywhere”): the name of a key's action, in the shortcut bar, Keys help (?) and the key-binding editor. It shows the chats you snoozed, with when each comes back.
msgid "Agents: snoozed"
msgstr "एजेंट: स्नूज़ की गई"

#. Ctrl+K command palette, a command's name (an action; a verb phrase is a command, a noun phrase names what it opens). What it does: Shows only chats with unread messages in the explorer.
#. Keys (key context “Everywhere”): the name of a key's action, in the shortcut bar, Keys help (?) and the key-binding editor. It shows only chats with unread messages in the explorer.
msgid "Agents: unread only"
msgstr "एजेंट: सिर्फ़ नहीं पढ़ी गई"

#. Ctrl+K command palette, a command's name (an action; a verb phrase is a command, a noun phrase names what it opens). What it does: Shows only the chats whose agent is working now in the explorer.
#. Keys (key context “Everywhere”): the name of a key's action, in the shortcut bar, Keys help (?) and the key-binding editor. It shows only the chats whose agent is working now in the explorer.
msgid "Agents: working"
msgstr "एजेंट: काम कर रहे"

#. voice picker dialog, title when the agent has no name
msgid "Agent’s voice"
msgstr "एजेंट की आवाज़"

#. chat list, filter chip above the chats: shows every chat
msgid "All"
msgstr "सभी"

#. navigation rail, tooltip of the button that shows every agent at once (the overview)
msgid "All agents"
msgstr "सभी एजेंट"

#. agent profile, Publications section, button that opens everything this agent has published
#. agent profile, shortcut bar label: opens everything the agent published
msgid "All publications"
msgstr "सभी पब्लिकेशन"

#. plan or workflow card in the chat, line under the progress bar when every step is finished
msgid "All steps done"
msgstr "सभी चरण पूरे हुए"

#. artifacts gallery footer: every item is shown; {n} is the count
msgid "All {n} shown"
msgid_plural "All {n} shown"
msgstr[0] "सभी {n} दिख रहे हैं"
msgstr[1] "सभी {n} दिख रहे हैं"

#. processes, outcome beside a background job after Stop: it had already ended, or it is now stopped (past participle)
msgid "Already stopped"
msgstr "पहले ही रुक चुका है"

#. Settings > Reset font to theme default, the row's value when nothing is changed
msgid "Already the theme default"
msgstr "पहले से थीम डिफ़ॉल्ट है"

#. Running box, second line: the agent's own turn also runs while a fork answers
msgid "Also working"
msgstr "साथ में अपना काम भी कर रहा है"

#. Running box, second line: the agent's own turn also runs, with an unnamed agent
msgid "Also working with another agent"
msgstr "साथ में दूसरे एजेंट के साथ भी काम कर रहा है"

#. Running box, second line: the agent's own turn also runs; {} is the other agent's name
msgid "Also working with {}"
msgstr "साथ में {} के साथ भी काम कर रहा है"

#. Settings > Scrollbar, an option: when scroll bars show
msgid "Always"
msgstr "हमेशा"

#. agent profile, "Tool activity" drop-down, option: every tool step stays shown
#. Settings > Tool activity, option: every tool call is always shown
#. Settings > Tool activity, an option: how tool calls show in the chat
#. Tool activity choice: every tool call stays shown
msgid "Always visible"
msgstr "हमेशा दिखाएं"

#. chat, who sent a prompt from another agent, when it has no name
msgid "An agent"
msgstr "कोई एजेंट"

#. Settings page and Ctrl+K, the line under the setting “Send animation” saying what it does
msgid "Animate sent messages into the chat."
msgstr "भेजे गए मैसेज को ऐनिमेशन के साथ चैट में लाएं।"

#. Settings page and Ctrl+K, a preference's name, the row label. What it does: Start new agents without a persona by default
msgid "Anonymous agents"
msgstr "गुमनाम एजेंट"

#. Settings page and Ctrl+K, a setting's name, the row label (a switch). What it does: New agents start without a contact's name and persona.
msgid "Anonymous agents by default"
msgstr "डिफ़ॉल्ट रूप से गुमनाम एजेंट"

#. dictation error: another window records already
msgid "Another Clarp window is recording. Stop that recording before starting here."
msgstr ""
"Clarp की दूसरी विंडो रिकॉर्ड कर रही है। यहां शुरू करने से पहले वह रिकॉर्डिंग रोकें।"

#. window banner: another Clarp window saved its pane layout later; this window's is kept as a recovery copy
msgid ""
"Another window saved a newer layout. This window's layout is kept in recovery."
msgstr ""
"किसी दूसरी विंडो ने नया लेआउट सेव किया है। इस विंडो का लेआउट रिकवरी में रखा गया है।"

#. decision card once answered: the answer was kept
msgid "Answer saved"
msgstr "जवाब सेव हो गया"

#. chat, chip on an answered question card when the answer has no words of its own (past participle)
#. chat, compact form card once answered (past participle)
msgid "Answered"
msgstr "जवाब दिया गया"

#. form card footnote after the answer was sent; the agent receives it when it next runs; {} is when it was answered (a time)
msgid "Answered {}. The agent gets it when it is next awake."
msgstr "{} जवाब दिया गया। एजेंट के अगली बार सक्रिय होने पर उसे मिलेगा।"

#. form card footnote after the answer was sent and the agent received it; {} is when it was answered (a time)
msgid "Answered {}. The agent has it."
msgstr "{} जवाब दिया गया। एजेंट को मिल गया है।"

#. chat, compact form card once answered; {} is the label of the button the user pressed
msgid "Answered · {}"
msgstr "जवाब दिया गया · {}"

#. form card footnote after the answer was sent; the agent receives it when its session next runs
msgid "Answered. The agent gets it when it is next awake."
msgstr "जवाब दिया गया। एजेंट के अगली बार सक्रिय होने पर उसे मिलेगा।"

#. form card footnote after the answer was sent and the agent received it
msgid "Answered. The agent has it."
msgstr "जवाब दिया गया। एजेंट को मिल गया है।"

#. chat header, the agent is busy answering other agents
msgid "Answering other agents"
msgstr "दूसरे एजेंटों को जवाब दे रहा है"

#. chat header, the agent answers other agents first; {} is how many messages wait ahead of the user's
msgid "Answering other agents · {} ahead of you"
msgstr "दूसरे एजेंटों को जवाब दे रहा है · आपसे पहले {}"

#. card status after sending answers: the Host took them
msgid "Answers accepted"
msgstr "जवाब स्वीकार किए गए"

#. error banner when starting an agent (Antigravity is a product name)
msgid "Antigravity is unavailable for new sessions on this Host"
msgstr "इस Host पर नए सेशन के लिए Antigravity उपलब्ध नहीं है"

#. Settings > Kept processes, the "When" row's value: a change takes effect with the next message
msgid "Applies on next message."
msgstr "अगले मैसेज से लागू होगा।"

#. Settings page and Ctrl+K, the line under the setting “Import settings…” saying what it does
msgid ""
"Applies the valid preferences of a settings file exported from Clarp and reports the rest."
msgstr ""
"Clarp से एक्सपोर्ट की गई सेटिंग्स फ़ाइल की सही सेटिंग्स लागू करता है और बाकी के बारे में बताता है।"

#. All agents overview, agent card menu item (verb): archive the agent
msgid "Archive"
msgstr "संग्रहित करें"

#. chat list, row at the bottom that opens the list of archived chats (adjective used as a list name; a count follows)
msgid "Archived"
msgstr "संग्रहित"

#. Ctrl+K command palette, a command's name (an action; a verb phrase is a command, a noun phrase names what it opens). What it does: Shows archived agents so you can restore them.
#. Keys (key context “Everywhere”): the name of a key's action, in the shortcut bar, Keys help (?) and the key-binding editor. It shows archived agents so you can restore them.
msgid "Archived agents"
msgstr "संग्रहित एजेंट"

#. artifact card title when it has none (noun: something an agent published)
#. artifacts gallery, title of an artifact with no title or file name (noun: something an agent published)
msgid "Artifact"
msgstr "आर्टिफ़ैक्ट"

#. chat's ⋯ menu, item that opens the agent's artifacts (published files, reports, documents) (noun)
msgid "Artifacts"
msgstr "आर्टिफ़ैक्ट"

#. artifacts gallery error: the artifacts list stopped loading; {} is the reason (End is the keyboard key)
msgid "Artifacts could not be read further: {}. End tries again."
msgstr "आर्टिफ़ैक्ट आगे नहीं पढ़े जा सके: {}। End से फिर से कोशिश करें।"

#. Settings page and Ctrl+K, the line under the preference “Confirm stop and release” saying what it does.
msgid ""
"Ask before Stop agent (Ctrl+.) or Release agent interrupt or let go of an agent"
msgstr ""
"एजेंट रोकें (Ctrl+.) या एजेंट को खत्म करें से किसी एजेंट को बीच में रोकने या छोड़ने से पहले पूछें"

#. processes panel note after asking a helper agent to stop; {} is its name
msgid "Asked {} to stop."
msgstr "{} को रुकने के लिए कहा गया।"

#. Assign contact dialog, primary button (verb: assign the chosen contact to this chat)
msgid "Assign"
msgstr "असाइन करें"

#. Assign contact dialog, title at the top: the dialog picks which agent contact runs this chat (verb phrase)
msgid "Assign contact"
msgstr "संपर्क असाइन करें"

#. Assign contact dialog, primary button text while the contact is being assigned (in progress)
msgid "Assigning…"
msgstr "असाइन किया जा रहा है…"

#. agent profile, Backend picker: why a backend is dimmed
