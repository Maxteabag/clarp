#. chat menu and profile, name of the chat view that shows messages and replies only (noun)
#. context: chat view
msgctxt "chat view"
msgid "Conversation"
msgstr "Samtale"

#. chat menu and profile, name of the chat view that also shows the agent's work (noun)
#. context: chat view
msgctxt "chat view"
msgid "Session"
msgstr "Økt"

#. countdown card, note: the countdown was cancelled (past participle)
#. context: countdown
msgctxt "countdown"
msgid "Cancelled"
msgstr "Avbrutt"

#. countdown card, shown in place of the time for the first minute after the target (adverb)
#. context: countdown
msgctxt "countdown"
msgid "Now"
msgstr "Nå"

#. Settings > Experiments, tool explanation level (adjective): between technical and plain
#. context: detail level
msgctxt "detail level"
msgid "Balanced"
msgstr "Balansert"

#. Settings > Experiments, tool explanation level (noun): written for developers, shows the original calls
#. context: detail level
msgctxt "detail level"
msgid "Developer"
msgstr "Utvikler"

#. Settings > Experiments, tool explanation level (playful noun): the simplest words, for someone with no technical knowledge
#. context: detail level
